界面:
{
    页面:
    {
        文字框:{名称:"标题",提示内容:"龙珠激斗脚本：邮件闭环",文字大小:16},
        文字框:{名称:"环境",提示内容:"MuMu 720×1280、320 DPI；当前QQ与当前区服",文字大小:12},
        多选框:{名称:"邮件启用",提示内容:"领取邮件奖励",选中:true},
        输入框:{名称:"邮件间隔秒",提示内容:"完成后再次执行间隔（秒）",初始文本:"21600",仅输入数字:true,最大输入长度:7},
        输入框:{名称:"登录总超时秒",提示内容:"启动到大厅总超时，含QQ授权（秒）",初始文本:"600",仅输入数字:true,最大输入长度:5},
        输入框:{名称:"业务总超时秒",提示内容:"业务及公共返回各自总超时（秒）",初始文本:"120",仅输入数字:true,最大输入长度:5},
        输入框:{名称:"返回延迟秒",提示内容:"公共返回/清障延迟（0为1秒，其余为设置秒数）",初始文本:"0",仅输入数字:true,最大输入长度:4},
        下拉框:{名称:"消息邮件",选项:["手动阅读","自动阅读",],初始选项:0},
        文字框:{名称:"规则",提示内容:"每次启动先执行邮件；超时重启后继续邮件；回大厅确认后才提交。",文字大小:12},
    },
}
