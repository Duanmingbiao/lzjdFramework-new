Dim coopEnabled, coopKeepDownload, coopTeamMode, coopInterval, coopRegisteredTask, coopFirst, coopDue, coopDone, coopFailed, coopCount, coopFailures, coopRestarts, coopRecoveries, coopPhase, coopTerminal, coopTerminalReason, coopLastMatch, coopLastOcr, coopTimeKey
Dim wukongLastOcr, wukongLastMatch
Dim wukongEnabled, wukongKeepDownload, wukongHidden, wukongSweep, wukongInterval, wukongRegisteredTask, wukongFirst, wukongDue, wukongDone, wukongFailed, wukongCount, wukongFailures, wukongRestarts, wukongRecoveries, wukongPhase, wukongTerminal, wukongTerminalReason
Dim stamina50Failed, stamina50Phase, stamina50Restarts, stamina50Recoveries, stamina51Failed, stamina51Phase, stamina51Restarts, stamina51Recoveries, stamina52Failed, stamina52Phase, stamina52Restarts, stamina52Recoveries, stamina53Failed, stamina53Phase, stamina53Restarts, stamina53Recoveries, stamina54Failed, stamina54Phase, stamina54Restarts, stamina54Recoveries
Dim staminaKeepDownload
Dim staminaEnabled, staminaGem, staminaRecover, staminaExchange, staminaPhase, staminaRestartCount, staminaRecoveryCount, staminaTerminal, stamina50Due, stamina50Count, stamina50Failures, stamina50Done, stamina51Due, stamina51Count, stamina51Failures, stamina51Done, stamina52Due, stamina52Count, stamina52Failures, stamina52Done, stamina53Due, stamina53Count, stamina53Failures, stamina53Done, stamina54Due, stamina54Count, stamina54Failures, stamina54Done
Dim qfriendEnabled, qfriendOneClick, qfriendInterval, qfriendRegisteredTask, qfriendDone, qfriendFailed, qfriendCount, qfriendFailures, qfriendDue, qfriendFirst, qfriendPhase, qfriendTerminal, qfriendRecovery
Dim friendEnabled, friendInterval, friendRegisteredTask, friendDone, friendFailed, friendCount, friendFailures, friendDue, friendFirst, friendPhase
// 龙珠激斗脚本: independent MQ implementation. Mail168 and task rewards169 share one scheduler.
Dim RESULT_OK, RESULT_WAIT, RESULT_FAIL, RESULT_TIMEOUT
Dim GAME_PACKAGE, QQ_PACKAGE, stageName, foundX, foundY
Dim mailEnabled, mailInterval, loginLimit, businessLimit, messageMode
Dim currentTask, resumeTask, registeredTask, mailDone, mailFailed
Dim mailCount, mailFailures, mailDue, mailFirst, mailPhase
Dim loginStarted, businessStarted, progressAt, loginFailures
Dim hallFrames, hallSampleAt, terminalConfirmed
Dim qqLastForeground, qqLastDiagnosticAt
Dim hallMisses, hallExtended, hallActionIndex, hallReturnDelaySeconds
Dim rewardEnabled, rewardInterval, rewardRegisteredTask
Dim rewardDone, rewardFailed, rewardCount, rewardFailures
Dim rewardDue, rewardFirst, rewardPhase
Dim foregroundThread, foregroundLoginPending, foregroundStartupAt
Dim signEnabled, signInterval, signRegisteredTask
Dim signDone, signFailed, signCount, signFailures, signDue, signFirst, signPhase
Dim monthEnabled, monthInterval, monthRegisteredTask, monthKeepDownload
Dim monthDone, monthFailed, monthCount, monthFailures, monthDue, monthFirst, monthPhase
Dim monthCardType, monthlySearchDirection, activityOcrLast, activityOcrLogAt
Call InitConstants()
Call LoadSettings()
Call NewSession()
Call InitForegroundMonitor()
Call RegisterTasks()
If GetScreenX() <> 720 Or GetScreenY() <> 1280 Then
    TracePrint "需要720x1280；请同时在MuMu确认320 DPI"
    EndScript
End If
Call Note("新会话启动；已勾选普通任务先执行一次")
Call Note("线程启动R2：准备调用Thread.Start")
foregroundThread = Thread.Start(ForegroundMonitor)
Call Note("线程启动R2：Thread.Start已返回")
foregroundStartupAt = TickCount()
Do While Not Thread.GetShareVar("fg.ready")
    If TickCount() - foregroundStartupAt >= 3000 Then
        Call Note("线程启动R2：3秒未完成首次采样，停止；检查前台日志最后一步")
        ExitScript
    End If
    Delay 20
Loop
Call Note("线程启动R2：首次采样已确认，进入公共调度")
Do
    Call SchedulerStep()
    Delay 200
Loop


// common/常量.mq
Sub InitConstants()
    RESULT_OK = 1
    RESULT_WAIT = 2
    RESULT_FAIL = 3
    RESULT_TIMEOUT = 4
    GAME_PACKAGE = "com.tencent.tmgp.dragonball"
    QQ_PACKAGE = "com.tencent.mobileqq"
End Sub


// common/前台监控.mq
// User-defined foreground policy. This thread only samples and reports.
// Peterson two-party gate: exactly one main thread and one monitor thread.
// Shared reads/writes use the engine store; never call the iOS-only lock APIs.
Sub EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.gate.main", True)
    Call Thread.SetShareVar("fg.gate.turn", "monitor")
    Do While Thread.GetShareVar("fg.gate.monitor") And Thread.GetShareVar("fg.gate.turn") = "monitor"
        Delay 1
    Loop
End Sub
Sub LeaveMainForegroundGate()
    Call Thread.SetShareVar("fg.gate.main", False)
End Sub
Sub EnterMonitorForegroundGate()
    Call Thread.SetShareVar("fg.gate.monitor", True)
    Call Thread.SetShareVar("fg.gate.turn", "main")
    Do While Thread.GetShareVar("fg.gate.main") And Thread.GetShareVar("fg.gate.turn") = "main"
        Delay 1
    Loop
End Sub
Sub LeaveMonitorForegroundGate()
    Call Thread.SetShareVar("fg.gate.monitor", False)
End Sub
Sub InitForegroundMonitor()
    Call Thread.SetShareVar("fg.gate.main", False)
    Call Thread.SetShareVar("fg.gate.monitor", False)
    Call Thread.SetShareVar("fg.gate.turn", "main")
    Call Thread.SetShareVar("fg.recovering", False)
    Call Thread.SetShareVar("fg.request", False)
    Call Thread.SetShareVar("fg.outside", False)
    Call Thread.SetShareVar("fg.since", 0)
    Call Thread.SetShareVar("fg.last", "<未采样>")
    Call Thread.SetShareVar("fg.reason", "")
    Call Thread.SetShareVar("fg.ready", False)
    foregroundLoginPending = False
End Sub
Sub ForegroundLog(message)
    Call WriteForegroundLog("[龙珠激斗脚本][前台监控] " & message)
End Sub
Sub SampleForeground(gamePackage, qqPackage)
    Dim package, nowAt, recovering, outside, startupProbe
    startupProbe = Not Thread.GetShareVar("fg.ready")
    // Lock only this short sample; never hold across waits or game lifecycle calls.
    If startupProbe Then
        Call ForegroundLog("线程互斥R3：首次采样进入共享互斥前")
    End If
    Call EnterMonitorForegroundGate()
    If startupProbe Then
        Call ForegroundLog("线程互斥R3：已进入共享互斥，读取前台前")
    End If
    package = Sys.GetFront()
    If startupProbe Then
        Call ForegroundLog("线程启动R2：首次前台读取完成")
    End If
    nowAt = TickCount()
    If package <> Thread.GetShareVar("fg.last") Then
        Call Thread.SetShareVar("fg.last", package)
        Call ForegroundLog("前台包名=" & package)
    End If
    recovering = Thread.GetShareVar("fg.recovering")
    outside = Thread.GetShareVar("fg.outside")
    If recovering Then
        Call Thread.SetShareVar("fg.outside", False)
    ElseIf Not Thread.GetShareVar("fg.request") Then
        If package = gamePackage Or package = qqPackage Or package = "com.tencent.mobileqq:openSdk" Then
            If outside Then
                Call ForegroundLog("回到允许前台，取消5秒倒计时")
            End If
            Call Thread.SetShareVar("fg.outside", False)
        ElseIf Not outside Then
            Call Thread.SetShareVar("fg.outside", True)
            Call Thread.SetShareVar("fg.since", nowAt)
            Call ForegroundLog("离开允许前台，开始5秒倒计时")
        ElseIf nowAt - Thread.GetShareVar("fg.since") >= 5000 Then
            Call Thread.SetShareVar("fg.reason", package)
            Call Thread.SetShareVar("fg.request", True)
            Call ForegroundLog("连续离开5秒，上报前台离开")
        End If
    End If
    Call LeaveMonitorForegroundGate()
End Sub
Sub ForegroundMonitor()
    // No cross-thread argument capture; initialize immutable package names locally.
    Dim monitorGame, monitorQQ
    Call ForegroundLog("线程启动R2：已进入监控线程")
    monitorGame = "com.tencent.tmgp.dragonball"
    monitorQQ = "com.tencent.mobileqq"
    Call SampleForeground(monitorGame, monitorQQ)
    Call ForegroundLog("线程启动R2：首次采样完成")
    Call Thread.SetShareVar("fg.ready", True)
    Do
        Call SampleForeground(monitorGame, monitorQQ)
        Delay 200
    Loop
End Sub
Function ForegroundInterrupted()
    Call EnterMainForegroundGate()
    ForegroundInterrupted = Thread.GetShareVar("fg.request")
    Call LeaveMainForegroundGate()
End Function
Sub BeginForegroundRecovery()
    Call EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.recovering", True)
    Call Thread.SetShareVar("fg.request", False)
    Call Thread.SetShareVar("fg.outside", False)
    Call LeaveMainForegroundGate()
End Sub
Sub EndForegroundRecovery()
    Call EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.outside", False)
    Call Thread.SetShareVar("fg.recovering", False)
    Call LeaveMainForegroundGate()
End Sub
Function BeginForegroundCommit()
    Dim accepted
    // Serialize the report/commit boundary; no completion can consume a pending report.
    Call EnterMainForegroundGate()
    accepted = Not Thread.GetShareVar("fg.request")
    BeginForegroundCommit = accepted
    If Not accepted Then
        Call LeaveMainForegroundGate()
    End If
End Function
Sub EndForegroundCommit()
    Call LeaveMainForegroundGate()
End Sub
Function HandleForegroundRecovery()
    HandleForegroundRecovery = False
    If Not ForegroundInterrupted() Then
        Exit Function
    End If
    Call Note("公共调度器收到前台离开；前台=" & Thread.GetShareVar("fg.reason"))
    If currentTask = 168 Or currentTask = 169 Or currentTask = 167 Or currentTask = 166 Or currentTask = 55 Or currentTask = 56 Or IsTimedStamina(currentTask) Or currentTask = 151 Or currentTask = 152 Or IsWorldBoss(currentTask) Then
        Call SaveRecovery()
    End If
    terminalConfirmed = False
    Call RestartGame()
    HandleForegroundRecovery = True
End Function


// common/日志.mq
// Separate files have one writer each; never acquire a nested thread lock here.
Sub WritePublicLog(path, message)
    Dim line, beforeBytes, afterBytes, created
    line = "[tick=" & TickCount() & "] " & message
    TracePrint line
    If Not Dir.Exist("/sdcard/Pictures") Then
        created = Dir.Create("/sdcard/Pictures")
    End If
    beforeBytes = 0
    If Dir.Exist(path) Then
        beforeBytes = File.Bytes(path)
    End If
    line = line & Chr(13) & Chr(10)
    Call File.Append(path, line)
    afterBytes = File.Bytes(path)
    If afterBytes <= beforeBytes Then
        TracePrint "[文件日志] 写入失败，请检查脚本应用存储权限和剩余空间"
    End If
End Sub
Sub WriteMainLog(message)
    Call WritePublicLog("/sdcard/Pictures/dragonball-main.log", message)
End Sub
Sub WriteForegroundLog(message)
    Call WritePublicLog("/sdcard/Pictures/dragonball-foreground.log", message)
End Sub
Sub Note(message)
    Call WriteMainLog("[龙珠激斗脚本][" & stageName & "] " & message)
End Sub
Sub SetStage(value)
    If stageName <> value Then
        stageName = value
        Call Note("进入阶段")
    End If
End Sub


// common/世界首领状态.mq
Function WorldBoolean(key)
    Dim raw, text
    WorldBoolean = False
    raw = ReadUIConfig(key, False)
    text = "<null>"
    If Not IsNull(raw) Then
        text = LCase(Trim(CStr(raw)))
        If text = "true" Or text = "1" Then
            WorldBoolean = True
        End If
    End If
    Call WriteMainLog("[世界首领配置] 键=" & key & " 原始值=" & text)
End Function
Function WorldNumber(key, defaultValue, upper)
    Dim raw, result
    raw = ReadUIConfig(key, defaultValue)
    result = defaultValue
    If IsNumeric(raw) Then
        If CDbl(raw) >= 0 And CDbl(raw) <= upper Then
            result = Int(CDbl(raw))
        End If
    End If
    Call WriteMainLog("[世界首领配置] 键=" & key & " 规范值=" & result)
    WorldNumber = result
End Function
Sub LoadWorldBossSettings()
    worldEnabled = WorldBoolean("世界首领启用")
    cellEnabled = WorldBoolean("打沙鲁启用")
    worldKeepDownload = WorldBoolean("保留下载提示")
    worldBuyConfig = WorldNumber("首领买次数", 0, 4)
    worldHour = WorldNumber("首领执行时", 10, 23)
    worldMinute = WorldNumber("首领执行分", 0, 59)
End Sub
Function WorldDayStart(stamp)
    WorldDayStart = Int((stamp + 28800) / 86400) * 86400 - 28800
End Function
Function IsWorldBoss(taskId)
    IsWorldBoss = taskId = 70 Or taskId = 32
End Function
Function WorldName(taskId)
    WorldName = "世界首领70"
    If taskId = 32 Then
        WorldName = "世界首领_打沙鲁32"
    End If
End Function
Sub WorldLog(message)
    Call Note("[" & WorldName(currentTask) & "] " & message)
End Sub
Sub WorldStage(value)
    If currentTask = 32 Then
        cellPhase = value
    Else
        worldPhase = value
    End If
    worldLastMatch = ""
    Call SetStage(value)
    Call WorldLog("当前阶段=" & value)
End Sub
Sub NewWorldBossSession()
    worldFinishedAt = 0
    cellFinishedAt = 0
    worldDue = WorldDayStart(Time()) + worldHour * 3600 + worldMinute * 60
    cellDue = WorldDayStart(Time()) + 75600
    worldBuyRuntime = worldBuyConfig
    worldLastMatch = ""
    worldLastOcr = ""
    worldTerminalReason = ""
    worldDone = False
    worldFailed = False
    worldCount = 0
    worldFailures = 0
    worldRestarts = 0
    worldRecoveries = 0
    worldPhase = "未开始"
    worldTerminal = False
    cellDone = False
    cellFailed = False
    cellCount = 0
    cellFailures = 0
    cellRestarts = 0
    cellRecoveries = 0
    cellPhase = "未开始"
    cellTerminal = False
End Sub
Function SelectWorldBoss()
    Dim nowStamp, dayStart
    SelectWorldBoss = 0
    nowStamp = Time()
    dayStart = WorldDayStart(nowStamp)
    If worldDue < dayStart Then
        worldDue = dayStart + worldHour * 3600 + worldMinute * 60
    End If
    If worldEnabled And nowStamp >= worldDue Then
        If nowStamp >= dayStart + 82800 Then
            worldDue = dayStart + 86400 + worldHour * 3600 + worldMinute * 60
            Call Note("[世界首领70] 已过23点窗口，不提交；下一次执行时间Unix=" & worldDue)
        Else
            SelectWorldBoss = 70
            Exit Function
        End If
    End If
    If cellEnabled And nowStamp >= cellDue Then
        If nowStamp >= dayStart + 82800 Then
            cellDue = dayStart + 86400 + 75600
            Call Note("[打沙鲁32] 已过23点窗口，不提交；下一次执行时间Unix=" & cellDue)
        ElseIf nowStamp >= dayStart + 75600 Then
            SelectWorldBoss = 32
        Else
            cellDue = dayStart + 75600
        End If
    End If
End Function
Sub StartWorldBossTask(taskId)
    worldLastMatch = ""
    worldLastOcr = ""
    worldTerminalReason = ""
    If taskId = 32 Then
        cellFinishedAt = 0
        cellTerminal = False
        cellDone = False
        cellFailed = False
        Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & cellRestarts & " 恢复次数=" & cellRecoveries)
    Else
        worldFinishedAt = 0
        worldTerminal = False
        worldDone = False
        worldFailed = False
        Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & worldRestarts & " 恢复次数=" & worldRecoveries & " 本会话剩余购买设置=" & worldBuyRuntime)
    End If
End Sub
Sub RecoverWorldBossTask(taskId)
    If taskId = 32 Then
        cellTerminal = False
        cellFailed = True
        cellFailures = cellFailures + 1
        cellRecoveries = cellRecoveries + 1
        Call WorldLog("保存恢复原任务=32 阶段=" & cellPhase & " 失败次数=" & cellFailures & " 恢复次数=" & cellRecoveries & " 是否提交完成=否")
    Else
        worldTerminal = False
        worldFailed = True
        worldFailures = worldFailures + 1
        worldRecoveries = worldRecoveries + 1
        Call WorldLog("保存恢复原任务=70 阶段=" & worldPhase & " 失败次数=" & worldFailures & " 恢复次数=" & worldRecoveries & " 是否提交完成=否")
    End If
End Sub
Sub RestartWorldBossTask(taskId)
    If taskId = 32 Then
        cellRestarts = cellRestarts + 1
        Call WorldLog("重启次数=" & cellRestarts & " 恢复次数=" & cellRecoveries)
    Else
        worldRestarts = worldRestarts + 1
        Call WorldLog("重启次数=" & worldRestarts & " 恢复次数=" & worldRecoveries)
    End If
End Sub
Sub CommitWorldBossTask(taskId)
    Dim dayStart, minute, finishedAt
    finishedAt = Time()
    If taskId = 70 And worldFinishedAt > 0 Then
        finishedAt = worldFinishedAt
    ElseIf taskId = 32 And cellFinishedAt > 0 Then
        finishedAt = cellFinishedAt
    End If
    dayStart = WorldDayStart(finishedAt)
    If taskId = 32 Then
        cellDone = True
        cellFailed = False
        cellCount = cellCount + 1
        cellDue = dayStart + 86400 + 75600
        cellPhase = "本日已完成"
        Call WorldLog("是否提交完成=是 次数=" & cellCount & " 下一次执行时间Unix=" & cellDue & " 重启次数=" & cellRestarts & " 恢复次数=" & cellRecoveries)
    Else
        worldDone = True
        worldFailed = False
        worldCount = worldCount + 1
        If finishedAt < dayStart + 75600 Then
            minute = Int(Rnd() * 50) + 1
            worldDue = dayStart + 75600 + minute * 60
            worldPhase = "本轮完成，等待夜间再次"
        Else
            worldDue = dayStart + 86400 + worldHour * 3600 + worldMinute * 60
            worldPhase = "本日已完成"
        End If
        Call WorldLog("是否提交完成=是 次数=" & worldCount & " 下一次执行时间Unix=" & worldDue & " 重启次数=" & worldRestarts & " 恢复次数=" & worldRecoveries)
    End If
End Sub


// common/合作冒险状态.mq
Function CoopBooleanSetting(key)
    Dim raw, text
    CoopBooleanSetting = False
    raw = ReadUIConfig(key, False)
    text = "<null>"
    If Not IsNull(raw) Then
        text = LCase(Trim(CStr(raw)))
        If text = "true" Or text = "1" Then
            CoopBooleanSetting = True
        End If
    End If
    Call WriteMainLog("[龙珠激斗脚本][合作152配置] 键=" & key & " 原始值=" & text)
End Function
Sub LoadCoopSettings()
    Dim raw
    coopEnabled = CoopBooleanSetting("合作冒险启用")
    coopKeepDownload = CoopBooleanSetting("保留下载提示")
    coopTeamMode = 0
    raw = ReadUIConfig("合作队伍模式", 0)
    If IsNumeric(raw) Then
        If CDbl(raw) = 1 Then
            coopTeamMode = 1
        End If
    End If
    coopInterval = 43200
    Call WriteMainLog("[龙珠激斗脚本][合作152配置] 队伍模式=" & coopTeamMode & " 间隔秒=" & coopInterval)
End Sub
Sub NewCoopSession()
    coopRegisteredTask = 152
    coopFirst = True
    coopDue = 0
    coopDone = False
    coopFailed = False
    coopCount = 0
    coopFailures = 0
    coopRestarts = 0
    coopRecoveries = 0
    coopPhase = "未开始"
    coopTerminal = False
    coopTerminalReason = ""
    coopLastMatch = ""
    coopLastOcr = ""
    coopTimeKey = ""
End Sub
Function CoopTimeEligible()
    Dim week, hour, key, state
    week = DateTime.WeekDay()
    hour = DateTime.Hour()
    CoopTimeEligible = False
    state = "原版分派未允许，尚未提交"
    // Literal root.800 branch semantics; no invented weekday-number conversion.
    If week <= 5 And week <> 1 Then
        CoopTimeEligible = True
        state = "原版分派允许"
    End If
    key = week & ":" & hour
    If key <> coopTimeKey Then
        Call Note("[合作大冒险152] 时间资格 WeekDay=" & week & " Hour=" & hour & " 结果=" & state)
        coopTimeKey = key
    End If
End Function
Sub StartCoopTask()
    coopTerminal = False
    coopDone = False
    coopFailed = False
    coopLastMatch = ""
    coopLastOcr = ""
    Call Note("[合作大冒险152] 任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & coopRestarts & " 恢复次数=" & coopRecoveries)
End Sub
Sub RecoverCoopTask()
    coopTerminal = False
    coopFailed = True
    coopFailures = coopFailures + 1
    coopRecoveries = coopRecoveries + 1
    Call Note("[合作大冒险152] 保存恢复任务=152 是否提交完成=否 阶段=" & coopPhase & " 失败次数=" & coopFailures & " 恢复次数=" & coopRecoveries)
End Sub
Sub CommitCoopTask()
    coopDone = True
    coopFailed = False
    coopCount = coopCount + 1
    coopDue = TickCount() + 43200000
    coopFirst = False
    coopPhase = "本轮完成，等待12小时"
    Call Note("[合作大冒险152] 是否提交完成=是 本轮次数=" & coopCount & " 下一次执行时间Unix=" & (Time() + 43200) & " 重启次数=" & coopRestarts & " 恢复次数=" & coopRecoveries)
End Sub


