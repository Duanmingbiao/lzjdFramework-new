// common/大厅清障.mq
// root.784: public return/clearance actions only. No business state submission.
Sub ResetHallClearing()
    hallMisses = 0
    hallExtended = False
    hallActionIndex = 0
End Sub
Function HallActionWait()
    HallActionWait = 1000
    If hallReturnDelaySeconds > 0 Then
        HallActionWait = hallReturnDelaySeconds * 1000
    End If
End Function
Function FindHallObstacle(includeExtended)
    FindHallObstacle = False
    hallActionIndex = 0
    If MatchPattern("大厅清障01") Then
        hallActionIndex = 1
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障02") Then
        hallActionIndex = 2
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障03") Then
        hallActionIndex = 3
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障04") Then
        hallActionIndex = 4
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障05") Then
        hallActionIndex = 5
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障06") Then
        hallActionIndex = 6
        FindHallObstacle = True
        Exit Function
    End If
    If includeExtended Then
        If MatchPattern("大厅清障07") Then
            hallActionIndex = 7
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障08") Then
            hallActionIndex = 8
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障09") Then
            hallActionIndex = 9
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障10") Then
            hallActionIndex = 10
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障11") Then
            hallActionIndex = 11
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障12") Then
            hallActionIndex = 12
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障13") Then
            hallActionIndex = 13
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障14") Then
            hallActionIndex = 14
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障15") Then
            hallActionIndex = 15
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障16") Then
            hallActionIndex = 16
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障17") Then
            hallActionIndex = 17
            FindHallObstacle = True
            Exit Function
        End If
    End If
End Function
Function ClearHallObstacle()
    Dim selected, selectedIndex, selectedX, selectedY, waitMs
    ClearHallObstacle = False
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    // The prototype keeps expanded candidate descriptors after the counter resets.
    If hallMisses > 3 Then
        hallMisses = 0
        hallExtended = True
    End If
    selected = FindHallObstacle(hallExtended)
    selectedIndex = hallActionIndex
    selectedX = foundX
    selectedY = foundY
    waitMs = HallActionWait()
    // Special lookup comes after selection but its action takes precedence.
    If MatchPattern("大厅清障特殊分支") Then
        Call Note("大厅清障：特殊分支，点击=" & (foundX - 311) & "," & (foundY + 10) & "，等待毫秒=" & waitMs)
        Call TouchPoint(foundX - 311, foundY + 10, waitMs)
        hallMisses = 0
        Call ResetHallCheck()
        ClearHallObstacle = True
    ElseIf selected Then
        Call Note("大厅清障：候选=" & selectedIndex & "，点击=" & selectedX & "," & selectedY & "，等待毫秒=" & waitMs)
        Call TouchPoint(selectedX, selectedY, waitMs)
        hallMisses = 0
        Call ResetHallCheck()
        ClearHallObstacle = True
    Else
        hallMisses = hallMisses + 1
    End If
    // Caller supplies the original 100ms tail once per clearance round.
End Function


// common/页面识别.mq
Function GreenArrow()
    GreenArrow = True
    If MatchPattern("绿色返回一") Then
        Exit Function
    End If
    GreenArrow = MatchPattern("绿色返回二")
End Function
Function HallCandidate()
    Dim candidateFound
    candidateFound = False
    HallCandidate = False
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    If MatchPattern("大厅主体") Then
        candidateFound = True
    ElseIf MatchPattern("大厅底部") Then
        candidateFound = True
    End If
    If Not candidateFound Then
        Exit Function
    End If
    HallCandidate = True
    If FindHallObstacle(True) Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("大厅清障特殊分支") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("获得奖励") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("邮件关闭弹窗") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭一") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭二") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭三") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("我知道了") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("回归公告") Then
        HallCandidate = False
    End If
End Function
Sub ResetHallCheck()
    hallFrames = 0
    hallSampleAt = TickCount() - 500
End Sub
Function ConfirmHall()
    ConfirmHall = False
    If TickCount() - hallSampleAt < 500 Then
        Exit Function
    End If
    hallSampleAt = TickCount()
    If HallCandidate() Then
        hallFrames = hallFrames + 1
    Else
        hallFrames = 0
    End If
    ConfirmHall = hallFrames >= 2
End Function


// common/游戏控制.mq
Sub StartGame()
    Call Note("[流程] 入口 StartGame")
    If Sys.AppIsFront(QQ_PACKAGE) Or Sys.GetFront() = "com.tencent.mobileqq:openSdk" Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            Call Note("[流程] 出口 StartGame 分支1 路径条件 Sys.IsRunning(GAME_PACKAGE)")
            Exit Sub
        End If
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call BeginForegroundRecovery()
        RunApp GAME_PACKAGE
        Call EndForegroundRecovery()
    End If
    Call Note("[流程] 出口 StartGame 到达函数末尾（不代表任务已提交）")
End Sub
Sub RestartGame()
    Call Note("[流程] 入口 RestartGame")
    Call BeginForegroundRecovery()
    foregroundLoginPending = True
    Call Note("重启游戏；保持同一会话及待恢复业务=" & resumeTask)
    KillApp GAME_PACKAGE
    // New-engine process shutdown settling delay, not a recovered task delay.
    Delay 1000
    loginStarted = TickCount()
    RunApp GAME_PACKAGE
    Call EndForegroundRecovery()
    Call Note("[流程] 出口 RestartGame 到达函数末尾（不代表任务已提交）")
End Sub


// common/返回大厅.mq
Function ReturnToHall()
    Dim returnStarted, acted
    Call Note("[流程] 入口 ReturnToHall")
    ReturnToHall = RESULT_TIMEOUT
    returnStarted = TickCount()
    Call SetStage("大厅清障与绿色箭头返回")
    Call ResetHallCheck()
    Call ResetHallClearing()
    Do
        If ForegroundInterrupted() Or TickCount() - returnStarted >= businessLimit Then
            Call Note("[流程] 出口 ReturnToHall 分支1 路径条件 ForegroundInterrupted() Or TickCount() - returnStarted >= businessLimit")
            Exit Function
        End If
        If ConfirmHall() Then
            ReturnToHall = RESULT_OK
            Call Note("[流程] 结果 ReturnToHall RESULT_OK")
            Call Note("[流程] 出口 ReturnToHall 分支2 路径条件 ConfirmHall()")
            Exit Function
        End If
        acted = ClearHallObstacle()
        Delay 100
    Loop
    Call Note("[流程] 出口 ReturnToHall 到达函数末尾（不代表任务已提交）")
End Function


// common/任务注册.mq
Sub RegisterTasks()
    registeredTask = 168
    rewardRegisteredTask = 169
    signRegisteredTask = 167
    Call Note("注册邮件168、任务奖励169和日常签到167；使用唯一串行调度器")
End Sub
Function SelectDueTask()
    Dim selected, selectedDue
    SelectDueTask = 0
    If resumeTask = registeredTask Or resumeTask = rewardRegisteredTask Or resumeTask = signRegisteredTask Then
        If resumeTask <> 0 Then
            SelectDueTask = resumeTask
            Exit Function
        End If
    End If
    If mailEnabled And mailFirst Then
        SelectDueTask = registeredTask
        Exit Function
    End If
    If rewardEnabled And rewardFirst Then
        SelectDueTask = rewardRegisteredTask
        Exit Function
    End If
    If signEnabled And signFirst Then
        SelectDueTask = signRegisteredTask
        Exit Function
    End If
    selected = 0
    selectedDue = 0
    If mailEnabled Then
        If TickCount() >= mailDue Then
            selected = registeredTask
            selectedDue = mailDue
        End If
    End If
    If rewardEnabled Then
        If TickCount() >= rewardDue Then
            If selected = 0 Or rewardDue < selectedDue Then
                selected = rewardRegisteredTask
                selectedDue = rewardDue
            End If
        End If
    End If
    If signEnabled Then
        If TickCount() >= signDue Then
            If selected = 0 Or signDue < selectedDue Then
                selected = signRegisteredTask
            End If
        End If
    End If
    SelectDueTask = selected
End Function


// common/任务分派.mq
Function DispatchTask(taskId)
    Call Note("[流程] 入口 DispatchTask")
    DispatchTask = RESULT_FAIL
    If taskId = 167 Then
        terminalConfirmed = False
        DispatchTask = ExecuteDailySign()
    ElseIf taskId = 168 Then
        terminalConfirmed = False
        DispatchTask = ExecuteMail()
    ElseIf taskId = 169 Then
        terminalConfirmed = False
        DispatchTask = ExecuteTaskRewards()
    End If
    Call Note("[流程] 出口 DispatchTask 到达函数末尾（不代表任务已提交）")
End Function


// common/任务调度.mq
Sub SchedulerStep()
    Dim selected, result, hallResult, committed
    committed = HandleForegroundRecovery()
    selected = SelectDueTask()
    If selected = 0 Then
        If foregroundLoginPending Then
            result = EnsureGameHall()
            Call Note("[流程] EnsureGameHall() 返回=" & result)
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If result = RESULT_OK Then
                foregroundLoginPending = False
            Else
                Call RestartGame()
            End If
        End If
        Exit Sub
    End If
    Call SaveCurrentTask(selected)
    Call Note("[流程] 调度入口 任务=" & selected)
    result = EnsureGameHall()
    Call Note("[流程] EnsureGameHall() 返回=" & result)
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result <> RESULT_OK Then
        loginFailures = loginFailures + 1
        Call Note("登录总超时，次数=" & loginFailures)
        Call RestartGame()
        Exit Sub
    End If
    foregroundLoginPending = False
    businessStarted = TickCount()
    result = DispatchTask(selected)
    Call Note("[流程] DispatchTask(selected) 返回=" & result)
    Do While result = RESULT_WAIT
        If BusinessExpired() Then
            result = RESULT_TIMEOUT
        Else
            Delay 20
            result = DispatchTask(selected)
            Call Note("[流程] DispatchTask(selected) 返回=" & result)
        End If
    Loop
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result = RESULT_OK And terminalConfirmed Then
        hallResult = ReturnToHall()
        Call Note("[流程] ReturnToHall() 返回=" & hallResult)
        If HandleForegroundRecovery() Then
            Exit Sub
        End If
        If hallResult = RESULT_OK Then
            committed = CommitTask(True)
            Call Note("[流程] CommitTask(True) 返回=" & committed)
            If committed Then
                Exit Sub
            End If
        End If
    End If
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    Call SaveRecovery()
    Call Note("[流程] 调度出口 业务未提交成功，进入恢复")
    Call RestartGame()
End Sub


// flows/001_游戏重连/QQ登录.mq
Function ClickQQAuthorization(patternName, label, offsetX, offsetY)
    ClickQQAuthorization = False
    If LoginExpired() Then
        Exit Function
    End If
    If MatchPattern(patternName) Then
        Call Note("QQ授权R3：" & label & "，模板=" & patternName & "，点击=" & (foundX + offsetX) & "," & (foundY + offsetY))
        Call TouchPoint(foundX + offsetX, foundY + offsetY, 1000)
        ClickQQAuthorization = True
    End If
End Function
Function HandleQQ()
    Dim anchorX, anchorY, authorizationHandled, diagnosticRound
    HandleQQ = False
    authorizationHandled = False
    diagnosticRound = False
    If TickCount() - qqLastDiagnosticAt >= 5000 Then
        qqLastDiagnosticAt = TickCount()
        diagnosticRound = True
        Call Note("QQ授权R3：原版图色巡检，登录已用毫秒=" & (TickCount() - loginStarted))
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // root.793 L3694-3752: one-click check precedes the three authorization groups.
    If MatchPattern("QQ一键登录") Then
        anchorX = foundX
        anchorY = foundY
        Call Note("QQ授权R3：一键登录")
        Call TouchPoint(anchorX - 151, anchorY + 86, 1000)
        If Not LoginExpired() Then
            Call TouchPoint(anchorX + 63, anchorY, 1000)
        End If
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // Keep the original candidates first. Add screenshot-derived fallback only.
    If ClickQQAuthorization("QQ授权登录一", "授权登录", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ授权登录二", "授权登录", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版头像昵称同意", "头像昵称同意", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // root.793 L4012/L4026: confirmation has two original candidates.
    If ClickQQAuthorization("QQ授权确认", "VIP会员确认", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ授权登录二", "VIP会员确认候选二", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版VIP会员确认", "VIP会员确认", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    If ClickQQAuthorization("QQ授权同意", "游戏信息同意", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版游戏信息同意", "游戏信息同意", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If Not authorizationHandled And diagnosticRound Then
        Call Note("QQ授权R3：未命中授权页面，继续登录总计时")
    End If
    // root.793 L4113-4117: authorization-section tail, not a new timeout.
    Delay 50
End Function


// flows/001_游戏重连/登录游戏.mq
Function EnsureGameHall()
    Dim agreementTouched, acted, clearanceChecked
    Call Note("[流程] 入口 EnsureGameHall")
    EnsureGameHall = RESULT_TIMEOUT
    agreementTouched = False
    If Not foregroundLoginPending Then
        loginStarted = TickCount()
    End If
    Call SetStage("启动及QQ登录")
    Call ResetHallCheck()
    Call ResetHallClearing()
    Call StartGame()
    Do
        If LoginExpired() Then
            Call Note("[流程] 出口 EnsureGameHall 分支1 路径条件 LoginExpired()")
            Exit Function
        End If
        If ConfirmHall() Then
            EnsureGameHall = RESULT_OK
            Call Note("[流程] 结果 EnsureGameHall RESULT_OK")
            Call Note("[流程] 出口 EnsureGameHall 分支2 路径条件 ConfirmHall()")
            Exit Function
        End If
        clearanceChecked = False
        acted = HandleQQ()
        If Sys.AppIsFront(GAME_PACKAGE) And Not acted Then
            // root.793: known notice handlers; no task-specific claim here.
            // Screenshot-specific game agreement; keep the shared login deadline.
            If MatchPattern("首次启动协议") Then
                Call Note("首次启动协议：点击同意，登录总计时继续")
                Call TouchPoint(foundX + 120, foundY + 1, 1000)
                acted = True
            ElseIf MatchPattern("游戏协议弹窗") Then
                Call Note("游戏协议弹窗：点击同意，登录总计时继续")
                Call TouchPoint(foundX + 58, foundY + 16, 1000)
                acted = True
            End If
            If Not acted Then
                acted = TouchPattern("我知道了", 1000)
            End If
            If Not acted Then
                acted = TouchPattern("回归公告", 1000)
            End If
            If Not acted Then
                acted = TouchPattern("开始游戏", 1500)
            End If
            // The original pattern named QQ登录页 is a login-options anchor.
            // root.793 L831-849 uses this template with automatic anchor click.
            If Not acted Then
                If MatchPattern("QQ登录页") Then
                    If MatchPattern("协议已选") Then
                        If MatchPattern("QQ登录页") Then
                            Call TouchPoint(foundX, foundY, 1500)
                            acted = True
                        End If
                    ElseIf Not agreementTouched Then
                        Call TouchPoint(45, 1150, 1500)
                        agreementTouched = True
                        acted = True
                    End If
                End If
            End If
            If Not acted Then
                clearanceChecked = True
                acted = ClearHallObstacle()
            End If
        End If
        // QQ or unknown foreground keeps the same login deadline.
        If clearanceChecked Then
            Delay 100
        Else
            Delay 20
        End If
    Loop
    Call Note("[流程] 出口 EnsureGameHall 到达函数末尾（不代表任务已提交）")
End Function


// flows/168_领邮件奖励/领邮件奖励.mq
Function MailEmpty()
    MailEmpty = True
    If MatchPattern("邮件空一") Then
        Exit Function
    End If
    MailEmpty = MatchPattern("邮件空二")
End Function
Function MailClaimable()
    MailClaimable = True
    If MatchPattern("邮件可领一") Then
        Exit Function
    End If
    MailClaimable = MatchPattern("邮件可领二")
End Function
Sub MailStage(value)
    mailPhase = value
    Call SetStage(value)
End Sub
Function ReadMessages()
    Dim localStarted, elapsed
    Call Note("[流程] 入口 ReadMessages")
    ReadMessages = RESULT_TIMEOUT
    localStarted = TickCount()
    Call MailStage("消息邮件自动阅读")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ReadMessages 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MatchPattern("邮件关闭弹窗") Then
            Call Note("[流程] 邮件图色命中 邮件关闭弹窗")
            Call TouchPoint(foundX, foundY, 200)
            localStarted = TickCount()
        End If
        If MatchPattern("邮件消息打开") Then
            Call Note("[流程] 邮件图色命中 邮件消息打开")
            Call TouchPoint(foundX, foundY, 200)
        End If
        elapsed = TickCount() - localStarted
        If elapsed > 2000 And elapsed <= 5000 Then
            If MatchPattern("邮件消息终态") Then
                Call Note("[流程] 邮件图色命中 邮件消息终态")
                ReadMessages = RESULT_OK
                Call Note("[流程] 结果 ReadMessages RESULT_OK")
                Call Note("[流程] 出口 ReadMessages 分支2 路径条件 MatchPattern('邮件消息终态')")
                Exit Function
            End If
        End If
        If elapsed > 5000 Then
            Call Note("[流程] 出口 ReadMessages 分支3 路径条件 elapsed > 5000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 ReadMessages 到达函数末尾（不代表任务已提交）")
End Function
Function ExecuteMail()
    Dim claimStarted, messageResult
    Call Note("[流程] 入口 ExecuteMail")
    ExecuteMail = RESULT_TIMEOUT
    Call MailStage("进入邮件")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ExecuteMail 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MatchPattern("邮件专业入口") Then
            Call Note("[流程] 邮件图色命中 邮件专业入口")
            Call TouchPoint(25, 830, 200)
        End If
        If MatchPattern("低客户端提示") Then
            Call Note("[流程] 邮件图色命中 低客户端提示")
            Call TouchPoint(foundX, foundY, 1500)
        End If
        If MailEmpty() Then
            Call Note("[流程] 邮件识别 无奖励状态命中")
            terminalConfirmed = True
            Call MailStage("入口确认无奖励")
            ExecuteMail = RESULT_OK
            Call Note("[流程] 结果 ExecuteMail RESULT_OK")
            Call Note("[流程] 出口 ExecuteMail 分支2 路径条件 MailEmpty()")
            Exit Function
        End If
        If MailClaimable() Then
            Delay 200
            Exit Do
        End If
        Delay 20
    Loop
    Call Progress()
    claimStarted = TickCount()
    Call MailStage("领取邮件奖励")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ExecuteMail 分支3 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MailClaimable() Then
            Call TouchPoint(foundX + 319, foundY - 90, 200)
            Call Progress()
        End If
        If MatchPattern("获得奖励") Then
            Call Note("[流程] 邮件图色命中 获得奖励")
            Call TouchPoint(foundX, foundY, 200)
            Call Progress()
        End If
        If MatchPattern("邮件关闭弹窗") Then
            Call Note("[流程] 邮件图色命中 邮件关闭弹窗")
            Call TouchPoint(foundX, foundY, 200)
            Call Progress()
        End If
        If MailEmpty() Then
            Call Note("[流程] 邮件识别 无奖励状态命中")
            Call Progress()
            Exit Do
        End If
        If TickCount() - claimStarted > 5000 Then
            Call Note("[流程] 出口 ExecuteMail 分支4 路径条件 TickCount() - claimStarted > 5000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 消息邮件模式 0手动跳过 1自动 当前=" & messageMode)
    If messageMode = 1 Then
        Call Note("[流程] 消息邮件 自动模式入口")
        messageResult = ReadMessages()
        If messageResult <> RESULT_OK Then
            Call Note("[流程] 出口 ExecuteMail 分支5 路径条件 messageResult <> RESULT_OK")
            Exit Function
        End If
    End If
    terminalConfirmed = True
    Call MailStage("邮件业务终态确认")
    ExecuteMail = RESULT_OK
    Call Note("[流程] 结果 ExecuteMail RESULT_OK")
    Call Note("[流程] 出口 ExecuteMail 到达函数末尾（不代表任务已提交）")
End Function


// flows/169_领任务奖励/领任务奖励.mq
// Independent MQ implementation of professional root.729 behavior.
Sub RewardStage(value)
    rewardPhase = value
    Call SetStage(value)
End Sub
Function RewardTouch(name, dx, dy, waitMs)
    RewardTouch = False
    If MatchPattern(name) Then
        Call Note("任务169：" & name & "，点击=" & (foundX + dx) & "," & (foundY + dy))
        Call TouchPoint(foundX + dx, foundY + dy, waitMs)
        RewardTouch = True
    End If
End Function
Function RewardGrowthClaimable()
    RewardGrowthClaimable = True
    If MatchPattern("169_成长有奖一") Then
        Exit Function
    End If
    RewardGrowthClaimable = MatchPattern("169_成长有奖二")
End Function
Function RewardGrowthEmpty()
    RewardGrowthEmpty = True
    If MatchPattern("169_成长无奖一") Then
        Exit Function
    End If
    RewardGrowthEmpty = MatchPattern("169_成长无奖二")
End Function
Function RewardDailyClaimable()
    RewardDailyClaimable = True
    If MatchPattern("169_日常有奖一") Then
        Exit Function
    End If
    RewardDailyClaimable = MatchPattern("169_日常有奖二")
End Function
Function RewardDailyEmpty()
    RewardDailyEmpty = True
    If MatchPattern("169_日常无奖一") Then
        Exit Function
    End If
    RewardDailyEmpty = MatchPattern("169_日常无奖二")
End Function
Function RewardPageKnown()
    RewardPageKnown = True
    If RewardGrowthClaimable() Then
        Exit Function
    End If
    If RewardGrowthEmpty() Then
        Exit Function
    End If
    If RewardDailyClaimable() Then
        Exit Function
    End If
    If RewardDailyEmpty() Then
        Exit Function
    End If
    If MatchPattern("169_通行证") Then
        Exit Function
    End If
    If MatchPattern("169_特殊有奖") Then
        Exit Function
    End If
    RewardPageKnown = MatchPattern("169_特殊无奖")
End Function
Function EnterTaskRewards()
    Dim acted
    Call Note("[流程] 入口 EnterTaskRewards")
    EnterTaskRewards = RESULT_TIMEOUT
    Call RewardStage("169进入任务页面")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 EnterTaskRewards 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        acted = RewardTouch("169_入口", 327, 0, 200)
        If RewardPageKnown() Then
            EnterTaskRewards = RESULT_OK
            Call Note("[流程] 结果 EnterTaskRewards RESULT_OK")
            Call Note("[流程] 出口 EnterTaskRewards 分支2 路径条件 RewardPageKnown()")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 EnterTaskRewards 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFirstPass()
    Dim phaseProgress
    Call Note("[流程] 入口 RewardFirstPass")
    RewardFirstPass = RESULT_TIMEOUT
    Call RewardStage("169第一段：成长、日常、特殊")
    phaseProgress = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFirstPass 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        // Independent checks in professional order; no universal popup priority.
        If RewardGrowthClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
            phaseProgress = TickCount()
        End If
        If RewardGrowthEmpty() Then
            Call TouchPoint(foundX - 90, foundY - 977, 50)
            phaseProgress = TickCount()
        End If
        If RewardDailyClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
        End If
        If RewardDailyEmpty() Then
            Delay 50
            RewardFirstPass = RESULT_OK
            Call Note("[流程] 结果 RewardFirstPass RESULT_OK")
            Call Note("[流程] 出口 RewardFirstPass 分支2 路径条件 RewardDailyEmpty()")
            Exit Function
        End If
        If RewardTouch("169_通行证", 179, -1045, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_特殊有奖", 0, 0, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_特殊无奖", -90, -977, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 50) Then
            phaseProgress = TickCount()
        End If
        If TickCount() - phaseProgress > 10000 Then
            Call Note("任务169第一段无进展超时，交公共恢复")
            Call Note("[流程] 出口 RewardFirstPass 分支3 路径条件 TickCount() - phaseProgress > 10000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFirstPass 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFourPositions()
    Dim phaseProgress, positionIndex, dx
    Call Note("[流程] 入口 RewardFourPositions")
    RewardFourPositions = RESULT_TIMEOUT
    Call RewardStage("169第二段：四位置奖励")
    phaseProgress = TickCount()
    positionIndex = 0
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFourPositions 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 200) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗二", 0, 0, 1000) Then
            phaseProgress = TickCount()
        End If
        If RewardDailyEmpty() Then
            dx = -159
            If positionIndex = 1 Then
                dx = -27
            ElseIf positionIndex = 2 Then
                dx = 106
            ElseIf positionIndex = 3 Then
                dx = 234
            End If
            Call Note("任务169四位置，序号=" & (positionIndex + 1))
            Call TouchPoint(foundX + dx, foundY - 875, 1000)
            positionIndex = positionIndex + 1
        End If
        // Original exit precedes the phase timeout check. Four clicks only.
        If positionIndex > 3 Then
            RewardFourPositions = RESULT_OK
            Call Note("[流程] 结果 RewardFourPositions RESULT_OK")
            Call Note("[流程] 出口 RewardFourPositions 分支2 路径条件 positionIndex > 3")
            Exit Function
        End If
        If TickCount() - phaseProgress > 10000 Then
            Call Note("任务169第二段无进展超时，交公共恢复")
            Call Note("[流程] 出口 RewardFourPositions 分支3 路径条件 TickCount() - phaseProgress > 10000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFourPositions 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFinalPass()
    Dim phaseProgress, acted
    Call Note("[流程] 入口 RewardFinalPass")
    RewardFinalPass = RESULT_TIMEOUT
    Call RewardStage("169第三段：确认成长或特殊终态")
    phaseProgress = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFinalPass 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If RewardTouch("169_奖励弹窗二", 0, 0, 1000) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 200) Then
            phaseProgress = TickCount()
        End If
        If RewardDailyEmpty() Then
            Call TouchPoint(foundX + 87, foundY - 977, 50)
        End If
        If RewardGrowthClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
            phaseProgress = TickCount()
        End If
        If RewardGrowthEmpty() Then
            If Not BusinessExpired() Then
                terminalConfirmed = True
                RewardFinalPass = RESULT_OK
                Call Note("[流程] 结果 RewardFinalPass RESULT_OK")
                Call RewardStage("169成长无奖终态已确认")
            End If
            Call Note("[流程] 出口 RewardFinalPass 分支2 路径条件 Not BusinessExpired()")
            Exit Function
        End If
        acted = RewardTouch("169_特殊有奖", 0, 0, 50)
        If MatchPattern("169_特殊无奖") Then
            If Not BusinessExpired() Then
                terminalConfirmed = True
                RewardFinalPass = RESULT_OK
                Call Note("[流程] 结果 RewardFinalPass RESULT_OK")
                Call RewardStage("169特殊无奖终态已确认")
            End If
            Call Note("[流程] 出口 RewardFinalPass 分支3 路径条件 Not BusinessExpired()")
            Exit Function
        End If
        If TickCount() - phaseProgress > 4000 Then
            Call Note("任务169末段无进展超时，未确认终态，交公共恢复")
            Call Note("[流程] 出口 RewardFinalPass 分支4 路径条件 TickCount() - phaseProgress > 4000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFinalPass 到达函数末尾（不代表任务已提交）")
End Function
Function ExecuteTaskRewards()
    Dim result
    Call Note("[流程] 入口 ExecuteTaskRewards")
    ExecuteTaskRewards = RESULT_TIMEOUT
    terminalConfirmed = False
    result = EnterTaskRewards()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支1 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    result = RewardFirstPass()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支2 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    result = RewardFourPositions()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支3 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    ExecuteTaskRewards = RewardFinalPass()
    Call Note("[流程] 出口 ExecuteTaskRewards 到达函数末尾（不代表任务已提交）")
End Function


// flows/167_日常签到/日常签到.mq
Sub SignStage(value)
    signPhase = value
    Call SetStage(value)
End Sub
Sub SignTouch(name, x, y, waitMs)
    Call Note("[签到167] 命中=" & name & " 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function EnterDailySign()
    EnterDailySign = RESULT_TIMEOUT
    Call SignStage("167进入签到中心")
    Call Note("[签到167] 入口 EnterDailySign")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 EnterDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_入口") Then
            Call SignTouch("167_入口", foundX, foundY, 100)
        End If
        If MatchPattern("167_中心页面") Then
            Call SignTouch("167_中心页面", 150, 50, 200)
            If BusinessExpired() Then
                Call Note("[签到167] 出口 EnterDailySign：点击后超时或中断")
                Exit Function
            End If
            EnterDailySign = RESULT_OK
            Call Note("[签到167] 出口 EnterDailySign：中心已识别，进入领取")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ClaimDailySign()
    Dim claimStarted, cumulativeLogged
    ClaimDailySign = RESULT_TIMEOUT
    claimStarted = TickCount()
    cumulativeLogged = False
    Call SignStage("167领取签到奖励")
    Call Note("[签到167] 入口 ClaimDailySign；累计检查门槛大于5000毫秒")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 ClaimDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_领取一") Then
            Call SignTouch("167_领取一", foundX + 5, foundY, 500)
        End If
        If MatchPattern("167_领取二") Then
            Call SignTouch("167_领取二", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_领取三") Then
            Call SignTouch("167_领取三", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_领取四") Then
            Call SignTouch("167_领取四", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_奖励弹窗") Then
            Call SignTouch("167_奖励弹窗", 5, 5, 0)
        End If
        If MatchPattern("167_充值提示") Then
            Call SignTouch("167_充值提示", foundX, foundY, 0)
        End If
        If TickCount() - claimStarted > 5000 Then
            If Not cumulativeLogged Then
                Call Note("[签到167] 累计检查启用；领取起点未刷新")
                cumulativeLogged = True
            End If
            If MatchPattern("167_累计可领") Then
                Call SignTouch("167_累计可领", foundX, foundY, 0)
            End If
            If MatchPattern("167_累计灰色") Then
                If BusinessExpired() Then
                    Call Note("[签到167] 出口 ClaimDailySign：灰色命中时已超时或中断")
                    Exit Function
                End If
                ClaimDailySign = RESULT_OK
                Call Note("[签到167] 出口 ClaimDailySign：累计灰色已确认，等待收尾终态")
                Exit Function
            End If
        End If
        Delay 20
    Loop
End Function
Function FinishDailySign()
    FinishDailySign = RESULT_TIMEOUT
    Call SignStage("167签到收尾确认")
    Call Progress()
    Call Note("[签到167] 入口 FinishDailySign")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 FinishDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_奖励弹窗") Then
            Call SignTouch("167_奖励弹窗收尾", foundX, foundY, 0)
            If BusinessExpired() Then
                Call Note("[签到167] 出口 FinishDailySign：收尾点击后超时或中断")
                Exit Function
            End If
            FinishDailySign = RESULT_OK
            Call Note("[签到167] 出口 FinishDailySign：奖励弹窗终态已处理")
            Exit Function
        End If
        If MatchPattern("167_中心页面") Then
            If BusinessExpired() Then
                Call Note("[签到167] 出口 FinishDailySign：中心命中时超时或中断")
                Exit Function
            End If
            FinishDailySign = RESULT_OK
            Call Note("[签到167] 出口 FinishDailySign：中心页面终态已确认")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteDailySign()
    Dim result
    ExecuteDailySign = RESULT_TIMEOUT
    terminalConfirmed = False
    Call Note("[签到167] 业务入口 ExecuteDailySign")
    result = EnterDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：进入失败，返回超时")
        Exit Function
    End If
    result = ClaimDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：领取未完成，返回超时")
        Exit Function
    End If
    result = FinishDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：收尾未完成，返回超时")
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[签到167] 业务出口：终态提交前超时或中断")
        Exit Function
    End If
    terminalConfirmed = True
    ExecuteDailySign = RESULT_OK
    Call SignStage("167签到业务终态确认")
    Call Note("[签到167] 业务出口：成功；等待公共返回大厅后提交")
End Function
