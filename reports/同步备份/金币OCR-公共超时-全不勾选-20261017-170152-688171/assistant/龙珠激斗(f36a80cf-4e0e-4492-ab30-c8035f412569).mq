// common/红绸军状态.mq
Function IsRedArmy(taskId)
    IsRedArmy = taskId = 84 Or taskId = 85
End Function
Function RedArmyName(taskId)
    RedArmyName = "消灭红绸军_中午84"
    If taskId = 85 Then
        RedArmyName = "消灭红绸军_下午85"
    End If
End Function
Sub LoadRedArmySettings()
    redEnabled = WorldBoolean("红绸军启用")
    redMap = WorldNumber("红绸军地图", 0, 2)
    red84Hour = WorldNumber("红绸军中午时", 12, 23)
    red84Minute = WorldNumber("红绸军中午分", 30, 59)
    red85Hour = WorldNumber("红绸军下午时", 20, 23)
    red85Minute = WorldNumber("红绸军下午分", 0, 59)
    Call WriteMainLog("[消灭红绸军84/85配置] 地图=" & redMap & " 中午=" & red84Hour & ":" & red84Minute & " 下午=" & red85Hour & ":" & red85Minute)
End Sub
Function RedArmyTime(taskId)
    Dim seconds
    If taskId = 84 Then
        seconds = red84Hour * 3600 + red84Minute * 60
        If seconds < 41400 Or seconds > 48600 Then
            seconds = 46800 + (10 + Int(Rnd() * 41)) * 60
            Call Note("[消灭红绸军84] 配置超出11:30至13:30，按专业版随机13:10至13:50")
        End If
    Else
        seconds = red85Hour * 3600 + red85Minute * 60
        If seconds < 66600 Or seconds > 73800 Then
            seconds = 68400 + (10 + Int(Rnd() * 41)) * 60
            Call Note("[消灭红绸军85] 配置超出18:30至20:30，按专业版随机19:10至19:50")
        End If
    End If
    RedArmyTime = seconds
End Function
Sub SetRedArmyPhase(value)
    If currentTask = 84 Then
        red84Phase = value
    Else
        red85Phase = value
    End If
End Sub
Sub NewRedArmySession()
    redReason = ""
    redMode = -1
    redActionAt = 0
    redFirstDone = False
    redRefreshLeft = 6
    red84Due = WorldDayStart(Time()) + RedArmyTime(84)
    red84Done = False
    red84Failed = False
    red84Count = 0
    red84Failures = 0
    red84Restarts = 0
    red84Recoveries = 0
    red84Phase = "未开始"
    red84Terminal = False
    red84Reason = ""
    red84FinishedAt = 0
    red85Due = WorldDayStart(Time()) + RedArmyTime(85)
    red85Done = False
    red85Failed = False
    red85Count = 0
    red85Failures = 0
    red85Restarts = 0
    red85Recoveries = 0
    red85Phase = "未开始"
    red85Terminal = False
    red85Reason = ""
    red85FinishedAt = 0
End Sub
Function SelectRedArmy()
    Dim nowStamp, dayStart
    SelectRedArmy = 0
    If Not redEnabled Then
        Exit Function
    End If
    nowStamp = Time()
    dayStart = WorldDayStart(nowStamp)
    If red84Due < dayStart Then
        red84Due = dayStart + RedArmyTime(84)
    End If
    If nowStamp >= red84Due Then
        If nowStamp > dayStart + 50400 Then
            red84Due = dayStart + 86400 + RedArmyTime(84)
            Call Note("[" & RedArmyName(84) & "] 时段已过，是否提交完成=否 下一次执行时间Unix=" & red84Due)
        Else
            SelectRedArmy = 84
            Exit Function
        End If
    End If
    If red85Due < dayStart Then
        red85Due = dayStart + RedArmyTime(85)
    End If
    If nowStamp >= red85Due Then
        If nowStamp > dayStart + 75600 Then
            red85Due = dayStart + 86400 + RedArmyTime(85)
            Call Note("[" & RedArmyName(85) & "] 时段已过，是否提交完成=否 下一次执行时间Unix=" & red85Due)
        Else
            SelectRedArmy = 85
            Exit Function
        End If
    End If
End Function
Sub StartRedArmyTask(taskId)
    redReason = ""
    redMode = -1
    worldLastMatch = ""
    worldLastOcr = ""
    If taskId = 84 Then
        red84Terminal = False
        red84Reason = ""
        red84FinishedAt = 0
        red84Done = False
        red84Failed = False
        Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 地图=" & redMap & " 重启次数=" & red84Restarts & " 恢复次数=" & red84Recoveries)
    ElseIf taskId = 85 Then
        red85Terminal = False
        red85Reason = ""
        red85FinishedAt = 0
        red85Done = False
        red85Failed = False
        Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 地图=" & redMap & " 重启次数=" & red85Restarts & " 恢复次数=" & red85Recoveries)
    End If
End Sub
Sub RecoverRedArmyTask(taskId)
    If taskId = 84 Then
        red84Terminal = False
        red84Failed = True
        red84Failures = red84Failures + 1
        red84Recoveries = red84Recoveries + 1
        Call WorldLog("保存恢复原任务=84 阶段=" & red84Phase & " 失败次数=" & red84Failures & " 恢复次数=" & red84Recoveries & " 是否提交完成=否")
    ElseIf taskId = 85 Then
        red85Terminal = False
        red85Failed = True
        red85Failures = red85Failures + 1
        red85Recoveries = red85Recoveries + 1
        Call WorldLog("保存恢复原任务=85 阶段=" & red85Phase & " 失败次数=" & red85Failures & " 恢复次数=" & red85Recoveries & " 是否提交完成=否")
    End If
End Sub
Sub RestartRedArmyTask(taskId)
    If taskId = 84 Then
        red84Restarts = red84Restarts + 1
        Call WorldLog("重启原任务=84 重启次数=" & red84Restarts & " 恢复次数=" & red84Recoveries)
    ElseIf taskId = 85 Then
        red85Restarts = red85Restarts + 1
        Call WorldLog("重启原任务=85 重启次数=" & red85Restarts & " 恢复次数=" & red85Recoveries)
    End If
End Sub
Sub CommitRedArmyTask(taskId)
    Dim finishedAt
    If taskId = 84 Then
        finishedAt = Time()
        If red84FinishedAt > 0 Then
            finishedAt = red84FinishedAt
        End If
        red84Done = True
        red84Failed = False
        red84Count = red84Count + 1
        red84Due = WorldDayStart(finishedAt) + 86400 + RedArmyTime(84)
        red84Phase = "本时段已完成，等待次日"
        Call WorldLog("是否提交完成=是 次数=" & red84Count & " 终态=" & red84Reason & " 下一次执行时间Unix=" & red84Due & " 重启次数=" & red84Restarts & " 恢复次数=" & red84Recoveries)
    ElseIf taskId = 85 Then
        finishedAt = Time()
        If red85FinishedAt > 0 Then
            finishedAt = red85FinishedAt
        End If
        red85Done = True
        red85Failed = False
        red85Count = red85Count + 1
        red85Due = WorldDayStart(finishedAt) + 86400 + RedArmyTime(85)
        red85Phase = "本时段已完成，等待次日"
        Call WorldLog("是否提交完成=是 次数=" & red85Count & " 终态=" & red85Reason & " 下一次执行时间Unix=" & red85Due & " 重启次数=" & red85Restarts & " 恢复次数=" & red85Recoveries)
    End If
End Sub


// common/跨服首领状态.mq
Sub LoadCrossBossSettings()
    crossEnabled = WorldBoolean("跨服首领启用")
    crossSundayStop = WorldBoolean("跨服首领周日停")
    crossBuyConfig = WorldNumber("跨服首领买次数", 0, 4)
    crossHour = WorldNumber("跨服首领执行时", 9, 23)
    crossMinute = WorldNumber("跨服首领执行分", 10, 59)
    Call WriteMainLog("[跨服世界首领83配置] 时=" & crossHour & " 分=" & crossMinute & " 购买选项=" & crossBuyConfig)
End Sub
Sub NewCrossBossSession()
    crossDue = WorldDayStart(Time()) + crossHour * 3600 + crossMinute * 60
    crossBuyRuntime = crossBuyConfig
    crossDone = False
    crossFailed = False
    crossCount = 0
    crossFailures = 0
    crossRestarts = 0
    crossRecoveries = 0
    crossPhase = "未开始"
    crossTerminal = False
    crossTerminalReason = ""
    crossFinishedAt = 0
    crossMode = -1
    crossActionAt = 0
End Sub
Function SelectCrossBoss()
    Dim nowStamp, dayStart, week, state
    SelectCrossBoss = 0
    If Not crossEnabled Then
        Exit Function
    End If
    nowStamp = Time()
    dayStart = WorldDayStart(nowStamp)
    If crossDue < dayStart Then
        crossDue = dayStart + crossHour * 3600 + crossMinute * 60
    End If
    If nowStamp < crossDue Then
        Exit Function
    End If
    week = DateTime.WeekDay()
    state = "允许执行"
    If nowStamp >= dayStart + 82800 Then
        state = "23点窗口已过"
    ElseIf week = 1 Then
        state = "专业版WeekDay=1不执行"
    ElseIf week = 7 And crossSundayStop Then
        state = "专业版WeekDay=7且周日停开启"
    End If
    If state <> "允许执行" Then
        crossDue = dayStart + 86400 + crossHour * 3600 + crossMinute * 60
        Call Note("[跨服世界首领83] 时间筛选 WeekDay=" & week & " 原因=" & state & " 是否提交完成=否 下一次执行时间Unix=" & crossDue)
        Exit Function
    End If
    Call Note("[跨服世界首领83] 时间筛选 WeekDay=" & week & " 允许执行")
    SelectCrossBoss = 83
End Function
Sub StartCrossBossTask()
    crossTerminal = False
    crossTerminalReason = ""
    crossFinishedAt = 0
    crossDone = False
    crossFailed = False
    crossMode = -1
    worldLastMatch = ""
    worldLastOcr = ""
    Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 剩余购买设置=" & crossBuyRuntime & " 重启次数=" & crossRestarts & " 恢复次数=" & crossRecoveries)
End Sub
Sub RecoverCrossBossTask()
    crossTerminal = False
    crossFailed = True
    crossFailures = crossFailures + 1
    crossRecoveries = crossRecoveries + 1
    Call WorldLog("保存恢复原任务=83 阶段=" & crossPhase & " 失败次数=" & crossFailures & " 恢复次数=" & crossRecoveries & " 是否提交完成=否")
End Sub
Sub RestartCrossBossTask()
    crossRestarts = crossRestarts + 1
    Call WorldLog("重启原任务=83 重启次数=" & crossRestarts & " 恢复次数=" & crossRecoveries)
End Sub
Sub CommitCrossBossTask()
    Dim finishedAt
    finishedAt = Time()
    If crossFinishedAt > 0 Then
        finishedAt = crossFinishedAt
    End If
    crossDone = True
    crossFailed = False
    crossCount = crossCount + 1
    crossDue = WorldDayStart(finishedAt) + 86400 + crossHour * 3600 + crossMinute * 60
    crossPhase = "本日已完成，等待下次日程"
    Call WorldLog("是否提交完成=是 次数=" & crossCount & " 终态=" & crossTerminalReason & " 下一次执行时间Unix=" & crossDue & " 重启次数=" & crossRestarts & " 恢复次数=" & crossRecoveries)
End Sub


// common/世界首领状态.mq
Function WorldBoolean(key)
    Dim raw, text
    WorldBoolean = False
    raw = ReadUIConfig(key, False)
    text = "<null>"
    If Not IsNull(raw) Then
        text = LCase(Trim(CStr(raw)))
        If text = "true" Or text = "1" Then
            WorldBoolean = True
        End If
    End If
    Call WriteMainLog("[世界首领配置] 键=" & key & " 原始值=" & text)
End Function
Function WorldNumber(key, defaultValue, upper)
    Dim raw, result
    raw = ReadUIConfig(key, defaultValue)
    result = defaultValue
    If IsNumeric(raw) Then
        If CDbl(raw) >= 0 And CDbl(raw) <= upper Then
            result = Int(CDbl(raw))
        End If
    End If
    Call WriteMainLog("[世界首领配置] 键=" & key & " 规范值=" & result)
    WorldNumber = result
End Function
Sub LoadWorldBossSettings()
    worldEnabled = WorldBoolean("世界首领启用")
    cellEnabled = WorldBoolean("打沙鲁启用")
    worldKeepDownload = WorldBoolean("保留下载提示")
    worldBuyConfig = WorldNumber("首领买次数", 0, 4)
    worldHour = WorldNumber("首领执行时", 10, 23)
    worldMinute = WorldNumber("首领执行分", 0, 59)
End Sub
Function WorldDayStart(stamp)
    WorldDayStart = Int((stamp + 28800) / 86400) * 86400 - 28800
End Function
Function IsWorldBoss(taskId)
    IsWorldBoss = taskId = 70 Or taskId = 32
End Function
Function WorldName(taskId)
    WorldName = "世界首领70"
    If taskId = 32 Then
        WorldName = "世界首领_打沙鲁32"
    ElseIf taskId = 13 Then
        WorldName = "经验试炼13"
    ElseIf taskId = 92 Then
        WorldName = "异时空试炼92"
    ElseIf taskId = 16 Then
        WorldName = "伙伴试炼16"
    ElseIf taskId = 15 Then
        WorldName = "基因试炼15"
    ElseIf taskId = 14 Then
        WorldName = "龙魂试炼14"
    ElseIf taskId = 12 Then
        WorldName = "金币试炼12"
    ElseIf taskId = 150 Then
        WorldName = "龙珠大冒险150"
    ElseIf taskId = 155 Then
        WorldName = "蛇道155"
    ElseIf taskId = 154 Then
        WorldName = "种仙豆154"
    ElseIf taskId = 153 Then
        WorldName = "悟空送仙豆153"
    ElseIf taskId = 78 Then
        WorldName = "战士集结78"
    ElseIf taskId = 79 Then
        WorldName = "超宇宙战士79"
    ElseIf taskId = 82 Then
        WorldName = "战士记忆82"
    ElseIf taskId = 80 Then
        WorldName = "弗利萨军团80"
    ElseIf taskId = 81 Then
        WorldName = "强者对决81"
    ElseIf taskId = 83 Then
        WorldName = "跨服世界首领83"
    ElseIf taskId = 71 Then
        WorldName = "地球保卫战71"
    ElseIf taskId = 88 Then
        WorldName = "那美克星组队战88"
    ElseIf taskId = 86 Then
        WorldName = "超战士传说86"
    ElseIf taskId = 87 Then
        WorldName = "激战超越极限87"
    ElseIf IsRedArmy(taskId) Then
        WorldName = RedArmyName(taskId)
    End If
End Function
Sub WorldLog(message)
    Call Note("[" & WorldName(currentTask) & "] " & message)
End Sub
Sub WorldStage(value)
    If currentTask = 92 Then
        yskPhase = value
    ElseIf currentTask = 16 Then
        partnerPhase = value
    ElseIf currentTask = 15 Then
        genePhase = value
    ElseIf currentTask = 14 Then
        soulPhase = value
    ElseIf currentTask = 13 Then
        experiencePhase = value
    ElseIf currentTask = 12 Then
        goldPhase = value
    ElseIf currentTask = 150 Then
        advPhase = value
    ElseIf currentTask = 155 Then
        snakePhase = value
    ElseIf currentTask = 154 Then
        plantPhase = value
    ElseIf currentTask = 153 Then
        senzuPhase = value
    ElseIf currentTask = 78 Then
        gatherPhase = value
    ElseIf currentTask = 79 Then
        universePhase = value
    ElseIf currentTask = 82 Then
        memoryPhase = value
    ElseIf currentTask = 80 Then
        friezaPhase = value
    ElseIf currentTask = 81 Then
        duelPhase = value
    ElseIf currentTask = 71 Then
        earthPhase = value
    ElseIf currentTask = 88 Then
        namekPhase = value
    ElseIf currentTask = 86 Then
        legendPhase = value
    ElseIf currentTask = 87 Then
        beyondPhase = value
    ElseIf currentTask = 32 Then
        cellPhase = value
    ElseIf currentTask = 83 Then
        crossPhase = value
    ElseIf IsRedArmy(currentTask) Then
        Call SetRedArmyPhase(value)
    Else
        worldPhase = value
    End If
    worldLastMatch = ""
    Call SetStage(value)
    Call WorldLog("当前阶段=" & value)
End Sub
Sub NewWorldBossSession()
    worldFinishedAt = 0
    cellFinishedAt = 0
    worldDue = WorldDayStart(Time()) + worldHour * 3600 + worldMinute * 60
    cellDue = WorldDayStart(Time()) + 75600
    worldBuyRuntime = worldBuyConfig
    worldLastMatch = ""
    worldLastOcr = ""
    worldTerminalReason = ""
    worldDone = False
    worldFailed = False
    worldCount = 0
    worldFailures = 0
    worldRestarts = 0
    worldRecoveries = 0
    worldPhase = "未开始"
    worldTerminal = False
    cellDone = False
    cellFailed = False
    cellCount = 0
    cellFailures = 0
    cellRestarts = 0
    cellRecoveries = 0
    cellPhase = "未开始"
    cellTerminal = False
End Sub
Function SelectWorldBoss()
    Dim nowStamp, dayStart
    SelectWorldBoss = 0
    nowStamp = Time()
    dayStart = WorldDayStart(nowStamp)
    If worldDue < dayStart Then
        worldDue = dayStart + worldHour * 3600 + worldMinute * 60
    End If
    If worldEnabled And nowStamp >= worldDue Then
        If nowStamp >= dayStart + 82800 Then
            worldDue = dayStart + 86400 + worldHour * 3600 + worldMinute * 60
            Call Note("[世界首领70] 已过23点窗口，不提交；下一次执行时间Unix=" & worldDue)
        Else
            SelectWorldBoss = 70
            Exit Function
        End If
    End If
    If cellEnabled And nowStamp >= cellDue Then
        If nowStamp >= dayStart + 82800 Then
            cellDue = dayStart + 86400 + 75600
            Call Note("[打沙鲁32] 已过23点窗口，不提交；下一次执行时间Unix=" & cellDue)
        ElseIf nowStamp >= dayStart + 75600 Then
            SelectWorldBoss = 32
        Else
            cellDue = dayStart + 75600
        End If
    End If
End Function
Sub StartWorldBossTask(taskId)
    worldLastMatch = ""
    worldLastOcr = ""
    worldTerminalReason = ""
    If taskId = 32 Then
        cellFinishedAt = 0
        cellTerminal = False
        cellDone = False
        cellFailed = False
        Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & cellRestarts & " 恢复次数=" & cellRecoveries)
    Else
        worldFinishedAt = 0
        worldTerminal = False
        worldDone = False
        worldFailed = False
        Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & worldRestarts & " 恢复次数=" & worldRecoveries & " 本会话剩余购买设置=" & worldBuyRuntime)
    End If
End Sub
Sub RecoverWorldBossTask(taskId)
    If taskId = 32 Then
        cellTerminal = False
        cellFailed = True
        cellFailures = cellFailures + 1
        cellRecoveries = cellRecoveries + 1
        Call WorldLog("保存恢复原任务=32 阶段=" & cellPhase & " 失败次数=" & cellFailures & " 恢复次数=" & cellRecoveries & " 是否提交完成=否")
    Else
        worldTerminal = False
        worldFailed = True
        worldFailures = worldFailures + 1
        worldRecoveries = worldRecoveries + 1
        Call WorldLog("保存恢复原任务=70 阶段=" & worldPhase & " 失败次数=" & worldFailures & " 恢复次数=" & worldRecoveries & " 是否提交完成=否")
    End If
End Sub
Sub RestartWorldBossTask(taskId)
    If taskId = 32 Then
        cellRestarts = cellRestarts + 1
        Call WorldLog("重启次数=" & cellRestarts & " 恢复次数=" & cellRecoveries)
    Else
        worldRestarts = worldRestarts + 1
        Call WorldLog("重启次数=" & worldRestarts & " 恢复次数=" & worldRecoveries)
    End If
End Sub
Sub CommitWorldBossTask(taskId)
    Dim dayStart, minute, finishedAt
    finishedAt = Time()
    If taskId = 70 And worldFinishedAt > 0 Then
        finishedAt = worldFinishedAt
    ElseIf taskId = 32 And cellFinishedAt > 0 Then
        finishedAt = cellFinishedAt
    End If
    dayStart = WorldDayStart(finishedAt)
    If taskId = 32 Then
        cellDone = True
        cellFailed = False
        cellCount = cellCount + 1
        cellDue = dayStart + 86400 + 75600
        cellPhase = "本日已完成"
        Call WorldLog("是否提交完成=是 次数=" & cellCount & " 下一次执行时间Unix=" & cellDue & " 重启次数=" & cellRestarts & " 恢复次数=" & cellRecoveries)
    Else
        worldDone = True
        worldFailed = False
        worldCount = worldCount + 1
        If finishedAt < dayStart + 75600 Then
            minute = Int(Rnd() * 50) + 1
            worldDue = dayStart + 75600 + minute * 60
            worldPhase = "本轮完成，等待夜间再次"
        Else
            worldDue = dayStart + 86400 + worldHour * 3600 + worldMinute * 60
            worldPhase = "本日已完成"
        End If
        Call WorldLog("是否提交完成=是 次数=" & worldCount & " 下一次执行时间Unix=" & worldDue & " 重启次数=" & worldRestarts & " 恢复次数=" & worldRecoveries)
    End If
End Sub


// common/合作冒险状态.mq
Function CoopBooleanSetting(key)
    Dim raw, text
    CoopBooleanSetting = False
    raw = ReadUIConfig(key, False)
    text = "<null>"
    If Not IsNull(raw) Then
        text = LCase(Trim(CStr(raw)))
        If text = "true" Or text = "1" Then
            CoopBooleanSetting = True
        End If
    End If
    Call WriteMainLog("[龙珠激斗脚本][合作152配置] 键=" & key & " 原始值=" & text)
End Function
Sub LoadCoopSettings()
    Dim raw
    coopEnabled = CoopBooleanSetting("合作冒险启用")
    coopKeepDownload = CoopBooleanSetting("保留下载提示")
    coopTeamMode = 0
    raw = ReadUIConfig("合作队伍模式", 0)
    If IsNumeric(raw) Then
        If CDbl(raw) = 1 Then
            coopTeamMode = 1
        End If
    End If
    coopInterval = 43200
    Call WriteMainLog("[龙珠激斗脚本][合作152配置] 队伍模式=" & coopTeamMode & " 间隔秒=" & coopInterval)
End Sub
Sub NewCoopSession()
    coopRegisteredTask = 152
    coopFirst = True
    coopDue = 0
    coopDone = False
    coopFailed = False
    coopCount = 0
    coopFailures = 0
    coopRestarts = 0
    coopRecoveries = 0
    coopPhase = "未开始"
    coopTerminal = False
    coopTerminalReason = ""
    coopLastMatch = ""
    coopLastOcr = ""
    coopTimeKey = ""
End Sub
Function CoopTimeEligible()
    Dim week, hour, key, state
    week = DateTime.WeekDay()
    hour = DateTime.Hour()
    CoopTimeEligible = False
    state = "原版分派未允许，尚未提交"
    // Literal root.800 branch semantics; no invented weekday-number conversion.
    If week <= 5 And week <> 1 Then
        CoopTimeEligible = True
        state = "原版分派允许"
    End If
    key = week & ":" & hour
    If key <> coopTimeKey Then
        Call Note("[合作大冒险152] 时间资格 WeekDay=" & week & " Hour=" & hour & " 结果=" & state)
        coopTimeKey = key
    End If
End Function
Sub StartCoopTask()
    coopTerminal = False
    coopDone = False
    coopFailed = False
    coopLastMatch = ""
    coopLastOcr = ""
    Call Note("[合作大冒险152] 任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & coopRestarts & " 恢复次数=" & coopRecoveries)
End Sub
Sub RecoverCoopTask()
    coopTerminal = False
    coopFailed = True
    coopFailures = coopFailures + 1
    coopRecoveries = coopRecoveries + 1
    Call Note("[合作大冒险152] 保存恢复任务=152 是否提交完成=否 阶段=" & coopPhase & " 失败次数=" & coopFailures & " 恢复次数=" & coopRecoveries)
End Sub
Sub CommitCoopTask()
    coopDone = True
    coopFailed = False
    coopCount = coopCount + 1
    coopDue = TickCount() + 43200000
    coopFirst = False
    coopPhase = "本轮完成，等待12小时"
    Call Note("[合作大冒险152] 是否提交完成=是 本轮次数=" & coopCount & " 下一次执行时间Unix=" & (Time() + 43200) & " 重启次数=" & coopRestarts & " 恢复次数=" & coopRecoveries)
End Sub


