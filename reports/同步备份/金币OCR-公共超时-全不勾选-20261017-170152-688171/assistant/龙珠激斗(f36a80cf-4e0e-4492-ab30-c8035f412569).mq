Call LoadSettings()
Call NewSession()
Call InitForegroundMonitor()
Call RegisterTasks()
If GetScreenX() <> 720 Or GetScreenY() <> 1280 Then
    TracePrint "需要720x1280；请同时在MuMu确认320 DPI"
    EndScript
End If
Call Note("新会话启动；已勾选普通任务先执行一次")
Call Note("线程启动R2：准备调用Thread.Start")
foregroundThread = Thread.Start(ForegroundMonitor)
Call Note("线程启动R2：Thread.Start已返回")
foregroundStartupAt = TickCount()
Do While Not Thread.GetShareVar("fg.ready")
    If TickCount() - foregroundStartupAt >= 3000 Then
        Call Note("线程启动R2：3秒未完成首次采样，停止；检查前台日志最后一步")
        ExitScript
    End If
    Delay 20
Loop
Call Note("线程启动R2：首次采样已确认，进入公共调度")
Do
    Call SchedulerStep()
    Delay 200
Loop


// common/常量.mq
Sub InitConstants()
    RESULT_OK = 1
    RESULT_WAIT = 2
    RESULT_FAIL = 3
    RESULT_TIMEOUT = 4
    GAME_PACKAGE = "com.tencent.tmgp.dragonball"
    QQ_PACKAGE = "com.tencent.mobileqq"
End Sub


// common/前台监控.mq
// User-defined foreground policy. This thread only samples and reports.
// Peterson two-party gate: exactly one main thread and one monitor thread.
// Shared reads/writes use the engine store; never call the iOS-only lock APIs.
Sub EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.gate.main", True)
    Call Thread.SetShareVar("fg.gate.turn", "monitor")
    Do While Thread.GetShareVar("fg.gate.monitor") And Thread.GetShareVar("fg.gate.turn") = "monitor"
        Delay 1
    Loop
End Sub
Sub LeaveMainForegroundGate()
    Call Thread.SetShareVar("fg.gate.main", False)
End Sub
Sub EnterMonitorForegroundGate()
    Call Thread.SetShareVar("fg.gate.monitor", True)
    Call Thread.SetShareVar("fg.gate.turn", "main")
    Do While Thread.GetShareVar("fg.gate.main") And Thread.GetShareVar("fg.gate.turn") = "main"
        Delay 1
    Loop
End Sub
Sub LeaveMonitorForegroundGate()
    Call Thread.SetShareVar("fg.gate.monitor", False)
End Sub
Sub InitForegroundMonitor()
    Call Thread.SetShareVar("fg.gate.main", False)
    Call Thread.SetShareVar("fg.gate.monitor", False)
    Call Thread.SetShareVar("fg.gate.turn", "main")
    Call Thread.SetShareVar("fg.recovering", False)
    Call Thread.SetShareVar("fg.request", False)
    Call Thread.SetShareVar("fg.outside", False)
    Call Thread.SetShareVar("fg.since", 0)
    Call Thread.SetShareVar("fg.last", "<未采样>")
    Call Thread.SetShareVar("fg.reason", "")
    Call Thread.SetShareVar("fg.ready", False)
    foregroundLoginPending = False
End Sub
Sub ForegroundLog(message)
    Call WriteForegroundLog("[龙珠激斗脚本][前台监控] " & message)
End Sub
Sub SampleForeground(gamePackage, qqPackage)
    Dim package, nowAt, recovering, outside, startupProbe
    startupProbe = Not Thread.GetShareVar("fg.ready")
    // Lock only this short sample; never hold across waits or game lifecycle calls.
    If startupProbe Then
        Call ForegroundLog("线程互斥R3：首次采样进入共享互斥前")
    End If
    Call EnterMonitorForegroundGate()
    If startupProbe Then
        Call ForegroundLog("线程互斥R3：已进入共享互斥，读取前台前")
    End If
    package = Sys.GetFront()
    If startupProbe Then
        Call ForegroundLog("线程启动R2：首次前台读取完成")
    End If
    nowAt = TickCount()
    If package <> Thread.GetShareVar("fg.last") Then
        Call Thread.SetShareVar("fg.last", package)
        Call ForegroundLog("前台包名=" & package)
    End If
    recovering = Thread.GetShareVar("fg.recovering")
    outside = Thread.GetShareVar("fg.outside")
    If recovering Then
        Call Thread.SetShareVar("fg.outside", False)
    ElseIf Not Thread.GetShareVar("fg.request") Then
        If package = gamePackage Or package = qqPackage Or package = "com.tencent.mobileqq:openSdk" Then
            If outside Then
                Call ForegroundLog("回到允许前台，取消5秒倒计时")
            End If
            Call Thread.SetShareVar("fg.outside", False)
        ElseIf Not outside Then
            Call Thread.SetShareVar("fg.outside", True)
            Call Thread.SetShareVar("fg.since", nowAt)
            Call ForegroundLog("离开允许前台，开始5秒倒计时")
        ElseIf nowAt - Thread.GetShareVar("fg.since") >= 5000 Then
            Call Thread.SetShareVar("fg.reason", package)
            Call Thread.SetShareVar("fg.request", True)
            Call ForegroundLog("连续离开5秒，上报前台离开")
        End If
    End If
    Call LeaveMonitorForegroundGate()
End Sub
Sub ForegroundMonitor()
    // No cross-thread argument capture; initialize immutable package names locally.
    Dim monitorGame, monitorQQ
    Call ForegroundLog("线程启动R2：已进入监控线程")
    monitorGame = "com.tencent.tmgp.dragonball"
    monitorQQ = "com.tencent.mobileqq"
    Call SampleForeground(monitorGame, monitorQQ)
    Call ForegroundLog("线程启动R2：首次采样完成")
    Call Thread.SetShareVar("fg.ready", True)
    Do
        Call SampleForeground(monitorGame, monitorQQ)
        Delay 200
    Loop
End Sub
Function ForegroundInterrupted()
    Call EnterMainForegroundGate()
    ForegroundInterrupted = Thread.GetShareVar("fg.request")
    Call LeaveMainForegroundGate()
End Function
Sub BeginForegroundRecovery()
    Call EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.recovering", True)
    Call Thread.SetShareVar("fg.request", False)
    Call Thread.SetShareVar("fg.outside", False)
    Call LeaveMainForegroundGate()
End Sub
Sub EndForegroundRecovery()
    Call EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.outside", False)
    Call Thread.SetShareVar("fg.recovering", False)
    Call LeaveMainForegroundGate()
End Sub
Function BeginForegroundCommit()
    Dim accepted
    // Serialize the report/commit boundary; no completion can consume a pending report.
    Call EnterMainForegroundGate()
    accepted = Not Thread.GetShareVar("fg.request")
    BeginForegroundCommit = accepted
    If Not accepted Then
        Call LeaveMainForegroundGate()
    End If
End Function
Sub EndForegroundCommit()
    Call LeaveMainForegroundGate()
End Sub
Function HandleForegroundRecovery()
    HandleForegroundRecovery = False
    If Not ForegroundInterrupted() Then
        Exit Function
    End If
    Call Note("公共调度器收到前台离开；前台=" & Thread.GetShareVar("fg.reason"))
    If currentTask = 92 Or currentTask = 16 Or currentTask = 15 Or currentTask = 14 Or currentTask = 13 Or currentTask = 12 Or currentTask = 150 Or currentTask = 155 Or currentTask = 154 Or currentTask = 153 Or currentTask = 81 Or currentTask = 80 Or currentTask = 82 Or currentTask = 79 Or currentTask = 78 Or currentTask = 71 Or currentTask = 86 Or currentTask = 87 Or currentTask = 88 Or currentTask = 168 Or currentTask = 169 Or currentTask = 167 Or currentTask = 166 Or currentTask = 55 Or currentTask = 56 Or IsTimedStamina(currentTask) Or currentTask = 151 Or currentTask = 152 Or IsWorldBoss(currentTask) Or currentTask = 83 Or IsRedArmy(currentTask) Then
        Call SaveRecovery()
    End If
    terminalConfirmed = False
    Call RestartGame()
    HandleForegroundRecovery = True
End Function


// common/日志.mq
// Separate files have one writer each; never acquire a nested thread lock here.
Sub WritePublicLog(path, message)
    Dim line, beforeBytes, afterBytes, created
    line = "[tick=" & TickCount() & "] " & message
    TracePrint line
    If Not Dir.Exist("/sdcard/Pictures") Then
        created = Dir.Create("/sdcard/Pictures")
    End If
    beforeBytes = 0
    If Dir.Exist(path) Then
        beforeBytes = File.Bytes(path)
    End If
    line = line & Chr(13) & Chr(10)
    Call File.Append(path, line)
    afterBytes = File.Bytes(path)
    If afterBytes <= beforeBytes Then
        TracePrint "[文件日志] 写入失败，请检查脚本应用存储权限和剩余空间"
    End If
End Sub
Sub WriteMainLog(message)
    Call WritePublicLog("/sdcard/Pictures/dragonball-main.log", message)
End Sub
Sub WriteForegroundLog(message)
    Call WritePublicLog("/sdcard/Pictures/dragonball-foreground.log", message)
End Sub
Sub Note(message)
    Call WriteMainLog("[龙珠激斗脚本][" & stageName & "] " & message)
End Sub
Sub SetStage(value)
    If stageName <> value Then
        stageName = value
        Call Note("进入阶段")
    End If
End Sub


// common/地球保卫状态.mq
Sub LoadEarthSettings()
    earthEnabled = WorldBoolean("地球保卫战启用")
    earthBuyConfig = WorldNumber("地球保卫买次数", 0, 5)
    earthTimeMode = WorldNumber("地球保卫执行时间", 0, 4)
End Sub

Function EarthConfiguredDue(dayStart)
    EarthConfiguredDue = dayStart + 64800
    If earthTimeMode = 1 Then
        EarthConfiguredDue = dayStart + 68400
    ElseIf earthTimeMode = 2 Then
        EarthConfiguredDue = dayStart + 72000
    ElseIf earthTimeMode = 3 Then
        EarthConfiguredDue = dayStart + 75000
    ElseIf earthTimeMode = 4 Then
        EarthConfiguredDue = dayStart
        If dayStart = WorldDayStart(Time()) Then
            EarthConfiguredDue = Time()
        End If
    End If
End Function

Sub NewEarthSession()
    earthDue = EarthConfiguredDue(WorldDayStart(Time()))
    earthBuyRuntime = earthBuyConfig
    earthRuntimeDay = WorldDayStart(Time())
    earthDone = False
    earthFailed = False
    earthCount = 0
    earthFailures = 0
    earthRestarts = 0
    earthRecoveries = 0
    earthPhase = "未开始"
    earthTerminal = False
    earthReason = ""
    earthPrestart = False
    earthMode = 0
End Sub

Function SelectEarth()
    Dim dayStart
    SelectEarth = 0
    If Not earthEnabled Then
        Exit Function
    End If
    dayStart = WorldDayStart(Time())
    If earthRuntimeDay <> dayStart Then
        earthBuyRuntime = earthBuyConfig
        earthRuntimeDay = dayStart
    End If
    If earthDue < dayStart Then
        earthDue = EarthConfiguredDue(dayStart)
        earthBuyRuntime = earthBuyConfig
    End If
    If DateTime.WeekDay() = 1 Then
        Exit Function
    End If
    If Time() >= earthDue Then
        SelectEarth = 71
    End If
End Function

Sub StartEarthTask()
    earthDone = False
    earthFailed = False
    earthTerminal = False
    earthReason = ""
    earthPrestart = False
    earthMode = 0
    earthPhase = "开始"
    worldLastMatch = ""
    Call WorldLog("任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & earthRestarts & " 恢复次数=" & earthRecoveries)
End Sub

Sub RecoverEarthTask()
    earthTerminal = False
    earthFailed = True
    earthFailures = earthFailures + 1
    earthRecoveries = earthRecoveries + 1
    earthPhase = "等待恢复"
    Call WorldLog("保存恢复原任务=71 阶段=" & earthPhase & " 失败次数=" & earthFailures & " 恢复次数=" & earthRecoveries & " 是否提交完成=否")
End Sub

Sub RestartEarthTask()
    earthRestarts = earthRestarts + 1
    Call WorldLog("重启原任务=71 重启次数=" & earthRestarts & " 恢复次数=" & earthRecoveries)
End Sub

Sub CommitEarthTask()
    Dim dayStart
    dayStart = WorldDayStart(Time())
    earthDone = True
    earthFailed = False
    earthCount = earthCount + 1
    If Not earthPrestart And earthDue < WorldDayStart(earthDue) + 64800 Then
        earthDue = dayStart + 64800
    Else
        earthDue = EarthConfiguredDue(dayStart + 86400)
    End If
    earthPhase = "本轮已结束"
    Call WorldLog("是否提交完成=是 次数=" & earthCount & " 终态=" & earthReason & " 下一次执行时间Unix=" & earthDue & " 重启次数=" & earthRestarts & " 恢复次数=" & earthRecoveries)
End Sub


// common/战士集结状态.mq
Sub LoadGatherSettings()
    gatherEnabled = WorldBoolean("战士集结启用")
    gatherDouble = WorldBoolean("战士集结双倍")
    gatherSweep = WorldBoolean("战士集结扫荡")
End Sub
Sub NewGatherSession()
    gatherDue = Time()
    gatherFinishedAt = 0
    gatherCount = 0
    gatherFailures = 0
    gatherRestarts = 0
    gatherRecoveries = 0
    gatherTerminal = False
    gatherPhase = "未开始"
    gatherReason = ""
    gatherEntryTimeout = False
    gatherPeriodEnded = False
End Sub
Function SelectGather()
    SelectGather = 0
    If gatherEnabled Then
        If Time() >= gatherDue Then
            SelectGather = 78
        End If
    End If
End Function
Sub StartGatherTask()
    gatherFinishedAt = 0
    gatherTerminal = False
    gatherEntryTimeout = False
    gatherPeriodEnded = False
    gatherReason = ""
    gatherPhase = "开始"
    worldLastMatch = ""
    Call WorldLog("任务开始Unix=" & Time() & " 重启次数=" & gatherRestarts & " 恢复次数=" & gatherRecoveries)
End Sub
Sub RecoverGatherTask()
    gatherTerminal = False
    gatherFailures = gatherFailures + 1
    gatherRecoveries = gatherRecoveries + 1
    Call WorldLog("保存原任务=78 阶段=" & gatherPhase & " 是否提交完成=否")
End Sub
Sub RestartGatherTask()
    gatherRestarts = gatherRestarts + 1
    Call WorldLog("重启原任务=78 次数=" & gatherRestarts)
End Sub
Sub CommitGatherTask()
    Dim dayStart, finishedAt
    finishedAt = Time()
    If gatherFinishedAt > 0 Then
        finishedAt = gatherFinishedAt
    End If
    dayStart = WorldDayStart(finishedAt)
    gatherCount = gatherCount + 1
    If gatherPeriodEnded Or finishedAt >= dayStart + 72000 Then
        gatherDue = dayStart + 86400
    ElseIf gatherEntryTimeout Then
        gatherDue = dayStart + 72300
    Else
        gatherDue = dayStart + 72000
    End If
    Call WorldLog("本轮提交次数=" & gatherCount & " 终态=" & gatherReason & " 下一次执行Unix=" & gatherDue)
End Sub


// common/超宇宙状态.mq
Sub LoadUniverseSettings()
    universeEnabled = WorldBoolean("日常_超宇宙战士")
    universeCapsule = WorldBoolean("日常_超宇宙战士_胶囊任务")
    universeFailureMode = WorldNumber("设置_重要_开战失败", 1, 1)
End Sub
Sub NewUniverseSession()
    universeDue = Time()
    universeDone = False
    universeCount = 0
    universeFailures = 0
    universeRestarts = 0
    universeRecoveries = 0
    universeTerminal = False
    universeFullClear = False
    universeReason = ""
    universePhase = "未开始"
    universeFinishedAt = 0
End Sub
Function SelectUniverse()
    SelectUniverse = 0
    If universeDone Then
        Exit Function
    End If
    If universeEnabled Then
        If Time() >= universeDue Then
            SelectUniverse = 79
        End If
    End If
End Function
Sub StartUniverseTask()
    universeTerminal = False
    universeFullClear = False
    universeReason = ""
    universePhase = "开始"
    universeFinishedAt = 0
    worldLastMatch = ""
    Call SetStage("超宇宙战士启动")
    Call WorldLog("任务开始Unix=" & Time() & " 胶囊任务=" & CStr(universeCapsule) & " 开战失败处理=" & universeFailureMode)
End Sub
Sub RecoverUniverseTask()
    universeTerminal = False
    universeFailures = universeFailures + 1
    universeRecoveries = universeRecoveries + 1
    Call WorldLog("保存原任务=79 阶段=" & universePhase & " 是否提交完成=否")
End Sub
Function ResetUniverseTaskTimer()
    ResetUniverseTaskTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    Call WorldLog("专业版任务计时重置；只在原调用点刷新，未确认界面不提交")
    ResetUniverseTaskTimer = True
End Function
Sub RestartUniverseTask()
    universeRestarts = universeRestarts + 1
    Call WorldLog("重启原任务=79 次数=" & universeRestarts)
End Sub
Sub CommitUniverseTask()
    universeCount = universeCount + 1
    universeDone = True
    Call WorldLog("本轮提交次数=" & universeCount & " 终态=" & universeReason & " 已完成锁存=是；等待公共重置或新会话，不自行安排零点重跑")
End Sub


// common/战士记忆状态.mq
Sub LoadMemorySettings()
    memoryEnabled = WorldBoolean("日常_战士记忆")
    memoryFailureMode = WorldNumber("设置_重要_开战失败", 1, 1)
End Sub
Sub NewMemorySession()
    memoryDone = False
    memoryCount = 0
    memoryFailures = 0
    memoryRestarts = 0
    memoryRecoveries = 0
    memoryTerminal = False
    memoryUncompleted = False
    memoryReason = ""
    memoryPhase = "未开始"
End Sub
Function SelectMemory()
    SelectMemory = 0
    If memoryEnabled And Not memoryDone Then
        SelectMemory = 82
    End If
End Function
Sub StartMemoryTask()
    memoryTerminal = False
    memoryUncompleted = False
    memoryReason = ""
    memoryPhase = "开始"
    worldLastMatch = ""
    Call WorldLog("任务开始Unix=" & Time() & " 开战失败处理=" & memoryFailureMode)
End Sub
Sub RecoverMemoryTask()
    memoryTerminal = False
    memoryUncompleted = False
    memoryFailures = memoryFailures + 1
    memoryRecoveries = memoryRecoveries + 1
    Call WorldLog("保存原任务=82 阶段=" & memoryPhase & " 是否提交完成=否")
End Sub
Sub RestartMemoryTask()
    memoryRestarts = memoryRestarts + 1
    Call WorldLog("重启原任务=82 次数=" & memoryRestarts)
End Sub
Sub CommitMemoryTask()
    memoryDone = True
    memoryCount = memoryCount + 1
    Call WorldLog("本轮提交次数=" & memoryCount & " 专业版出口=" & memoryReason & "；不是挑战胜利证明；不自行安排跨日重跑")
End Sub
Function ConfirmMemoryTerminal(reason)
    ConfirmMemoryTerminal = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    memoryReason = reason
    memoryTerminal = True
    terminalConfirmed = True
    Call WorldLog("专业版本轮出口=" & reason & "；等待公共回大厅，尚未提交")
    ConfirmMemoryTerminal = RESULT_OK
End Function
Function ReleaseMemoryUncompleted(hallConfirmed)
    ReleaseMemoryUncompleted = False
    If currentTask <> 82 Or Not memoryUncompleted Or Not hallConfirmed Then
        Exit Function
    End If
    If Not BeginForegroundCommit() Then
        Exit Function
    End If
    Call WorldLog("专业版开战超过20次选择结束任务：返回大厅，不写完成、不安排臆测冷却；交回串行调度")
    memoryUncompleted = False
    currentTask = 0
    resumeTask = 0
    terminalConfirmed = False
    ReleaseMemoryUncompleted = True
    Call EndForegroundCommit()
End Function


// common/弗利萨状态.mq
Sub LoadFriezaSettings()
    Dim raw
    friezaEnabled = WorldBoolean("日常_弗利萨军团")
    friezaFailureMode = WorldNumber("设置_重要_开战失败", 1, 1)
    friezaIdleLimit = WorldNumber("设置_重连_超时时间", 120, 999) * 1000
    friezaFailureLimit = WorldNumber("设置_重要_任务失败上限", 2, 9999)
    friezaHallDelay = WorldNumber("设置_重要_返回大厅延迟", 0, 99)
    raw = ReadUIConfig("设置_重要_闪退", True)
    friezaRestartOnTimeout = True
    If Not IsNull(raw) Then
        friezaRestartOnTimeout = LCase(Trim(CStr(raw))) = "true" Or Trim(CStr(raw)) = "1"
    End If
End Sub
Sub NewFriezaSession()
    friezaDone = False
    friezaAbandoned = False
    friezaCount = 0
    friezaFailures = 0
    friezaRecoveries = 0
    friezaRestarts = 0
    friezaTerminal = False
    friezaTimedOut = False
    friezaTimeoutCounted = False
    friezaRunning = False
    friezaWatchdogTripped = False
    friezaWatchdogAt = TickCount()
    friezaReason = ""
    friezaPhase = "未开始"
End Sub
Function SelectFrieza()
    SelectFrieza = 0
    If friezaEnabled And Not friezaDone And Not friezaAbandoned Then
        SelectFrieza = 80
    End If
End Function
Sub StartFriezaTask()
    friezaTerminal = False
    friezaTimedOut = False
    friezaTimeoutCounted = False
    friezaRunning = False
    friezaWatchdogTripped = False
    friezaWatchdogAt = TickCount()
    friezaReason = ""
    friezaPhase = "开始"
    worldLastMatch = ""
    Call WorldLog("专业版无进展超时毫秒=" & friezaIdleLimit & " 失败上限=" & friezaFailureLimit & " 超时重启=" & CStr(friezaRestartOnTimeout))
End Sub
Sub FriezaProgress()
    If friezaRunning Then
        If TickCount() - friezaWatchdogAt > friezaIdleLimit Then
            friezaTimedOut = True
            friezaWatchdogTripped = True
            friezaReason = "专业版公共无进展超时；迟到的进展不能撤销"
        End If
    End If
    friezaWatchdogAt = TickCount()
End Sub
Function FriezaWatchdogExpired()
    Dim interrupted
    interrupted = ForegroundInterrupted()
    FriezaWatchdogExpired = interrupted
    If interrupted Then
        Exit Function
    End If
    If friezaWatchdogTripped Then
        FriezaWatchdogExpired = True
        Exit Function
    End If
    If TickCount() - friezaWatchdogAt > friezaIdleLimit Then
        friezaTimedOut = True
        friezaWatchdogTripped = True
        friezaReason = "专业版公共无进展超时"
        FriezaWatchdogExpired = True
    End If
End Function
Sub RecoverFriezaTask()
    friezaTerminal = False
    friezaRunning = False
    friezaRecoveries = friezaRecoveries + 1
    If friezaTimedOut And Not friezaTimeoutCounted Then
        friezaFailures = friezaFailures + 1
        friezaTimeoutCounted = True
        If friezaFailures >= friezaFailureLimit Then
            friezaAbandoned = True
        End If
    End If
    If friezaAbandoned Then
        resumeTask = 0
    End If
    Call WorldLog("保存原任务=80 原因=" & friezaReason & " 阶段=" & friezaPhase & " 超时失败次数=" & friezaFailures & " 放弃本轮=" & CStr(friezaAbandoned) & " 正常完成次数=" & friezaCount)
End Sub
Sub RestartFriezaTask()
    friezaRunning = False
    friezaRestarts = friezaRestarts + 1
    Call WorldLog("公共重启80 次数=" & friezaRestarts)
End Sub
Sub CommitFriezaTask()
    friezaDone = True
    friezaRunning = False
    friezaCount = friezaCount + 1
    Call WorldLog("公共大厅确认后提交80 次数=" & friezaCount & " 出口=" & friezaReason & "；不等同战斗胜利，不自行安排跨日重跑")
End Sub
Function ConfirmFriezaTerminal(reason)
    ConfirmFriezaTerminal = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    friezaTerminal = True
    terminalConfirmed = True
    friezaReason = reason
    Call WorldLog("专业版本轮出口=" & reason & "；等待公共返回大厅，尚未提交")
    ConfirmFriezaTerminal = RESULT_OK
End Function
Function ReleaseFriezaTimeout(hallConfirmed)
    ReleaseFriezaTimeout = False
    If currentTask <> 80 Or Not friezaTimedOut Or Not hallConfirmed Then
        Exit Function
    End If
    If Not BeginForegroundCommit() Then
        Exit Function
    End If
    currentTask = 0
    friezaRunning = False
    terminalConfirmed = False
    If friezaAbandoned Then
        resumeTask = 0
    Else
        resumeTask = 80
    End If
    ReleaseFriezaTimeout = True
    Call EndForegroundCommit()
End Function


// common/强者对决状态.mq
Sub LoadDuelSettings()
    Dim raw
    duelEnabled = WorldBoolean("日常_强者对决")
