        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("原试炼入口60秒未确认；交公共恢复，不写完成")
            Exit Function
        End If
        If Not SoulWait(20) Then
            Exit Function
        End If
    Loop
End Function
Function ExecuteSoulTrial()
    ExecuteSoulTrial = RESULT_TIMEOUT
    If EnterSoulTrial() <> RESULT_OK Then
        Exit Function
    End If
    ExecuteSoulTrial = RunSoulTrial()
End Function

// task14 only. Original OCR regions/conditions retained; 3.8 OcrText is not paddleV5.
Function SoulFilterText(value)
    Dim output
    output = ""
    If IsNull(value) Then
        SoulFilterText = output
        Exit Function
    End If
    // Conservative old-OCR separator normalization, not the original ssUtil engine.
    // Keep all other characters: e.g. error02 must never become an exhausted token.
    output = Replace(value, "/", "")
    output = Replace(output, "|", "")
    output = Replace(output, " ", "")
    output = Replace(output, Chr(9), "")
    output = Replace(output, Chr(10), "")
    output = Replace(output, Chr(13), "")
    SoulFilterText = output
End Function
Function SoulCountExhausted(value)
    SoulCountExhausted = value = "02" Or value = "03" Or value = "04" Or value = "05" Or value = "012" Or value = "013" Or value = "014" Or value = "015"
End Function
Function SoulSweepReady()
    SoulSweepReady = True
    If WorldMatch("014_P12") Then
        Exit Function
    End If
    SoulSweepReady = WorldMatch("014_P13")
End Function
Function SoulEntryIcon()
    SoulEntryIcon = True
    If WorldMatch("014_P02") Then
        Exit Function
    End If
    SoulEntryIcon = False
End Function
Function SoulSweepResult()
    SoulSweepResult = True
    If WorldMatch("014_P26") Then
        Exit Function
    End If
    SoulSweepResult = WorldMatch("014_P27")
End Function
Function SoulAutoTriple()
    SoulAutoTriple = False
    If WorldMatch("014_AutoReady") Then
        SoulAutoTriple = True
    ElseIf WorldMatch("014_AutoOff") Then
        Call WorldOffset(-310, 170, 50)
    ElseIf WorldMatch("014_TripleOff") Then
        Call WorldOffset(318, 92, 50)
    ElseIf WorldMatch("014_BattleBase") Then
        Call WorldOffset(318, 16, 50)
    End If
End Function
Function RunSoulTrial()
    Dim phase, actionAt, overallAt, text, ax, ay, countRead
    RunSoulTrial = RESULT_TIMEOUT
    phase = 0
    actionAt = TickCount()
    overallAt = TickCount()
    countRead = False
    If Not ResetSoulTimer() Then
        Exit Function
    End If
    Call WorldStage("龙魂试炼次数与入口")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("014_P02") Then
            ax = foundX
            ay = foundY
            text = SoulFilterText(WorldText(ax - 115, ay + 108, ax - 62, ay + 134))
            If SoulCountExhausted(text) Then
                RunSoulTrial = ConfirmSoulExit("原次数耗尽", 1)
                Exit Function
            End If
            If text <> "" Then
                If InStr(1, text, "00:") > 0 Then
                    RunSoulTrial = ConfirmSoulExit("原冷却改期", 2)
                    Exit Function
                End If
            End If
            // A0=2 VM PC250/251: missing OCR does not open the entry gate.
            If text <> "" Then
                countRead = True
            End If
        End If
        If WorldMatch("014_P05") Then
            RunSoulTrial = ConfirmSoulExit("原龙魂灰色入口结束", 5)
            Exit Function
        End If
        If countRead Then
            If SoulEntryIcon() Then
                If Not WorldOffset(0, 0, 50) Then
                    Exit Function
                End If
            End If
            If Not SoulWait(50) Then
                Exit Function
            End If
            If SoulSweepReady() Then
                phase = 1
                Exit Do
            End If
            If Not SoulWait(50) Then
                Exit Function
            End If
            If WorldMatch("014_P14") Then
                phase = 2
                Exit Do
            End If
            If TickCount() - actionAt > 20000 Then
                phase = 3
            End If
        End If
        If Not SoulWait(50) Then
            Exit Function
        End If
    Loop
    If Not ResetSoulTimer() Then
        Exit Function
    End If
    actionAt = TickCount()
    Call WorldStage("龙魂试炼扫荡或挑战")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If Not SoulWait(50) Then
            Exit Function
        End If
        If phase = 1 Then
            If SoulSweepReady() Then
                If Not WorldOffset(0, 0, 500) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
        ElseIf phase = 2 Then
            If WorldMatch("014_P14") Then
                If Not WorldOffset(180, -252, 500) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
            If WorldMatch("152_开战图标6") Then
                If Not WorldTap(398, 982, 500) Then
                    Exit Function
                End If
                If Not WorldTap(587, 982, 500) Then
                    Exit Function
                End If
                If Not SoulWait(500) Then
                    Exit Function
                End If
                If Not ResetSoulTimer() Then
                    Exit Function
                End If
            End If
            If WorldMatch("032_少人提示") Then
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
        ElseIf phase = 3 Then
            RunSoulTrial = ConfirmSoulExit("原入页20秒边界", 3)
            Exit Function
        ElseIf phase = 4 Then
            text = WorldText(65, 7, 247, 59)
            If text = "试炼" Then
                RunSoulTrial = ConfirmSoulExit("原试炼标题返回", 4)
                Exit Function
            End If
            If WorldMatch("014_P23") Then
                If Not WorldTap(128, 1228, 1000) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
        End If
        If WorldMatch("014_P22") Then
            If Not WorldOffset(-98, -361, 0) Then
                Exit Function
            End If
            phase = 4
            actionAt = TickCount()
        End If
        If WorldMatch("014_P24") Then
            If Not WorldOffset(-116, -315, 500) Then
                Exit Function
            End If
            phase = 4
            actionAt = TickCount()
        End If
        If WorldMatch("014_P25") Then
            ax = foundX
            ay = foundY
            If Not SoulWait(1000) Then
                Exit Function
            End If
            If Not WorldTap(ax, ay, 0) Then
                Exit Function
            End If
            RunSoulTrial = ConfirmSoulExit("原战斗失败退出", 4)
            Exit Function
        End If
        If SoulSweepResult() Then
            ax = foundX
            ay = foundY
            If Not SoulWait(1000) Then
                Exit Function
            End If
            If Not WorldTap(ax, ay, 0) Then
                Exit Function
            End If
            phase = 4
        End If
        If SoulAutoTriple() Then
            If Not ResetSoulTimer() Then
                Exit Function
            End If
            actionAt = TickCount()
            If Not SoulWait(500) Then
                Exit Function
            End If
        End If
        If TickCount() - actionAt > 35000 Or TickCount() - overallAt > 300000 Then
            RunSoulTrial = ConfirmSoulExit("原35秒或300秒超时", 3)
            Exit Function
        End If
    Loop
End Function


// common/基因试炼状态.mq
Sub LoadGeneSettings()
    Dim raw
    geneEnabled = WorldBoolean("SlJyin")
    raw = ReadUIConfig("设置_重要_闪退", True)
    geneRestartOnTimeout = True
    If Not IsNull(raw) Then
        geneRestartOnTimeout = LCase(Trim(CStr(raw))) = "true" Or Trim(CStr(raw)) = "1"
    End If
End Sub
Sub NewGeneSession()
    geneDue = Time()
    geneDone = False
    geneAbandoned = False
    geneCount = 0
    geneRecoveries = 0
    geneRestarts = 0
    genePhase = "未开始"
    geneReason = ""
    geneExitKind = 0
    geneFinishedAt = 0
    geneNativeTimeout = False
    geneFailures = 0
    geneForcedRecovery = False
    geneNoRestartPending = False
    genePickIndex = 0
    geneClickAt = 0
    geneActionAt = 0
    geneSpecialExit = False
End Sub
Function SelectGene()
    SelectGene = 0
    If geneEnabled And Not geneDone And Not geneAbandoned And Time() >= geneDue Then
        SelectGene = 15
    End If
End Function
Sub StartGeneTask()
    geneForcedRecovery = False
    geneNoRestartPending = False
    geneReason = ""
    geneExitKind = 0
    geneFinishedAt = 0
    geneNativeTimeout = False
    Call WorldStage("基因试炼启动")
End Sub
Sub RecoverGeneTask()
    geneRecoveries = geneRecoveries + 1
    If geneForcedRecovery Then
        Call WorldLog("原公共超时失败次数=" & geneFailures & "；不按原业务出口计次")
    ElseIf geneNativeTimeout Then
        geneCount = geneCount + 1
        geneDue = geneFinishedAt + 65
        geneAbandoned = geneCount >= 5
        resumeTask = 0
        Call WorldLog("原业务超时计次并延后65秒；非胜利、非成功提交 次数=" & geneCount)
    Else
        Call WorldLog("前台或公共边界恢复；保留15，不计次、不改期")
    End If
    If geneAbandoned Then
        resumeTask = 0
    End If
    geneForcedRecovery = False
    geneNativeTimeout = False
    geneExitKind = 0
    terminalConfirmed = False
End Sub
Sub RestartGeneTask()
    geneRestarts = geneRestarts + 1
    Call WorldLog("公共重启恢复15 次数=" & geneRestarts)
End Sub
Sub CommitGeneTask()
    If geneExitKind = 1 Or geneExitKind = 5 Then
        geneDone = True
    ElseIf geneExitKind = 2 Then
        geneDue = geneFinishedAt + 65
    ElseIf geneExitKind = 4 Then
        geneCount = geneCount + 1
        geneDue = geneFinishedAt + 65
        geneDone = geneCount >= 5
    End If
    geneExitKind = 0
    Call WorldLog("大厅连续确认后提交原出口；次数=" & geneCount & " 下次Unix=" & geneDue)
End Sub
Function ResetGeneTimer()
    ResetGeneTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    ResetGeneTimer = True
End Function
Function ConfirmGeneExit(reason, exitKind)
    ConfirmGeneExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    geneReason = reason
    geneExitKind = exitKind
    geneFinishedAt = Time()
    If exitKind = 3 Then
        geneNativeTimeout = True
        Call WorldLog("原超时出口=" & reason & "；交公共恢复，不标成功")
        Exit Function
    End If
    If exitKind <> 1 And exitKind <> 2 And exitKind <> 4 And exitKind <> 5 Then
        Exit Function
    End If
    terminalConfirmed = True
    Call WorldLog("原出口=" & reason & "；尚未提交，等待大厅连续确认")
    ConfirmGeneExit = RESULT_OK
End Function
Function GeneForcedTimeout()
    Dim hallResult
    GeneForcedTimeout = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    geneFailures = geneFailures + 1
    If geneFailures >= 3 Then
        geneAbandoned = True
    End If
    Call WorldLog("原图色调用公共超时处理；失败次数=" & geneFailures & "；非成功出口")
    If Not ResetGeneTimer() Then
        Exit Function
    End If
    If Sys.IsRunning(GAME_PACKAGE) And Not geneRestartOnTimeout Then
        hallResult = ReturnToHall()
        If hallResult = RESULT_OK Then
            GeneForcedTimeout = RESULT_OK
            Exit Function
        End If
        geneNoRestartPending = True
    End If
    geneForcedRecovery = True
End Function


