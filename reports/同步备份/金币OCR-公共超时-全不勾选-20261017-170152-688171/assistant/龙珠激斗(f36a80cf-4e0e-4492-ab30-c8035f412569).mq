End Sub
Sub SaveCurrentTask(taskId)
    Call Note("[流程] 入口 SaveCurrentTask")
    currentTask = taskId
    resumeTask = taskId
    terminalConfirmed = False
    If taskId = 13 Then
        Call StartExperienceTask()
    End If
    If taskId = 92 Then
        Call StartYskTask()
    End If
    If taskId = 16 Then
        Call StartPartnerTask()
    End If
    If taskId = 15 Then
        Call StartGeneTask()
    End If
    If taskId = 14 Then
        Call StartSoulTask()
    End If
    If taskId = 12 Then
        Call StartGoldTask()
    End If
    If taskId = 150 Then
        Call StartAdventureTask()
    End If
    If taskId = 155 Then
        Call StartSnakeTask()
    End If
    If taskId = 154 Then
        Call StartPlantTask()
    End If
    If taskId = 153 Then
        Call StartSenzuTask()
    End If
    If taskId = 79 Then
        Call Note("[流程] SaveCurrentTask 即将初始化任务79")
        Call StartUniverseTask()
        Call Note("[流程] SaveCurrentTask 已完成任务79初始化")
    End If
    If taskId = 82 Then
        Call StartMemoryTask()
    End If
    If taskId = 80 Then
        Call StartFriezaTask()
    End If
    If taskId = 81 Then
        Call StartDuelTask()
    End If
    If taskId = 78 Then
        Call StartGatherTask()
    End If
    If taskId = 71 Then
        Call StartEarthTask()
    End If
    If taskId = 88 Then
        Call StartNamekTask()
    End If
    If taskId = 87 Then
        Call StartBeyondTask()
    End If
    If taskId = 86 Then
        Call StartLegendTask()
    End If
    If IsRedArmy(taskId) Then
        Call StartRedArmyTask(taskId)
    End If
    If taskId = 83 Then
        Call StartCrossBossTask()
    End If
    If IsWorldBoss(taskId) Then
        Call StartWorldBossTask(taskId)
    End If
    If taskId = 152 Then
        Call StartCoopTask()
    End If
    If taskId = 151 Then
        Call StartWukongTask()
    End If
    If IsTimedStamina(taskId) Then
        Call StartTimedStamina(taskId)
    End If
    If taskId = 56 Then
        qfriendDone = False
        qfriendFailed = False
        qfriendTerminal = False
        qfriendRecovery = False
    ElseIf taskId = 55 Then
        friendDone = False
        friendFailed = False
    ElseIf taskId = 166 Then
        monthDone = False
        monthFailed = False
    ElseIf taskId = 167 Then
        signDone = False
        signFailed = False
    ElseIf taskId = 168 Then
        mailDone = False
        mailFailed = False
    ElseIf taskId = 169 Then
        rewardDone = False
        rewardFailed = False
    End If
    Call Note("[流程] 出口 SaveCurrentTask 到达函数末尾（不代表任务已提交）")
End Sub
Sub SaveRecovery()
    Call Note("[流程] 入口 SaveRecovery")
    resumeTask = currentTask
    If currentTask = 13 Then
        Call RecoverExperienceTask()
    End If
    If currentTask = 92 Then
        Call RecoverYskTask()
    End If
    If currentTask = 16 Then
        Call RecoverPartnerTask()
    End If
    If currentTask = 15 Then
        Call RecoverGeneTask()
    End If
    If currentTask = 14 Then
        Call RecoverSoulTask()
    End If
    If currentTask = 12 Then
        Call RecoverGoldTask()
    End If
    If currentTask = 150 Then
        Call RecoverAdventureTask()
    End If
    If currentTask = 155 Then
        Call RecoverSnakeTask()
    End If
    If currentTask = 154 Then
        Call RecoverPlantTask()
    End If
    If currentTask = 153 Then
        Call RecoverSenzuTask()
    End If
    If currentTask = 79 Then
        Call RecoverUniverseTask()
    End If
    If currentTask = 82 Then
        Call RecoverMemoryTask()
    End If
    If currentTask = 80 Then
        Call RecoverFriezaTask()
    End If
    If currentTask = 81 Then
        Call RecoverDuelTask()
    End If
    If currentTask = 71 Then
        Call RecoverEarthTask()
    End If
    If currentTask = 78 Then
        Call RecoverGatherTask()
    End If
    If currentTask = 88 Then
        Call RecoverNamekTask()
    End If
    If currentTask = 87 Then
        Call RecoverBeyondTask()
    End If
    If currentTask = 86 Then
        Call RecoverLegendTask()
    End If
    If IsRedArmy(currentTask) Then
        Call RecoverRedArmyTask(currentTask)
    End If
    If currentTask = 83 Then
        Call RecoverCrossBossTask()
    End If
    If IsWorldBoss(currentTask) Then
        Call RecoverWorldBossTask(currentTask)
    End If
    If currentTask = 152 Then
        Call RecoverCoopTask()
    End If
    If currentTask = 151 Then
        Call RecoverWukongTask()
    End If
    If IsTimedStamina(currentTask) Then
        Call RecoverTimedStamina(currentTask)
    End If
    If currentTask = 56 Then
        qfriendFailed = True
        qfriendRecovery = True
        qfriendTerminal = False
        qfriendFailures = qfriendFailures + 1
        qfriendPhase = "等待恢复"
        Call Note("[Q友体力56] 保存原任务=" & resumeTask & " 失败次数=" & qfriendFailures)
    ElseIf currentTask = 55 Then
        friendFailed = True
        friendFailures = friendFailures + 1
        friendPhase = "等待恢复"
        Call Note("[好友体力55] 保存恢复 原业务=" & resumeTask & " 失败次数=" & friendFailures)
    ElseIf currentTask = 166 Then
        monthFailed = True
        monthFailures = monthFailures + 1
        Call Note("保留原业务=" & resumeTask & "，月卡失败次数=" & monthFailures)
    ElseIf currentTask = 167 Then
        signFailed = True
        signFailures = signFailures + 1
        Call Note("保留原业务=" & resumeTask & "，签到失败次数=" & signFailures)
    ElseIf currentTask = 168 Then
        mailFailed = True
        mailFailures = mailFailures + 1
        Call Note("保留原业务=" & resumeTask & "，业务失败次数=" & mailFailures)
    ElseIf currentTask = 169 Then
        rewardFailed = True
        rewardFailures = rewardFailures + 1
        Call Note("保留原业务=" & resumeTask & "，业务失败次数=" & rewardFailures)
    End If
    Call Note("[流程] 出口 SaveRecovery 到达函数末尾（不代表任务已提交）")
End Sub
Function CommitTask(hallConfirmed)
    Call Note("[流程] 入口 CommitTask")
    CommitTask = False
    If currentTask <> 92 And currentTask <> 16 And currentTask <> 15 And currentTask <> 14 And currentTask <> 13 And currentTask <> 12 And currentTask <> 150 And currentTask <> 155 And currentTask <> 154 And currentTask <> 153 And currentTask <> 81 And currentTask <> 80 And currentTask <> 82 And currentTask <> 79 And currentTask <> 78 And currentTask <> 71 And currentTask <> 88 And currentTask <> 87 And currentTask <> 86 And currentTask <> 168 And currentTask <> 169 And currentTask <> 167 And currentTask <> 166 And currentTask <> 55 And currentTask <> 56 And Not IsTimedStamina(currentTask) And currentTask <> 151 And currentTask <> 152 And Not IsWorldBoss(currentTask) And currentTask <> 83 And Not IsRedArmy(currentTask) Then
        Call Note("[流程] 出口 CommitTask 分支1 路径条件 currentTask <> 168 And currentTask <> 169 And currentTask <> 167 And currentTask <> 166 And currentTask <> 55 And currentTask <> 56")
        Exit Function
    End If
    If Not terminalConfirmed Then
        Call Note("[流程] 出口 CommitTask 分支2 路径条件 Not terminalConfirmed")
        Exit Function
    End If
    If Not hallConfirmed Then
        Call Note("[流程] 出口 CommitTask 分支3 路径条件 Not hallConfirmed")
        Exit Function
    End If
    If Not BeginForegroundCommit() Then
        Call Note("[流程] 出口 CommitTask 分支4 路径条件 Not BeginForegroundCommit()")
        Exit Function
    End If
    If currentTask = 92 Then
        Call CommitYskTask()
    ElseIf currentTask = 16 Then
        Call CommitPartnerTask()
    ElseIf currentTask = 15 Then
        Call CommitGeneTask()
    ElseIf currentTask = 14 Then
        Call CommitSoulTask()
    ElseIf currentTask = 13 Then
        Call CommitExperienceTask()
    ElseIf currentTask = 12 Then
        Call CommitGoldTask()
    ElseIf currentTask = 150 Then
        Call CommitAdventureTask()
    ElseIf currentTask = 155 Then
        Call CommitSnakeTask()
    ElseIf currentTask = 154 Then
        Call CommitPlantTask()
    ElseIf currentTask = 153 Then
        Call CommitSenzuTask()
    ElseIf currentTask = 71 Then
        Call CommitEarthTask()
    ElseIf currentTask = 78 Then
        Call CommitGatherTask()
    ElseIf currentTask = 79 Then
        Call CommitUniverseTask()
    ElseIf currentTask = 82 Then
        Call CommitMemoryTask()
    ElseIf currentTask = 80 Then
        Call CommitFriezaTask()
    ElseIf currentTask = 81 Then
        Call CommitDuelTask()
    ElseIf currentTask = 88 Then
        Call CommitNamekTask()
    ElseIf currentTask = 87 Then
        Call CommitBeyondTask()
    ElseIf currentTask = 86 Then
        Call CommitLegendTask()
    ElseIf IsRedArmy(currentTask) Then
        Call CommitRedArmyTask(currentTask)
    ElseIf currentTask = 83 Then
        Call CommitCrossBossTask()
    ElseIf IsWorldBoss(currentTask) Then
        Call CommitWorldBossTask(currentTask)
    ElseIf currentTask = 152 Then
        Call CommitCoopTask()
    ElseIf currentTask = 151 Then
        Call CommitWukongTask()
    ElseIf IsTimedStamina(currentTask) Then
        Call CommitTimedStamina(currentTask)
    ElseIf currentTask = 56 Then
        qfriendDone = True
        qfriendFailed = False
        qfriendRecovery = False
        qfriendCount = qfriendCount + 1
        qfriendDue = TickCount() + qfriendInterval * 1000
        qfriendFirst = False
        qfriendPhase = "完成"
        Call Note("[Q友体力56] 返回大厅连续确认后提交 次数=" & qfriendCount & " 间隔秒=" & qfriendInterval)
    ElseIf currentTask = 55 Then
        friendDone = True
        friendFailed = False
        friendCount = friendCount + 1
        friendDue = TickCount() + friendInterval * 1000
        friendFirst = False
        friendPhase = "完成"
        Call Note("[好友体力55] 返回大厅连续确认后提交 次数=" & friendCount & " 间隔秒=" & friendInterval)
    ElseIf currentTask = 166 Then
        monthDone = True
        monthFailed = False
        monthCount = monthCount + 1
        monthDue = TickCount() + monthInterval * 1000
        monthFirst = False
        monthPhase = "完成"
        Call Note("月卡龙石166提交完成，次数=" & monthCount & "，间隔秒=" & monthInterval)
    ElseIf currentTask = 167 Then
        signDone = True
        signFailed = False
        signCount = signCount + 1
        signDue = TickCount() + signInterval * 1000
        signFirst = False
        signPhase = "完成"
        Call Note("日常签到167提交完成，次数=" & signCount & "，间隔秒=" & signInterval)
    ElseIf currentTask = 168 Then
        mailDone = True
        mailFailed = False
        mailCount = mailCount + 1
        mailDue = TickCount() + mailInterval * 1000
        mailFirst = False
        mailPhase = "完成"
        Call Note("邮件提交完成，次数=" & mailCount & "，间隔秒=" & mailInterval)
    ElseIf currentTask = 169 Then
        rewardDone = True
        rewardFailed = False
        rewardCount = rewardCount + 1
        rewardDue = TickCount() + rewardInterval * 1000
        rewardFirst = False
        rewardPhase = "完成"
        Call Note("任务奖励169提交完成，次数=" & rewardCount & "，间隔秒=" & rewardInterval)
    End If
    currentTask = 0
    resumeTask = 0
    terminalConfirmed = False
    CommitTask = True
    Call Note("[流程] 结果 CommitTask True")
    Call EndForegroundCommit()
    Call Note("[流程] 出口 CommitTask 到达函数末尾（不代表任务已提交）")
End Function


// common/运行计时.mq
Function LoginExpired()
    LoginExpired = ForegroundInterrupted() Or TickCount() - loginStarted >= loginLimit
End Function
Function BusinessExpired()
    If currentTask = 92 Then
        BusinessExpired = ForegroundInterrupted()
        Exit Function
    End If
    If currentTask = 16 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 15 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 14 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 13 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 12 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 150 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 155 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 154 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 153 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 79 Then
        BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted > businessLimit
        Exit Function
    End If
    If currentTask = 80 And friezaRunning Then
        BusinessExpired = FriezaWatchdogExpired()
        Exit Function
    End If
    If currentTask = 81 And duelRunning Then
        BusinessExpired = DuelWatchdogExpired()
        Exit Function
    End If
    BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted >= businessLimit
End Function
Sub Progress()
    progressAt = TickCount()
End Sub


// common/点击操作.mq
Sub TouchPoint(x, y, waitMs)
    Dim remaining, sliceMs
    Call Note("[流程] 入口 TouchPoint")
    If ForegroundInterrupted() Then
        Call Note("[流程] 出口 TouchPoint 分支1 路径条件 ForegroundInterrupted()")
        Exit Sub
    End If
    // Do not tap another app during the five-second grace period.
    If Not Sys.AppIsFront(GAME_PACKAGE) And Not Sys.AppIsFront(QQ_PACKAGE) And Sys.GetFront() <> "com.tencent.mobileqq:openSdk" Then
        Call Note("[流程] 出口 TouchPoint 分支2 路径条件 Not Sys.AppIsFront(GAME_PACKAGE) And Not Sys.AppIsFront(QQ_PACKAGE) And Sys.GetFront() <> 'com.tencent.mobileqq:openSdk'")
        Exit Sub
    End If
    ReleaseCapture
    Tap x, y
    Call Note("[流程] 已发送点击 x=" & x & " y=" & y & " 等待毫秒=" & waitMs)
    remaining = waitMs
    Do While remaining > 0
        If ForegroundInterrupted() Then
            Call Note("[流程] 出口 TouchPoint 分支3 路径条件 ForegroundInterrupted()")
            Exit Sub
        End If
        sliceMs = remaining
        If sliceMs > 100 Then
            sliceMs = 100
        End If
        Delay sliceMs
        remaining = remaining - sliceMs
    Loop
    Call Note("[流程] 出口 TouchPoint 到达函数末尾（不代表任务已提交）")
End Sub
Function TouchPattern(name, waitMs)
    TouchPattern = False
    If MatchPattern(name) Then
        Call Note("[流程] 图色命中 " & name)
        Call TouchPoint(foundX, foundY, waitMs)
        TouchPattern = True
    End If
End Function


// common/活动入口.mq
Function ReadActivityText(x1, y1, x2, y2)
    Dim text
    ReadActivityText = ""
    If ForegroundInterrupted() Then
        Exit Function
    End If
    ReleaseCapture
    text = Image.OcrText(x1, y1, x2, y2, 0, 0)
    If IsNull(text) Then
        text = ""
    End If
    If text <> activityOcrLast Or TickCount() - activityOcrLogAt >= 5000 Then
        Call Note("[活动OCR] 区域=" & x1 & "," & y1 & "," & x2 & "," & y2 & " 文本=" & text)
        activityOcrLast = text
        activityOcrLogAt = TickCount()
    End If
    ReadActivityText = text
End Function
Sub SwipeActivityPage(reverse)
    If ForegroundInterrupted() Then
        Call Note("[活动滑动] 出口：前台中断，未执行")
        Exit Sub
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call Note("[活动滑动] 出口：游戏不在前台，未执行")
        Exit Sub
    End If
    ReleaseCapture
    If reverse Then
        Call Note("[活动滑动] 159,137到609,137，300毫秒")
        Swipe 159, 137, 609, 137, 300
    Else
        Call Note("[活动滑动] 609,137到159,137，300毫秒")
        Swipe 609, 137, 159, 137, 300
    End If
    If ForegroundInterrupted() Then
        Call Note("[活动滑动] 出口：后续短滑前中断")
        Exit Sub
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call Note("[活动滑动] 出口：后续短滑前离开游戏")
        Exit Sub
    End If
    Swipe 100, 100, 100, 50, 100
    Call Note("[活动滑动] 出口：已完成及100,100到100,50短滑")
End Sub


