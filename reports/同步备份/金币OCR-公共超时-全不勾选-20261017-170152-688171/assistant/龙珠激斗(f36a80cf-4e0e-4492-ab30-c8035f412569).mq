// common/大厅清障.mq
// root.784: public return/clearance actions only. No business state submission.
Sub ResetHallClearing()
    hallMisses = 0
    hallExtended = False
    hallActionIndex = 0
End Sub
Function HallActionWait()
    HallActionWait = 1000
    If currentTask = 80 Then
        If friezaHallDelay > 0 Then
            HallActionWait = friezaHallDelay * 1000
        End If
        Exit Function
    End If
    If currentTask = 81 Then
        If duelHallDelay > 0 Then
            HallActionWait = duelHallDelay * 1000
        End If
        Exit Function
    End If
    If hallReturnDelaySeconds > 0 Then
        HallActionWait = hallReturnDelaySeconds * 1000
    End If
End Function
Function FindHallObstacle(includeExtended)
    FindHallObstacle = False
    hallActionIndex = 0
    If MatchPattern("大厅清障01") Then
        hallActionIndex = 1
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障02") Then
        hallActionIndex = 2
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障03") Then
        hallActionIndex = 3
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障04") Then
        hallActionIndex = 4
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障05") Then
        hallActionIndex = 5
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障06") Then
        hallActionIndex = 6
        FindHallObstacle = True
        Exit Function
    End If
    If includeExtended Then
        If MatchPattern("大厅清障07") Then
            hallActionIndex = 7
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障08") Then
            hallActionIndex = 8
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障09") Then
            hallActionIndex = 9
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障10") Then
            hallActionIndex = 10
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障11") Then
            hallActionIndex = 11
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障12") Then
            hallActionIndex = 12
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障13") Then
            hallActionIndex = 13
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障14") Then
            hallActionIndex = 14
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障15") Then
            hallActionIndex = 15
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障16") Then
            hallActionIndex = 16
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障17") Then
            hallActionIndex = 17
            FindHallObstacle = True
            Exit Function
        End If
    End If
End Function
Function ClearHallObstacle()
    Dim selected, selectedIndex, selectedX, selectedY, waitMs
    ClearHallObstacle = False
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    // The prototype keeps expanded candidate descriptors after the counter resets.
    If hallMisses > 3 Then
        hallMisses = 0
        hallExtended = True
    End If
    selected = FindHallObstacle(hallExtended)
    selectedIndex = hallActionIndex
    selectedX = foundX
    selectedY = foundY
    waitMs = HallActionWait()
    // Special lookup comes after selection but its action takes precedence.
    If MatchPattern("大厅清障特殊分支") Then
        Call Note("大厅清障：特殊分支，点击=" & (foundX - 311) & "," & (foundY + 10) & "，等待毫秒=" & waitMs)
        Call TouchPoint(foundX - 311, foundY + 10, waitMs)
        hallMisses = 0
        Call ResetHallCheck()
        ClearHallObstacle = True
    ElseIf selected Then
        Call Note("大厅清障：候选=" & selectedIndex & "，点击=" & selectedX & "," & selectedY & "，等待毫秒=" & waitMs)
        Call TouchPoint(selectedX, selectedY, waitMs)
        hallMisses = 0
        Call ResetHallCheck()
        ClearHallObstacle = True
    Else
        hallMisses = hallMisses + 1
    End If
    // Caller supplies the original 100ms tail once per clearance round.
End Function


// common/页面识别.mq
Function GreenArrow()
    GreenArrow = True
    If MatchPattern("绿色返回一") Then
        Exit Function
    End If
    GreenArrow = MatchPattern("绿色返回二")
End Function
Function HallCandidate()
    Dim candidateFound
    candidateFound = False
    HallCandidate = False
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    If MatchPattern("大厅主体") Then
        candidateFound = True
    ElseIf MatchPattern("大厅底部") Then
        candidateFound = True
    End If
    If Not candidateFound Then
        Exit Function
    End If
    HallCandidate = True
    If FindHallObstacle(True) Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("大厅清障特殊分支") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("获得奖励") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("邮件关闭弹窗") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭一") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭二") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭三") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("我知道了") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("回归公告") Then
        HallCandidate = False
    End If
End Function
Sub ResetHallCheck()
    hallFrames = 0
    hallSampleAt = TickCount() - 500
End Sub
Function ConfirmHall()
    ConfirmHall = False
    If TickCount() - hallSampleAt < 500 Then
        Exit Function
    End If
    hallSampleAt = TickCount()
    If HallCandidate() Then
        hallFrames = hallFrames + 1
    Else
        hallFrames = 0
    End If
    ConfirmHall = hallFrames >= 2
End Function


// common/游戏控制.mq
Sub StartGame()
    Call Note("[流程] 入口 StartGame")
    If Sys.AppIsFront(QQ_PACKAGE) Or Sys.GetFront() = "com.tencent.mobileqq:openSdk" Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            Call Note("[流程] 出口 StartGame 分支1 路径条件 Sys.IsRunning(GAME_PACKAGE)")
            Exit Sub
        End If
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call BeginForegroundRecovery()
        RunApp GAME_PACKAGE
        Call EndForegroundRecovery()
    End If
    Call Note("[流程] 出口 StartGame 到达函数末尾（不代表任务已提交）")
End Sub
Sub RestartGame()
    If currentTask = 13 Then
        Call RestartExperienceTask()
    End If
    If currentTask = 92 Then
        Call RestartYskTask()
    End If
    If currentTask = 16 Then
        Call RestartPartnerTask()
    End If
    If currentTask = 15 Then
        Call RestartGeneTask()
    End If
    If currentTask = 14 Then
        Call RestartSoulTask()
    End If
    If currentTask = 12 Then
        Call RestartGoldTask()
    End If
    If currentTask = 150 Then
        Call RestartAdventureTask()
    End If
    If currentTask = 155 Then
        Call RestartSnakeTask()
    End If
    If currentTask = 154 Then
        Call RestartPlantTask()
    End If
    If currentTask = 153 Then
        Call RestartSenzuTask()
    End If
    If currentTask = 71 Then
        Call RestartEarthTask()
    End If
    If currentTask = 78 Then
        Call RestartGatherTask()
    End If
    If currentTask = 79 Then
        Call RestartUniverseTask()
    End If
    If currentTask = 82 Then
        Call RestartMemoryTask()
    End If
    If currentTask = 80 Then
        Call RestartFriezaTask()
    End If
    If currentTask = 81 Then
        Call RestartDuelTask()
    End If
    If currentTask = 88 Then
        Call RestartNamekTask()
    End If
    If currentTask = 87 Then
        Call RestartBeyondTask()
    End If
    If currentTask = 86 Then
        Call RestartLegendTask()
    End If
    If IsRedArmy(currentTask) Then
        Call RestartRedArmyTask(currentTask)
    End If
    If currentTask = 83 Then
        Call RestartCrossBossTask()
    End If
    If IsWorldBoss(currentTask) Then
        Call RestartWorldBossTask(currentTask)
    End If
    If currentTask = 152 Then
        coopRestarts = coopRestarts + 1
        Call Note("[合作大冒险152] 重启原任务=152 重启次数=" & coopRestarts & " 恢复次数=" & coopRecoveries)
    End If
    If currentTask = 151 Then
        wukongRestarts = wukongRestarts + 1
        Call Note("[悟空的冒险151] 重启原任务=151 重启次数=" & wukongRestarts & " 恢复次数=" & wukongRecoveries)
    End If
    If IsTimedStamina(currentTask) Then
        Call RestartTimedStamina(currentTask)
    End If
    Call Note("[流程] 入口 RestartGame")
    Call BeginForegroundRecovery()
    foregroundLoginPending = True
    Call Note("重启游戏；保持同一会话及待恢复业务=" & resumeTask)
    KillApp GAME_PACKAGE
    // New-engine process shutdown settling delay, not a recovered task delay.
    Delay 1000
    loginStarted = TickCount()
    RunApp GAME_PACKAGE
    Call EndForegroundRecovery()
    Call Note("[流程] 出口 RestartGame 到达函数末尾（不代表任务已提交）")
End Sub


// common/强敌入口.mq
Function WorldMatch(name)
    Dim token, matched
    matched = MatchPattern(name)
    WorldMatch = matched
    If matched Then
        token = name & ":" & foundX & "," & foundY
        If token <> worldLastMatch Then
            Call WorldLog("命中模板=" & name & " 锚点=" & foundX & "," & foundY & " 图色区域方向相似度=见登记")
            worldLastMatch = token
        End If
    End If
End Function
Function WorldPair(base)
    Dim name
    WorldPair = True
    name = base & "一"
    If WorldMatch(name) Then
        Exit Function
    End If
    name = base & "二"
    WorldPair = WorldMatch(name)
End Function
Function WorldTap(x, y, waitMs)
    WorldTap = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Exit Function
    End If
    Call WorldLog("点击坐标=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    WorldTap = Not BusinessExpired()
End Function
Sub WorldWait(waitMs)
    Call WorldLog("等待毫秒=" & waitMs)
    Delay waitMs
End Sub
Function WorldOffset(dx, dy, waitMs)
    Call WorldLog("点击偏移=" & dx & "," & dy)
    WorldOffset = WorldTap(foundX + dx, foundY + dy, waitMs)
End Function
Function WorldText(x1, y1, x2, y2)
    Dim text, token
    ReleaseCapture
    text = Image.OcrText(x1, y1, x2, y2, 0, 0)
    If IsNull(text) Then
        text = ""
    End If
    token = x1 & "," & y1 & "," & x2 & "," & y2 & ":" & text
    If token <> worldLastOcr Then
        Call WorldLog("OCR区域=" & x1 & "," & y1 & "," & x2 & "," & y2 & " 文本=" & text)
        worldLastOcr = token
    End If
    WorldText = text
End Function
Sub WorldResourcePrompt()
    Dim x, y, text, clicked
    If Not worldKeepDownload Then
        If WorldMatch("强敌_资源下载提示") Then
            x = foundX
            y = foundY
            text = WorldText(100, 395, 317, 448)
            If text = "下载新功能" Then
                clicked = WorldTap(x, y, 0)
            End If
            text = WorldText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                clicked = WorldTap(x, y, 0)
            End If
        End If
    End If
End Sub
Function EnemyHallKnown()
    EnemyHallKnown = True
    If WorldPair("强敌_大厅") Then
        Exit Function
    End If
    EnemyHallKnown = WorldMatch("强敌_大厅底部")
End Function
Function EnterEnemyHall()
    Dim started, result, clicked
    EnterEnemyHall = RESULT_TIMEOUT
    started = TickCount()
    Call WorldStage("强敌入侵入口")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=强敌入口公共超时或前台中断；未提交")
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldPair("强敌_目标") Then
            EnterEnemyHall = RESULT_OK
            Exit Function
        End If
        result = ReturnToHall()
        Call WorldLog("入口公共返回大厅结果=" & result)
        If result <> RESULT_OK Then
            Exit Function
        End If
        If EnemyHallKnown() Then
            If WorldPair("强敌_入口") Then
                clicked = WorldOffset(0, 0, 1500)
                If Not clicked Then
                    Exit Function
                End If
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                If Not Sys.AppIsFront(GAME_PACKAGE) Or BusinessExpired() Then
                    Exit Function
                End If
                ReleaseCapture
                Call WorldLog("大厅滑动=150,545到500,545 时长=300 等待毫秒=0")
                Swipe 150, 545, 500, 545, 300
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("超时原因=强敌入口60秒；恢复原任务，不标完成")
            Exit Function
        End If
        Delay 20
    Loop
End Function


// common/返回大厅.mq
Function ReturnToHall()
    Dim returnStarted, acted, callerStage
    callerStage = stageName
    Call Note("[流程] 入口 ReturnToHall")
    ReturnToHall = RESULT_TIMEOUT
    returnStarted = TickCount()
    Call SetStage("大厅清障与绿色箭头返回")
    Call ResetHallCheck()
    Call ResetHallClearing()
    Do
        If ForegroundInterrupted() Or TickCount() - returnStarted >= businessLimit Then
            Call Note("[流程] 出口 ReturnToHall 分支1 路径条件 ForegroundInterrupted() Or TickCount() - returnStarted >= businessLimit")
            Exit Do
        End If
        If ConfirmHall() Then
            ReturnToHall = RESULT_OK
            Call Note("[流程] 结果 ReturnToHall RESULT_OK")
            Call Note("[流程] 出口 ReturnToHall 分支2 路径条件 ConfirmHall()")
            Exit Do
        End If
        acted = ClearHallObstacle()
        Delay 100
    Loop
    Call SetStage(callerStage)
    Call Note("[流程] 出口 ReturnToHall 到达函数末尾（不代表任务已提交）")
End Function


