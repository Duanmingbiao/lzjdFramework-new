        If TickCount() >= mailDue Then
            selected = registeredTask
            selectedDue = mailDue
        End If
    End If
    If rewardEnabled Then
        If TickCount() >= rewardDue Then
            If selected = 0 Or rewardDue < selectedDue Then
                selected = rewardRegisteredTask
                selectedDue = rewardDue
            End If
        End If
    End If
    If signEnabled Then
        If TickCount() >= signDue Then
            If selected = 0 Or signDue < selectedDue Then
                selected = signRegisteredTask
                selectedDue = signDue
            End If
        End If
    End If
    If monthEnabled Then
        If TickCount() >= monthDue Then
            If selected = 0 Or monthDue < selectedDue Then
                selected = monthRegisteredTask
                selectedDue = monthDue
            End If
        End If
    End If
    If friendEnabled Then
        If TickCount() >= friendDue Then
            If selected = 0 Or friendDue < selectedDue Then
                selected = friendRegisteredTask
                selectedDue = friendDue
            End If
        End If
    End If
    If qfriendEnabled Then
        If TickCount() >= qfriendDue Then
            If selected = 0 Or qfriendDue < selectedDue Then
                selected = qfriendRegisteredTask
                selectedDue = qfriendDue
            End If
        End If
    End If
    If wukongEnabled Then
        If TickCount() >= wukongDue Then
            If selected = 0 Or wukongDue < selectedDue Then
                selected = wukongRegisteredTask
                selectedDue = wukongDue
            End If
        End If
    End If
    If coopEnabled Then
        If TickCount() >= coopDue Then
            If CoopTimeEligible() Then
                If selected = 0 Or coopDue < selectedDue Then
                    selected = coopRegisteredTask
                End If
            End If
        End If
    End If
    SelectDueTask = selected
End Function


// common/任务分派.mq
Function DispatchTask(taskId)
    Call Note("[流程] 入口 DispatchTask")
    DispatchTask = RESULT_FAIL
    If taskId = 92 Then
        terminalConfirmed = False
        DispatchTask = ExecuteYskTrial()
    ElseIf taskId = 16 Then
        terminalConfirmed = False
        DispatchTask = ExecutePartnerTrial()
    ElseIf taskId = 15 Then
        terminalConfirmed = False
        DispatchTask = ExecuteGeneTrial()
    ElseIf taskId = 14 Then
        terminalConfirmed = False
        DispatchTask = ExecuteSoulTrial()
    ElseIf taskId = 13 Then
        terminalConfirmed = False
        DispatchTask = ExecuteExperienceTrial()
    ElseIf taskId = 12 Then
        terminalConfirmed = False
        DispatchTask = ExecuteGoldTrial()
    ElseIf taskId = 150 Then
        terminalConfirmed = False
        DispatchTask = ExecuteAdventure()
    ElseIf taskId = 155 Then
        terminalConfirmed = False
        DispatchTask = ExecuteSnake()
    ElseIf taskId = 154 Then
        terminalConfirmed = False
        DispatchTask = ExecutePlant()
    ElseIf taskId = 153 Then
        terminalConfirmed = False
        DispatchTask = ExecuteSenzu()
    ElseIf taskId = 81 Then
        terminalConfirmed = False
        DispatchTask = ExecuteDuel()
    ElseIf taskId = 80 Then
        terminalConfirmed = False
        DispatchTask = ExecuteFrieza()
    ElseIf taskId = 82 Then
        terminalConfirmed = False
        DispatchTask = ExecuteMemory()
    ElseIf taskId = 79 Then
        terminalConfirmed = False
        DispatchTask = ExecuteUniverse()
    ElseIf taskId = 78 Then
        terminalConfirmed = False
        DispatchTask = ExecuteGather()
    ElseIf taskId = 71 Then
        terminalConfirmed = False
        DispatchTask = ExecuteEarth()
    ElseIf taskId = 88 Then
        terminalConfirmed = False
        DispatchTask = ExecuteNamek()
    ElseIf taskId = 87 Then
        terminalConfirmed = False
        DispatchTask = ExecuteBeyond()
    ElseIf taskId = 86 Then
        terminalConfirmed = False
        DispatchTask = ExecuteLegend()
    ElseIf IsRedArmy(taskId) Then
        terminalConfirmed = False
        DispatchTask = ExecuteRedArmy(taskId)
    ElseIf taskId = 83 Then
        terminalConfirmed = False
        DispatchTask = ExecuteCrossBoss()
    ElseIf taskId = 70 Then
        terminalConfirmed = False
        DispatchTask = ExecuteWorldBoss()
    ElseIf taskId = 32 Then
        terminalConfirmed = False
        DispatchTask = ExecuteCellBoss()
    ElseIf taskId = 152 Then
        terminalConfirmed = False
        DispatchTask = ExecuteCoopAdventure()
    ElseIf taskId = 151 Then
        terminalConfirmed = False
        DispatchTask = ExecuteWukongAdventure()
    ElseIf IsTimedStamina(taskId) Then
        terminalConfirmed = False
        DispatchTask = ExecuteTimedStamina(taskId)
    ElseIf taskId = 56 Then
        terminalConfirmed = False
        DispatchTask = ExecuteQQFriendStamina()
    ElseIf taskId = 55 Then
        terminalConfirmed = False
        DispatchTask = ExecuteFriendEnergy()
    ElseIf taskId = 166 Then
        terminalConfirmed = False
        DispatchTask = ExecuteMonthlyStones()
    ElseIf taskId = 167 Then
        terminalConfirmed = False
        DispatchTask = ExecuteDailySign()
    ElseIf taskId = 168 Then
        terminalConfirmed = False
        DispatchTask = ExecuteMail()
    ElseIf taskId = 169 Then
        terminalConfirmed = False
        DispatchTask = ExecuteTaskRewards()
    End If
    Call Note("[流程] 出口 DispatchTask 到达函数末尾（不代表任务已提交）")
End Function


// common/任务调度.mq
Sub SchedulerStep()
    Dim selected, result, hallResult, committed
    committed = HandleForegroundRecovery()
    selected = SelectDueTask()
    If selected = 0 Then
        If foregroundLoginPending Then
            result = EnsureGameHall()
            Call Note("[流程] EnsureGameHall() 返回=" & result)
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If result = RESULT_OK Then
                foregroundLoginPending = False
            Else
                Call RestartGame()
            End If
        End If
        Exit Sub
    End If
    Call SaveCurrentTask(selected)
    Call Note("[流程] 调度入口 任务=" & selected)
    result = EnsureGameHall()
    Call Note("[流程] EnsureGameHall() 返回=" & result)
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result <> RESULT_OK Then
        loginFailures = loginFailures + 1
        Call Note("登录总超时，次数=" & loginFailures)
        Call RestartGame()
        Exit Sub
    End If
    foregroundLoginPending = False
    businessStarted = TickCount()
    result = DispatchTask(selected)
    Call Note("[流程] DispatchTask(selected) 返回=" & result)
    If currentTask = 82 And result = RESULT_WAIT Then
        If memoryUncompleted Then
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseMemoryUncompleted(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    If currentTask = 88 And result = RESULT_WAIT Then
        If namekDeferred Then
            hallResult = ReturnToHall()
            Call WorldLog("待重试返回大厅结果=" & hallResult & " 是否提交完成=否")
            If HandleForegroundRecovery() Then
                Call Note("[流程] 出口 SchedulerStep 待重试时前台恢复")
                Exit Sub
            End If
            If ScheduleNamekRetry(hallResult = RESULT_OK) Then
                Call Note("[流程] 出口 SchedulerStep 任务88已安排一小时后重试，未提交完成")
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    Do While result = RESULT_WAIT
        If BusinessExpired() Then
            result = RESULT_TIMEOUT
        Else
            Delay 20
            result = DispatchTask(selected)
            Call Note("[流程] DispatchTask(selected) 返回=" & result)
        End If
    Loop
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result = RESULT_OK And terminalConfirmed Then
        hallResult = ReturnToHall()
        Call Note("[流程] ReturnToHall() 返回=" & hallResult)
        If currentTask = 71 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 88 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 87 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 86 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If IsRedArmy(currentTask) Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 83 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If IsWorldBoss(currentTask) Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 152 Then
            Call Note("[合作大冒险152] 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 151 Then
            Call Note("[悟空的冒险151] 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If IsTimedStamina(currentTask) Then
            Call Note("[定时体力] 编号=" & currentTask & " 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If HandleForegroundRecovery() Then
            Exit Sub
        End If
        If hallResult = RESULT_OK Then
            committed = CommitTask(True)
            If committed Then
                Call Note("[流程] CommitTask(True) 返回=true")
            Else
                Call Note("[流程] CommitTask(True) 返回=false")
            End If
            If committed Then
                Exit Sub
            End If
        End If
    End If
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If currentTask = 80 And result = RESULT_OK And terminalConfirmed Then
        If hallResult <> RESULT_OK Then
            friezaTimedOut = True
            friezaReason = "专业版公共返回大厅失败，不提交完成"
        End If
    End If
    If currentTask = 81 And result = RESULT_OK And terminalConfirmed Then
        If hallResult <> RESULT_OK Then
            duelTimedOut = True
            duelReason = "专业版公共返回大厅失败，不提交完成"
        End If
    End If
    Call SaveRecovery()
    If currentTask = 92 And yskNoRestartPending Then
        yskNoRestartPending = False
        Exit Sub
    End If
    If currentTask = 15 And geneNoRestartPending Then
        geneNoRestartPending = False
        Call WorldLog("原公共超时配置不重启；大厅未确认，保留公共恢复，不提交")
        Exit Sub
    End If
    Call Note("[流程] 调度出口 业务未提交成功，进入恢复")
    If currentTask = 81 And duelTimedOut And Not duelRestartOnTimeout Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            duelRunning = False
            duelWatchdogTripped = False
            Call DuelProgress()
            duelRunning = True
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseDuelTimeout(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            duelRunning = False
            Exit Sub
        End If
    End If
    If currentTask = 80 And friezaTimedOut And Not friezaRestartOnTimeout Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            friezaRunning = False
            friezaWatchdogTripped = False
            Call FriezaProgress()
            friezaRunning = True
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseFriezaTimeout(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            // Keep the no-restart option even when hall confirmation failed.
            friezaRunning = False
            Exit Sub
        End If
    End If
    Call RestartGame()
End Sub


// flows/001_游戏重连/QQ登录.mq
Function ClickQQAuthorization(patternName, label, offsetX, offsetY)
    ClickQQAuthorization = False
    If LoginExpired() Then
        Exit Function
    End If
    If MatchPattern(patternName) Then
        Call Note("QQ授权R3：" & label & "，模板=" & patternName & "，点击=" & (foundX + offsetX) & "," & (foundY + offsetY))
        Call TouchPoint(foundX + offsetX, foundY + offsetY, 1000)
        ClickQQAuthorization = True
    End If
End Function
Function HandleQQ()
    Dim anchorX, anchorY, authorizationHandled, diagnosticRound
    HandleQQ = False
    authorizationHandled = False
    diagnosticRound = False
    If TickCount() - qqLastDiagnosticAt >= 5000 Then
        qqLastDiagnosticAt = TickCount()
        diagnosticRound = True
        Call Note("QQ授权R3：原版图色巡检，登录已用毫秒=" & (TickCount() - loginStarted))
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // root.793 L3694-3752: one-click check precedes the three authorization groups.
    If MatchPattern("QQ一键登录") Then
        anchorX = foundX
        anchorY = foundY
        Call Note("QQ授权R3：一键登录")
        Call TouchPoint(anchorX - 151, anchorY + 86, 1000)
        If Not LoginExpired() Then
            Call TouchPoint(anchorX + 63, anchorY, 1000)
        End If
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // Keep the original candidates first. Add screenshot-derived fallback only.
    If ClickQQAuthorization("QQ授权登录一", "授权登录", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ授权登录二", "授权登录", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版头像昵称同意", "头像昵称同意", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // root.793 L4012/L4026: confirmation has two original candidates.
    If ClickQQAuthorization("QQ授权确认", "VIP会员确认", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ授权登录二", "VIP会员确认候选二", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版VIP会员确认", "VIP会员确认", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    If ClickQQAuthorization("QQ授权同意", "游戏信息同意", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版游戏信息同意", "游戏信息同意", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If Not authorizationHandled And diagnosticRound Then
        Call Note("QQ授权R3：未命中授权页面，继续登录总计时")
    End If
    // root.793 L4113-4117: authorization-section tail, not a new timeout.
    Delay 50
End Function


// flows/001_游戏重连/登录游戏.mq
Function EnsureGameHall()
    Dim agreementTouched, acted, clearanceChecked
    Call Note("[流程] 入口 EnsureGameHall")
    EnsureGameHall = RESULT_TIMEOUT
    agreementTouched = False
    If Not foregroundLoginPending Then
        loginStarted = TickCount()
    End If
    Call SetStage("启动及QQ登录")
    Call ResetHallCheck()
    Call ResetHallClearing()
    Call StartGame()
    Do
        If LoginExpired() Then
            Call Note("[流程] 出口 EnsureGameHall 分支1 路径条件 LoginExpired()")
            Exit Function
        End If
        If ConfirmHall() Then
            EnsureGameHall = RESULT_OK
            Call Note("[流程] 结果 EnsureGameHall RESULT_OK")
            Call Note("[流程] 出口 EnsureGameHall 分支2 路径条件 ConfirmHall()")
            Exit Function
        End If
        clearanceChecked = False
        acted = HandleQQ()
        If Sys.AppIsFront(GAME_PACKAGE) And Not acted Then
            // root.793: known notice handlers; no task-specific claim here.
            // Screenshot-specific game agreement; keep the shared login deadline.
            If MatchPattern("首次启动协议") Then
                Call Note("首次启动协议：点击同意，登录总计时继续")
                Call TouchPoint(foundX + 120, foundY + 1, 1000)
                acted = True
            ElseIf MatchPattern("游戏协议弹窗") Then
                Call Note("游戏协议弹窗：点击同意，登录总计时继续")
                Call TouchPoint(foundX + 58, foundY + 16, 1000)
                acted = True
            End If
            If Not acted Then
                acted = TouchPattern("我知道了", 1000)
            End If
            If Not acted Then
                acted = TouchPattern("回归公告", 1000)
            End If
            If Not acted Then
                acted = TouchPattern("开始游戏", 1500)
            End If
            // The original pattern named QQ登录页 is a login-options anchor.
            // root.793 L831-849 uses this template with automatic anchor click.
            If Not acted Then
                If MatchPattern("QQ登录页") Then
                    If MatchPattern("协议已选") Then
                        If MatchPattern("QQ登录页") Then
                            Call TouchPoint(foundX, foundY, 1500)
                            acted = True
                        End If
                    ElseIf Not agreementTouched Then
                        Call TouchPoint(45, 1150, 1500)
                        agreementTouched = True
                        acted = True
                    End If
                End If
            End If
            If Not acted Then
                clearanceChecked = True
                acted = ClearHallObstacle()
            End If
        End If
        // QQ or unknown foreground keeps the same login deadline.
        If clearanceChecked Then
            Delay 100
        Else
            Delay 20
        End If
    Loop
    Call Note("[流程] 出口 EnsureGameHall 到达函数末尾（不代表任务已提交）")
End Function


// flows/168_领邮件奖励/领邮件奖励.mq
Function MailEmpty()
    MailEmpty = True
    If MatchPattern("邮件空一") Then
        Exit Function
    End If
    MailEmpty = MatchPattern("邮件空二")
End Function
Function MailClaimable()
    MailClaimable = True
    If MatchPattern("邮件可领一") Then
        Exit Function
    End If
    MailClaimable = MatchPattern("邮件可领二")
End Function
Sub MailStage(value)
    mailPhase = value
    Call SetStage(value)
End Sub
Function ReadMessages()
    Dim localStarted, elapsed
    Call Note("[流程] 入口 ReadMessages")
    ReadMessages = RESULT_TIMEOUT
    localStarted = TickCount()
    Call MailStage("消息邮件自动阅读")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ReadMessages 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MatchPattern("邮件关闭弹窗") Then
            Call Note("[流程] 邮件图色命中 邮件关闭弹窗")
            Call TouchPoint(foundX, foundY, 200)
            localStarted = TickCount()
        End If
        If MatchPattern("邮件消息打开") Then
            Call Note("[流程] 邮件图色命中 邮件消息打开")
            Call TouchPoint(foundX, foundY, 200)
        End If
        elapsed = TickCount() - localStarted
        If elapsed > 2000 And elapsed <= 5000 Then
            If MatchPattern("邮件消息终态") Then
                Call Note("[流程] 邮件图色命中 邮件消息终态")
                ReadMessages = RESULT_OK
                Call Note("[流程] 结果 ReadMessages RESULT_OK")
                Call Note("[流程] 出口 ReadMessages 分支2 路径条件 MatchPattern('邮件消息终态')")
                Exit Function
            End If
        End If
        If elapsed > 5000 Then
            Call Note("[流程] 出口 ReadMessages 分支3 路径条件 elapsed > 5000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 ReadMessages 到达函数末尾（不代表任务已提交）")
End Function
Function ExecuteMail()
    Dim claimStarted, messageResult
    Call Note("[流程] 入口 ExecuteMail")
    ExecuteMail = RESULT_TIMEOUT
    Call MailStage("进入邮件")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ExecuteMail 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MatchPattern("邮件专业入口") Then
            Call Note("[流程] 邮件图色命中 邮件专业入口")
            Call TouchPoint(25, 830, 200)
        End If
        If MatchPattern("低客户端提示") Then
            Call Note("[流程] 邮件图色命中 低客户端提示")
            Call TouchPoint(foundX, foundY, 1500)
        End If
        If MailEmpty() Then
            Call Note("[流程] 邮件识别 无奖励状态命中")
            terminalConfirmed = True
            Call MailStage("入口确认无奖励")
            ExecuteMail = RESULT_OK
            Call Note("[流程] 结果 ExecuteMail RESULT_OK")
            Call Note("[流程] 出口 ExecuteMail 分支2 路径条件 MailEmpty()")
            Exit Function
        End If
        If MailClaimable() Then
            Delay 200
            Exit Do
        End If
        Delay 20
    Loop
    Call Progress()
    claimStarted = TickCount()
    Call MailStage("领取邮件奖励")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ExecuteMail 分支3 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MailClaimable() Then
            Call TouchPoint(foundX + 319, foundY - 90, 200)
            Call Progress()
        End If
        If MatchPattern("获得奖励") Then
            Call Note("[流程] 邮件图色命中 获得奖励")
            Call TouchPoint(foundX, foundY, 200)
            Call Progress()
        End If
        If MatchPattern("邮件关闭弹窗") Then
            Call Note("[流程] 邮件图色命中 邮件关闭弹窗")
            Call TouchPoint(foundX, foundY, 200)
            Call Progress()
        End If
        If MailEmpty() Then
            Call Note("[流程] 邮件识别 无奖励状态命中")
            Call Progress()
            Exit Do
        End If
        If TickCount() - claimStarted > 5000 Then
            Call Note("[流程] 出口 ExecuteMail 分支4 路径条件 TickCount() - claimStarted > 5000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 消息邮件模式 0手动跳过 1自动 当前=" & messageMode)
    If messageMode = 1 Then
        Call Note("[流程] 消息邮件 自动模式入口")
        messageResult = ReadMessages()
        If messageResult <> RESULT_OK Then
            Call Note("[流程] 出口 ExecuteMail 分支5 路径条件 messageResult <> RESULT_OK")
            Exit Function
        End If
    End If
    terminalConfirmed = True
    Call MailStage("邮件业务终态确认")
    ExecuteMail = RESULT_OK
    Call Note("[流程] 结果 ExecuteMail RESULT_OK")
    Call Note("[流程] 出口 ExecuteMail 到达函数末尾（不代表任务已提交）")
End Function


// flows/169_领任务奖励/领任务奖励.mq
// Independent MQ implementation of professional root.729 behavior.
Sub RewardStage(value)
    rewardPhase = value
    Call SetStage(value)
End Sub
Function RewardTouch(name, dx, dy, waitMs)
    RewardTouch = False
    If MatchPattern(name) Then
        Call Note("任务169：" & name & "，点击=" & (foundX + dx) & "," & (foundY + dy))
        Call TouchPoint(foundX + dx, foundY + dy, waitMs)
        RewardTouch = True
    End If
End Function
Function RewardGrowthClaimable()
    RewardGrowthClaimable = True
    If MatchPattern("169_成长有奖一") Then
        Exit Function
    End If
    RewardGrowthClaimable = MatchPattern("169_成长有奖二")
End Function
Function RewardGrowthEmpty()
    RewardGrowthEmpty = True
    If MatchPattern("169_成长无奖一") Then
        Exit Function
    End If
    RewardGrowthEmpty = MatchPattern("169_成长无奖二")
End Function
Function RewardDailyClaimable()
    RewardDailyClaimable = True
    If MatchPattern("169_日常有奖一") Then
        Exit Function
    End If
    RewardDailyClaimable = MatchPattern("169_日常有奖二")
End Function
Function RewardDailyEmpty()
    RewardDailyEmpty = True
    If MatchPattern("169_日常无奖一") Then
        Exit Function
    End If
    RewardDailyEmpty = MatchPattern("169_日常无奖二")
End Function
Function RewardPageKnown()
    RewardPageKnown = True
    If RewardGrowthClaimable() Then
        Exit Function
    End If
    If RewardGrowthEmpty() Then
        Exit Function
    End If
    If RewardDailyClaimable() Then
        Exit Function
    End If
    If RewardDailyEmpty() Then
        Exit Function
    End If
    If MatchPattern("169_通行证") Then
        Exit Function
    End If
    If MatchPattern("169_特殊有奖") Then
        Exit Function
    End If
    RewardPageKnown = MatchPattern("169_特殊无奖")
End Function
Function EnterTaskRewards()
    Dim acted
    Call Note("[流程] 入口 EnterTaskRewards")
    EnterTaskRewards = RESULT_TIMEOUT
    Call RewardStage("169进入任务页面")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 EnterTaskRewards 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        acted = RewardTouch("169_入口", 327, 0, 200)
        If RewardPageKnown() Then
            EnterTaskRewards = RESULT_OK
            Call Note("[流程] 结果 EnterTaskRewards RESULT_OK")
            Call Note("[流程] 出口 EnterTaskRewards 分支2 路径条件 RewardPageKnown()")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 EnterTaskRewards 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFirstPass()
    Dim phaseProgress
    Call Note("[流程] 入口 RewardFirstPass")
    RewardFirstPass = RESULT_TIMEOUT
    Call RewardStage("169第一段：成长、日常、特殊")
    phaseProgress = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFirstPass 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        // Independent checks in professional order; no universal popup priority.
        If RewardGrowthClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
            phaseProgress = TickCount()
        End If
        If RewardGrowthEmpty() Then
            Call TouchPoint(foundX - 90, foundY - 977, 50)
            phaseProgress = TickCount()
        End If
        If RewardDailyClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
        End If
        If RewardDailyEmpty() Then
            Delay 50
            RewardFirstPass = RESULT_OK
            Call Note("[流程] 结果 RewardFirstPass RESULT_OK")
            Call Note("[流程] 出口 RewardFirstPass 分支2 路径条件 RewardDailyEmpty()")
            Exit Function
        End If
        If RewardTouch("169_通行证", 179, -1045, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_特殊有奖", 0, 0, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_特殊无奖", -90, -977, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 50) Then
            phaseProgress = TickCount()
        End If
        If TickCount() - phaseProgress > 10000 Then
            Call Note("任务169第一段无进展超时，交公共恢复")
            Call Note("[流程] 出口 RewardFirstPass 分支3 路径条件 TickCount() - phaseProgress > 10000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFirstPass 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFourPositions()
    Dim phaseProgress, positionIndex, dx
    Call Note("[流程] 入口 RewardFourPositions")
    RewardFourPositions = RESULT_TIMEOUT
    Call RewardStage("169第二段：四位置奖励")
    phaseProgress = TickCount()
    positionIndex = 0
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFourPositions 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 200) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗二", 0, 0, 1000) Then
            phaseProgress = TickCount()
        End If
        If RewardDailyEmpty() Then
            dx = -159
            If positionIndex = 1 Then
                dx = -27
            ElseIf positionIndex = 2 Then
                dx = 106
            ElseIf positionIndex = 3 Then
                dx = 234
            End If
            Call Note("任务169四位置，序号=" & (positionIndex + 1))
            Call TouchPoint(foundX + dx, foundY - 875, 1000)
            positionIndex = positionIndex + 1
        End If
        // Original exit precedes the phase timeout check. Four clicks only.
        If positionIndex > 3 Then
            RewardFourPositions = RESULT_OK
            Call Note("[流程] 结果 RewardFourPositions RESULT_OK")
            Call Note("[流程] 出口 RewardFourPositions 分支2 路径条件 positionIndex > 3")
            Exit Function
        End If
        If TickCount() - phaseProgress > 10000 Then
            Call Note("任务169第二段无进展超时，交公共恢复")
            Call Note("[流程] 出口 RewardFourPositions 分支3 路径条件 TickCount() - phaseProgress > 10000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFourPositions 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFinalPass()
    Dim phaseProgress, acted
    Call Note("[流程] 入口 RewardFinalPass")
    RewardFinalPass = RESULT_TIMEOUT
    Call RewardStage("169第三段：确认成长或特殊终态")
    phaseProgress = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFinalPass 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If RewardTouch("169_奖励弹窗二", 0, 0, 1000) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 200) Then
            phaseProgress = TickCount()
        End If
        If RewardDailyEmpty() Then
            Call TouchPoint(foundX + 87, foundY - 977, 50)
        End If
        If RewardGrowthClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
            phaseProgress = TickCount()
        End If
        If RewardGrowthEmpty() Then
            If Not BusinessExpired() Then
                terminalConfirmed = True
                RewardFinalPass = RESULT_OK
                Call Note("[流程] 结果 RewardFinalPass RESULT_OK")
                Call RewardStage("169成长无奖终态已确认")
            End If
            Call Note("[流程] 出口 RewardFinalPass 分支2 路径条件 Not BusinessExpired()")
            Exit Function
        End If
        acted = RewardTouch("169_特殊有奖", 0, 0, 50)
        If MatchPattern("169_特殊无奖") Then
            If Not BusinessExpired() Then
                terminalConfirmed = True
                RewardFinalPass = RESULT_OK
                Call Note("[流程] 结果 RewardFinalPass RESULT_OK")
                Call RewardStage("169特殊无奖终态已确认")
            End If
            Call Note("[流程] 出口 RewardFinalPass 分支3 路径条件 Not BusinessExpired()")
            Exit Function
        End If
        If TickCount() - phaseProgress > 4000 Then
            Call Note("任务169末段无进展超时，未确认终态，交公共恢复")
            Call Note("[流程] 出口 RewardFinalPass 分支4 路径条件 TickCount() - phaseProgress > 4000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFinalPass 到达函数末尾（不代表任务已提交）")
End Function
Function ExecuteTaskRewards()
    Dim result
    Call Note("[流程] 入口 ExecuteTaskRewards")
    ExecuteTaskRewards = RESULT_TIMEOUT
    terminalConfirmed = False
    result = EnterTaskRewards()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支1 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    result = RewardFirstPass()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支2 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    result = RewardFourPositions()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支3 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    ExecuteTaskRewards = RewardFinalPass()
    Call Note("[流程] 出口 ExecuteTaskRewards 到达函数末尾（不代表任务已提交）")
End Function


// flows/167_日常签到/日常签到.mq
Sub SignStage(value)
    signPhase = value
    Call SetStage(value)
End Sub
Sub SignTouch(name, x, y, waitMs)
    Call Note("[签到167] 命中=" & name & " 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function EnterDailySign()
    EnterDailySign = RESULT_TIMEOUT
    Call SignStage("167进入签到中心")
    Call Note("[签到167] 入口 EnterDailySign")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 EnterDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_入口") Then
            Call SignTouch("167_入口", foundX, foundY, 100)
        End If
        If MatchPattern("167_中心页面") Then
            Call SignTouch("167_中心页面", 150, 50, 200)
            If BusinessExpired() Then
                Call Note("[签到167] 出口 EnterDailySign：点击后超时或中断")
                Exit Function
            End If
            EnterDailySign = RESULT_OK
            Call Note("[签到167] 出口 EnterDailySign：中心已识别，进入领取")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ClaimDailySign()
    Dim claimStarted, cumulativeLogged
    ClaimDailySign = RESULT_TIMEOUT
    claimStarted = TickCount()
    cumulativeLogged = False
    Call SignStage("167领取签到奖励")
    Call Note("[签到167] 入口 ClaimDailySign；累计检查门槛大于5000毫秒")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 ClaimDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_领取一") Then
            Call SignTouch("167_领取一", foundX + 5, foundY, 500)
        End If
        If MatchPattern("167_领取二") Then
            Call SignTouch("167_领取二", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_领取三") Then
            Call SignTouch("167_领取三", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_领取四") Then
            Call SignTouch("167_领取四", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_奖励弹窗") Then
            Call SignTouch("167_奖励弹窗", 5, 5, 0)
        End If
        If MatchPattern("167_充值提示") Then
            Call SignTouch("167_充值提示", foundX, foundY, 0)
        End If
        If TickCount() - claimStarted > 5000 Then
            If Not cumulativeLogged Then
                Call Note("[签到167] 累计检查启用；领取起点未刷新")
                cumulativeLogged = True
            End If
            If MatchPattern("167_累计可领") Then
                Call SignTouch("167_累计可领", foundX, foundY, 0)
            End If
            If MatchPattern("167_累计灰色") Then
                If BusinessExpired() Then
                    Call Note("[签到167] 出口 ClaimDailySign：灰色命中时已超时或中断")
                    Exit Function
                End If
                ClaimDailySign = RESULT_OK
                Call Note("[签到167] 出口 ClaimDailySign：累计灰色已确认，等待收尾终态")
                Exit Function
            End If
        End If
        Delay 20
    Loop
End Function
Function FinishDailySign()
    FinishDailySign = RESULT_TIMEOUT
    Call SignStage("167签到收尾确认")
    Call Progress()
    Call Note("[签到167] 入口 FinishDailySign")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 FinishDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_奖励弹窗") Then
            Call SignTouch("167_奖励弹窗收尾", foundX, foundY, 0)
            If BusinessExpired() Then
                Call Note("[签到167] 出口 FinishDailySign：收尾点击后超时或中断")
                Exit Function
            End If
            FinishDailySign = RESULT_OK
            Call Note("[签到167] 出口 FinishDailySign：奖励弹窗终态已处理")
            Exit Function
        End If
        If MatchPattern("167_中心页面") Then
            If BusinessExpired() Then
                Call Note("[签到167] 出口 FinishDailySign：中心命中时超时或中断")
                Exit Function
            End If
            FinishDailySign = RESULT_OK
            Call Note("[签到167] 出口 FinishDailySign：中心页面终态已确认")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteDailySign()
    Dim result
    ExecuteDailySign = RESULT_TIMEOUT
    terminalConfirmed = False
    Call Note("[签到167] 业务入口 ExecuteDailySign")
    result = EnterDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：进入失败，返回超时")
        Exit Function
    End If
    result = ClaimDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：领取未完成，返回超时")
        Exit Function
    End If
    result = FinishDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：收尾未完成，返回超时")
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[签到167] 业务出口：终态提交前超时或中断")
        Exit Function
    End If
    terminalConfirmed = True
    ExecuteDailySign = RESULT_OK
    Call SignStage("167签到业务终态确认")
    Call Note("[签到167] 业务出口：成功；等待公共返回大厅后提交")
End Function


// flows/166_领月卡龙石/领月卡龙石.mq
Sub MonthStage(value)
    monthPhase = value
    Call SetStage(value)
End Sub
Sub MonthTouch(name, x, y, waitMs)
    Call Note("[月卡166] 命中=" & name & " 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function MonthActivityFrame()
    MonthActivityFrame = True
    If MatchPattern("166_活动框一") Then
        Exit Function
    End If
    MonthActivityFrame = MatchPattern("166_活动框二")
End Function
Function MonthHallKnown()
    MonthHallKnown = True
    If MatchPattern("166_大厅识别一") Then
        Exit Function
    End If
    If MatchPattern("166_大厅识别二") Then
        Exit Function
    End If
    MonthHallKnown = MatchPattern("166_大厅识别三")
End Function
Function MonthActivityIcon()
    MonthActivityIcon = True
    If MatchPattern("166_大厅活动入口一") Then
        Exit Function
    End If
    MonthActivityIcon = MatchPattern("166_大厅活动入口二")
End Function
Sub MonthResourcePrompt()
    Dim x, y, text
    If Not monthKeepDownload Then
        If MatchPattern("166_资源下载提示") Then
            x = foundX
            y = foundY
            text = ReadActivityText(100, 395, 317, 448)
            If text = "下载新功能" Then
                Call MonthTouch("166_资源下载提示标题", x, y, 0)
            End If
            text = ReadActivityText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                Call MonthTouch("166_资源下载提示网络", x, y, 0)
            End If
        End If
    End If
End Sub
Function EnterMonthlyActivities()
    Dim initialStarted, enterStarted, text, hallResult
    EnterMonthlyActivities = RESULT_TIMEOUT
    Call MonthStage("166进入活动界面")
    Call Note("[月卡166] 入口 EnterMonthlyActivities")
    initialStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：活动位置检查超时或前台中断")
            Exit Function
        End If
        If MonthActivityFrame() Then
            EnterMonthlyActivities = RESULT_OK
            Call Note("[月卡166] 出口：原活动框已确认")
            Exit Function
        End If
        If TickCount() - initialStarted > 2000 Then
            Exit Do
        End If
        Delay 20
    Loop
    hallResult = ReturnToHall()
    If hallResult <> RESULT_OK Then
        Call Note("[月卡166] 出口：进入活动前返回大厅失败")
        Exit Function
    End If
    enterStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：进入活动业务总超时或前台中断")
            Exit Function
        End If
        Call MonthResourcePrompt()
        If MonthActivityFrame() Then
            EnterMonthlyActivities = RESULT_OK
            Call Note("[月卡166] 出口：专业版当前位置活动框复核成功，进入月卡分页")
            Exit Function
        End If
        text = ReadActivityText(65, 7, 247, 59)
        If text = "活动" Then
            EnterMonthlyActivities = RESULT_OK
            Call Note("[月卡166] 出口：OCR活动标题已确认")
            Exit Function
        Else
            hallResult = ReturnToHall()
            If hallResult <> RESULT_OK Then
                Call Note("[月卡166] 出口：活动标题未成立且公共返回失败")
                Exit Function
            End If
        End If
        If MonthHallKnown() Then
            If MonthActivityIcon() Then
                Call MonthTouch("166_大厅活动入口", foundX, foundY, 1500)
            Else
                hallResult = ReturnToHall()
                If hallResult <> RESULT_OK Then
                    Call Note("[月卡166] 出口：无活动图标且公共返回失败")
                    Exit Function
                End If
            End If
        End If
        Delay 300
        If TickCount() - enterStarted > 60000 Then
            Call Note("[月卡166] 出口：专业版活动入口60秒超时；不提交完成")
            Delay 2000
            Exit Function
        End If
    Loop
End Function
Function FindMonthlyPage()
    Dim searchStarted, lastAction, swipeCount
    FindMonthlyPage = RESULT_TIMEOUT
    searchStarted = TickCount()
    lastAction = TickCount() + 1500
    swipeCount = 0
    monthlySearchDirection = 0
    Call MonthStage("166查找月卡分页")
    Call Note("[月卡166] 入口 FindMonthlyPage，入口限时35秒")
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：分页业务总超时或前台中断")
            Exit Function
        End If
        If monthlySearchDirection < 4 Then
            monthlySearchDirection = monthlySearchDirection + 1
        Else
            monthlySearchDirection = 0
        End If
        If MatchPattern("166_月卡页面") Then
            FindMonthlyPage = RESULT_OK
            Call Note("[月卡166] 出口：月卡页面已确认，搜索方向=" & monthlySearchDirection)
            Exit Function
        End If
        If MonthActivityFrame() Then
            If MatchPattern("166_月卡图标") Then
                Call MonthTouch("166_月卡图标", foundX, foundY, 1500)
                lastAction = TickCount()
            End If
            If TickCount() - lastAction > 1500 Then
                swipeCount = swipeCount + 1
                Call Note("[月卡166] 活动分页滑动序号=" & swipeCount)
                If swipeCount <= 7 Then
                    Call SwipeActivityPage(False)
                Else
                    Call SwipeActivityPage(True)
                    If swipeCount = 14 Then
                        swipeCount = 0
                    End If
                End If
                lastAction = TickCount()
            End If
        End If
        If TickCount() - searchStarted > 35000 Then
            Call Note("[月卡166] 出口：专业版分页35秒超时；不提交完成")
            Delay 2000
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function DetectMonthlyCard()
    Dim detected
    DetectMonthlyCard = RESULT_TIMEOUT
    monthCardType = -1
    Call MonthStage("166识别月卡类型")
    Call Progress()
    Call Note("[月卡166] 入口 DetectMonthlyCard；顺序左卡、右卡、双卡、未购买")
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：卡型未知至总超时或前台中断")
            Exit Function
        End If
        detected = False
        If MatchPattern("166_类型左卡") Then
            monthCardType = 1
            detected = True
        ElseIf MatchPattern("166_类型右卡") Then
            monthCardType = 3
            detected = True
        ElseIf MatchPattern("166_类型双卡") Then
            monthCardType = 2
            detected = True
        ElseIf MatchPattern("166_类型未购买") Then
            monthCardType = 0
            detected = True
        End If
        If detected Then
            Call Note("[月卡166] 卡型=" & monthCardType & "；0未购买 1左卡 2双卡 3右卡；等待1000毫秒")
            Delay 1000
            If BusinessExpired() Then
                Call Note("[月卡166] 出口：卡型等待后总超时或中断")
                Exit Function
            End If
            DetectMonthlyCard = RESULT_OK
            Call Note("[月卡166] 出口：卡型已确认")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Sub MonthClaimPair(name, dx)
    Dim x, y
    If MatchPattern(name) Then
        x = foundX + dx
        y = foundY - 184
        Call MonthTouch(name, x, y, 500)
        Call MonthTouch(name, x, y, 500)
    End If
End Sub
Function ClaimMonthlyStones()
    Dim finished
    ClaimMonthlyStones = RESULT_TIMEOUT
    Call MonthStage("166领取月卡龙石")
    Call Progress()
    Call Note("[月卡166] 入口 ClaimMonthlyStones，卡型=" & monthCardType)
    If monthCardType = 0 Then
        ClaimMonthlyStones = RESULT_OK
        Call Note("[月卡166] 出口：明确未购买，无奖励终态")
        Exit Function
    End If
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：领取总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("166_奖励弹窗") Then
            Call MonthTouch("166_奖励弹窗", foundX, foundY, 0)
        End If
        finished = False
        If monthCardType = 1 Then
            Call MonthClaimPair("166_左卡可领", 63)
            finished = MatchPattern("166_左卡灰色")
        ElseIf monthCardType = 2 Then
            Call MonthClaimPair("166_左卡可领", 63)
            Call MonthClaimPair("166_右卡可领", 410)
            finished = MatchPattern("166_双卡灰色")
        ElseIf monthCardType = 3 Then
            Call MonthClaimPair("166_右卡可领", 410)
            finished = MatchPattern("166_右卡灰色")
        End If
        If finished Then
            If BusinessExpired() Then
                Call Note("[月卡166] 出口：灰色终态命中时总超时或中断")
                Exit Function
            End If
            ClaimMonthlyStones = RESULT_OK
            Call Note("[月卡166] 出口：对应月卡灰色终态确认，卡型=" & monthCardType)
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteMonthlyStones()
    Dim result
    ExecuteMonthlyStones = RESULT_TIMEOUT
    terminalConfirmed = False
    Call Note("[月卡166] 业务入口 ExecuteMonthlyStones")
    result = EnterMonthlyActivities()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：活动入口失败，返回超时")
        Exit Function
    End If
    result = FindMonthlyPage()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：月卡分页失败，返回超时")
        Exit Function
    End If
    result = DetectMonthlyCard()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：卡型未确认，返回超时")
        Exit Function
    End If
    result = ClaimMonthlyStones()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：月卡终态未确认，返回超时")
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[月卡166] 业务出口：终态提交前已超时或中断")
        Exit Function
    End If
    terminalConfirmed = True
    ExecuteMonthlyStones = RESULT_OK
    Call MonthStage("166月卡业务终态确认")
    Call Note("[月卡166] 业务出口：成功，等待公共返回大厅后提交")
End Function


// flows/055_好友体力/好友体力.mq
Sub FriendStage(value)
    friendPhase = value
    Call SetStage(value)
End Sub
Function FriendTap(x, y, waitMs)
    FriendTap = False
    // Public foreground grace remains five seconds; never count a skipped click.
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Exit Function
    End If
    Call Note("[好友体力55] 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    If Not BusinessExpired() Then
        FriendTap = True
    End If
End Function
Function ExecuteFriendEnergy()
    Dim enteredAt, anchorX, anchorY, firstGroup
    ExecuteFriendEnergy = RESULT_TIMEOUT
    terminalConfirmed = False
    enteredAt = TickCount()
    firstGroup = True
    Call FriendStage("好友体力55进入")
    Call Note("[好友体力55] 入口 root.707 全屏多点找色 方向1 相似度0.9；进入限时10000毫秒")
    Do
        If BusinessExpired() Then
            Call Note("[好友体力55] 进入出口：公共超时或前台中断，保留原任务")
            Exit Function
        End If
        If MatchPattern("055_大厅入口锚点") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[好友体力55] 命中大厅锚点=" & anchorX & "," & anchorY & " 区域0,0,719,1279 偏移538,-28")
            If Not FriendTap(anchorX + 538, anchorY - 28, 1000) Then
                Exit Function
            End If
        End If
        If MatchPattern("055_好友页面") Then
            Call Note("[好友体力55] 进入好友页面确认；每组重新找色，同组沿用锚点")
            Exit Do
        End If
        If TickCount() - enteredAt > 10000 Then
            Call Note("[好友体力55] 进入超时出口：未确认好友页，不提交，交公共恢复原任务")
            Exit Function
        End If
        Delay 20
    Loop
    Call FriendStage("好友体力55第一组")
    Do
        If BusinessExpired() Then
            Call Note("[好友体力55] 动作出口：公共超时或前台中断，保留原任务")
            Exit Function
        End If
        If MatchPattern("055_好友页面") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[好友体力55] 命中好友页面=" & anchorX & "," & anchorY & " 区域0,0,719,1279")
            If firstGroup Then
                Call Note("[好友体力55] 第一组 偏移250,-110 双点击 等待500/1000毫秒")
                If Not FriendTap(anchorX + 250, anchorY - 110, 500) Then
                    Exit Function
                End If
                If Not FriendTap(anchorX + 250, anchorY - 110, 1000) Then
                    Exit Function
                End If
                firstGroup = False
                Call FriendStage("好友体力55第二组")
            Else
                Call Note("[好友体力55] 第二组 偏移460,-110 双点击 等待500/0毫秒")
                If Not FriendTap(anchorX + 460, anchorY - 110, 500) Then
                    Exit Function
                End If
                If Not FriendTap(anchorX + 460, anchorY - 110, 0) Then
                    Exit Function
                End If
                terminalConfirmed = True
                Call FriendStage("好友体力55待返回大厅")
                Call Note("[好友体力55] 业务出口成功：两组双点击完成，按用户确认终态；等待公共返回大厅连续确认后提交")
                ExecuteFriendEnergy = RESULT_OK
                Exit Function
            End If
        Else
            Delay 20
        End If
    Loop
End Function


// flows/056_Q友体力/Q友体力.mq
Sub QFriendStage(value)
    qfriendPhase = value
    Call SetStage(value)
    Call Note("[Q友体力56] 当前阶段=" & value)
End Sub
Function QFriendTap(x, y, waitMs)
    QFriendTap = False
    // Public foreground grace remains five seconds; never count a skipped click.
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Call Note("[Q友体力56] 点击出口=前台等待期间公共超时或中断，保留56恢复")
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[Q友体力56] 点击出口=动作前公共超时或中断，未执行点击")
        Exit Function
    End If
    Call Note("[Q友体力56] 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    If Not BusinessExpired() Then
        QFriendTap = True
    Else
        Call Note("[Q友体力56] 点击出口=动作等待期间公共超时或中断，不计为完成")
    End If
End Function
Function QFriendMatch(name)
    Dim matched
    matched = MatchPattern(name)
    QFriendMatch = matched
    If matched Then
        Call Note("[Q友体力56] 命中模板=" & name & " 搜索区域=0,0,719,1279 相似度=0.9 方向=1 锚点=" & foundX & "," & foundY)
    End If
End Function
Function ExecuteQQFriendStamina()
    Dim entryProgress, lastClaim, lastScroll, actionStarted, scrollCount, claimRun, scrollLocked, anchorX, anchorY, text, lastText, idleMs
    ExecuteQQFriendStamina = RESULT_TIMEOUT
    terminalConfirmed = False
    qfriendTerminal = False
    entryProgress = TickCount()
    Call QFriendStage("Q友体力56进入")
    If qfriendOneClick Then
        Call Note("[Q友体力56] 业务入口；一键领取配置=开启")
    Else
        Call Note("[Q友体力56] 业务入口；一键领取配置=关闭")
    End If
    Do
        If BusinessExpired() Then
            Call Note("[Q友体力56] 超时阶段=进入；公共超时或前台中断，等待公共恢复56")
            Exit Function
        End If
        If QFriendMatch("056_大厅入口") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[Q友体力56] 点击偏移=538,-28")
            If Not QFriendTap(anchorX + 538, anchorY - 28, 1000) Then
                Exit Function
            End If
            entryProgress = TickCount()
        End If
        If QFriendMatch("056_游戏好友页") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[Q友体力56] 切换QQ好友页签 点击偏移=10,-1046 等待毫秒=0")
            If Not QFriendTap(anchorX + 10, anchorY - 1046, 0) Then
                Exit Function
            End If
        End If
        If QFriendMatch("056_Q友页面") Then
            Call Note("[Q友体力56] Q友页面确认 等待毫秒=6000")
            // Reuse interruptible wait in public TouchPoint only for clicks; this is an explicit source Delay.
            Delay 6000
            Exit Do
        End If
        If TickCount() - entryProgress > 20000 Then
            Call Note("[Q友体力56] 失败原因=进入20秒无进展；不沿用原版标完成，交公共超时恢复")
            Exit Function
        End If
        Delay 20
    Loop
    actionStarted = TickCount()
    lastScroll = actionStarted
    Call QFriendStage("Q友体力56第一组")
    Do
        If BusinessExpired() Then
            Call Note("[Q友体力56] 超时阶段=第一组；公共超时或前台中断")
            Exit Function
        End If
        If QFriendMatch("056_Q友页面") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[Q友体力56] 第一组双点击 点击偏移=250,-110 等待毫秒=500/1000；不作为已赠送画面证明")
            If Not QFriendTap(anchorX + 250, anchorY - 110, 500) Then
                Exit Function
            End If
            If Not QFriendTap(anchorX + 250, anchorY - 110, 1000) Then
                Exit Function
            End If
            Exit Do
        End If
        Delay 20
    Loop
    lastClaim = entryProgress
    scrollCount = 0
    claimRun = 0
    scrollLocked = True
    lastText = "<未识别>"
    Call QFriendStage("Q友体力56领取")
    Do
        If BusinessExpired() Then
            Call Note("[Q友体力56] 超时阶段=领取；公共超时或前台中断，保留56")
            Exit Function
        End If
        If qfriendOneClick Then
            If QFriendMatch("056_Q友页面") Then
                anchorX = foundX
                anchorY = foundY
                Call Note("[Q友体力56] 一键领取 点击偏移=460,-110 等待毫秒=500/0")
                If Not QFriendTap(anchorX + 460, anchorY - 110, 500) Then
                    Exit Function
                End If
                If Not QFriendTap(anchorX + 460, anchorY - 110, 0) Then
                    Exit Function
                End If
                Call Note("[Q友体力56] 业务终态确认=用户批准的批量双点击完成；等待公共返回大厅")
                Exit Do
            End If
        Else
            If TickCount() - lastScroll > 2000 And Not scrollLocked Then
                If QFriendMatch("056_Q友页面") Then
                    anchorX = foundX
                    anchorY = foundY
                    If Not Sys.AppIsFront(GAME_PACKAGE) Then
                        Call Note("[Q友体力56] 滚动暂停：游戏不在前台")
                    Else
                        ReleaseCapture
                        If scrollCount < 10 Then
                            Call Note("[Q友体力56] 向上滚动 偏移250,-200到250,-580 时长200 等待1000")
                            Swipe anchorX + 250, anchorY - 200, anchorX + 250, anchorY - 580, 200
                            Delay 1000
                        ElseIf scrollCount < 20 Then
                            Call Note("[Q友体力56] 向下滚动 偏移250,-580到250,-200 时长200 等待1000")
                            Swipe anchorX + 250, anchorY - 580, anchorX + 250, anchorY - 200, 200
                            Delay 1000
                        Else
                            scrollCount = 0
                        End If
                        scrollCount = scrollCount + 1
                        claimRun = 0
                        Call Progress()
                    End If
                End If
                lastScroll = TickCount()
            End If
            If QFriendMatch("056_单项领取") Then
                anchorX = foundX
                anchorY = foundY
                Call Note("[Q友体力56] 单项领取 点击偏移=0,0 等待毫秒=500")
                If Not QFriendTap(anchorX, anchorY, 500) Then
                    Exit Function
                End If
                lastClaim = TickCount()
                lastScroll = TickCount()
                claimRun = claimRun + 1
                Call Progress()
            End If
            If QFriendMatch("056_Q友页面") Then
                ReleaseCapture
                text = Image.OcrText(555, 215, 623, 248, 0, 0)
                If IsNull(text) Then
                    text = ""
                End If
                If text <> lastText Then
                    Call Note("[Q友体力56] OCR 搜索区域=555,215,623,248 参数0 文本=" & text)
                    lastText = text
                End If
                If text = "60/60" Or text = "6060" Then
                    If Not BusinessExpired() Then
                        Call Note("[Q友体力56] 业务终态确认=Q友页OCR满额；等待公共返回大厅")
                        Exit Do
                    End If
                End If
            End If
            idleMs = TickCount() - lastClaim
            If idleMs > 2000 And idleMs <= 20000 Then
                scrollLocked = False
            ElseIf idleMs > 30000 Then
                Call Note("[Q友体力56] 失败原因=30秒无领取进展且未确认OCR终态；交公共恢复56")
                Exit Function
            End If
            If TickCount() - actionStarted > 180000 Or claimRun > 10 Then
                Call Note("[Q友体力56] 失败原因=专业版操作保护出口，未确认终态；交公共恢复56")
                Exit Function
            End If
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[Q友体力56] 终态提交前公共超时或前台中断，不返回成功")
        Exit Function
    End If
    qfriendTerminal = True
    terminalConfirmed = True
    Call QFriendStage("Q友体力56待返回大厅")
    ExecuteQQFriendStamina = RESULT_OK
    Call Note("[Q友体力56] 业务出口=成功；尚未提交完成次数")
End Function


// flows/050_定时领取体力/定时领取体力.mq
Sub TimedStage(value)
    staminaPhase = value
    Call SetTimedStaminaPhase(currentTask, value)
    Call SetStage(value)
End Sub
Sub TimedTouch(name, x, y, waitMs)
    Call Note("[定时体力] 命中=" & name & " 点击=" & x & "," & y & " 点击偏移=0,0 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function TimedActivityFrame()
    TimedActivityFrame = True
    If StaminaMatch("050_活动框一") Then
        Exit Function
    End If
    TimedActivityFrame = StaminaMatch("050_活动框二")
End Function
Function TimedHallKnown()
    TimedHallKnown = True
    If StaminaMatch("050_大厅识别一") Then
        Exit Function
    End If
    If StaminaMatch("050_大厅识别二") Then
        Exit Function
    End If
    TimedHallKnown = StaminaMatch("050_大厅识别三")
End Function
Function TimedActivityIcon()
    TimedActivityIcon = True
    If StaminaMatch("050_大厅活动入口一") Then
        Exit Function
    End If
    TimedActivityIcon = StaminaMatch("050_大厅活动入口二")
End Function
Sub TimedResourcePrompt()
    Dim x, y, text
    If Not staminaKeepDownload Then
        If StaminaMatch("050_资源下载提示") Then
            x = foundX
            y = foundY
            text = ReadActivityText(100, 395, 317, 448)
            If text = "下载新功能" Then
                Call TimedTouch("050_资源下载提示标题", x, y, 0)
            End If
            text = ReadActivityText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                Call TimedTouch("050_资源下载提示网络", x, y, 0)
            End If
        End If
    End If
End Sub
Function EnterTimedActivities()
    Dim initialStarted, enterStarted, text, hallResult
    EnterTimedActivities = RESULT_TIMEOUT
    Call TimedStage("定时体力进入活动")
    Call Note("[定时体力] 入口 EnterTimedActivities")
    initialStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 出口：活动位置检查超时或前台中断")
            Exit Function
        End If
        If TimedActivityFrame() Then
            EnterTimedActivities = RESULT_OK
            Call Note("[定时体力] 出口：原活动框已确认")
            Exit Function
        End If
        If TickCount() - initialStarted > 2000 Then
            Exit Do
        End If
        Delay 20
    Loop
    hallResult = ReturnToHall()
    If hallResult <> RESULT_OK Then
        Call Note("[定时体力] 出口：进入活动前返回大厅失败")
        Exit Function
    End If
    enterStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 出口：进入活动业务总超时或前台中断")
            Exit Function
        End If
        Call TimedResourcePrompt()
        If TimedActivityFrame() Then
            EnterTimedActivities = RESULT_OK
            Call Note("[定时体力] 出口：专业版当前位置活动框复核成功，进入体力分页")
            Exit Function
        End If
        text = ReadActivityText(65, 7, 247, 59)
        If text = "活动" Then
            EnterTimedActivities = RESULT_OK
            Call Note("[定时体力] 出口：OCR活动标题已确认")
            Exit Function
        Else
            hallResult = ReturnToHall()
            If hallResult <> RESULT_OK Then
                Call Note("[定时体力] 出口：活动标题未成立且公共返回失败")
                Exit Function
            End If
        End If
        If TimedHallKnown() Then
            If TimedActivityIcon() Then
                Call TimedTouch("050_大厅活动入口", foundX, foundY, 1500)
            Else
                hallResult = ReturnToHall()
                If hallResult <> RESULT_OK Then
                    Call Note("[定时体力] 出口：无活动图标且公共返回失败")
                    Exit Function
                End If
            End If
        End If
        Delay 300
        If TickCount() - enterStarted > 60000 Then
            Call Note("[定时体力] 出口：专业版活动入口60秒超时；不提交完成")
            Delay 2000
            Exit Function
        End If
    Loop
End Function
Function StaminaMatch(name)
    Dim matched
    matched = MatchPattern(name)
    StaminaMatch = matched
    If matched Then
        Call Note("[定时体力] 编号=" & currentTask & " 阶段=" & staminaPhase & " 命中模板=" & name & " 搜索区域=见图色登记 锚点=" & foundX & "," & foundY)
    End If
End Function
Function StaminaTap(x, y, waitMs)
    StaminaTap = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Call Note("[定时体力] 失败原因=动作前等待前台时超时或中断；未提交")
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[定时体力] 失败原因=动作前公共超时或中断；未提交")
        Exit Function
    End If
    Call Note("[定时体力] 编号=" & currentTask & " 点击坐标=" & x & "," & y & " 点击偏移=0,0（模板锚点或已记录的固定坐标） 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    StaminaTap = Not BusinessExpired()
End Function
Function StaminaSlotName(slot)
    StaminaSlotName = "晚上"
    If slot = 1 Then
        StaminaSlotName = "上午"
    ElseIf slot = 2 Then
        StaminaSlotName = "中午"
    ElseIf slot = 3 Then
        StaminaSlotName = "下午"
    End If
End Function
Function EnterTimedStaminaPage()
    Dim started, lastAction, swipeCount, direction, name
    EnterTimedStaminaPage = RESULT_TIMEOUT
    If EnterTimedActivities() <> RESULT_OK Then
        Call Note("[定时体力] 失败原因=公共活动入口未确认")
        Exit Function
    End If
    started = TickCount()
    lastAction = TickCount() + 1500
    swipeCount = 0
    direction = 0
    Call TimedStage("定时体力查找分页")
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=查找分页公共超时或前台中断")
            Exit Function
        End If
        If direction < 4 Then
            direction = direction + 1
        Else
            direction = 0
        End If
        If StaminaMatch("050_体力页面一") Then
            EnterTimedStaminaPage = RESULT_OK
            Exit Function
        End If
        If StaminaMatch("050_体力页面二") Then
            EnterTimedStaminaPage = RESULT_OK
            Exit Function
        End If
        If TimedActivityFrame() Then
            If StaminaMatch("050_体力图标") Then
                If Not StaminaTap(foundX, foundY, 1500) Then
                    Exit Function
                End If
                lastAction = TickCount()
            End If
            If TickCount() - lastAction > 1500 Then
                swipeCount = swipeCount + 1
                Call Note("[定时体力] 分页滑动序号=" & swipeCount & " 专业版辅助搜索方向=" & direction)
                If swipeCount <= 7 Then
                    Call SwipeActivityPage(False)
                Else
                    Call SwipeActivityPage(True)
                    If swipeCount = 14 Then
                        swipeCount = 0
                    End If
                End If
                lastAction = TickCount()
            End If
        End If
        If TickCount() - started > 35000 Then
            Call Note("[定时体力] 超时原因=分页查找超过35000毫秒 等待2000后公共恢复")
            Delay 2000
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function DetectStaminaSlot(slot)
    Dim prefix, name
    DetectStaminaSlot = RESULT_TIMEOUT
    prefix = "050_" & StaminaSlotName(slot)
    Call TimedStage(prefix)
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=初始时段状态未知；未提交完成")
            Exit Function
        End If
        name = prefix & "已领"
        If StaminaMatch(name) Then
            Call Note("[定时体力] 初始状态=已领取；不是最终完成提交")
            Delay 200
            DetectStaminaSlot = RESULT_OK
            Exit Function
        End If
        name = prefix & "可补"
        If StaminaMatch(name) Then
            Call Note("[定时体力] 初始状态=可补领")
            Delay 200
            DetectStaminaSlot = RESULT_OK
            Exit Function
        End If
        name = prefix & "可领"
        If StaminaMatch(name) Then
            Call Note("[定时体力] 初始状态=免费未领取")
            Delay 200
            DetectStaminaSlot = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ClaimTimedStamina(slot)
    Dim actionSlot, name, prefix, terminalName
    ClaimTimedStamina = RESULT_TIMEOUT
    terminalName = "050_" & StaminaSlotName(slot) & "已领"
    If staminaGem Then
        If slot = 2 Then
            terminalName = "050_前两档已领"
        ElseIf slot = 3 Then
            terminalName = "050_前三档已领"
        ElseIf slot = 4 Then
            terminalName = "050_四档已领"
        End If
    End If
    Call TimedStage("定时体力领取与补领")
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=领取未确认已领终态；未提交完成")
            Exit Function
        End If
        actionSlot = slot
        If staminaGem Then
            actionSlot = 1
        End If
        Do While actionSlot <= slot
            prefix = "050_" & StaminaSlotName(actionSlot)
            name = prefix & "可领"
            If StaminaMatch(name) Then
                If Not StaminaTap(foundX, foundY, 200) Then
                    Exit Function
                End If
            End If
            If staminaGem Then
                name = prefix & "可补"
                If StaminaMatch(name) Then
                    If Not StaminaTap(foundX, foundY, 200) Then
                        Exit Function
                    End If
                End If
            End If
            actionSlot = actionSlot + 1
        Loop
        If StaminaMatch(terminalName) Then
            Call Note("[定时体力] 领取正常终态=" & terminalName & " 等待毫秒=200；已领取或已无本档奖励")
            Delay 200
            ClaimTimedStamina = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function TimedStaminaExtras()
    Dim started, phase, text, attempt, balance
    TimedStaminaExtras = RESULT_TIMEOUT
    If Not staminaRecover And Not staminaExchange Then
        TimedStaminaExtras = RESULT_OK
        Exit Function
    End If
    Call TimedStage("定时体力追回兑换")
    started = TickCount()
    phase = 0
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=追回兑换公共超时或前台中断")
            Exit Function
        End If
        If StaminaMatch("050_追回入口") Then
            Call Note("[定时体力] 固定点击追回入口630,260")
            If Not StaminaTap(630, 260, 1000) Then
                Exit Function
            End If
        End If
        If phase = 0 Then
            If staminaRecover Then
                If StaminaMatch("050_追回灰色") Then
                    Call Note("[定时体力] 追回灰色，进入兑换阶段")
                    phase = 1
                End If
                If StaminaMatch("050_追回可用") Then
                    If Not StaminaTap(570, 400, 1000) Then
                        Exit Function
                    End If
                End If
                If StaminaMatch("050_追回确认") Then
                    ReleaseCapture
                    text = Image.OcrText(141, 543, 564, 651, 0, 0)
                    If IsNull(text) Then
                        text = ""
                    End If
                    Call Note("[定时体力] 追回确认OCR 区域141,543,564,651 关键词是否消耗/5日内未 模糊 文本=" & text)
                    If InStr(1, text, "是否消耗") > 0 Or InStr(1, text, "5日内未") > 0 Then
                        If Not StaminaTap(440, 785, 1000) Then
                            Exit Function
                        End If
                        phase = 1
                    End If
                End If
            Else
                phase = 1
            End If
        ElseIf phase = 1 Then
            If staminaExchange Then
                If StaminaMatch("050_兑换弹窗") Then
                    If Not StaminaTap(612, 650, 1000) Then
                        Exit Function
                    End If
                    If Not StaminaTap(412, 750, 1000) Then
                        Exit Function
                    End If
                    If Not StaminaTap(412, 750, 1000) Then
                        Exit Function
                    End If
                    TimedStaminaExtras = RESULT_OK
                    Call Note("[定时体力] 兑换正常出口=专业版特殊弹窗三次点击完成")
                    Exit Function
                End If
                If StaminaMatch("050_兑换灰色") Then
                    TimedStaminaExtras = RESULT_OK
                    Call Note("[定时体力] 兑换正常出口=灰色不可兑换")
                    Exit Function
                End If
                If StaminaMatch("050_兑换可用") Then
                    attempt = 1
                    Do While attempt <= 2
                        ReleaseCapture
                        text = Image.OcrText(95, 262, 184, 294, 2, 0)
                        If IsNull(text) Then
                            text = ""
                        End If
                        Call Note("[定时体力] 兑换余额OCR 区域95,262,184,294 参数2 次数=" & attempt & " 文本=" & text)
                        If IsNumeric(text) Then
                            balance = Int(CDbl(text))
                            If balance >= 40 Then
                                If Not StaminaTap(570, 777, 1000) Then
                                    Exit Function
                                End If
                                Exit Do
                            Else
                                TimedStaminaExtras = RESULT_OK
                                Call Note("[定时体力] 兑换正常出口=已识别余额不足40")
                                Exit Function
                            End If
                        End If
                        Delay 500
                        attempt = attempt + 1
                    Loop
                End If
            Else
                TimedStaminaExtras = RESULT_OK
                Call Note("[定时体力] 可选追回流程完成，兑换关闭")
                Exit Function
            End If
        End If
        If TickCount() - started > 15000 Then
            Call Note("[定时体力] 超时原因=追回兑换15000毫秒保护出口，未确认终态，不提交")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteTimedStamina(taskId)
    Dim slot, checkSlot, result
    ExecuteTimedStamina = RESULT_TIMEOUT
    terminalConfirmed = False
    staminaTerminal = False
    slot = taskId - 49
    If slot = 5 Then
        slot = 4
    End If
    Call Note("[定时体力] 业务入口 名称=" & StaminaName(taskId) & " 编号=" & taskId & " 开始时间Unix=" & Time())
    result = EnterTimedStaminaPage()
    If result <> RESULT_OK Then
        Call Note("[定时体力] 失败或超时原因=进入体力页面失败，等待公共恢复原任务；未提交")
        Exit Function
    End If
    checkSlot = 1
    Do While checkSlot <= slot
        If DetectStaminaSlot(checkSlot) <> RESULT_OK Then
            Exit Function
        End If
        Call Progress()
        checkSlot = checkSlot + 1
    Loop
    Call Note("[定时体力] 初始状态确认完成 等待毫秒=3000")
    Delay 3000
    Call Progress()
    If ClaimTimedStamina(slot) <> RESULT_OK Then
        Exit Function
    End If
    If TimedStaminaExtras() <> RESULT_OK Then
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[定时体力] 终态出口前公共超时或中断，未提交完成")
        Exit Function
    End If
    staminaTerminal = True
    terminalConfirmed = True
    ExecuteTimedStamina = RESULT_OK
    Call TimedStage("定时体力业务终态确认")
    Call Note("[定时体力] 正常终态确认；等待公共返回大厅与连续确认，是否提交完成=否")
End Function


// flows/151_悟空的冒险/悟空的冒险.mq
Sub WukongStage(value)
    wukongPhase = value
    wukongLastMatch = ""
    Call SetStage(value)
    Call Note("[悟空的冒险151] 当前阶段=" & value)
End Sub
Function WukongMatch(name)
    Dim matched, token
    matched = MatchPattern(name)
    WukongMatch = matched
    If matched Then
        token = name & ":" & foundX & "," & foundY
        If token <> wukongLastMatch Then
        Call Note("[悟空的冒险151] 命中模板=" & name & " 区域=见151图色登记 相似度0.9 锚点=" & foundX & "," & foundY)
            wukongLastMatch = token
        End If
    End If
End Function
Function WukongTap(x, y, waitMs)
    WukongTap = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Call Note("[悟空的冒险151] 失败原因=等待游戏前台时公共超时或中断；未提交")
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[悟空的冒险151] 失败原因=动作前公共超时或中断；未提交")
        Exit Function
    End If
    Call Note("[悟空的冒险151] 点击坐标=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    WukongTap = Not BusinessExpired()
End Function
Function WukongAction(name, waitMs)
    WukongAction = False
    If WukongMatch(name) Then
        Call Note("[悟空的冒险151] 点击偏移=0,0")
        WukongAction = WukongTap(foundX, foundY, waitMs)
    End If
End Function
Function WukongSwipe(x1, y1, x2, y2, duration, waitMs)
    WukongSwipe = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Exit Function
    End If
    ReleaseCapture
    Call Note("[悟空的冒险151] 固定滑动=" & x1 & "," & y1 & "到" & x2 & "," & y2 & " 时长=" & duration & " 等待毫秒=" & waitMs)
    Swipe x1, y1, x2, y2, duration
    Delay waitMs
    WukongSwipe = Not BusinessExpired()
End Function
Function WukongReadText(x1, y1, x2, y2)
    Dim text, token
    ReleaseCapture
    text = Image.OcrText(x1, y1, x2, y2, 0, 0)
    If IsNull(text) Then
        text = ""
    End If
    token = x1 & "," & y1 & "," & x2 & "," & y2 & ":" & text
    If token <> wukongLastOcr Then
    Call Note("[悟空的冒险151] OCR区域=" & x1 & "," & y1 & "," & x2 & "," & y2 & " 文本=" & text)
        wukongLastOcr = token
    End If
    WukongReadText = text
End Function
Sub WukongResourcePrompt()
    Dim x, y, text, clicked
    If Not wukongKeepDownload Then
        If WukongMatch("151_资源下载提示") Then
            x = foundX
            y = foundY
            text = WukongReadText(100, 395, 317, 448)
            If text = "下载新功能" Then
                Call Note("[悟空的冒险151] 资源下载提示 点击偏移=0,0")
                clicked = WukongTap(x, y, 0)
            End If
            text = WukongReadText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                clicked = WukongTap(x, y, 0)
            End If
        End If
    End If
End Sub
Function WukongEntryReached()
    WukongEntryReached = True
    If WukongMatch("151_入口已到一") Then
        Exit Function
    End If
    If WukongMatch("151_入口已到二") Then
        Exit Function
    End If
    WukongEntryReached = WukongMatch("151_隐藏界面")
End Function
Function WukongHallKnown()
    WukongHallKnown = True
    If WukongMatch("151_大厅条件一") Then
        Exit Function
    End If
    If WukongMatch("151_大厅条件二") Then
        Exit Function
    End If
    WukongHallKnown = WukongMatch("151_大厅底部条件")
End Function
Function WukongHallIcon()
    WukongHallIcon = True
    If WukongMatch("151_大厅入口一") Then
        Exit Function
    End If
    WukongHallIcon = WukongMatch("151_大厅入口二")
End Function
Function EnterWukongAdventure()
    Dim started, misses, x, y, result
    EnterWukongAdventure = RESULT_TIMEOUT
    started = TickCount()
    misses = 0
    Call WukongStage("151大厅入口")
    Do
        If BusinessExpired() Then
            Call Note("[悟空的冒险151] 超时原因=大厅入口公共超时或前台中断")
            Exit Function
        End If
        Call WukongResourcePrompt()
        If WukongEntryReached() Then
            EnterWukongAdventure = RESULT_OK
            Exit Function
        ElseIf misses > 10 Then
            result = ReturnToHall()
            Call Note("[悟空的冒险151] 入口补救返回大厅结果=" & result)
            If result <> RESULT_OK Then
                Exit Function
            End If
            misses = 0
        Else
            misses = misses + 1
        End If
        If WukongHallKnown() Then
            If WukongHallIcon() Then
                x = foundX
                y = foundY
                Call Note("[悟空的冒险151] 大厅入口点击偏移=160,-60")
                If Not WukongTap(x + 160, y - 60, 1500) Then
                    Exit Function
                End If
                misses = 0
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Call Note("[悟空的冒险151] 大厅无入口时返回失败，未提交")
                    Exit Function
                End If
                If Not WukongSwipe(150, 545, 500, 545, 300, 0) Then
                    Exit Function
                End If
            End If
        End If
        Delay 300
        If TickCount() - started > 60000 Then
            Call Note("[悟空的冒险151] 超时原因=专业版大厅入口60秒，等待2000后恢复原151，不沿用标完成")
            Delay 2000
            Exit Function
        End If
    Loop
End Function
Function DetectWukongMode()
    Dim checkedAt, oldAttempts, text
    // Internal mode: 0 timeout, 1 sweep, 2 hidden, 3 explicit terminal.
    DetectWukongMode = 0
    Call WukongStage("151确认冒险界面")
    Do
        If BusinessExpired() Then
            Call Note("[悟空的冒险151] 超时原因=业务页面确认未知或前台中断")
            Exit Function
        End If
        Call WukongResourcePrompt()
        If WukongMatch("151_冒险主界面") Then
            Call Note("[悟空的冒险151] 主页面确认 等待毫秒=2000")
            Delay 2000
            Exit Do
        End If
        If WukongMatch("151_隐藏界面") Then
            Exit Do
        End If
        If WukongMatch("151_过场") Then
            Call Note("[悟空的冒险151] 过场固定点击150,50")
            If Not WukongTap(150, 50, 200) Then
                Exit Function
            End If
        End If
        Delay 20
    Loop
    Call Progress()
    checkedAt = TickCount()
    oldAttempts = 0
    Call WukongStage("151扫荡资格与旧关回退")
    Do
        If BusinessExpired() Then
            Call Note("[悟空的冒险151] 超时原因=扫荡资格未知或前台中断")
            Exit Function
        End If
        If WukongMatch("151_可扫荡") Then
            Delay 500
            DetectWukongMode = 1
            Exit Function
        End If
        If WukongMatch("151_隐藏界面") Then
            DetectWukongMode = 2
            Exit Function
        End If
        If WukongMatch("151_过场") Then
            If Not WukongTap(150, 50, 200) Then
                Exit Function
            End If
        End If
        If WukongMatch("151_冒险主界面") Then
            text = WukongReadText(361, 814, 654, 848)

            If InStr(1, text, "度") > 0 Or InStr(1, text, "通关") > 0 Then
                If wukongSweep <> 1 Or oldAttempts > 5 Then
                    Delay 2000
                    wukongTerminalReason = "专业版已确认当前不可扫荡；不回退或旧关回退已结束"
                    DetectWukongMode = 3
                    Exit Function
                ElseIf oldAttempts = 1 Or oldAttempts = 2 Then
                    If Not WukongSwipe(70, 150, 342, 152, 2000, 500) Then
                        Exit Function
                    End If
                    oldAttempts = oldAttempts + 1
                Else
                    Call Note("[悟空的冒险151] 旧关回退固定点击70,150")
                    If Not WukongTap(70, 150, 2000) Then
                        Exit Function
                    End If
                    oldAttempts = oldAttempts + 1
                End If
            End If
        End If
        If TickCount() - checkedAt > 2000 Then
            If WukongMatch("151_扫荡灰色") Then
                Delay 500
                wukongTerminalReason = "专业版扫荡资格阶段明确灰色终态"
                DetectWukongMode = 3
                Exit Function
            End If
        End If
        Delay 20
    Loop
End Function
Function SweepWukongAdventure()
    Dim lastAction, grayCount
    SweepWukongAdventure = 0
    lastAction = TickCount()
    grayCount = 0
    Call WukongStage("151扫荡")
    Do
        If BusinessExpired() Then
            Call Note("[悟空的冒险151] 超时原因=扫荡公共超时或前台中断")
            Exit Function
        End If
        If TickCount() - lastAction > 30000 Then
            Call Note("[悟空的冒险151] 超时原因=扫荡30秒无动作进展；未提交，恢复151")
            Exit Function
        End If
        If WukongMatch("151_可扫荡") Then
            Call Note("[悟空的冒险151] 扫荡固定点击567,800")
            If Not WukongTap(567, 800, 500) Then
                Exit Function
            End If
            lastAction = TickCount()
        End If
        If WukongAction("151_下一步", 500) Then
            lastAction = TickCount()
        End If
        If WukongAction("151_扫荡确认", 1500) Then
            lastAction = TickCount()
        End If
        If WukongMatch("151_隐藏界面") Then
            SweepWukongAdventure = 2
            Exit Function
        End If
        If TickCount() - lastAction > 2000 Then
            If WukongMatch("151_扫荡灰色") Then
                Delay 500
                grayCount = grayCount + 1
                Call Note("[悟空的冒险151] 扫荡灰色终态累计=" & grayCount)
            End If
        End If
        If grayCount > 1 Then
            wukongTerminalReason = "专业版扫荡阶段累计两次灰色终态"
            SweepWukongAdventure = 3
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function CollectWukongAdventure()
    Dim started, grayCount, firstClaim, acted, x, y
    CollectWukongAdventure = RESULT_TIMEOUT
    started = TickCount()
    grayCount = 0
    firstClaim = True
    Call WukongStage("151隐藏收集")
    Do
        If BusinessExpired() Then
            Call Note("[悟空的冒险151] 超时原因=隐藏收集公共超时或前台中断，未提交")
            Exit Function
        End If
        acted = WukongAction("151_极品1", 1700)
        acted = WukongAction("151_极品2", 1700)
        acted = WukongAction("151_极品3", 1700)
        acted = WukongAction("151_极品4", 1700)
        acted = WukongAction("151_极品5", 1700)
        If wukongHidden = 1 Then
            acted = WukongAction("151_上品1", 1700)
            acted = WukongAction("151_上品2", 1700)
            acted = WukongAction("151_上品3", 1700)
            acted = WukongAction("151_上品4", 1700)
        End If
        acted = WukongAction("151_隐藏界面", 0)
        acted = WukongAction("151_返回弹窗一", 500)
        If Not acted Then
            acted = WukongAction("151_返回弹窗二", 500)
        End If
        If firstClaim Then
            If WukongMatch("151_隐藏领取") Then
                x = foundX
                y = foundY
                Call Note("[悟空的冒险151] 隐藏领取沿用同一锚点 点击偏移=0,0 三次等待200/200/200")
                If Not WukongTap(x, y, 200) Then
                    Exit Function
                End If
                If Not WukongTap(x, y, 200) Then
                    Exit Function
                End If
                If Not WukongTap(x, y, 200) Then
                    Exit Function
                End If
                firstClaim = False
            End If
        End If
        If TickCount() - started > 4000 Then
            If WukongMatch("151_扫荡灰色") Then
                Delay 500
                grayCount = grayCount + 1
                Call Note("[悟空的冒险151] 隐藏灰色终态累计=" & grayCount)
                // User-approved repair of root.712 PC1050/1051 missing exit.
                If grayCount > 1 Then
                    wukongTerminalReason = "用户批准的隐藏阶段累计两次灰色终态"
                    CollectWukongAdventure = RESULT_OK
                    Exit Function
                End If
            End If
        End If
        Delay 20
    Loop
End Function
Function ExecuteWukongAdventure()
    Dim mode, result, earlyTerminal
    ExecuteWukongAdventure = RESULT_TIMEOUT
    terminalConfirmed = False
    wukongTerminal = False
    wukongTerminalReason = ""
    earlyTerminal = False
    Call Note("[悟空的冒险151] 业务入口 开始时间Unix=" & Time() & " 隐藏选项=" & wukongHidden & " 扫荡选项=" & wukongSweep)
    result = EnterWukongAdventure()
    If result <> RESULT_OK Then
        Exit Function
    End If
    mode = DetectWukongMode()
    If mode = 0 Then
        Exit Function
    End If
    If mode = 3 Then
        earlyTerminal = True
    Else
        Call Progress()
        If mode = 1 Then
            mode = SweepWukongAdventure()
            If mode = 0 Then
                Exit Function
            End If
        End If
        Call Progress()
        If mode = 2 Then
            If CollectWukongAdventure() <> RESULT_OK Then
                Exit Function
            End If
        End If
    End If
    If Not earlyTerminal Then
        Delay 500
    End If
    If BusinessExpired() Then
        Call Note("[悟空的冒险151] 终态前公共超时或中断；不返回成功")
        Exit Function
    End If
    wukongTerminal = True
    terminalConfirmed = True
    ExecuteWukongAdventure = RESULT_OK
    Call WukongStage("151业务终态确认")
    Call Note("[悟空的冒险151] 正常终态=" & wukongTerminalReason & " 等待公共返回大厅；是否提交完成=否")
End Function


// flows/152_合作大冒险/合作大冒险.mq
Sub CoopStage(value)
    coopPhase = value
    coopLastMatch = ""
    Call SetStage(value)
    Call Note("[合作大冒险152] 当前阶段=" & value)
End Sub
Function CoopMatch(name)
    Dim matched, token
    matched = MatchPattern(name)
    CoopMatch = matched
    If matched Then
        token = name & ":" & foundX & "," & foundY
        If token <> coopLastMatch Then
        Call Note("[合作大冒险152] 命中模板=" & name & " 区域=见152图色登记 相似度0.9 锚点=" & foundX & "," & foundY)
            coopLastMatch = token
        End If
    End If
End Function
Function CoopTap(x, y, waitMs)
    CoopTap = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Call Note("[合作大冒险152] 失败原因=等待游戏前台时公共超时或中断；未提交")
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[合作大冒险152] 失败原因=动作前公共超时或中断；未提交")
        Exit Function
    End If
    Call Note("[合作大冒险152] 点击坐标=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    CoopTap = Not BusinessExpired()
End Function
Function CoopAction(name, waitMs)
    CoopAction = False
    If CoopMatch(name) Then
        Call Note("[合作大冒险152] 点击偏移=0,0")
        CoopAction = CoopTap(foundX, foundY, waitMs)
    End If
End Function
Function CoopSwipe(x1, y1, x2, y2, duration, waitMs)
    CoopSwipe = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Exit Function
    End If
    ReleaseCapture
    Call Note("[合作大冒险152] 固定滑动=" & x1 & "," & y1 & "到" & x2 & "," & y2 & " 时长=" & duration & " 等待毫秒=" & waitMs)
    Swipe x1, y1, x2, y2, duration
    Delay waitMs
    CoopSwipe = Not BusinessExpired()
End Function
Function CoopReadText(x1, y1, x2, y2)
    Dim text, token
    ReleaseCapture
    text = Image.OcrText(x1, y1, x2, y2, 0, 0)
    If IsNull(text) Then
        text = ""
    End If
    token = x1 & "," & y1 & "," & x2 & "," & y2 & ":" & text
    If token <> coopLastOcr Then
    Call Note("[合作大冒险152] OCR区域=" & x1 & "," & y1 & "," & x2 & "," & y2 & " 文本=" & text)
        coopLastOcr = token
    End If
    CoopReadText = text
End Function
Sub CoopResourcePrompt()
    Dim x, y, text, clicked
    If Not coopKeepDownload Then
        If CoopMatch("152_资源下载提示") Then
            x = foundX
            y = foundY
            text = CoopReadText(100, 395, 317, 448)
            If text = "下载新功能" Then
                Call Note("[合作大冒险152] 资源下载提示 点击偏移=0,0")
                clicked = CoopTap(x, y, 0)
            End If
            text = CoopReadText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                clicked = CoopTap(x, y, 0)
            End If
        End If
    End If
End Sub
Function CoopEntryReached()
    CoopEntryReached = CoopMatch("152_大厅入口二")
End Function
Function CoopHallKnown()
    CoopHallKnown = True
    If CoopMatch("152_大厅条件一") Then
        Exit Function
    End If
    If CoopMatch("152_大厅条件二") Then
        Exit Function
    End If
    CoopHallKnown = CoopMatch("152_大厅底部条件")
End Function
Function CoopHallIcon()
    CoopHallIcon = True
    If CoopMatch("152_大厅入口一") Then
        Exit Function
    End If
    CoopHallIcon = CoopMatch("152_大厅入口二")
End Function
Function EnterCoopAdventure()
    Dim started, misses, x, y, result
    EnterCoopAdventure = RESULT_TIMEOUT
    started = TickCount()
    misses = 0
    Call CoopStage("152大厅入口")
    Do
        If BusinessExpired() Then
            Call Note("[合作大冒险152] 超时原因=大厅入口公共超时或前台中断")
            Exit Function
        End If
        Call CoopResourcePrompt()
        If CoopEntryReached() Then
            EnterCoopAdventure = RESULT_OK
            Exit Function
        ElseIf misses > 10 Then
            result = ReturnToHall()
            Call Note("[合作大冒险152] 入口补救返回大厅结果=" & result)
            If result <> RESULT_OK Then
                Exit Function
            End If
            misses = 0
        Else
            misses = misses + 1
        End If
        If CoopHallKnown() Then
            If CoopHallIcon() Then
                x = foundX
                y = foundY
                Call Note("[合作大冒险152] 大厅入口点击偏移=160,-60")
                If Not CoopTap(x + 160, y - 60, 1500) Then
                    Exit Function
                End If
                misses = 0
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Call Note("[合作大冒险152] 大厅无入口时返回失败，未提交")
                    Exit Function
                End If
                If Not CoopSwipe(150, 545, 500, 545, 300, 0) Then
                    Exit Function
                End If
            End If
        End If
        Delay 300
        If TickCount() - started > 60000 Then
            Call Note("[合作大冒险152] 超时原因=专业版大厅入口60秒，等待2000后恢复原152，不沿用标完成")
            Delay 2000
            Exit Function
        End If
    Loop
End Function
Function CoopOffsetAction(name, dx, dy, waitMs)
    CoopOffsetAction = False
    If CoopMatch(name) Then
        Call Note("[合作大冒险152] 点击偏移=" & dx & "," & dy)
        CoopOffsetAction = CoopTap(foundX + dx, foundY + dy, waitMs)
    End If
End Function
Function EnterCoopTeam()
    Dim started, actions, soloChecks, name
    EnterCoopTeam = RESULT_TIMEOUT
    started = TickCount()
    actions = 0
    soloChecks = 0
    Call CoopStage("152创建或加入队伍")
    Call Note("[合作大冒险152] 队伍模式=" & coopTeamMode & " 0快速加入/1创队独玩")
    Do
        If BusinessExpired() Then
            Call Note("[合作大冒险152] 超时原因=组队公共超时或前台中断")
            Exit Function
        End If
        Call CoopResourcePrompt()
        If CoopOffsetAction("152_模式入口", 0, 0, 200) Then
            Call Note("[合作大冒险152] 进入合作模式")
        End If
        If coopTeamMode = 0 Then
            If CoopOffsetAction("152_组队首页", 404, -120, 200) Then
                actions = actions + 1
            End If
        Else
            If CoopOffsetAction("152_组队首页", 100, -120, 200) Then
                actions = actions + 1
            End If
        End If
        If coopTeamMode = 1 Then
            If CoopOffsetAction("152_独玩勾选前", 417, -119, 200) Then
                soloChecks = soloChecks + 1
            End If
        End If
        name = "152_独玩开启"
        If coopTeamMode = 0 Or soloChecks > 5 Then
            name = "152_快速离开"
        End If
        If CoopOffsetAction(name, 251, -124, 200) Then
            actions = actions + 1
        End If
        If CoopMatch("152_冒险主界面") Then
            Delay 200
            Call Progress()
            EnterCoopTeam = RESULT_OK
            Call Note("[合作大冒险152] 队伍进入冒险主界面确认")
            Exit Function
        End If
        If TickCount() - started > 10000 Or actions > 10 Then
            Call Note("[合作大冒险152] 失败原因=组队超过10000毫秒或操作次数超过10，等待1000后恢复152；未提交")
            Delay 1000
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function RunCoopAdventure()
    Dim started, openFailures, diceAttempts, bossAttempts, x, y, matched
    RunCoopAdventure = RESULT_TIMEOUT
    started = TickCount()
    openFailures = 0
    diceAttempts = 0
    bossAttempts = 0
    Call CoopStage("152合作冒险事件")
    Do
        If BusinessExpired() Then
            Call Note("[合作大冒险152] 超时原因=冒险事件公共超时或前台中断；未提交")
            Exit Function
        End If
        If CoopOffsetAction("152_模式入口", 0, 0, 200) Then
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_冒险主界面", 516, -87, 50) Then
            openFailures = 0
            diceAttempts = diceAttempts + 1
        End If
        If CoopOffsetAction("152_抽牌事件", 410, -227, 50) Then
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_抽牌完成", 120, 12, 50) Then
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_随机事件", 0, 0, 1000) Then
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_胜利一", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_转盘未抽", 250, -570, 2000) Then
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_转盘已抽", 0, 0, 1000) Then
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_奖励一", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_奖励二", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_传送一", 0, 0, 1000) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_传送二", 0, 0, 1000) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopMatch("152_挑战对话") Then
            x = foundX
            y = foundY
            Call Note("[合作大冒险152] 挑战对话同锚点双击 点击偏移=0,0 等待200/200后50")
            If Not CoopTap(x, y, 200) Then
                Exit Function
            End If
            If Not CoopTap(x, y, 200) Then
                Exit Function
            End If
            Delay 50
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_胜利二", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_战斗失败", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_小芳奖励", -164, 526, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_进度箱子", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_圣水奖励", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If CoopMatch("152_开战图标6") Then
            Call Note("[合作大冒险152] 开战固定坐标398,982→587,982，等待500/500")
            If Not CoopTap(398, 982, 500) Then
                Exit Function
            End If
            If Not CoopTap(587, 982, 500) Then
                Exit Function
            End If
            openFailures = openFailures + 1
            diceAttempts = 0
        End If
        If CoopOffsetAction("152_跳过", -311, 87, 500) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        // Original repeats this template at a distinct priority after skip; retain both checks.
        If CoopOffsetAction("152_圣水奖励", 0, 0, 50) Then
            Call Progress()
            openFailures = 0
            diceAttempts = 0
        End If
        If bossAttempts < 5 Then
            matched = CoopOffsetAction("152_BOSS一", 0, 0, 500)
            If Not matched Then
                matched = CoopOffsetAction("152_BOSS二", 0, 0, 500)
            End If
            If matched Then
                bossAttempts = bossAttempts + 1
                Call Note("[合作大冒险152] BOSS点击累计=" & bossAttempts)
            End If
        End If
        If CoopMatch("152_体力购买") Then
            Call Progress()
            Call Note("[合作大冒险152] 识别体力购买界面，进入原版收尾；未购买体力、尚未确认本轮结束")
            RunCoopAdventure = RESULT_OK
            Exit Function
        End If
        If openFailures > 10 Then
            Call Note("[合作大冒险152] 失败原因=专业版开战计数超过10；不跳过，交公共恢复152")
            RunCoopAdventure = RESULT_FAIL
            Exit Function
        End If
        If TickCount() - started > 300000 Then
            Call Note("[合作大冒险152] 超时原因=专业版冒险300000毫秒，等待1000后恢复152")
            Delay 1000
            Exit Function
        End If
        If diceAttempts > 5 Then
            Call Note("[合作大冒险152] 未确认终态=专业版连续投骰超过5称次数不足；不属用户批准的两类本轮结束，等待1000后恢复152")
            Delay 1000
            RunCoopAdventure = RESULT_FAIL
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function FinishCoopAdventure()
    Dim started, boardActions, toggle, acted
    FinishCoopAdventure = RESULT_TIMEOUT
    started = TickCount()
    boardActions = 0
    toggle = 0
    Call CoopStage("152合作冒险收尾")
    Do
        If BusinessExpired() Then
            Call Note("[合作大冒险152] 超时原因=收尾公共超时或前台中断；未提交")
            Exit Function
        End If
        If CoopOffsetAction("152_体力购买", 298, -306, 50) Then
            Call Progress()
        End If
        If CoopOffsetAction("152_小芳奖励", -164, 526, 50) Then
            Call Progress()
            boardActions = 0
        End If
        If CoopOffsetAction("152_奖励通用", 0, 0, 50) Then
            Call Progress()
            boardActions = 0
        End If
        If CoopOffsetAction("152_购买关闭", 0, 0, 50) Then
            Call Progress()
        End If
        If CoopOffsetAction("152_已领取关闭", 0, 0, 50) Then
            Call Progress()
            coopTerminalReason = "专业版领取界面已领取并关闭"
            FinishCoopAdventure = RESULT_OK
            Exit Function
        End If
        If toggle = 1 Then
            acted = CoopOffsetAction("152_冒险主界面", 530, -1093, 1000)
        Else
            acted = CoopOffsetAction("152_冒险主界面", 10, -793, 1000)
            If acted Then
                toggle = 0
            End If
        End If
        If acted Then
            Call Progress()
            toggle = toggle + 1
            boardActions = boardActions + 1
            Call Note("[合作大冒险152] 主界面收尾操作累计=" & boardActions)
        End If
        If boardActions > 4 Then
            coopTerminalReason = "用户批准的专业版主界面累计5次收尾操作"
            FinishCoopAdventure = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 300000 Then
            Call Note("[合作大冒险152] 超时原因=专业版收尾300000毫秒，等待1000后恢复152")
            Delay 1000
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteCoopAdventure()
    Dim result
    ExecuteCoopAdventure = RESULT_TIMEOUT
    terminalConfirmed = False
    coopTerminal = False
    coopTerminalReason = ""
    Call Note("[合作大冒险152] 业务入口 开始时间Unix=" & Time() & " 队伍模式=" & coopTeamMode)
    result = EnterCoopAdventure()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterCoopTeam()
    If result <> RESULT_OK Then
        ExecuteCoopAdventure = result
        Exit Function
    End If
    result = RunCoopAdventure()
    If result <> RESULT_OK Then
        ExecuteCoopAdventure = result
        Exit Function
    End If
    result = FinishCoopAdventure()
    If result <> RESULT_OK Then
        Exit Function
    End If
    Delay 500
    If BusinessExpired() Then
        Call Note("[合作大冒险152] 终态后公共超时或中断，未提交完成")
        Exit Function
    End If
    coopTerminal = True
    terminalConfirmed = True
    ExecuteCoopAdventure = RESULT_OK
    Call CoopStage("152本轮业务终态确认")
    Call Note("[合作大冒险152] 正常终态=" & coopTerminalReason & " 等待公共返回大厅连续确认；是否提交完成=否")
End Function


// flows/070_世界首领/世界首领.mq
Function EnterBossPage(prefix)
    Dim clicked, matched
    EnterBossPage = RESULT_TIMEOUT
    Call WorldStage("进入世界首领")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=首领页面入口未确认")
            Exit Function
        End If
        Call WorldWait(200)
        If WorldPair(prefix & "入口") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
        End If
        Call WorldWait(200)
        If prefix = "070_" Then
            matched = WorldMatch("070_首领界面")
        Else
            matched = WorldPair("032_首领界面")
        End If
        If matched Then
            Call WorldWait(300)
            If Not BusinessExpired() Then
                EnterBossPage = RESULT_OK
            End If
            Exit Function
        End If
        Call WorldWait(200)
    Loop
End Function
Function FinishBossRewards(prefix)
    Dim clicked, x, y
    FinishBossRewards = RESULT_TIMEOUT
    Call WorldStage("首领奖励收尾")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=领奖页面未知或公共超时；未提交")
            Exit Function
        End If
        If WorldPair(prefix & "领奖") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair(prefix & "无奖") Then
            Call WorldWait(1000)
            worldTerminalReason = "专业版明确无奖励可领取"
            Exit Do
        End If
        If WorldPair(prefix & "灰领") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
            worldTerminalReason = "用户批准的专业版灰色领取界面点击出口"
            Exit Do
        End If
        Call WorldWait(300)
        If WorldPair(prefix & "蓝领") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
        End If
        Call WorldWait(300)
        If WorldPair(prefix & "领奖弹窗") Then
            x = foundX
            y = foundY
            If prefix = "070_" Then
                x = 100
                y = 50
            End If
            Call WorldLog("奖励双击 点击偏移=0,0；70使用固定100,50，32使用命中锚点")
            clicked = WorldTap(x, y, 500)
            If Not clicked Then
                Exit Function
            End If
            clicked = WorldTap(x, y, 0)
            If Not clicked Then
                Exit Function
            End If
            worldTerminalReason = "用户批准的专业版奖励弹窗双击出口"
            Exit Do
        End If
    Loop
    If BusinessExpired() Then
        Exit Function
    End If
    Call WorldLog("正常终态=" & worldTerminalReason & " 等待公共返回大厅连续确认；是否提交完成=否")
    FinishBossRewards = RESULT_OK
End Function

Function BuyWorldBossAttempts()
    Dim started, prepared, adds, price, text, x, y, i, clicked, decisions
    BuyWorldBossAttempts = RESULT_TIMEOUT
    If worldBuyRuntime = 0 Then
        Call WorldLog("购买次数=不购买")
        BuyWorldBossAttempts = RESULT_OK
        Exit Function
    End If
    adds = 2
    price = 60
    If worldBuyRuntime = 2 Then
        adds = 4
        price = 140
    ElseIf worldBuyRuntime = 3 Then
        adds = 6
        price = 320
    ElseIf worldBuyRuntime = 4 Then
        adds = 9
        price = 870
    End If
    prepared = False
    decisions = 0
    started = TickCount()
    Call WorldStage("世界首领购买次数")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=购买阶段公共超时；保留当前恢复任务")
            Exit Function
        End If
        If WorldMatch("070_首领界面") Then
            If prepared Then
                BuyWorldBossAttempts = RESULT_OK
                Exit Function
            Else
                clicked = WorldTap(640, 1050, 1000)
                If Not clicked Then
                    Exit Function
                End If
            End If
        End If
        If WorldMatch("070_购买弹窗") Then
            x = foundX
            y = foundY
            If Not prepared Then
                Call WorldLog("购买设置 目标次数=" & (adds + 1) & " 加号次数=" & adds & " 应有价格=" & price & " 点击偏移=-212,152")
                For i = 1 To adds
                    clicked = WorldTap(x - 212, y + 152, 300)
                    If Not clicked Then
                        Exit Function
                    End If
                Next
                Call WorldWait(1000)
                For i = 1 To 2
                    text = WorldText(322, 785, 433, 815)
                    Call WorldWait(200)
                Next
                prepared = True
            Else
                text = WorldText(322, 785, 433, 815)
                clicked = False
                If IsNumeric(text) Then
                    If Int(CDbl(text)) = price And decisions = 0 Then
                        Call WorldLog("购买价格核对通过 点击偏移=-306,330")
                        clicked = WorldTap(x - 306, y + 330, 0)
                    End If
                End If
                If Not clicked Then
                    Call WorldLog("关闭购买 原因=OCR非预期价格或已处理 点击偏移=-11,17")
                    clicked = WorldTap(x - 11, y + 17, 0)
                End If
                If Not clicked Then
                    Exit Function
                End If
                decisions = decisions + 1
                Call WorldWait(1000)
                worldBuyRuntime = 0
            End If
        End If
        If TickCount() - started > 15000 Then
            worldBuyRuntime = 0
            Call WorldLog("购买阶段15秒结束，清除本会话购买设置后继续扫荡；非业务终态")
            BuyWorldBossAttempts = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function SweepWorldBoss()
    Dim lastAction, count, x, y, clicked, text
    SweepWorldBoss = RESULT_TIMEOUT
    lastAction = TickCount()
    count = 0
    Call WorldStage("世界首领扫荡")
    Call Progress()
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=扫荡公共超时或前台中断")
            Exit Function
        End If
        If WorldMatch("070_购买弹窗") Then
            clicked = WorldOffset(-11, 17, 0)
            If Not clicked Then
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If WorldPair("070_扫荡") Then
            x = foundX
            y = foundY
            text = WorldText(473, 1026, 613, 1075)
            If text = "挑战次数0" Or text = "挑战次数|0" Then
                Call WorldLog("OCR命中=挑战次数0/挑战次数|0，进入领奖；尚未提交")
                SweepWorldBoss = RESULT_OK
                Exit Function
            End If
            Call WorldLog("扫荡同锚点三点击 点击偏移=0,0")
            clicked = WorldTap(x, y, 50)
            If Not clicked Then
                Exit Function
            End If
            clicked = WorldTap(x, y, 50)
            If Not clicked Then
                Exit Function
            End If
            clicked = WorldTap(x, y, 100)
            If Not clicked Then
                Exit Function
            End If
            lastAction = TickCount()
            count = count + 1
            Call WorldLog("扫荡累计=" & count)
        End If
        Call WorldWait(50)
        If WorldPair("070_消灭") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
            lastAction = TickCount()
            count = 0
        End If
        Call WorldWait(50)
        If WorldPair("070_复活") Then
            Call WorldLog("等待BOSS复活，清空连续扫荡计数")
            count = 0
        End If
        Call WorldWait(50)
        If WorldPair("070_奖励") Then
            clicked = WorldTap(100, 50, 300)
            If Not clicked Then
                Exit Function
            End If
            lastAction = TickCount()
            count = 0
            Call Progress()
        End If
        If count > 15 Then
            Call WorldLog("连续扫荡超过15次，按专业版进入领奖；尚未确认业务终态")
            Call Progress()
            SweepWorldBoss = RESULT_OK
            Exit Function
        End If
        If TickCount() - lastAction > 30000 Then
            Call WorldLog("专业版阶段出口=扫荡30秒无进展，停止扫荡并进入领奖；不是业务完成")
            Call Progress()
            SweepWorldBoss = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function ExecuteWorldBoss()
    Dim result
    ExecuteWorldBoss = RESULT_TIMEOUT
    worldTerminal = False
    terminalConfirmed = False
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterBossPage("070_")
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = BuyWorldBossAttempts()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = SweepWorldBoss()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = FinishBossRewards("070_")
    If result <> RESULT_OK Or BusinessExpired() Then
        Exit Function
    End If
    worldFinishedAt = Time()
    worldTerminal = True
    terminalConfirmed = True
    ExecuteWorldBoss = RESULT_OK
End Function


// flows/032_世界首领沙鲁/打沙鲁.mq
Function EnterCellEncounter()
    Dim clicked
    EnterCellEncounter = RESULT_TIMEOUT
    Call WorldStage("打沙鲁进入奇遇")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=奇遇入口未知；未提交")
            Exit Function
        End If
        If WorldPair("032_奇遇入口") Then
            clicked = WorldOffset(0, 0, 0)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
        End If
        Call WorldWait(50)
        If WorldPair("032_奇遇界面") Then
            cellEncounterEnded = False
            Call Progress()
            Call WorldWait(50)
            EnterCellEncounter = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("032_奇遇结束") Then
            cellEncounterEnded = True
            Call Progress()
            Call WorldWait(50)
            Call WorldLog("识别奇遇已结束，走已结束关闭返回路径")
            EnterCellEncounter = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function SweepCellEncounter(limit)
    Dim count, clicked, x, y, i
    SweepCellEncounter = RESULT_TIMEOUT
    count = 0
    Call WorldStage("打沙鲁扫荡 阶段阈值=" & limit)
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=奇遇扫荡未知；未提交")
            Exit Function
        End If
        If WorldPair("032_关闭") Then
            clicked = WorldOffset(0, 0, 50)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
            SweepCellEncounter = RESULT_OK
            Exit Function
        End If
        If WorldPair("032_扫荡") Then
            x = foundX
            y = foundY
            Call WorldLog("奇遇扫荡同锚点六点击 点击偏移=0,0")
            For i = 1 To 5
                clicked = WorldTap(x, y, 50)
                If Not clicked Then
                    Exit Function
                End If
            Next
            clicked = WorldTap(x, y, 0)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
            count = count + 1
            Call WorldWait(500)
            Call WorldLog("奇遇扫荡累计=" & count & " 阶段阈值=" & limit)
        End If
        Call WorldWait(50)
        If WorldPair("032_结果") Then
            x = foundX
            y = foundY
            Call WorldWait(1000)
            clicked = WorldTap(x, y, 0)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
            count = 0
        End If
        If count > limit Then
            Call Progress()
            Call WorldLog("扫荡阶段计数出口，仅推进下一阶段；不是任务成功")
            SweepCellEncounter = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function RunCellFirstBattle()
    Dim count, clicked
    RunCellFirstBattle = RESULT_TIMEOUT
    count = 0
    Call WorldStage("打沙鲁首次开战与退出")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=首次战斗未知；未提交")
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("032_开战") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
            count = count + 1
        End If
        If WorldMatch("032_开战图标6") Then
            clicked = WorldTap(587, 982, 2000)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
        End If
        If WorldMatch("032_少人提示") Then
            clicked = WorldOffset(0, 0, 2000)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldMatch("032_暂停") Then
            clicked = WorldOffset(-311, 10, 200)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
        End If
        If WorldMatch("032_退出") Then
            clicked = WorldOffset(0, 0, 200)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
            RunCellFirstBattle = RESULT_OK
            Exit Function
        End If
        If count > 3 Then
            Call Progress()
            Call WorldLog("开战累计超过3，进入结果处理；尚未提交")
            RunCellFirstBattle = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function ReturnCellEncounter()
    Dim x, y, clicked
    ReturnCellEncounter = RESULT_TIMEOUT
    Call WorldStage("打沙鲁首次战斗后返回奇遇")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=战后奇遇页面未确认")
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("032_结果") Then
            x = foundX
            y = foundY
            Call WorldWait(1000)
            clicked = WorldTap(x, y, 0)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
        End If
        Call WorldWait(50)
        If WorldPair("032_奇遇界面") Then
            Call Progress()
            Call WorldWait(1000)
            ReturnCellEncounter = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function ReturnCellWorldBoss()
    Dim clicked
    ReturnCellWorldBoss = RESULT_TIMEOUT
    Call WorldStage("打沙鲁关闭奇遇返回首领")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=奇遇关闭后首领页面未确认")
            Exit Function
        End If
        If WorldPair("032_关闭") Then
            clicked = WorldOffset(0, 0, 50)
            If Not clicked Then
                Exit Function
            End If
            Call Progress()
            If cellEncounterEnded Then
                ReturnCellWorldBoss = RESULT_OK
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If Not cellEncounterEnded Then
            If WorldPair("032_关闭其他") Then
                clicked = WorldOffset(0, 0, 50)
                If Not clicked Then
                    Exit Function
                End If
                Call Progress()
            End If
            Call WorldWait(50)
        End If
        If WorldPair("032_首领界面") Then
            Call WorldWait(300)
            Call Progress()
            ReturnCellWorldBoss = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function ExecuteCellBoss()
    Dim result
    ExecuteCellBoss = RESULT_TIMEOUT
    cellTerminal = False
    terminalConfirmed = False
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterBossPage("032_")
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterCellEncounter()
    If result <> RESULT_OK Then
        Exit Function
    End If
    If Not cellEncounterEnded Then
        result = SweepCellEncounter(20)
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = RunCellFirstBattle()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = ReturnCellEncounter()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = SweepCellEncounter(3)
        If result <> RESULT_OK Then
            Exit Function
        End If
    End If
    result = ReturnCellWorldBoss()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = FinishBossRewards("032_")
    If result <> RESULT_OK Or BusinessExpired() Then
        Exit Function
    End If
    cellFinishedAt = Time()
    cellTerminal = True
    terminalConfirmed = True
    ExecuteCellBoss = RESULT_OK
End Function


// flows/083_跨服世界首领/跨服世界首领.mq
Function EnterCrossBoss()
    Dim clicked
    EnterCrossBoss = RESULT_TIMEOUT
    Call WorldStage("83跨服首领入口与阶段识别")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=跨服入口或阶段未确认；未提交")
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldPair("083_入口") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_灰入口") Then
            crossMode = -1
            crossTerminalReason = "用户批准的专业版灰色入口不可用出口"
            EnterCrossBoss = RESULT_OK
            Exit Function
        End If
        // The original checks the same two gray candidates twice at this priority.
        If WorldPair("083_灰入口") Then
            crossMode = -1
            crossTerminalReason = "用户批准的专业版灰色入口不可用出口"
            EnterCrossBoss = RESULT_OK
            Exit Function
        End If
        If WorldPair("083_预备") Then
            crossMode = 0
            Call WorldLog("分流=预备阶段")
            EnterCrossBoss = RESULT_OK
            Exit Function
        End If
        If WorldPair("083_未上阵") Then
            crossMode = 1
            Call WorldLog("分流=正式阶段未上阵")
            EnterCrossBoss = RESULT_OK
            Exit Function
        End If
        If WorldPair("083_已上阵") Then
            crossMode = 1
            Call WorldLog("分流=正式阶段已上阵")
            EnterCrossBoss = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function RunCrossPreparation()
    Dim attacks, results, started, clicked, text
    RunCrossPreparation = RESULT_TIMEOUT
    attacks = 0
    results = 0
    started = TickCount()
    Call WorldStage("83预备阶段")
    Call Progress()
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=预备阶段公共超时或前台中断")
            Exit Function
        End If
        If attacks > 5 Or results >= 10 Then
            Call WorldWait(50)
            If WorldPair("083_预备退出") Then
                clicked = WorldOffset(0, 0, 0)
                If Not clicked Then
                    Exit Function
                End If
                crossTerminalReason = "用户批准的预备操作达阈值且退出模板点击出口"
                RunCrossPreparation = RESULT_OK
                Exit Function
            End If
            // The original 3000ms origin is preparation entry, not threshold entry.
            If TickCount() - started > 3000 Then
                crossTerminalReason = "专业版预备操作达阈值，退出模板未命中且阶段累计超过3000毫秒，本轮结束"
                Call WorldLog("专业版预备阶段出口=" & crossTerminalReason & "；等待公共返回大厅确认，不直接提交")
                RunCrossPreparation = RESULT_OK
                Exit Function
            End If
        Else
            If WorldPair("083_预备") Then
                text = WorldText(406, 1084, 496, 1113)
                If text = "次数不够" Then
                    crossTerminalReason = "专业版预备阶段OCR明确次数不够"
                    RunCrossPreparation = RESULT_OK
                    Exit Function
                End If
                clicked = WorldOffset(0, 0, 500)
                If Not clicked Then
                    Exit Function
                End If
                results = 0
                attacks = attacks + 1
                Call WorldLog("预备操作累计=" & attacks & " 结果操作累计=" & results)
            End If
            If WorldPair("083_预备结果") Then
                clicked = WorldOffset(0, 0, 500)
                If Not clicked Then
                    Exit Function
                End If
                results = results + 1
                Call WorldLog("预备结果累计=" & results & " 预备操作累计=" & attacks)
            End If
        End If
        Delay 20
    Loop
End Function
Function BuyCrossBossAttempts()
    Dim started, prepared, adds, price, text, x, y, i, clicked, decisions
    BuyCrossBossAttempts = RESULT_TIMEOUT
    If crossBuyRuntime = 0 Then
        Call WorldLog("购买次数=不购买")
        BuyCrossBossAttempts = RESULT_OK
        Exit Function
    End If
    adds = 2
    price = 60
    If crossBuyRuntime = 2 Then
        adds = 4
        price = 140
    ElseIf crossBuyRuntime = 3 Then
        adds = 6
        price = 320
    ElseIf crossBuyRuntime = 4 Then
        adds = 9
        price = 870
    End If
    prepared = False
    decisions = 0
    started = TickCount()
    Call WorldStage("83跨服首领购买次数")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=购买阶段公共超时；保留当前恢复任务")
            Exit Function
        End If
        If WorldMatch("083_购买主界面") Then
            If prepared Then
                BuyCrossBossAttempts = RESULT_OK
                Exit Function
            Else
                clicked = WorldTap(590, 1150, 1000)
                If Not clicked Then
                    Exit Function
                End If
            End If
        End If
        If WorldMatch("083_购买弹窗") Then
            x = foundX
            y = foundY
            If Not prepared Then
                Call WorldLog("购买设置 目标次数=" & (adds + 1) & " 加号次数=" & adds & " 应有价格=" & price & " 点击偏移=-212,152")
                For i = 1 To adds
                    clicked = WorldTap(x - 212, y + 152, 300)
                    If Not clicked Then
                        Exit Function
                    End If
                Next
                Call WorldWait(1000)
                For i = 1 To 2
                    text = WorldText(322, 785, 433, 815)
                    Call WorldWait(200)
                Next
                prepared = True
            Else
                text = WorldText(322, 785, 433, 815)
                clicked = False
                If IsNumeric(text) Then
                    If Int(CDbl(text)) = price And decisions = 0 Then
                        Call WorldLog("购买价格核对通过 点击偏移=-306,330")
                        clicked = WorldTap(x - 306, y + 330, 0)
                    End If
                End If
                If Not clicked Then
                    Call WorldLog("关闭购买 原因=OCR非预期价格或已处理 点击偏移=-11,17")
                    clicked = WorldTap(x - 11, y + 17, 0)
                End If
                If Not clicked Then
                    Exit Function
                End If
                decisions = decisions + 1
                Call WorldWait(1000)
                crossBuyRuntime = 0
            End If
        End If
        If TickCount() - started > 15000 Then
            crossBuyRuntime = 0
            Call WorldLog("购买阶段15秒结束，清除本会话购买设置后继续扫荡；非业务终态")
            BuyCrossBossAttempts = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function SweepCrossBoss()
    Dim count, clicked
    SweepCrossBoss = RESULT_TIMEOUT
    count = 0
    Call WorldStage("83正式阶段扫荡")
    Call Progress()
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=正式扫荡公共超时或前台中断")
            Exit Function
        End If
        If count > 5 Then
            Call WorldLog("连续扫荡超过5次，进入页面确认与领奖；非终态")
            SweepCrossBoss = RESULT_OK
            Exit Function
        End If
        If WorldPair("083_已上阵") Then
            clicked = WorldOffset(0, 0, 500)
            If Not clicked Then
                Exit Function
            End If
            count = count + 1
            Call WorldLog("正式扫荡累计=" & count)
        End If
        If WorldPair("083_未上阵") Then
            clicked = WorldOffset(0, 0, 500)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_扫荡奖励") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
            crossActionAt = TickCount()
            count = 0
        End If
        Call WorldWait(50)
        If WorldPair("083_次数弹窗") Then
            clicked = WorldOffset(0, 0, 0)
            If Not clicked Then
                Exit Function
            End If
            crossActionAt = TickCount()
            Call WorldLog("识别次数弹窗并点击，进入收尾确认；非终态")
            SweepCrossBoss = RESULT_OK
            Exit Function
        End If
        If count > 5 Then
            Call WorldLog("连续扫荡超过5次，进入页面确认与领奖；非终态")
            SweepCrossBoss = RESULT_OK
            Exit Function
        End If
        If TickCount() - crossActionAt > 15000 Then
            Call WorldLog("专业版阶段出口=正式扫荡15秒未获奖励，进入主界面确认与领奖；不是业务完成")
            SweepCrossBoss = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function ConfirmCrossBossBoard()
    Dim clicked
    ConfirmCrossBossBoard = RESULT_TIMEOUT
    Call WorldStage("83扫荡后主界面确认")
    Call Progress()
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=扫荡后主界面未确认")
            Exit Function
        End If
        If WorldPair("083_次数弹窗") Then
            clicked = WorldOffset(0, 0, 300)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_已上阵") Then
            Call WorldWait(500)
            ConfirmCrossBossBoard = RESULT_OK
            Exit Function
        End If
        If WorldPair("083_未上阵") Then
            Call WorldWait(500)
            ConfirmCrossBossBoard = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function FinishCrossBossRewards()
    Dim clicked
    FinishCrossBossRewards = RESULT_TIMEOUT
    Call WorldStage("83跨服首领奖励收尾")
    Do
        If BusinessExpired() Then
            Call WorldLog("超时原因=跨服领奖终态未确认；未提交")
            Exit Function
        End If
        If WorldPair("083_领奖入口") Then
            clicked = WorldOffset(0, 0, 500)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_一键领取") Then
            clicked = WorldOffset(0, 0, 500)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_领取奖励") Then
            clicked = WorldOffset(0, 0, 500)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_领取关闭") Then
            clicked = WorldOffset(0, 0, 500)
            If Not clicked Then
                Exit Function
            End If
        End If
        If WorldPair("083_无奖励") Then
            Call WorldWait(500)
            If BusinessExpired() Then
                Exit Function
            End If
            crossTerminalReason = "专业版正式阶段明确无奖励，任务结束"
            FinishCrossBossRewards = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteCrossBoss()
    Dim result
    ExecuteCrossBoss = RESULT_TIMEOUT
    crossTerminal = False
    terminalConfirmed = False
    crossTerminalReason = ""
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterCrossBoss()
    If result <> RESULT_OK Then
        Exit Function
    End If
    If crossMode = 0 Then
        result = RunCrossPreparation()
        If result <> RESULT_OK Then
            Exit Function
        End If
    ElseIf crossMode = 1 Then
        // Preserve the professional local timer origin before the purchase stage.
        crossActionAt = TickCount()
        result = BuyCrossBossAttempts()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = SweepCrossBoss()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = ConfirmCrossBossBoard()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = FinishCrossBossRewards()
        If result <> RESULT_OK Then
            Exit Function
        End If
    End If
    If crossTerminalReason = "" Or BusinessExpired() Then
        Call WorldLog("失败原因=没有明确业务终态或已超时；不提交")
        Exit Function
    End If
    crossFinishedAt = Time()
    crossTerminal = True
    terminalConfirmed = True
    Call WorldLog("正常终态=" & crossTerminalReason & " 等待公共返回大厅连续确认；是否提交完成=否")
    ExecuteCrossBoss = RESULT_OK
End Function


// flows/084_消灭红绸军/消灭红绸军.mq
Function RedArmyExpired()
    Dim expired
    expired = BusinessExpired()
    RedArmyExpired = expired
    If expired Then
        Call WorldLog("失败或超时原因=公共业务总超时或前台中断；保存原任务=" & currentTask & " 是否提交完成=否")
    End If
End Function
Function EnterRedArmy()
    Dim acted, clicked
    EnterRedArmy = RESULT_TIMEOUT
    Call WorldStage("红绸军入口")
    Do
        If RedArmyExpired() Then
            Exit Function
        End If
        acted = False
        Call WorldResourcePrompt()
        If WorldMatch("084_入口") Then
            If Not WorldOffset(0, 0, 2000) Then
                Exit Function
            End If
            acted = True
        End If
        If WorldMatch("084_未开启") Then
            Call WorldWait(2000)
            If RedArmyExpired() Then
                Exit Function
            End If
            redReason = "专业版灰色未开启入口，本时段结束"
            redMode = -1
            EnterRedArmy = RESULT_OK
            Exit Function
        End If
        If WorldMatch("084_时间已过") Then
            Call WorldWait(2000)
            If RedArmyExpired() Then
                Exit Function
            End If
            redReason = "专业版明确任务时间已过，本时段结束"
            redMode = -1
            EnterRedArmy = RESULT_OK
            Exit Function
        End If
        If WorldMatch("084_主界面") Then
            Call WorldWait(500)
            If RedArmyExpired() Then
                Exit Function
            End If
            redMode = 0
            EnterRedArmy = RESULT_OK
            Exit Function
        End If
        If Not acted Then
            Delay 20
        End If
    Loop
End Function
Function SelectRedArmyMap()
    Dim base, selectedName, entryName
    SelectRedArmyMap = RESULT_TIMEOUT
    base = "084_图一"
    If redMap = 1 Then
        base = "084_图二"
    ElseIf redMap = 2 Then
        base = "084_图三"
    End If
    selectedName = base & "已选"
    entryName = base & "入口"
    Call WorldStage("红绸军地图选择")
    Call WorldLog("地图配置=" & redMap)
    Do
        If RedArmyExpired() Then
            Exit Function
        End If
        If WorldPair(selectedName) Then
            Call WorldWait(500)
            If RedArmyExpired() Then
                Exit Function
            End If
            SelectRedArmyMap = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair(entryName) Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            Call Progress()
        End If
    Loop
End Function
Function EnterRedArmyMonster(base)
    Dim acted
    EnterRedArmyMonster = RESULT_TIMEOUT
    Call WorldStage(base)
    Do
        If RedArmyExpired() Then
            Exit Function
        End If
        acted = False
        If WorldPair(base) Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            Call Progress()
            acted = True
        End If
        If WorldPair("084_扫荡界面") Then
            Call Progress()
            Call WorldWait(500)
            If RedArmyExpired() Then
                Exit Function
            End If
            EnterRedArmyMonster = RESULT_OK
            Exit Function
        End If
        If Not acted Then
            Delay 20
        End If
    Loop
End Function
Function RedArmyVictory()
    RedArmyVictory = False
    If WorldMatch("084_胜利") Then
        redActionAt = TickCount()
        If Not WorldOffset(0, 0, 500) Then
            Exit Function
        End If
        Call Progress()
        RedArmyVictory = True
    End If
End Function
Function RedArmyFlip()
    RedArmyFlip = False
    If WorldPair("084_翻牌") Then
        redActionAt = TickCount()
        If Not WorldOffset(0, 0, 1000) Then
            Exit Function
        End If
        Call Progress()
        Call WorldWait(50)
        RedArmyFlip = True
    End If
End Function
Function RedArmyFlipDone()
    RedArmyFlipDone = False
    If WorldPair("084_翻牌完成") Then
        redActionAt = TickCount()
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        Call Progress()
        Call WorldWait(50)
        RedArmyFlipDone = True
    End If
End Function
Function SweepRedArmyMonster(mode)
    Dim count, limit, text, x, y, acted
    SweepRedArmyMonster = RESULT_TIMEOUT
    count = 0
    limit = 5
    If mode = 2 Then
        limit = 7
    End If
    Call WorldStage("红绸军扫荡")
    Call WorldLog("扫荡阶段模式=" & mode & " 0=中午 1=下午首怪 2=下午后两怪")
    If mode = 1 Then
        Call WorldWait(50)
    End If
    Do
        If RedArmyExpired() Then
            Exit Function
        End If
        acted = False
        If mode = 1 And count > 6 Then
            Call WorldWait(500)
            If RedArmyExpired() Then
                Exit Function
            End If
            Call WorldLog("首怪7组双点完成，仅结束扫荡阶段，尚非业务终态")
            SweepRedArmyMonster = RESULT_OK
            Exit Function
        End If
        If WorldPair("084_扫荡界面") Then
            x = foundX
            y = foundY
            text = WorldText(297, 827, 417, 852)
            If text = "挑战次数：0" Then
                Call WorldLog("扫荡OCR次数为零，仅结束阶段，尚非业务终态")
                SweepRedArmyMonster = RESULT_OK
                Exit Function
            End If
            Call WorldLog("扫荡双点击偏移=0,0 组次=" & (count + 1))
            If Not WorldTap(x, y, 20) Then
                Exit Function
            End If
            If Not WorldTap(x, y, 500) Then
                Exit Function
            End If
            count = count + 1
            Call Progress()
            acted = True
        End If
        If mode <> 1 And count > limit Then
            Call WorldLog("扫荡组数=" & count & " 达专业版阶段阈值，尚非业务终态")
            SweepRedArmyMonster = RESULT_OK
            Exit Function
        End If
        If RedArmyVictory() Then
            count = 0
            acted = True
            If mode = 1 Then
                SweepRedArmyMonster = RESULT_OK
                Exit Function
            End If
        End If
        If mode = 1 Then
            Call WorldWait(50)
        End If
        If RedArmyFlip() Then
            count = 0
            acted = True
        End If
        If RedArmyFlipDone() Then
            count = 0
            acted = True
        End If
        If Not acted And mode <> 1 Then
            Delay 20
        End If
    Loop
End Function
Function CloseRedArmyMonster(mode)
    Dim closed
    CloseRedArmyMonster = RESULT_TIMEOUT
    Call WorldStage("红绸军战斗收尾确认板面")
    Do
        If RedArmyExpired() Then
            Exit Function
        End If
        closed = RedArmyVictory()
        If mode = 1 Then
            closed = RedArmyFlip()
        End If
        Call WorldWait(50)
        closed = RedArmyFlipDone()
        Call WorldWait(50)
        If WorldPair("084_关闭") Then
            redActionAt = TickCount()
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            Call Progress()
            Call WorldWait(50)
        End If
        If mode <> 1 Then
            Call WorldWait(50)
        End If
        If WorldMatch("084_主界面") Then
            Call WorldWait(500)
            If RedArmyExpired() Then
                Exit Function
            End If
            CloseRedArmyMonster = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function RefreshRedArmyPage()
    Dim leftPage, acted
    RefreshRedArmyPage = RESULT_TIMEOUT
    leftPage = False
    Call WorldStage("红绸军防卡切页")
    Do
        If RedArmyExpired() Then
            Exit Function
        End If
        acted = False
        If WorldMatch("084_主界面") Then
            If leftPage Then
                Call WorldLog("防卡切页已重新确认红绸军板面")
                RefreshRedArmyPage = RESULT_OK
                Exit Function
            End If
            If Not WorldOffset(0, 0, 2000) Then
                Exit Function
            End If
            acted = True
        End If
        If WorldMatch("084_入口") Then
            If Not leftPage Then
                leftPage = True
            Else
                If Not WorldOffset(0, 0, 1000) Then
                    Exit Function
                End If
                acted = True
            End If
        End If
        If Not acted Then
            Delay 20
        End If
    Loop
End Function
Function WaitRedArmyRefresh()
    Dim i, result, text
    WaitRedArmyRefresh = RESULT_TIMEOUT
    redFirstDone = False
    Call WorldStage("红绸军首怪等待刷新")
    For i = 1 To 30
        If RedArmyExpired() Then
            Exit Function
        End If
        redRefreshLeft = redRefreshLeft - 1
        Call WorldLog("首怪刷新倒计时=" & redRefreshLeft)
        Call WorldWait(1000)
        If RedArmyExpired() Then
            Exit Function
        End If
        If redRefreshLeft < 1 Then
            redRefreshLeft = 6
            result = RefreshRedArmyPage()
            If result <> RESULT_OK Then
                Exit Function
            End If
            result = SelectRedArmyMap()
            If result <> RESULT_OK Then
                Exit Function
            End If
            WaitRedArmyRefresh = RESULT_OK
            Exit Function
        End If
        If WorldMatch("085_首怪打完") Then
            redFirstDone = True
            Call WorldLog("首怪明确打完，仅结束首怪阶段")
            WaitRedArmyRefresh = RESULT_OK
            Exit Function
        End If
        Call Progress()
        If WorldMatch("085_等待主界面") Then
            text = WorldText(262, 395, 404, 430)
            If text = "挑战次数：1" Or text = "挑战次数：2" Then
                Call WorldWait(1000)
                If RedArmyExpired() Then
                    Exit Function
                End If
                Call WorldLog("首怪次数刷新，继续首怪")
                WaitRedArmyRefresh = RESULT_OK
                Exit Function
            End If
        End If
    Next
End Function
Function RunRedArmyFirstMonster()
    Dim started, result
    RunRedArmyFirstMonster = RESULT_TIMEOUT
    started = TickCount()
    redActionAt = started
    redFirstDone = False
    redRefreshLeft = 6
    Do
        result = EnterRedArmyMonster("085_首怪")
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = SweepRedArmyMonster(1)
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = CloseRedArmyMonster(1)
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = RefreshRedArmyPage()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = SelectRedArmyMap()
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = WaitRedArmyRefresh()
        If result <> RESULT_OK Then
            Exit Function
        End If
        If redFirstDone Then
            RunRedArmyFirstMonster = RESULT_OK
            Exit Function
        End If
        If TickCount() - redActionAt > 120000 Then
            Call WorldLog("超时原因=专业版首怪120000ms无胜利/翻牌进展，恢复原85；不提交")
            Exit Function
        End If
        If TickCount() - started > 240000 Then
            Call WorldLog("超时原因=专业版首怪240000ms总计时，恢复原85；不提交")
            Exit Function
        End If
    Loop
End Function
Function ExecuteRedArmy(taskId)
    Dim result, mode, monster
    ExecuteRedArmy = RESULT_TIMEOUT
    terminalConfirmed = False
    redReason = ""
    Call WorldLog("业务入口 ExecuteRedArmy 编号=" & taskId)
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterRedArmy()
    If result <> RESULT_OK Then
        Exit Function
    End If
    If redMode = 0 Then
        result = SelectRedArmyMap()
        If result <> RESULT_OK Then
            Exit Function
        End If
        If taskId = 85 Then
            result = RunRedArmyFirstMonster()
            If result <> RESULT_OK Then
                Exit Function
            End If
        End If
        mode = 0
        If taskId = 85 Then
            mode = 2
        End If
        For monster = 2 To 3
            If taskId = 85 Then
                result = RefreshRedArmyPage()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                result = SelectRedArmyMap()
                If result <> RESULT_OK Then
                    Exit Function
                End If
            End If
            Call WorldLog("进入怪物序号=" & monster)
            If monster = 2 Then
                result = EnterRedArmyMonster("084_第二怪")
            Else
                result = EnterRedArmyMonster("084_第三怪")
            End If
            If result <> RESULT_OK Then
                Exit Function
            End If
            result = SweepRedArmyMonster(mode)
            If result <> RESULT_OK Then
                Exit Function
            End If
            result = CloseRedArmyMonster(0)
            If result <> RESULT_OK Then
                Exit Function
            End If
        Next
        redReason = "第二/第三怪按原流程收尾并确认红绸军主界面，本时段结束"
    End If
    If redReason = "" Or RedArmyExpired() Then
        Call WorldLog("失败原因=未确认业务终态；不提交")
        Exit Function
    End If
    If taskId = 84 Then
        red84Terminal = True
        red84Reason = redReason
        red84FinishedAt = Time()
    Else
        red85Terminal = True
        red85Reason = redReason
        red85FinishedAt = Time()
    End If
    terminalConfirmed = True
    Call WorldLog("正常终态=" & redReason & " 等待公共返回大厅连续确认；是否提交完成=否")
    ExecuteRedArmy = RESULT_OK
End Function


// flows/086_超战士传说/超战士传说.mq
Function LegendExpired()
    Dim expired
    expired = BusinessExpired()
    LegendExpired = expired
    If expired Then
        Call WorldLog("失败或超时原因=公共业务总超时或前台中断；保存原任务=86 是否提交完成=否")
    End If
End Function

Function ConfirmLegendTerminal(reason)
    ConfirmLegendTerminal = RESULT_TIMEOUT
    If LegendExpired() Then
        Exit Function
    End If
    legendReason = reason
    legendTerminal = True
    terminalConfirmed = True
    Call WorldLog("正常终态=" & reason & " 等待公共返回大厅连续确认；是否提交完成=否")
    ConfirmLegendTerminal = RESULT_OK
End Function

Function LegendAutoTriple()
    LegendAutoTriple = False
    If LegendExpired() Then
        Exit Function
    End If
    If WorldMatch("086_三倍已就绪") Then
        LegendAutoTriple = True
        Exit Function
    End If
    If WorldMatch("086_开启自动") Then
        If Not WorldOffset(-310, 170, 50) Then
            Exit Function
        End If
    ElseIf WorldMatch("086_开启三倍") Then
        If Not WorldOffset(318, 92, 50) Then
            Exit Function
        End If
    ElseIf WorldMatch("086_战斗基准") Then
        If Not WorldOffset(318, 16, 50) Then
            Exit Function
        End If
    End If
End Function

Function ExecuteLegend()
    Dim result, difficultyChecked, acted
    ExecuteLegend = RESULT_TIMEOUT
    terminalConfirmed = False
    legendTerminal = False
    legendReason = ""
    difficultyChecked = False
    Call WorldLog("业务入口 ExecuteLegend 编号=86")
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    Call WorldStage("超战士传说入口")
    Do
        If LegendExpired() Then
            Exit Function
        End If
        acted = False
        If WorldPair("086_未开启") Then
            Call WorldWait(2000)
            ExecuteLegend = ConfirmLegendTerminal("专业版灰色未开启入口，本轮结束")
            Exit Function
        End If
        If WorldPair("086_入口") Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
            acted = True
        End If
        If WorldPair("086_无任务") Then
            If Not difficultyChecked Then
                Call WorldLog("专业版分支=看看困难 等待毫秒=2000 点击坐标=120,718 等待毫秒=2000")
                Call WorldWait(2000)
                If Not WorldTap(120, 718, 2000) Then
                    Exit Function
                End If
                difficultyChecked = True
                acted = True
            Else
                Call WorldWait(2000)
                ExecuteLegend = ConfirmLegendTerminal("切换困难后仍明确当前没有任务，本轮结束")
                Exit Function
            End If
        End If
        If WorldPair("086_界面") Then
            Call WorldWait(500)
            Exit Do
        End If
        If Not acted Then
            Delay 50
        End If
    Loop
    Call Progress()
    Call WorldStage("超战士传说挑战循环")
    difficultyChecked = False
    Do
        If LegendExpired() Then
            Exit Function
        End If
        acted = False
        If WorldPair("086_界面") Then
            Call WorldLog("点击挑战 锚点=" & foundX & "," & foundY & " 等待毫秒=500")
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            Call Progress()
            acted = True
        End If
        If WorldMatch("152_开战图标6") Then
            Call WorldLog("挑战目标=6 固定坐标398,982到587,982 等待500/500")
            If Not WorldTap(398, 982, 500) Then
                Exit Function
            End If
            If Not WorldTap(587, 982, 500) Then
                Exit Function
            End If
            acted = True
        End If
        If LegendAutoTriple() Then
            Call WorldLog("专业版自动三倍已就绪，战斗中等待3000毫秒")
            Call WorldWait(3000)
            acted = True
        End If
        If WorldMatch("086_挑战成功") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            Call WorldLog("单场挑战成功，仅继续循环，尚非业务终态")
            Call Progress()
            acted = True
        End If
        If WorldPair("086_战斗失败") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            Call WorldLog("失败原因=专业版战斗失败分支；项目不复制其完成标记，恢复原任务86；是否提交完成=否")
            Exit Function
        End If
        If WorldPair("086_无任务") Then
            If Not difficultyChecked Then
                Call WorldWait(2000)
                If Not WorldTap(120, 718, 2000) Then
                    Exit Function
                End If
                difficultyChecked = True
                acted = True
            Else
                ExecuteLegend = ConfirmLegendTerminal("挑战后切换困难仍明确当前没有任务，本轮结束")
                Exit Function
            End If
        End If
        If Not acted Then
            Delay 50
        End If
    Loop
End Function


// flows/087_激战超越极限/激战超越极限.mq
Function BeyondExpired()
    Dim expired
    expired = BusinessExpired()
    BeyondExpired = expired
    If expired Then
        Call WorldLog("失败或超时原因=公共业务总超时或前台中断；保存原任务=87 是否提交完成=否")
    End If
End Function

Function ConfirmBeyondTerminal(reason)
    ConfirmBeyondTerminal = RESULT_TIMEOUT
    If BeyondExpired() Then
        Exit Function
    End If
    beyondReason = reason
    beyondTerminal = True
    terminalConfirmed = True
    Call WorldLog("正常终态=" & reason & " 等待公共返回大厅连续确认；是否提交完成=否")
    ConfirmBeyondTerminal = RESULT_OK
End Function

Function EnterBeyond()
    EnterBeyond = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BeyondExpired() Then
            Exit Function
        End If
            Delay 20
        Loop
        Swipe 370, 1000, 370, 300, 300
        Call WorldWait(1000)
        If WorldPair("087_入口") Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
        End If
        If WorldMatch("087_任务页一") Then
            Call WorldWait(300)
            EnterBeyond = RESULT_OK
            Exit Function
        End If
        If WorldMatch("087_已完成一") Then
            Call WorldWait(500)
            beyondRewardsReady = True
            EnterBeyond = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldMatch("087_未开启一") Then
            Call WorldWait(2000)
            EnterBeyond = ConfirmBeyondTerminal("专业版灰色未开放或等级不足，本轮结束")
            Exit Function
        End If
    Loop
End Function

Function EnterBeyondSupport()
    EnterBeyondSupport = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        If WorldPair("087_寻求支援") Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
        End If
        If WorldPair("087_支援无资源") Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
            EnterBeyondSupport = RESULT_OK
            Exit Function
        End If
        If WorldPair("087_支援页") Then
            Call WorldWait(300)
            EnterBeyondSupport = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function InviteBeyondWarriors()
    InviteBeyondWarriors = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        If WorldPair("087_可邀请") Then
            If Not WorldOffset(-160, -770, 500) Then
                Exit Function
            End If
            If Not WorldOffset(-160, -350, 500) Then
                Exit Function
            End If
            If Not WorldOffset(64, 29, 500) Then
                Exit Function
            End If
            InviteBeyondWarriors = RESULT_OK
            Exit Function
        End If
        If WorldPair("087_不可邀请") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            InviteBeyondWarriors = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function ReturnBeyondFromSupport()
    ReturnBeyondFromSupport = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        If WorldPair("087_不可邀请") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
        End If
        If WorldPair("087_返回按钮") Then
            Call WorldWait(1500)
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("087_任务页一") Then
            ReturnBeyondFromSupport = RESULT_OK
            Exit Function
        End If
        If WorldMatch("087_已完成一") Then
            Call WorldWait(500)
            ReturnBeyondFromSupport = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function FightBeyondRound()
    Dim battleClicks
    battleClicks = 0
    FightBeyondRound = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        If WorldMatch("087_已完成一") Then
            Call WorldWait(2000)
            FightBeyondRound = RESULT_OK
            Exit Function
        End If
        If WorldMatch("087_点击战斗") Then
            If battleClicks < 5 Then
            If Not WorldOffset(190, 12, 0) Then
                Exit Function
            End If
                battleClicks = battleClicks + 1
            Else
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            End If
        End If
        Call WorldWait(50)
        If WorldPair("087_开战页") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
        End If
        If WorldMatch("152_开战图标6") Then
            If Not WorldTap(398, 982, 500) Then
                Exit Function
            End If
            If Not WorldTap(587, 982, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("087_跳过") Then
            If Not WorldOffset(-310, 93, 50) Then
                Exit Function
            End If
            Call WorldWait(3000)
        End If
        If WorldMatch("087_挑战成功一") Then
            If Not WorldOffset(0, 0, 2000) Then
                Exit Function
            End If
            FightBeyondRound = RESULT_OK
            Exit Function
        End If
        If WorldMatch("087_挑战成功二") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            FightBeyondRound = RESULT_OK
            Exit Function
        End If
        If WorldPair("087_战斗失败") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            FightBeyondRound = ConfirmBeyondTerminal("专业版明确战斗失败并结束任务")
            Exit Function
        End If
    Loop
End Function

Function ContinueBeyondRound()
    ContinueBeyondRound = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        If WorldPair("087_战斗失败") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldPair("087_继续任务") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
        End If
        If WorldMatch("087_任务页一") Then
            ContinueBeyondRound = RESULT_OK
            Exit Function
        End If
        If WorldMatch("087_已完成一") Then
            Call WorldWait(50)
            beyondRewardsReady = True
            ContinueBeyondRound = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function FinishBeyondRewards()
    FinishBeyondRewards = RESULT_TIMEOUT
    Do
        If BeyondExpired() Then
            Exit Function
        End If
        If WorldMatch("087_已完成一") Then
            If Not WorldOffset(475, -975, 50) Then
                Exit Function
            End If
        End If
        If WorldMatch("087_奖励弹窗") Then
            If Not WorldOffset(0, 0, 50) Then
                Exit Function
            End If
        End If
        If WorldMatch("087_灰色领取") Then
            If Not WorldOffset(0, 0, 50) Then
                Exit Function
            End If
            FinishBeyondRewards = ConfirmBeyondTerminal("专业版英雄奖励领取完成")
            Exit Function
        End If
        If WorldMatch("087_蓝色领取") Then
            If Not WorldOffset(0, 0, 50) Then
                Exit Function
            End If
        End If
    Loop
End Function

Function ExecuteBeyond()
    Dim roundIndex
    ExecuteBeyond = RESULT_TIMEOUT
    terminalConfirmed = False
    beyondTerminal = False
    beyondReason = ""
    beyondRewardsReady = False
    If EnterEnemyHall() <> RESULT_OK Then
        Exit Function
    End If
    Call WorldStage("激战超越极限入口")
    If EnterBeyond() <> RESULT_OK Then
        Exit Function
    End If
    If beyondTerminal Then
        ExecuteBeyond = RESULT_OK
        Exit Function
    End If
    If Not beyondRewardsReady Then
        For roundIndex = 1 To 10
            Call WorldStage("激战超越极限寻求支援")
            If EnterBeyondSupport() <> RESULT_OK Then
                Exit Function
            End If
            Call WorldStage("激战超越极限邀请")
            If InviteBeyondWarriors() <> RESULT_OK Then
                Exit Function
            End If
            Call WorldStage("激战超越极限支援返回确认")
            If ReturnBeyondFromSupport() <> RESULT_OK Then
                Exit Function
            End If
            Call WorldStage("激战超越极限战斗")
            If FightBeyondRound() <> RESULT_OK Then
                Exit Function
            End If
            If beyondTerminal Then
                ExecuteBeyond = RESULT_OK
                Exit Function
            End If
            Call WorldWait(1000)
            Call WorldStage("激战超越极限继续任务")
            If ContinueBeyondRound() <> RESULT_OK Then
                Exit Function
            End If
            If beyondRewardsReady Then
                Exit For
            End If
        Next
    End If
    Call WorldStage("激战超越极限领奖")
    ExecuteBeyond = FinishBeyondRewards()
End Function


// flows/088_那美克星组队战/那美克星组队战.mq
Function NamekExpired()
    Dim expired
    expired = BusinessExpired()
    NamekExpired = expired
    If expired Then
        Call WorldLog("失败或超时原因=公共业务总超时或前台中断；保存原任务=88 是否提交完成=否")
    End If
End Function

Function ConfirmNamekTerminal(reason)
    ConfirmNamekTerminal = RESULT_TIMEOUT
    If NamekExpired() Then
        Exit Function
    End If
    namekReason = reason
    namekTerminal = True
    terminalConfirmed = True
    Call WorldLog("正常终态=" & reason & " 等待公共返回大厅连续确认；是否提交完成=否")
    ConfirmNamekTerminal = RESULT_OK
End Function

Function NamekRetry(reason)
    NamekRetry = RESULT_TIMEOUT
    If NamekExpired() Then
        Exit Function
    End If
    namekReason = reason
    namekRetryAt = Time() + 3600
    namekDeferred = True
    terminalConfirmed = False
    Call WorldLog("专业版一小时后重试 原因=" & reason & " 下一次执行时间Unix=" & namekRetryAt & " 是否提交完成=否")
    NamekRetry = RESULT_WAIT
End Function

Function EnterNamek()
    Dim started
    EnterNamek = RESULT_TIMEOUT
    started = TickCount()
    Call WorldStage("那美克星组队战入口")
    Do
        If NamekExpired() Then
            Exit Function
        End If
        // root.785 强敌入袭/滑下；root.636每轮先滑后等待1000。
        Do While Not Sys.AppIsFront(GAME_PACKAGE)
            If NamekExpired() Then
                Exit Function
            End If
            Delay 20
        Loop
        Call WorldLog("入口滑动=370,1000到370,300 时长=300 等待毫秒=1000")
        Swipe 370, 1000, 370, 300, 300
        Call WorldWait(1000)
        If WorldPair("088_入口") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If WorldPair("088_未开放") Then
            Call WorldWait(1000)
            EnterNamek = ConfirmNamekTerminal("专业版明确灰色入口未开放")
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("088_未准备") Then
            Call WorldWait(50)
            EnterNamek = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("088_准备") Then
            Call WorldWait(50)
            EnterNamek = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 25000 Then
            EnterNamek = NamekRetry("专业版入口25秒仍未到任务页")
            Exit Function
        End If
        If Time() < WorldDayStart(Time()) + 36000 Then
            EnterNamek = NamekRetry("恢复任务早于专业版10点业务时间")
            Exit Function
        End If
    Loop
End Function

Function PrepareNamek()
    PrepareNamek = RESULT_TIMEOUT
    Call WorldStage("那美克星组队战进入关卡")
    Do
        If NamekExpired() Then
            Exit Function
        End If
        If WorldPair("088_未准备") Then
            If Not WorldOffset(0, 0, 50) Then
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If WorldPair("088_准备") Then
            If Not WorldOffset(0, 0, 5000) Then
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If WorldPair("088_关卡") Then
            PrepareNamek = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("088_任务结束") Then
            Call WorldWait(2000)
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            PrepareNamek = ConfirmNamekTerminal("专业版准备阶段明确任务已经结束")
            Exit Function
        End If
    Loop
End Function

Function RunNamek()
    Dim quickRounds, idleRounds, defeats
    RunNamek = RESULT_TIMEOUT
    quickRounds = 0
    idleRounds = 0
    defeats = 0
    Call WorldStage("那美克星组队战挑战")
    Do
        If NamekExpired() Then
            Exit Function
        End If
        If quickRounds < 4 Then
            If WorldMatch("088_快速战斗") Then
                If Not WorldOffset(0, 0, 500) Then
                    Exit Function
                End If
            End If
            quickRounds = quickRounds + 1
        Else
            If WorldPair("088_关卡") Then
                idleRounds = idleRounds + 1
                Call WorldLog("专业版关卡轮点次数=" & idleRounds)
                If Not WorldOffset(-150, -280, 50) Then
                    Exit Function
                End If
                If Not WorldOffset(-20, -490, 50) Then
                    Exit Function
                End If
                If Not WorldOffset(-340, -620, 50) Then
                    Exit Function
                End If
                If Not WorldOffset(-210, -790, 50) Then
                    Exit Function
                End If
                If Not WorldOffset(60, -950, 50) Then
                    Exit Function
                End If
                Call WorldWait(500)
            End If
            quickRounds = 0
        End If
        If WorldMatch("088_小怪详情") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("152_开战图标6") Then
            If Not WorldTap(398, 982, 500) Then
                Exit Function
            End If
            If Not WorldTap(587, 982, 500) Then
                Exit Function
            End If
            idleRounds = 0
        End If
        If WorldMatch("088_跳过") Then
            If Not WorldOffset(-310, 93, 50) Then
                Exit Function
            End If
            Call WorldWait(3000)
            idleRounds = 0
        End If
        If WorldMatch("088_有宝箱") Then
            If Not WorldOffset(-146, -537, 50) Then
                Exit Function
            End If
            If Not WorldOffset(-146, -537, 500) Then
                Exit Function
            End If
            idleRounds = 0
        End If
        If WorldMatch("088_战斗失败") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            defeats = defeats + 1
            Call WorldLog("专业版战败次数=" & defeats & " 是否提交完成=否")
        End If
        Call WorldWait(50)
        If WorldPair("088_空宝箱") Then
            If Not WorldOffset(0, 0, 50) Then
                Exit Function
            End If
            idleRounds = 0
        End If
        Call WorldWait(50)
        If WorldPair("088_蓝框") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            RunNamek = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("088_任务结束") Then
            Call WorldWait(2000)
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            RunNamek = RESULT_OK
            Exit Function
        End If
        If idleRounds > 5 Then
            Call WorldLog("专业版关卡轮点超过5轮，只转收尾，不直接提交")
            RunNamek = RESULT_OK
            Exit Function
        End If
        If defeats > 5 Then
            RunNamek = NamekRetry("专业版战败超过5次，一小时后再次执行")
            Exit Function
        End If
    Loop
End Function

Function FinishNamek()
    FinishNamek = RESULT_TIMEOUT
    Call WorldStage("那美克星组队战收尾")
    Do
        If NamekExpired() Then
            Exit Function
        End If
        If WorldPair("088_任务结束") Then
            Call WorldWait(2000)
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If WorldPair("088_蓝框") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            FinishNamek = ConfirmNamekTerminal("专业版收尾首末关卡蓝框点击结束")
            Exit Function
        End If
        If WorldPair("088_关卡") Then
            FinishNamek = ConfirmNamekTerminal("专业版收尾明确回到关卡页面")
            Exit Function
        End If
    Loop
End Function

Function ExecuteNamek()
    Dim result
    ExecuteNamek = RESULT_TIMEOUT
    terminalConfirmed = False
    namekTerminal = False
    namekDeferred = False
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterNamek()
    If result <> RESULT_OK Or namekTerminal Then
        ExecuteNamek = result
        Exit Function
    End If
    result = PrepareNamek()
    If result <> RESULT_OK Or namekTerminal Then
        ExecuteNamek = result
        Exit Function
    End If
    result = RunNamek()
    If result <> RESULT_OK Then
        ExecuteNamek = result
        Exit Function
    End If
    ExecuteNamek = FinishNamek()
End Function


// flows/071_地球保卫战/地球保卫战.mq
Function EarthExpired()
    Dim expired
    expired = BusinessExpired()
    EarthExpired = expired
    If expired Then
        Call WorldLog("失败或超时原因=公共业务总超时或前台中断；保存原任务=71 是否提交完成=否")
    End If
End Function

Function ConfirmEarthTerminal(reason)
    ConfirmEarthTerminal = RESULT_TIMEOUT
    If EarthExpired() Then
        Exit Function
    End If
    earthReason = reason
    earthTerminal = True
    terminalConfirmed = True
    Call WorldLog("正常终态=" & reason & " 等待公共返回大厅连续确认；是否提交完成=否")
    ConfirmEarthTerminal = RESULT_OK
End Function

Function EnterEarth()
    Dim started, slideEnabled
    EnterEarth = RESULT_TIMEOUT
    started = TickCount()
    slideEnabled = True
    Call WorldStage("地球保卫战入口与扫荡勾选")
    Do
        If EarthExpired() Then
            Exit Function
        End If
        If slideEnabled Then
            Do While Not Sys.AppIsFront(GAME_PACKAGE)
                If EarthExpired() Then
                    Exit Function
                End If
                Delay 20
            Loop
            Call WorldLog("入口滑动=370,1000到370,300 时长=300 等待毫秒=1000")
            Swipe 370, 1000, 370, 300, 300
            Call WorldWait(1000)
        End If
        If WorldMatch("071_入口") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            started = TickCount()
            slideEnabled = False
        End If
        If WorldMatch("071_未开始") Then
            earthPrestart = True
            EnterEarth = ConfirmEarthTerminal("专业版明确地球保卫战未开始")
            Exit Function
        End If
        If WorldMatch("071_快速加入") Then
            If Not WorldTap(360, 1100, 500) Then
                Exit Function
            End If
            started = TickCount()
        End If
        If WorldMatch("071_聊天") Then
            If Not WorldTap(25, 1111, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("071_未勾扫荡") Then
            If Not WorldTap(600, 1200, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("071_已勾扫荡") Then
            earthMode = 1
            EnterEarth = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 20000 Then
            Call WorldLog("失败原因=专业版入口20秒无确认；恢复71，不提交")
            Exit Function
        End If
    Loop
End Function

Function BuyEarthAttempts()
    Dim started, configured, adds, expected, popupConfigured, attempts, i, text, priceOK, x, y
    BuyEarthAttempts = RESULT_TIMEOUT
    If earthBuyRuntime = 0 Then
        BuyEarthAttempts = RESULT_OK
        Exit Function
    End If
    Call WorldStage("地球保卫战购买次数")
    started = TickCount()
    configured = earthBuyRuntime
    adds = configured * 2 - 1
    expected = 40
    If configured = 2 Then
        expected = 100
    ElseIf configured = 3 Then
        expected = 200
    ElseIf configured = 4 Then
        expected = 360
    ElseIf configured = 5 Then
        expected = 560
    End If
    popupConfigured = False
    attempts = 0
    Do
        If EarthExpired() Then
            Exit Function
        End If
        If WorldMatch("071_已勾扫荡") Then
            If Not popupConfigured Then
                If Not WorldTap(600, 1150, 1000) Then
                    Exit Function
                End If
            Else
                BuyEarthAttempts = RESULT_OK
                Exit Function
            End If
        End If
        If WorldMatch("071_购买弹窗") Then
            x = foundX
            y = foundY
            If Not popupConfigured Then
                For i = 1 To adds
                    If Not WorldTap(x - 285, y + 145, 200) Then
                        Exit Function
                    End If
                Next
                Call WorldWait(1000)
                For i = 1 To 2
                    text = WorldText(364, 774, 422, 800)
                    Call WorldWait(200)
                Next
                popupConfigured = True
            Else
                text = WorldText(364, 774, 422, 800)
                priceOK = False
                If IsNumeric(text) Then
                    priceOK = Int(CDbl(text)) = expected
                End If
                If priceOK And attempts = 0 Then
                    If Not WorldTap(x - 310, y + 324, 0) Then
                        Exit Function
                    End If
                    Call WorldLog("购买确认次数=" & configured * 2 & " 识别金额=" & text)
                Else
                    If Not WorldTap(x - 11, y + 17, 0) Then
                        Exit Function
                    End If
                    Call WorldLog("关闭购买 原始金额=" & text & " 期望金额=" & expected & " 已尝试次数=" & attempts)
                End If
                attempts = attempts + 1
                Call WorldWait(1000)
                earthBuyRuntime = 0
            End If
        End If
        If TickCount() - started > 20000 Then
            Call WorldLog("失败原因=专业版购买20秒未返回业务页面；恢复71，不提交")
            Exit Function
        End If
    Loop
End Function

Function RunEarth()
    Dim actionAt
    RunEarth = RESULT_TIMEOUT
    actionAt = TickCount()
    Call WorldStage("地球保卫战扫荡与挑战")
    Do
        If EarthExpired() Then
            Exit Function
        End If
        If earthMode = 1 Then
            If WorldMatch("071_可扫荡") Then
                If Not WorldTap(500, 1100, 3000) Then
                    Exit Function
                End If
            End If
            If WorldMatch("071_扫荡灰色") Then
                earthMode = 2
                Call WorldLog("扫荡灰色，进入挑战阶段；是否提交完成=否")
            End If
        ElseIf earthMode = 2 Then
            If WorldMatch("071_可挑战") Then
                If Not WorldTap(200, 1100, 3000) Then
                    Exit Function
                End If
            End If
            If WorldMatch("071_挑战灰色") Then
                RunEarth = ConfirmEarthTerminal("专业版明确挑战灰色没有次数")
                Exit Function
            End If
        End If
        If WorldPair("071_开战") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("071_少人") Then
            If Not WorldOffset(0, 0, 2000) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("071_暂停") Then
            If Not WorldOffset(-311, 10, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("071_退出") Then
            // Professional Find2(..., true) sends the anchor click itself.
            If Not WorldOffset(0, 0, 2000) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("071_战斗结束") Then
            If Not WorldTap(145, 58, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If TickCount() - actionAt > 150000 Then
            Call WorldLog("失败原因=专业版战斗150秒无进展；恢复71，不提交")
            Exit Function
        End If
    Loop
End Function

Function ExecuteEarth()
    Dim result
    ExecuteEarth = RESULT_TIMEOUT
    terminalConfirmed = False
    earthTerminal = False
    earthPrestart = False
    earthMode = 0
    result = EnterEnemyHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterEarth()
    If result <> RESULT_OK Or earthTerminal Then
        ExecuteEarth = result
        Exit Function
    End If
    result = BuyEarthAttempts()
    If result <> RESULT_OK Then
        ExecuteEarth = result
        Exit Function
    End If
    ExecuteEarth = RunEarth()
End Function


// flows/078_战士集结/战士集结.mq
Function ConfirmGatherTerminal(reason)
    ConfirmGatherTerminal = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    gatherReason = reason
    gatherFinishedAt = Time()
    gatherTerminal = True
    terminalConfirmed = True
    Call WorldLog("专业版本轮出口=" & reason & "；等待公共返回大厅连续确认，未提交")
    ConfirmGatherTerminal = RESULT_OK
End Function

Function EnterGatherHall()
    Dim started, result
    EnterGatherHall = RESULT_TIMEOUT
    Call WorldStage("异时空冒险入口")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("078_异时空页面一") Or WorldMatch("078_异时空页面二") Or WorldMatch("078_异时空页面三") Then
            EnterGatherHall = RESULT_OK
            Exit Function
        End If
        result = ReturnToHall()
        If result <> RESULT_OK Then
            Exit Function
        End If
        If EnemyHallKnown() Then
            If WorldPair("078_异时空入口") Then
                If Not WorldOffset(0, 0, 1500) Then
                    Exit Function
                End If
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Or BusinessExpired() Then
                    Exit Function
                End If
                If Sys.AppIsFront(GAME_PACKAGE) Then
                    Swipe 150, 545, 500, 545, 300
                End If
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Exit Function
        End If
        Delay 20
    Loop
End Function

Function EnterGather()
    Dim started
    EnterGather = RESULT_TIMEOUT
    Call WorldStage("战士集结入口与开始收集")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("078_入口") Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
        End If
        If WorldMatch("078_本期结束") Then
            Call WorldWait(1000)
            gatherPeriodEnded = True
            EnterGather = ConfirmGatherTerminal("图色确认本期已结束")
            Exit Function
        End If
        If WorldMatch("078_开始收集") Then
            If Not WorldOffset(251, -263, 300) Then
                Exit Function
            End If
        End If
        If WorldMatch("078_收集界面") Then
            Call WorldWait(300)
            EnterGather = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 20000 Then
            gatherEntryTimeout = True
            EnterGather = ConfirmGatherTerminal("专业版入口20秒出口；20点前改约20:05，不冒充次数耗尽")
            Exit Function
        End If
    Loop
End Function

Function RunGather()
    Dim newCount, oldCount, mode, oldY, searchAt, actionAt, x, y, matched
    RunGather = RESULT_TIMEOUT
    newCount = 0
    oldCount = 0
    mode = 0
    oldY = 0
    searchAt = TickCount()
    actionAt = TickCount()
    Call WorldStage("战士集结推图与扫荡")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If newCount < 4 And TickCount() - searchAt < 5000 Then
            If WorldMatch("078_新关卡") Then
                oldY = foundY
                If Not WorldOffset(0, 0, 300) Then
                    Exit Function
                End If
                mode = 1
            End If
            actionAt = TickCount()
        Else
            If WorldMatch("078_老关卡") Then
                oldY = foundY
                If Not WorldOffset(0, 0, 300) Then
                    Exit Function
                End If
                mode = 2
            End If
        End If
        If WorldMatch("078_关卡详情") Then
            x = foundX
            y = foundY
            If gatherDouble Then
                If Not WorldTap(x - 286, y + 626, 0) Then
                    Exit Function
                End If
            End If
            Call WorldWait(200)
            If mode = 1 Then
                If Not WorldTap(x - 121, y + 558, 200) Then
                    Exit Function
                End If
                If Not WorldTap(x, y, 1000) Then
                    Exit Function
                End If
                newCount = newCount + 1
                actionAt = TickCount()
            Else
                If oldCount < 4 Then
                    If Not WorldTap(x - 121, y + 558, 0) Then
                        Exit Function
                    End If
                    If oldCount >= 3 Then
                        actionAt = TickCount()
                    End If
                Else
                    If gatherSweep And oldY < 350 Then
                        If Not WorldTap(x - 452, y + 558, 0) Then
                            Exit Function
                        End If
                    Else
                        oldCount = 9
                    End If
                End If
                Call WorldWait(500)
                If Not WorldTap(x, y, 1000) Then
                    Exit Function
                End If
                oldCount = oldCount + 1
            End If
            Call WorldLog("新图计数=" & newCount & " 老图计数=" & oldCount & " 模式=" & mode & " 老图Y=" & oldY)
        End If
        If WorldMatch("078_关卡对话") Then
            If Not WorldOffset(55, 1040, 100) Then
                Exit Function
            End If
        End If
        If WorldMatch("152_开战图标6") Then
            If Not WorldTap(587, 982, 500) Then
                Exit Function
            End If
            If Not WorldTap(398, 982, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("078_跳过战斗") Then
            If Not WorldOffset(-310, 93, 50) Then
                Exit Function
            End If
            Call WorldWait(3000)
            actionAt = TickCount()
        End If
        If WorldMatch("078_阵容不满") Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
        End If
        If WorldMatch("078_结算一") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            searchAt = TickCount()
        End If
        If WorldMatch("078_结算二") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            oldCount = 0
            newCount = 0
            searchAt = TickCount()
            actionAt = TickCount()
        End If
        If WorldMatch("078_扫荡返回") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If oldCount >= 8 Or TickCount() - actionAt > 10000 Then
            If WorldMatch("078_收集界面") Then
                RunGather = RESULT_OK
                Exit Function
            End If
        End If
    Loop
End Function

Function FinishGather()
    Dim started, slot, dx
    FinishGather = RESULT_TIMEOUT
    Call WorldStage("战士集结七位置任务")
    started = TickCount()
    slot = 1
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("078_收集界面") Then
            dx = 102
            If slot = 2 Then
                dx = 170
            ElseIf slot = 3 Then
                dx = 246
            ElseIf slot = 4 Then
                dx = 316
            ElseIf slot = 5 Then
                dx = 363
            ElseIf slot = 6 Then
                dx = 433
            ElseIf slot = 7 Then
                dx = 513
            End If
            If Not WorldOffset(dx, -155, 500) Then
                Exit Function
            End If
            slot = slot + 1
            If slot > 7 Then
                slot = 1
            End If
        End If
        If WorldMatch("078_任务详情") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("078_任务提示") Then
            If Not WorldOffset(-161, -560, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("078_任务关闭") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If TickCount() - started > 10000 Then
            If WorldMatch("078_收集界面") Then
                FinishGather = ConfirmGatherTerminal("专业版七位置处理10秒且重新确认收集界面")
                Exit Function
            End If
        End If
    Loop
End Function

Function ExecuteGather()
    Dim result
    ExecuteGather = RESULT_TIMEOUT
    result = EnterGatherHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterGather()
    If gatherTerminal Then
        ExecuteGather = result
        Exit Function
    End If
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = RunGather()
    If result <> RESULT_OK Then
        Exit Function
    End If
    ExecuteGather = FinishGather()
End Function


// flows/079_超宇宙战士/超宇宙战士.mq
Function ConfirmUniverseTerminal(reason)
    ConfirmUniverseTerminal = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    universeReason = reason
    universeFinishedAt = Time()
    universeTerminal = True
    terminalConfirmed = True
    Call WorldLog("专业版本轮出口=" & reason & "；等待公共回大厅确认，未提交")
    ConfirmUniverseTerminal = RESULT_OK
End Function

Function EnterUniverse()
    EnterUniverse = RESULT_TIMEOUT
    Call WorldStage("超宇宙战士入口")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("079_未开启") Then
            Call WorldWait(200)
            EnterUniverse = ConfirmUniverseTerminal("图色确认未开启")
            Exit Function
        End If
        If WorldPair("079_入口") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
        End If
        If WorldPair("079_地图") Or WorldMatch("079_地图三") Then
            Call WorldWait(300)
            EnterUniverse = RESULT_OK
            Exit Function
        End If
        If WorldMatch("079_全通关入口") Then
            Call WorldWait(1000)
            If Not WorldTap(150, 50, 300) Then
                Exit Function
            End If
            universeFullClear = True
        End If
    Loop
End Function

Function UniverseMapPoint(layout, index)
    Dim x, y
    UniverseMapPoint = False
    x = 0
    y = 0
    If layout = 1 Then
        If index = 1 Then
            x = 393
            y = 1070
        ElseIf index = 2 Then
            x = 190
            y = 843
        ElseIf index = 3 Then
            x = 383
            y = 779
        ElseIf index = 4 Then
            x = 620
            y = 622
        ElseIf index = 5 Then
            x = 441
            y = 491
        ElseIf index = 6 Then
            x = 191
            y = 372
        End If
    ElseIf layout = 2 Then
        If index = 1 Then
            x = 506
            y = 967
        ElseIf index = 2 Then
            x = 183
            y = 882
        ElseIf index = 3 Then
            x = 374
            y = 741
        ElseIf index = 4 Then
            x = 665
            y = 637
        ElseIf index = 5 Then
            x = 454
            y = 598
        ElseIf index = 6 Then
            x = 253
            y = 370
        End If
    ElseIf layout = 3 Then
        If index = 1 Then
            x = 388
            y = 1085
        ElseIf index = 2 Then
            x = 180
            y = 869
        ElseIf index = 3 Then
            x = 432
            y = 734
        ElseIf index = 4 Then
            x = 639
            y = 645
        ElseIf index = 5 Then
            x = 304
            y = 350
        End If
    End If
    If x > 0 Then
        UniverseMapPoint = WorldTap(x, y, 300)
    End If
End Function

Function RunUniverse()
    Dim point, attempts, battles, misses, actionAt
    RunUniverse = RESULT_TIMEOUT
    Call WorldStage("超宇宙战士地图挑战")
    point = 1
    attempts = 0
    battles = 0
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("079_巡图一") Then
            If point <= 6 Then
                If Not UniverseMapPoint(1, point) Then
                    Exit Function
                End If
                point = point + 1
            Else
                point = 1
            End If
        End If
        If WorldMatch("079_巡图二") Then
            If point <= 6 Then
                If Not UniverseMapPoint(2, point) Then
                    Exit Function
                End If
                point = point + 1
            Else
                point = 1
            End If
        End If
        If WorldMatch("079_巡图三") Then
            If point <= 5 Then
                If Not UniverseMapPoint(3, point) Then
                    Exit Function
                End If
                point = point + 1
            Else
                point = 1
            End If
        End If
        If WorldPair("079_获得") Then
            If Not WorldTap(150, 50, 250) Then
                Exit Function
            End If
            attempts = 0
            actionAt = TickCount()
        End If
        If WorldPair("079_关卡详情") Then
            If WorldPair("079_挑战按钮") Then
                If attempts >= 2 Then
                    If Not WorldTap(210, 858, 250) Then
                        Exit Function
                    End If
                End If
                If Not WorldTap(507, 862, 250) Then
                    Exit Function
                End If
                attempts = attempts + 1
                Call WorldLog("地图挑战尝试=" & attempts)
            End If
        End If
        If WorldMatch("152_开战图标6") Then
            battles = battles + 1
            misses = 0
            If battles < 2 Then
                If Not WorldTap(398, 982, 1000) Then
                    Exit Function
                End If
                Do
                    If BusinessExpired() Then
                        Exit Function
                    End If
                    If WorldMatch("079_首次开战确认") Then
                        If Not WorldTap(398, 982, 1000) Then
                            Exit Function
                        End If
                    Else
                        misses = misses + 1
                        Call WorldWait(200)
                    End If
                    If misses > 5 Then
                        Exit Do
                    End If
                Loop
                If Not WorldTap(128, 1228, 1500) Then
                    Exit Function
                End If
                attempts = 0
                actionAt = TickCount()
            Else
                If Not WorldTap(128, 1228, 1500) Then
                    Exit Function
                End If
            End If
        End If
        If attempts > 5 Or TickCount() - actionAt > 15000 Then
            RunUniverse = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function ReturnUniversePage(finalReturn)
    Dim reportAt
    ReturnUniversePage = RESULT_TIMEOUT
    reportAt = TickCount()
    If finalReturn Then
        Call WorldStage("超宇宙战士最终界面确认")
    Else
        Call WorldStage("超宇宙战士挑战后返回")
    End If
    Do
        If BusinessExpired() Then
            Call WorldLog("返回确认退出：公共计时或前台中断；未确认返回界面，不提交")
            Exit Function
        End If
        If finalReturn Then
            Call WorldWait(50)
            If WorldMatch("079_胶囊失败") Then
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
            End If
        Else
            If WorldPair("079_获得") Then
                If Not WorldOffset(0, 0, 50) Then
                    Exit Function
                End If
            End If
            If WorldMatch("079_全通关返回") Then
                If Not WorldTap(150, 50, 1000) Then
                    Exit Function
                End If
            End If
            Call WorldWait(50)
            If WorldMatch("079_关闭窗口") Then
                If Not WorldOffset(0, 0, 200) Then
                    Exit Function
                End If
            End If
        End If
        If WorldPair("079_返回界面") Then
            If finalReturn Then
                Call WorldWait(50)
            Else
                Call WorldWait(200)
            End If
            ReturnUniversePage = RESULT_OK
            Exit Function
        End If
        If TickCount() - reportAt >= 5000 Then
            Call WorldLog("返回界面尚未命中；不盲点、不放宽识别；距原计时重置毫秒=" & (TickCount() - businessStarted))
            reportAt = TickCount()
        End If
    Loop
End Function

Function RunUniverseCapsule()
    Dim actionAt, started, idleLimit, starts, quickCount
    RunUniverseCapsule = RESULT_TIMEOUT
    Call WorldStage("超宇宙战士胶囊任务")
    actionAt = TickCount()
    started = TickCount()
    idleLimit = 5000
    starts = 0
    quickCount = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("079_胶囊入口") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        Call WorldWait(50)
        If WorldMatch("079_打开胶囊") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
            starts = 0
        End If
        Call WorldWait(50)
        If WorldMatch("079_胶囊任务页") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
            starts = 0
            quickCount = 0
        End If
        Call WorldWait(50)
        If WorldMatch("079_打开胶囊") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
            starts = 0
            quickCount = 0
        End If
        Call WorldWait(50)
        If WorldMatch("079_胶囊快速挑战") Then
            quickCount = quickCount + 1
            If quickCount > 4 Then
                If Not WorldOffset(-440, 850, 0) Then
                    Exit Function
                End If
                quickCount = 0
            Else
                If Not WorldOffset(-150, 850, 0) Then
                    Exit Function
                End If
            End If
            If Not ResetUniverseTaskTimer() Then
                Exit Function
            End If
            Call WorldWait(200)
            actionAt = TickCount()
            idleLimit = 15000
            starts = 0
            Call WorldLog("胶囊快速计数=" & quickCount)
        End If
        Call WorldWait(50)
        If WorldMatch("152_开战图标6") Then
            If Not WorldTap(398, 982, 500) Then
                Exit Function
            End If
            If Not WorldTap(587, 982, 500) Then
                Exit Function
            End If
            starts = starts + 1
            Call WorldLog("胶囊开战累计=" & starts)
        End If
        If WorldMatch("079_阵容不足") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("078_跳过战斗") Then
            If Not WorldOffset(-310, 93, 50) Then
                Exit Function
            End If
            actionAt = TickCount()
            starts = 0
            quickCount = 0
            idleLimit = 15000
        End If
        If WorldPair("079_胶囊获得") Then
            If Not WorldTap(150, 50, 500) Then
                Exit Function
            End If
            starts = 0
            quickCount = 0
            actionAt = TickCount()
        End If
        If WorldMatch("079_胶囊失败") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            universeReason = "专业版胶囊失败出口；不是挑战成功"
            RunUniverseCapsule = RESULT_OK
            Exit Function
        End If
        If TickCount() - actionAt > idleLimit Or starts > 10 Or TickCount() - started > 180000 Then
            If starts > 10 And universeFailureMode = 1 Then
                Call WorldLog("专业版开战超过10次且选择重启任务；交公共恢复79，不提交")
                Exit Function
            End If
            RunUniverseCapsule = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function ExecuteUniverse()
    Dim result
    ExecuteUniverse = RESULT_TIMEOUT
    result = EnterGatherHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterUniverse()
    If universeTerminal Then
        ExecuteUniverse = result
        Exit Function
    End If
    If result <> RESULT_OK Then
        Exit Function
    End If
    If Not ResetUniverseTaskTimer() Then
        Exit Function
    End If
    If Not universeFullClear Then
        result = RunUniverse()
        If result <> RESULT_OK Then
            Exit Function
        End If
    End If
    If Not ResetUniverseTaskTimer() Then
        Exit Function
    End If
    result = ReturnUniversePage(False)
    If result <> RESULT_OK Then
        Exit Function
    End If
    If Not ResetUniverseTaskTimer() Then
        Exit Function
    End If
    If universeCapsule Then
        result = RunUniverseCapsule()
        If result <> RESULT_OK Then
            Exit Function
        End If
    End If
    If Not ResetUniverseTaskTimer() Then
        Exit Function
    End If
    result = ReturnUniversePage(True)
    If result <> RESULT_OK Then
        Exit Function
    End If
    Call WorldWait(500)
    If universeReason = "" Then
        universeReason = "专业版挑战及可选胶囊处理后确认返回界面"
    End If
    ExecuteUniverse = ConfirmUniverseTerminal(universeReason)
End Function


// flows/082_战士记忆/战士记忆.mq
Function EnterMemory()
    Dim actionAt, index, patternName
    EnterMemory = RESULT_TIMEOUT
    Call WorldStage("战士记忆入口完成状态识别")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("082_未开启") Then
            Call WorldWait(200)
            EnterMemory = ConfirmMemoryTerminal("图色确认未开启")
            Exit Function
        End If
        If WorldMatch("082_入口") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        For index = 0 To 4
            patternName = "082_完成状态" & index
            If WorldMatch(patternName) Then
                memoryInitial = index
                Call WorldWait(200)
                EnterMemory = RESULT_OK
                Exit Function
            End If
        Next
        If TickCount() - actionAt > 5000 Then
            memoryInitial = 4
            Call WorldLog("专业版入口5秒出口转领奖，不代表识别到完成或次数耗尽")
            EnterMemory = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function MemoryNativeLimit()
    MemoryNativeLimit = False
    If TickCount() - memoryStarted > 180000 Then
        If ConfirmMemoryTerminal("专业版挑战/返回/重入共享180秒出口；非胜利证明") = RESULT_OK Then
            MemoryNativeLimit = True
        End If
    End If
End Function

Function ReturnMemoryPage()
    ReturnMemoryPage = RESULT_TIMEOUT
    Call WorldStage("战士记忆挑战后返回")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_蓝按钮") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            memoryAnswer = 1
        End If
        If WorldMatch("082_失败") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_胜利") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_返回界面") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_主界面") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_入口") Then
            ReturnMemoryPage = RESULT_OK
            Exit Function
        End If
        If MemoryNativeLimit() Then
            ReturnMemoryPage = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function ReenterMemory()
    ReenterMemory = RESULT_TIMEOUT
    Call WorldStage("战士记忆重入")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_大厅入口") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_入口") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_主界面") Then
            ReenterMemory = RESULT_OK
            Exit Function
        End If
        If MemoryNativeLimit() Then
            ReenterMemory = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function AdvanceMemoryBranch()
    AdvanceMemoryBranch = False
    If memorySide >= 1 And memoryAnswer = 1 Then
        AdvanceMemoryBranch = True
        Exit Function
    End If
    If memoryAnswer = 1 Then
        memorySide = memorySide + 1
    End If
    If memoryAnswer = 0 Then
        memoryAnswer = 1
    Else
        memoryAnswer = 0
    End If
    Call WorldLog("专业版自动分支：侧=" & memorySide & " 答案=" & memoryAnswer)
End Function

Function RunMemory()
    Dim cleanup, result, index, x, y
    RunMemory = RESULT_TIMEOUT
    memoryAnswer = 0
    memorySide = 0
    If memoryInitial = 1 Then
        memorySide = 1
    ElseIf memoryInitial = 2 Then
        memorySide = 2
    End If
    memoryStarts = 0
    memoryStarted = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldStage("战士记忆挑战")
        cleanup = False
        If WorldMatch("082_蓝按钮") Then
            cleanup = True
        Else
            If WorldMatch("082_下一步") Then
                x = foundX
                y = foundY
                For index = 1 To 4
                    If Not WorldTap(x, y, 100) Then
                        Exit Function
                    End If
                Next
            End If
        End If
        If Not cleanup Then
            If WorldMatch("082_失败") Then
                cleanup = True
            ElseIf WorldMatch("082_胜利") Then
                cleanup = True
            End If
        End If
        If Not cleanup Then
            If WorldMatch("082_主界面") Then
                If memorySide = 0 Or memorySide = 2 Then
                    If Not WorldOffset(26, -525, 0) Then
                        Exit Function
                    End If
                Else
                    If Not WorldOffset(480, -525, 0) Then
                        Exit Function
                    End If
                End If
            End If
            If WorldMatch("082_答案") Then
                If memoryAnswer = 0 Then
                    If Not WorldOffset(0, 0, 0) Then
                        Exit Function
                    End If
                Else
                    If Not WorldOffset(195, 0, 0) Then
                        Exit Function
                    End If
                End If
            End If
            If WorldMatch("152_开战图标6") Then
                If memoryAnswer = 0 Then
                    If Not WorldTap(128, 1228, 0) Then
                        Exit Function
                    End If
                    cleanup = True
                Else
                    If Not WorldTap(398, 982, 500) Then
                        Exit Function
                    End If
                    If Not WorldTap(587, 982, 500) Then
                        Exit Function
                    End If
                    memoryStarts = memoryStarts + 1
                End If
            End If
            If Not cleanup Then
                If WorldMatch("078_跳过战斗") Then
                    If Not WorldOffset(-310, 93, 50) Then
                        Exit Function
                    End If
                    Call WorldWait(500)
                    memoryStarts = 0
                End If
                If memoryStarts > 20 Then
                    If memoryFailureMode = 1 Then
                        Call WorldLog("专业版开战超过20次置重启标志；交公共恢复82，不提交")
                        Exit Function
                    Else
                        memoryUncompleted = True
                        RunMemory = RESULT_WAIT
                        Exit Function
                    End If
                End If
                If MemoryNativeLimit() Then
                    RunMemory = RESULT_OK
                    Exit Function
                End If
            End If
        End If
        If cleanup Then
            result = ReturnMemoryPage()
            If result <> RESULT_OK Or memoryTerminal Then
                RunMemory = result
                Exit Function
            End If
            result = ReenterMemory()
            If result <> RESULT_OK Or memoryTerminal Then
                RunMemory = result
                Exit Function
            End If
            If AdvanceMemoryBranch() Then
                RunMemory = RESULT_OK
                Exit Function
            End If
        End If
    Loop
End Function

Function FinishMemoryRewards()
    Dim actionAt
    FinishMemoryRewards = RESULT_TIMEOUT
    Call WorldStage("战士记忆双侧奖励")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_获得一") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_完成状态3") Then
            If Not WorldOffset(248, -437, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_完成状态4") Then
            Exit Do
        End If
        If TickCount() - actionAt > 5000 Then
            FinishMemoryRewards = ConfirmMemoryTerminal("专业版双侧领奖5秒无动作出口；不是次数耗尽")
            Exit Function
        End If
    Loop
    Call WorldStage("战士记忆附加奖励")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_获得二") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_主界面") Then
            If Not WorldOffset(354, -1074, 50) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_奖励面板") Then
            If Not WorldTap(600, 416, 50) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_最终界面") Then
            FinishMemoryRewards = ConfirmMemoryTerminal("专业版最终界面出口")
            Exit Function
        End If
        If TickCount() - actionAt > 5000 Then
            FinishMemoryRewards = ConfirmMemoryTerminal("专业版附加奖励5秒无动作出口；非胜利证明")
            Exit Function
        End If
    Loop
End Function

Function ExecuteMemory()
    Dim result
    ExecuteMemory = RESULT_TIMEOUT
    result = EnterGatherHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterMemory()
    If memoryTerminal Or result <> RESULT_OK Then
        ExecuteMemory = result
        Exit Function
    End If
    If memoryInitial < 3 Then
        result = RunMemory()
        If memoryTerminal Or result <> RESULT_OK Then
            ExecuteMemory = result
            Exit Function
        End If
    End If
    ExecuteMemory = FinishMemoryRewards()
End Function


// flows/080_弗利萨军团/弗利萨军团.mq
Function EnterFrieza()
    EnterFrieza = RESULT_TIMEOUT
    Call WorldStage("弗利萨军团入口")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("080_入口") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
        End If
        If WorldPair("080_未开启") Then
            Call WorldWait(200)
            EnterFrieza = ConfirmFriezaTerminal("图色确认未开启")
            Exit Function
        End If
        If WorldMatch("080_已完成") Then
            Call WorldWait(200)
            EnterFrieza = ConfirmFriezaTerminal("图色确认已完成")
            Exit Function
        End If
        If WorldMatch("080_基地界面") Then
            Call WorldWait(200)
            friezaEntryMode = 1
            EnterFrieza = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldPair("080_旧关入口") Then
            Call WorldWait(200)
            friezaEntryMode = 2
            EnterFrieza = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If WorldMatch("080_新关入口") Then
            Call WorldWait(200)
            friezaEntryMode = 3
            EnterFrieza = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function RunFriezaOld()
    Dim actionAt
    RunFriezaOld = RESULT_TIMEOUT
    Call WorldStage("弗利萨军团旧关处理")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldPair("080_旧关绿色") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
        End If
        If WorldPair("080_旧关蓝色") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            actionAt = TickCount()
            Call WorldWait(200)
        End If
        If WorldPair("080_旧关确定") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            Call FriezaProgress()
            Call WorldWait(1500)
            Exit Do
        End If
        Call WorldWait(500)
        If TickCount() - actionAt > 10000 Then
            Exit Do
        End If
    Loop
    Call FriezaProgress()
    Call WorldStage("弗利萨军团旧关后返回")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldPair("080_旧关蓝色") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            actionAt = TickCount()
            Call WorldWait(200)
        End If
        If WorldPair("080_旧关确定") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
        End If
        If WorldMatch("080_已完成") Then
            Call WorldWait(200)
            RunFriezaOld = ConfirmFriezaTerminal("旧关返回图色确认已完成")
            Exit Function
        End If
        If WorldMatch("080_基地界面") Then
            Call WorldWait(200)
            friezaEntryMode = 1
            RunFriezaOld = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function FriezaAutoTriple()
    FriezaAutoTriple = False
    If BusinessExpired() Then
        Exit Function
    End If
    If WorldMatch("086_三倍已就绪") Then
        FriezaAutoTriple = True
        Exit Function
    End If
    If WorldMatch("086_开启自动") Then
        If Not WorldOffset(-310, 170, 50) Then
            Exit Function
        End If
    ElseIf WorldMatch("086_开启三倍") Then
        If Not WorldOffset(318, 92, 50) Then
            Exit Function
        End If
    ElseIf WorldMatch("086_战斗基准") Then
        If Not WorldOffset(318, 16, 50) Then
            Exit Function
        End If
    End If
End Function

Function FriezaStartBattle()
    FriezaStartBattle = False
    If Not WorldTap(398, 982, 500) Then
        Exit Function
    End If
    FriezaStartBattle = WorldTap(587, 982, 500)
End Function

Function RunFriezaNew()
    Dim started
    RunFriezaNew = RESULT_TIMEOUT
    Call WorldStage("弗利萨军团新关挑战")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("080_新关入口") Then
            If Not WorldTap(355, 1100, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("080_新关挑战") Then
            If Not WorldTap(514, 760, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("080_新关获得") Then
            If Not WorldTap(150, 50, 500) Then
                Exit Function
            End If
            Call FriezaProgress()
        End If
        If WorldMatch("152_开战图标6") Then
            If Not FriezaStartBattle() Then
                Exit Function
            End If
        End If
        If FriezaAutoTriple() Then
            Call WorldWait(500)
            Call FriezaProgress()
        End If
        If WorldMatch("080_已完成") Then
            Call WorldWait(200)
            RunFriezaNew = ConfirmFriezaTerminal("新关图色确认已完成")
            Exit Function
        End If
        If WorldMatch("080_基地界面") Then
            RunFriezaNew = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 360000 Then
            friezaTimedOut = True
            friezaReason = "专业版新关360秒超时处理，不是完成"
            Exit Function
        End If
    Loop
End Function

Function FriezaBaseFailure(counter)
    FriezaBaseFailure = RESULT_WAIT
    If counter > 10 Then
        If friezaFailureMode = 1 Then
            Call WorldLog("专业版基地计数超过10请求公共重启，不提交")
            FriezaBaseFailure = RESULT_TIMEOUT
        Else
            FriezaBaseFailure = ConfirmFriezaTerminal("专业版基地开战失败选择结束任务；不是胜利")
        End If
    End If
End Function

Function RunFriezaBase()
    Dim counter, result
    RunFriezaBase = RESULT_TIMEOUT
    Call WorldStage("弗利萨军团秘密基地")
    counter = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("080_基地界面") Then
            If Not WorldTap(467, 134, 200) Then
                Exit Function
            End If
            counter = 0
        End If
        If WorldPair("080_探索") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            counter = 0
        End If
        If WorldPair("080_触发战斗") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            counter = 0
        End If
        If WorldMatch("152_开战图标6") Then
            If Not FriezaStartBattle() Then
                Exit Function
            End If
        End If
        If WorldMatch("078_跳过战斗") Then
            If Not WorldOffset(-310, 93, 50) Then
                Exit Function
            End If
            Call WorldWait(2000)
            counter = 0
            Call FriezaProgress()
        End If
        If WorldPair("080_基地结束") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            RunFriezaBase = RESULT_OK
            Exit Function
        End If
        // root.624 local R4 is only cleared; do not invent a counter increment.
        result = FriezaBaseFailure(counter)
        If result <> RESULT_WAIT Then
            RunFriezaBase = result
            Exit Function
        End If
    Loop
End Function

Function FinishFrieza()
    FinishFrieza = RESULT_TIMEOUT
    Call WorldStage("弗利萨军团基地结束确认")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldPair("080_基地结束") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            Call FriezaProgress()
            Call WorldWait(200)
        End If
        If WorldMatch("080_已完成") Then
            Call WorldWait(200)
            Exit Do
        End If
    Loop
    Call WorldWait(500)
    FinishFrieza = ConfirmFriezaTerminal("基地结束后图色确认已完成")
End Function

Function ExecuteFrieza()
    Dim result
    ExecuteFrieza = RESULT_TIMEOUT
    Call FriezaProgress()
    friezaRunning = True
    result = EnterGatherHall()
    If result <> RESULT_OK Then
        If Not ForegroundInterrupted() Then
            friezaTimedOut = True
            friezaReason = "专业版异时空公共入口超时，入口未确认"
        End If
        Exit Function
    End If
    result = EnterFrieza()
    If friezaTerminal Or result <> RESULT_OK Then
        ExecuteFrieza = result
        Exit Function
    End If
    Call FriezaProgress()
    If friezaEntryMode = 2 Then
        result = RunFriezaOld()
    ElseIf friezaEntryMode = 3 Then
        result = RunFriezaNew()
    End If
    If friezaEntryMode = 2 Or friezaEntryMode = 3 Then
        If friezaTerminal Or result <> RESULT_OK Then
            ExecuteFrieza = result
            Exit Function
        End If
    End If
    If friezaTerminal Then
        ExecuteFrieza = result
        Exit Function
    End If
    Call FriezaProgress()
    result = RunFriezaBase()
    If friezaTerminal Or result <> RESULT_OK Then
        ExecuteFrieza = result
        Exit Function
    End If
    ExecuteFrieza = FinishFrieza()
End Function


// flows/081_强者对决/强者对决.mq
Function DuelMatch(index)
    Dim key
    If index < 10 Then
        key = "081_P0" & index
    Else
        key = "081_P" & index
    End If
    DuelMatch = WorldMatch(key)
End Function
Function DuelPair(first, second)
    DuelPair = True
    If DuelMatch(first) Then
        Exit Function
    End If
    DuelPair = DuelMatch(second)
End Function
Function EnterDuel()
    Dim scans
    EnterDuel = RESULT_TIMEOUT
    Call WorldStage("强者对决入口")
    scans = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Do While Not Sys.AppIsFront(GAME_PACKAGE)
            If BusinessExpired() Then
                Exit Function
            End If
            Delay 20
        Loop
        If scans > 1 Then
            scans = 0
            Swipe 370, 300, 370, 1000, 300
        Else
            scans = scans + 1
            Swipe 370, 1000, 370, 300, 300
        End If
        Call WorldWait(1000)
        If DuelPair(0, 1) Then
            EnterDuel = ConfirmDuelTerminal("完整图色确认未开启")
            Exit Function
        End If
        Call WorldWait(200)
        If DuelPair(2, 3) Then
            If Not WorldOffset(0, 0, 300) Then
                Exit Function
            End If
        End If
        Call WorldWait(50)
        If DuelMatch(4) Then
            duelEntryMode = 2
            EnterDuel = RESULT_OK
            Exit Function
        End If
        Call WorldWait(50)
        If DuelMatch(5) Then
            If duelProphecy <> 0 Then
                duelEntryMode = 1
                EnterDuel = RESULT_OK
            Else
                EnterDuel = ConfirmDuelTerminal("对决已完成且不抽预言")
            End If
            Exit Function
        End If
        If DuelMatch(6) Then
            Call WorldWait(1000)
            Call DuelProgress()
            EnterDuel = ConfirmDuelTerminal("完整灰色完成图色出口")
            Exit Function
        End If
    Loop
End Function
Function RefreshDuelManual()
    Dim attempts, x, y, starsFound
    RefreshDuelManual = RESULT_TIMEOUT
    Call WorldStage("强者对决普通刷新")
    attempts = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If duelStars < 2 Then
            If DuelMatch(7) Then
                RefreshDuelManual = RESULT_OK
                Exit Function
            End If
        End If
        If DuelMatch(8) Then
            x = foundX
            y = foundY
            Call WorldWait(500)
            starsFound = False
            If duelStars = 0 Then
                starsFound = DuelPair(9, 10)
            ElseIf duelStars = 1 Or duelStars = 2 Then
                starsFound = DuelPair(13, 14)
            ElseIf duelStars = 3 Then
                starsFound = DuelPair(15, 16)
            End If
            If starsFound Then
                Call WorldWait(1000)
                Call DuelProgress()
                RefreshDuelManual = RESULT_OK
                Exit Function
            End If
            Call WorldWait(500)
            If DuelPair(11, 12) Then
                Call WorldWait(1000)
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
            Else
                If Not WorldTap(x + 53, y - 97, 0) Then
                    Exit Function
                End If
                attempts = attempts + 1
            End If
        End If
        If duelStars < 2 And attempts > 1 Then
            RefreshDuelManual = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function DuelQuickCondition()
    DuelQuickCondition = False
    If duelQuickStars = 1 Then
        If duelQuickMultiple = 0 Then
            DuelQuickCondition = DuelMatch(18)
        ElseIf duelQuickMultiple = 1 Then
            DuelQuickCondition = DuelMatch(19)
        ElseIf duelQuickMultiple = 2 Then
            DuelQuickCondition = DuelMatch(20)
        End If
    ElseIf duelQuickStars = 0 Then
        If duelQuickMultiple = 1 Then
            DuelQuickCondition = DuelMatch(21)
        ElseIf duelQuickMultiple = 2 Then
            DuelQuickCondition = DuelMatch(22)
        End If
    End If
End Function
Function RefreshDuelQuick()
    Dim opened, toggles, dy
    RefreshDuelQuick = RESULT_TIMEOUT
    Call WorldStage("强者对决一键刷新")
    opened = False
    toggles = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If DuelMatch(8) Then
            If Not opened Then
                If Not WorldOffset(260, -95, 1000) Then
                    Exit Function
                End If
                opened = True
            Else
                RefreshDuelQuick = RESULT_OK
                Exit Function
            End If
        End If
        Call WorldWait(5)
        If DuelMatch(17) Then
            toggles = toggles + 1
            dy = 252
            If toggles = 1 Or toggles = 5 Then
                dy = 114
            ElseIf toggles = 2 Or toggles = 6 Then
                dy = 188
            End If
            If Not WorldOffset(-90, dy, 0) Then
                Exit Function
            End If
            If toggles = 7 Then
                toggles = 0
            End If
            Call WorldWait(1000)
        End If
        Call WorldWait(5)
        If DuelQuickCondition() Then
            If Not WorldOffset(-288, 320, 500) Then
                Exit Function
            End If
            opened = True
        End If
    Loop
End Function
Function RunDuelBattle()
    Dim starts
    RunDuelBattle = RESULT_TIMEOUT
    Call WorldStage("强者对决挑战")
    starts = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If DuelMatch(17) Then
            If Not WorldOffset(-288, 320, 1000) Then
                Exit Function
            End If
        End If
        If DuelPair(23, 24) Then
            If Not WorldOffset(0, 0, 2000) Then
                Exit Function
            End If
            Call DuelProgress()
            starts = 0
        End If
        If WorldMatch("152_开战图标6") Then
            If Not WorldTap(398, 982, 1000) Then
                Exit Function
            End If
            If Not WorldTap(587, 982, 500) Then
                Exit Function
            End If
            starts = starts + 1
        End If
        If WorldMatch("078_跳过战斗") Then
            If Not WorldOffset(-310, 93, 50) Then
                Exit Function
            End If
            Call WorldWait(1000)
            starts = 0
            Call DuelProgress()
        End If
        If DuelPair(25, 26) Then
            Call WorldWait(500)
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            Call DuelProgress()
            starts = 0
            RunDuelBattle = RESULT_OK
            Exit Function
        End If
        If DuelMatch(5) Then
            If duelProphecy <> 0 Then
                RunDuelBattle = RESULT_OK
            Else
                RunDuelBattle = ConfirmDuelTerminal("对决完成且不抽预言")
            End If
            Exit Function
        End If
        If starts > 10 Then
            If duelFailureMode = 1 Then
                Call WorldLog("专业版开战超过10次请求公共重启，不提交")
            Else
                duelEarlyStop = True
                Call WorldLog("专业版写完成后PC1765仍跳往1768；继续最终确认，不提前提交")
                RunDuelBattle = RESULT_OK
            End If
            Exit Function
        End If
    Loop
End Function
Function ReturnDuelPage()
    ReturnDuelPage = RESULT_TIMEOUT
    Call WorldStage("强者对决挑战后确认")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If DuelPair(25, 26) Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            Call DuelProgress()
        End If
        Call WorldWait(5)
        If DuelMatch(5) Then
            If duelProphecy <> 0 Then
                ReturnDuelPage = RESULT_OK
            Else
                ReturnDuelPage = ConfirmDuelTerminal("最终确认对决完成且不抽预言")
            End If
            Exit Function
        End If
        Call WorldWait(5)
        If DuelMatch(6) Then
            Call WorldWait(1000)
            Call DuelProgress()
            ReturnDuelPage = ConfirmDuelTerminal("最终灰色完成图色出口")
            Exit Function
        End If
    Loop
End Function
Function RunDuelProphecy()
    Dim actionAt
    RunDuelProphecy = RESULT_TIMEOUT
    Call WorldStage("强者对决强者预言")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If DuelMatch(27) Then
            If Not WorldOffset(461, -970, 500) Then
                Exit Function
            End If
        End If
        If DuelMatch(28) Then
            If duelProphecy = 1 Then
                If Not WorldOffset(93, -194, 1000) Then
                    Exit Function
                End If
            ElseIf duelProphecy = 2 Then
                If Not WorldOffset(434, -194, 1000) Then
                    Exit Function
                End If
            End If
            actionAt = TickCount()
        End If
        If DuelMatch(29) Then
            If Not WorldOffset(485, -306, 500) Then
                Exit Function
            End If
        End If
        If DuelPair(30, 31) Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If DuelMatch(32) Then
            Call WorldWait(500)
            RunDuelProphecy = RESULT_OK
            Exit Function
        End If
        If TickCount() - actionAt > 8000 Or duelProphecy = 1 Then
            If DuelMatch(33) Then
                Call WorldWait(500)
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
            End If
        End If
    Loop
End Function
Function ExecuteDuel()
    Dim result
    ExecuteDuel = RESULT_TIMEOUT
    If duelPendingTerminal Then
        ExecuteDuel = ConfirmDuelTerminal("专业版已确认出口；恢复时只补公共大厅提交，不重复刷新或抽取")
        Exit Function
    End If
    Call DuelProgress()
    duelRunning = True
    result = EnterGatherHall()
    If result <> RESULT_OK Then
        If Not ForegroundInterrupted() Then
            duelTimedOut = True
            duelReason = "异时空公共入口超时，入口未确认"
        End If
        Exit Function
    End If
    result = EnterDuel()
    If duelTerminal Or result <> RESULT_OK Then
        ExecuteDuel = result
        Exit Function
    End If
    If duelEntryMode = 2 Then
        If duelQuickStars = 0 And duelQuickMultiple = 0 Then
            result = RefreshDuelManual()
        Else
            Call DuelProgress()
            result = RefreshDuelQuick()
        End If
        If result <> RESULT_OK Then
            Exit Function
        End If
        result = RunDuelBattle()
        If duelTerminal Or result <> RESULT_OK Then
            ExecuteDuel = result
            Exit Function
        End If
        result = ReturnDuelPage()
        If duelTerminal Or result <> RESULT_OK Then
            ExecuteDuel = result
            Exit Function
        End If
    End If
    If duelProphecy <> 0 Then
        result = RunDuelProphecy()
        If result <> RESULT_OK Then
            Exit Function
        End If
    End If
    Call WorldWait(500)
    ExecuteDuel = ConfirmDuelTerminal("专业版预言结束出口")
End Function


// common/悟空送仙豆状态.mq
Sub LoadSenzuSettings()
    senzuEnabled = WorldBoolean("日常_悟空送仙豆")
End Sub
Sub NewSenzuSession()
    senzuDue = Time()
    senzuDone = False
    senzuAssist = True
    senzuCount = 0
    senzuRecoveries = 0
    senzuRestarts = 0
    senzuPhase = "未开始"
    senzuReason = ""
    senzuStop = False
    senzuFinishedAt = 0
End Sub
Function SelectSenzu()
    SelectSenzu = 0
    If senzuEnabled And Not senzuDone And Time() >= senzuDue Then
        SelectSenzu = 153
    End If
End Function
Sub StartSenzuTask()
    senzuReason = ""
    senzuStop = False
    senzuFinishedAt = 0
    Call WorldStage("悟空送仙豆启动")
    Call WorldLog("协助好友=" & CStr(senzuAssist) & " 已提交次数=" & senzuCount)
End Sub
Sub RecoverSenzuTask()
    senzuReason = ""
    senzuStop = False
    senzuRecoveries = senzuRecoveries + 1
    Call WorldLog("保存原任务153；不写完成，不改下次时间；协助好友=" & CStr(senzuAssist))
End Sub
Sub RestartSenzuTask()
    senzuRestarts = senzuRestarts + 1
    Call WorldLog("重启原任务153 次数=" & senzuRestarts)
End Sub
Sub CommitSenzuTask()
    If senzuStop Then
        senzuCount = 3
        senzuDone = True
    Else
        senzuCount = senzuCount + 1
        senzuDue = senzuFinishedAt + 3600
        senzuDone = senzuCount > 3
    End If
    Call WorldLog("公共大厅确认后提交153 次数=" & senzuCount & " 出口=" & senzuReason & " 下次Unix=" & senzuDue & " 已完成=" & CStr(senzuDone))
End Sub
Function ResetSenzuTimer()
    ResetSenzuTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    Call WorldLog("专业版任务计时重置")
    ResetSenzuTimer = True
End Function
Function ConfirmSenzuExit(reason, stopTask)
    ConfirmSenzuExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    senzuReason = reason
    senzuStop = stopTask
    senzuFinishedAt = Time()
    terminalConfirmed = True
    Call WorldLog("专业版出口=" & reason & "；仍须公共大厅确认，尚未提交")
    ConfirmSenzuExit = RESULT_OK
End Function


// flows/153_悟空送仙豆/悟空送仙豆.mq
Function EnterSenzu()
    Dim started, actionAt, result, clicked
    EnterSenzu = RESULT_TIMEOUT
    Call WorldStage("悟空送仙豆大厅入口")
    started = TickCount()
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("153_P00") Then
            EnterSenzu = RESULT_OK
            Exit Function
        End If
        If TickCount() - actionAt > 2000 Then
            If WorldMatch("153_大厅一") Or WorldMatch("153_大厅二") Or WorldMatch("153_大厅三") Then
                If WorldMatch("153_入口") Then
                    If Not WorldOffset(0, 0, 0) Then
                        Exit Function
                    End If
                Else
                    result = ReturnToHall()
                    If result <> RESULT_OK Then
                        Exit Function
                    End If
                    If Not Sys.AppIsFront(GAME_PACKAGE) Or BusinessExpired() Then
                        Exit Function
                    End If
                    Swipe 150, 545, 500, 545, 300
                End If
                actionAt = TickCount()
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("专业版入口60秒失败；按现工程未知页面不提交契约恢复153，不伪装业务完成")
            Exit Function
        End If
        Delay 20
    Loop
End Function

Function AssistSenzu()
    Dim refreshAt, actionAt, count, superReady, i, x, y
    AssistSenzu = RESULT_TIMEOUT
    Call WorldStage("悟空送仙豆协助好友")
    refreshAt = TickCount()
    actionAt = TickCount()
    count = 0
    superReady = False
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If count > 4 Then
            senzuAssist = False
            Call WorldLog("专业版协助结束；协助好友锁存关闭，不代表运送完成")
            AssistSenzu = RESULT_OK
            Exit Function
        End If
        If TickCount() - refreshAt > 3000 Then
            If WorldMatch("153_P00") Then
                If Not WorldOffset(437, -102, 0) Then
                    Exit Function
                End If
                refreshAt = TickCount()
                actionAt = TickCount()
                count = count + 1
                Call WorldWait(50)
            End If
        End If
        Call WorldWait(50)
        If WorldPair("153_协助入口") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            actionAt = TickCount()
            count = 0
            Call WorldWait(50)
        End If
        Call WorldWait(50)
        If WorldPair("153_协助列表") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            actionAt = TickCount()
            count = count + 1
            Call WorldWait(50)
        End If
        Call WorldWait(50)
        If WorldMatch("153_P05") Then
            If Not WorldOffset(-288, 713, 1000) Then
                Exit Function
            End If
            superReady = True
        End If
        If superReady Then
            If WorldMatch("153_P06") Then
                x = foundX - 288
                y = foundY + 713
                For i = 1 To 80
                    If Not WorldTap(x, y, 20) Then
                        Exit Function
                    End If
                Next
                superReady = False
            End If
        End If
        If TickCount() - actionAt > 10000 Then
            If WorldMatch("153_P07") Then
                If Not WorldOffset(14, 18, 1000) Then
                    Exit Function
                End If
                superReady = True
            End If
        End If
        Call WorldWait(50)
        If WorldPair("153_已协助关闭") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("153_P10") Then
            If Not WorldOffset(-371, 574, 1000) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
    Loop
End Function

Function TransportSenzu()
    Dim refreshes
    TransportSenzu = RESULT_TIMEOUT
    Call WorldStage("悟空送仙豆运送")
    refreshes = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("153_P11") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P00") Then
            If Not WorldOffset(230, -97, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P12") Then
            If Not WorldTap(80, 600, 250) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P13") Then
            If Not WorldTap(584, 582, 0) Then
                Exit Function
            End If
            refreshes = refreshes + 1
            Call WorldWait(250)
        End If
        If WorldMatch("153_P14") Then
            If Not WorldOffset(0, 0, 100) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P15") Then
            If Not WorldOffset(-22, -571, 100) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P16") Then
            If Not WorldTap(360, 1100, 250) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P17") Then
            If Not WorldTap(140, 1100, 500) Then
                Exit Function
            End If
            If Not WorldTap(360, 1100, 250) Then
                Exit Function
            End If
        End If
        If WorldPair("153_护送完成") Then
            If Not WorldOffset(0, 0, 100) Then
                Exit Function
            End If
        End If
        If WorldPair("153_消费石头") Then
            Call WorldWait(500)
            TransportSenzu = RESULT_OK
            Exit Function
        End If
        If refreshes > 4 Then
            TransportSenzu = ConfirmSenzuExit("专业版运送刷新超过4次，结束本轮任务并置原计数3", True)
            Exit Function
        End If
    Loop
End Function

Function FinishSenzu()
    FinishSenzu = RESULT_TIMEOUT
    Call WorldStage("悟空送仙豆收尾确认")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldPair("153_消费石头") Then
            If Not WorldOffset(0, 0, 50) Then
                Exit Function
            End If
        End If
        If WorldMatch("153_P00") Then
            If senzuCount + 1 > 3 Then
                Call WorldWait(1000)
            End If
            FinishSenzu = ConfirmSenzuExit("专业版运送收尾回到仙豆界面", False)
            Exit Function
        End If
    Loop
End Function

Function ExecuteSenzu()
    Dim result
    ExecuteSenzu = RESULT_TIMEOUT
    result = EnterSenzu()
    If result <> RESULT_OK Then
        Exit Function
    End If
    If senzuAssist Then
        result = AssistSenzu()
        If result <> RESULT_OK Then
            Exit Function
        End If
    End If
    If Not ResetSenzuTimer() Then
        Exit Function
    End If
    result = TransportSenzu()
    If terminalConfirmed Or result <> RESULT_OK Then
        ExecuteSenzu = result
        Exit Function
    End If
    If Not ResetSenzuTimer() Then
        Exit Function
    End If
    ExecuteSenzu = FinishSenzu()
End Function


// common/种仙豆状态.mq
Sub LoadPlantSettings()
    plantEnabled = WorldBoolean("日常_种仙豆")
End Sub
Sub NewPlantSession()
    plantDue = WorldDayStart(Time()) + 21600
    plantDone = False
    plantCount = 0
    plantRecoveries = 0
    plantRestarts = 0
    plantPhase = "未开始"
    plantReason = ""
End Sub
Function SelectPlant()
    SelectPlant = 0
    If plantEnabled And Not plantDone And Time() >= plantDue Then
        SelectPlant = 154
    End If
End Function
Sub StartPlantTask()
    plantReason = ""
    Call WorldStage("种仙豆启动")
    Call WorldLog("专业版06:00任务；本次执行不新增购买配置")
End Sub
Sub RecoverPlantTask()
    plantReason = ""
    plantRecoveries = plantRecoveries + 1
    Call WorldLog("保存原任务154；未确认收尾，不提交完成")
End Sub
Sub RestartPlantTask()
    plantRestarts = plantRestarts + 1
    Call WorldLog("重启原任务154 次数=" & plantRestarts)
End Sub
Sub CommitPlantTask()
    plantDone = True
    plantCount = plantCount + 1
    Call WorldLog("公共大厅确认后提交154 次数=" & plantCount & " 出口=" & plantReason & "；不自行安排一小时或跨日重跑")
End Sub
Function ResetPlantTimer()
    ResetPlantTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    Call WorldLog("专业版任务计时重置")
    ResetPlantTimer = True
End Function
Function ConfirmPlantExit(reason)
    ConfirmPlantExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    plantReason = reason
    terminalConfirmed = True
    Call WorldLog("专业版出口=" & reason & "；尚未提交，等待公共大厅确认")
    ConfirmPlantExit = RESULT_OK
End Function


// flows/154_种仙豆/种仙豆.mq
Function EnterPlant()
    Dim started, result
    EnterPlant = RESULT_TIMEOUT
    Call WorldStage("种仙豆大厅入口")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("154_P00") Then
            EnterPlant = RESULT_OK
            Exit Function
        End If
        result = ReturnToHall()
        If result <> RESULT_OK Then
            Exit Function
        End If
        If WorldMatch("153_大厅一") Or WorldMatch("153_大厅二") Or WorldMatch("153_大厅三") Then
            If WorldPair("154_入口") Then
                If Not WorldOffset(0, 0, 1500) Then
                    Exit Function
                End If
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                If Not Sys.AppIsFront(GAME_PACKAGE) Or BusinessExpired() Then
                    Exit Function
                End If
                Swipe 150, 545, 500, 545, 300
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("专业版入口60秒出口；现公共契约保留154恢复，不以未知界面标完成")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ConfirmPlantPage()
    ConfirmPlantPage = RESULT_TIMEOUT
    Call WorldStage("种仙豆页面确认")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("154_P00") Then
            Call WorldWait(1000)
            If BusinessExpired() Then
                Exit Function
            End If
            ConfirmPlantPage = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function RunPlant()
    Dim started, collectCount, phase
    RunPlant = RESULT_TIMEOUT
    Call WorldStage("种仙豆收取与金币升级")
    started = TickCount()
    collectCount = 0
    phase = 0
    If Not ResetPlantTimer() Then
        Exit Function
    End If
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If phase = 0 Then
            If WorldMatch("154_P00") Then
                If Not WorldOffset(-23, -70, 1000) Then
                    Exit Function
                End If
                collectCount = collectCount + 1
            End If
        ElseIf phase = 1 Then
            If WorldMatch("154_P01") Then
                If Not WorldOffset(250, -940, 1500) Then
                    Exit Function
                End If
            End If
            If WorldMatch("154_P02") Then
                If Not WorldOffset(0, 0, 1000) Then
                    Exit Function
                End If
            End If
            If WorldMatch("154_P03") Then
                Call WorldLog("专业版主界面需要龙石出口；不点击购买")
                RunPlant = RESULT_OK
                Exit Function
            End If
            If WorldMatch("154_P04") Then
                Call WorldLog("专业版升级弹层需要龙石出口；不确认购买")
                RunPlant = RESULT_OK
                Exit Function
            End If
            If WorldMatch("154_P05") Then
                Call WorldLog("专业版满级出口")
                RunPlant = RESULT_OK
                Exit Function
            End If
        End If
        If WorldMatch("154_P06") Then
            If Not WorldTap(150, 50, 50) Then
                Exit Function
            End If
            If Not ResetPlantTimer() Then
                Exit Function
            End If
            phase = 1
        End If
        If collectCount > 5 Then
            phase = 1
        End If
        If TickCount() - started > 20000 Then
            Call WorldLog("专业版业务20秒阶段出口；不是终态，继续收尾确认")
            RunPlant = RESULT_OK
            Exit Function
        End If
    Loop
End Function
Function FinishPlant()
    Dim started
    FinishPlant = RESULT_TIMEOUT
    Call WorldStage("种仙豆收尾确认")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("154_P06") Then
            If Not WorldTap(150, 50, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("154_P04") Then
            If Not WorldOffset(-30, 20, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("154_P00") Or WorldMatch("154_P05") Then
            Call WorldWait(500)
            FinishPlant = ConfirmPlantExit("原种仙豆主界面或满级界面确认")
            Exit Function
        End If
        If TickCount() - started > 10000 Then
            Call WorldLog("专业版收尾10秒失败；保留154恢复，未确认页面不提交")
            Exit Function
        End If
    Loop
End Function
Function ExecutePlant()
    Dim result
    ExecutePlant = RESULT_TIMEOUT
    result = EnterPlant()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = ConfirmPlantPage()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = RunPlant()
    If result <> RESULT_OK Then
        Exit Function
    End If
    ExecutePlant = FinishPlant()
End Function


// common/蛇道状态.mq
Sub LoadSnakeSettings()
    snakeEnabled = WorldBoolean("日常_蛇道")
    snakeCatchup = WorldNumber("日常_蛇道_补打", 1, 1)
    snakeHour = WorldNumber("日常_蛇道_时间", 9, 23)
    snakeMinute = WorldNumber("日常_蛇道_分钟", 10, 59)
    snakeMode = WorldNumber("日常_蛇道_模式", 0, 2)
    snakeAnimation = WorldNumber("日常_蛇道_跳过动画", 1, 1)
    snakeHireRow = WorldNumber("日常_蛇道_雇佣战士_行", 0, 9)
    snakeHireColumn = WorldNumber("日常_蛇道_雇佣战士_个", 0, 2)
    snakeHireSlot = WorldNumber("日常_蛇道_雇佣战士_位置", 5, 6)
    snakeEffect = WorldNumber("日常_蛇道_特殊效果", 0, 13)
    snakeOrdinary = ReadUIConfig("日常_蛇道_普通关卡", "9,10,11,12,13")
    snakeHard = ReadUIConfig("日常_蛇道_困难关卡", "1,2,3,4,5,6,7,8")
    snakeFailureLimit = WorldNumber("日常_蛇道_失败次数", 3, 99)
End Sub
Sub NewSnakeSession()
    snakeDue = WorldDayStart(Time()) + snakeHour * 3600 + snakeMinute * 60
    snakeDone = False
    snakeCount = 0
    snakeRecoveries = 0
    snakeRestarts = 0
    snakePhase = "未开始"
    snakeReason = ""
    snakeRetry = False
    snakeFinishedAt = 0
    snakeFloor = 1
    snakeFailures = 0
    snakeStarts = 0
    snakeActionAt = TickCount()
    snakeCatchupUsed = False
End Sub
Function SelectSnake()
    Dim seconds
    SelectSnake = 0
    seconds = Time() - WorldDayStart(Time())
    If snakeCatchup = 0 And Not snakeCatchupUsed And seconds > 1800 And seconds < 17400 Then
        snakeEnabled = True
        snakeDone = False
        snakeMode = 1
        snakeDue = Time()
        snakeCatchupUsed = True
        Call WorldLog("原00:30至04:50开区间补打；本会话一次、运行时强打，不改保存配置")
    End If
    If snakeEnabled And Not snakeDone And Time() >= snakeDue Then
        SelectSnake = 155
    End If
End Function
Sub StartSnakeTask()
    snakeReason = ""
    snakeRetry = False
    snakeFinishedAt = 0
    Call WorldStage("蛇道启动")
    Call WorldLog("模式=" & snakeMode & " 动画=" & snakeAnimation & "；雇佣旧OCR兼容，不声称识别引擎一致")
End Sub
Sub RecoverSnakeTask()
    snakeReason = ""
    snakeRetry = False
    snakeRecoveries = snakeRecoveries + 1
    Call WorldLog("保存原任务155；未确认出口和大厅，不提交完成或改期")
End Sub
Sub RestartSnakeTask()
    snakeRestarts = snakeRestarts + 1
    Call WorldLog("重启原任务155 次数=" & snakeRestarts)
End Sub
Sub CommitSnakeTask()
    snakeCount = snakeCount + 1
    If snakeRetry Then
        snakeDue = snakeFinishedAt + 3600
    Else
        snakeDone = True
    End If
    Call WorldLog("公共大厅确认后提交155 出口=" & snakeReason & " 完成=" & CStr(snakeDone) & " 下次Unix=" & snakeDue)
End Sub
Function ResetSnakeTimer()
    ResetSnakeTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    ResetSnakeTimer = True
End Function
Function ConfirmSnakeExit(reason, retryLater)
    ConfirmSnakeExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    snakeReason = reason
    snakeRetry = retryLater
    snakeFinishedAt = Time()
    terminalConfirmed = True
    Call WorldLog("专业版出口=" & reason & " 延后一小时=" & CStr(retryLater) & "；等待公共大厅确认")
    ConfirmSnakeExit = RESULT_OK
End Function
Function SnakeListContains(raw, stage)
    Dim text, start, i, item
    SnakeListContains = False
    If IsNull(raw) Then
        Exit Function
    End If
    text = CStr(raw) & ","
    start = 1
    For i = 1 To Len(text)
        If Mid(text, i, 1) = "," Then
            item = Mid(text, start, i - start)
            If IsNumeric(item) Then
                If Int(CDbl(item)) = stage Then
                    SnakeListContains = True
                    Exit Function
                End If
            End If
            start = i + 1
        End If
    Next
End Function
Function SnakeDifficulty(stage)
    SnakeDifficulty = 0
    If SnakeListContains(snakeOrdinary, stage) Then
        SnakeDifficulty = 1
    ElseIf SnakeListContains(snakeHard, stage) Then
        SnakeDifficulty = 2
    End If
End Function


// flows/155_蛇道/蛇道.mq
Function SnakeSwipe(x1, y1, x2, y2, duration, waitMs)
    SnakeSwipe = False
    If BusinessExpired() Or Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    Swipe x1, y1, x2, y2, duration
    Call WorldWait(waitMs)
    SnakeSwipe = Not BusinessExpired()
End Function
Function EnterSnake()
    Dim started, result, hallAt
    EnterSnake = RESULT_TIMEOUT
    Call WorldStage("蛇道大厅入口")
    started = TickCount()
    hallAt = started
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("155_P63") Or WorldMatch("155_P46") Then
            EnterSnake = RESULT_OK
            Exit Function
        End If
        If WorldMatch("155_P60") Or WorldMatch("155_P61") Or WorldMatch("155_P62") Then
            If WorldMatch("155_P58") Or WorldMatch("155_P59") Then
                If Not WorldOffset(0, 0, 200) Then
                    Exit Function
                End If
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                If Not SnakeSwipe(500, 545, 150, 545, 300, 0) Then
                    Exit Function
                End If
            End If
            hallAt = TickCount()
        End If
        If TickCount() - hallAt > 4000 Then
            result = ReturnToHall()
            If result <> RESULT_OK Then
                Exit Function
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("专业版入口60秒出口；公共契约保留155恢复，不将未知页面记完成")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function SnakeHireTextHit()
    Dim text
    SnakeHireTextHit = False
    If BusinessExpired() Then
        Exit Function
    End If
    // Approved 3.8 substitute: same rectangle/keywords, not the same OCR engine.
    text = WorldText(82, 545, 648, 637)
    If IsNull(text) Then
        Exit Function
    End If
    If Len(Trim(CStr(text))) = 0 Then
        Exit Function
    End If
    SnakeHireTextHit = InStr(1, CStr(text), "雇佣") > 0 Or InStr(1, CStr(text), "该战士") > 0
End Function
Function SnakeHireScroll(fullPage)
    SnakeHireScroll = False
    If Not SnakeSwipe(358, 991, 358, 491, 400, 0) Then
        Exit Function
    End If
    If Not SnakeSwipe(259, 655, 254, 654, 200, 1000) Then
        Exit Function
    End If
    If fullPage Then
        If Not SnakeSwipe(358, 991, 358, 741, 400, 0) Then
            Exit Function
        End If
        If Not SnakeSwipe(259, 655, 254, 654, 200, 500) Then
            Exit Function
        End If
    End If
    SnakeHireScroll = True
End Function
Function HireSnakeWarrior()
    Dim started, pages, dx, dy, remainder, phase, clicks, ax, ay
    HireSnakeWarrior = RESULT_TIMEOUT
    If snakeHireRow = 0 Then
        HireSnakeWarrior = RESULT_OK
        Exit Function
    End If
    Call WorldStage("蛇道雇佣战士")
    pages = Int((snakeHireRow - 1) / 3)
    remainder = snakeHireRow - Int(snakeHireRow / 3) * 3
    dy = -285
    If remainder = 1 Then
        dy = -791
    ElseIf remainder = 2 Then
        dy = -539
    End If
    dx = 44
    If snakeHireColumn = 1 Then
        dx = 249
    ElseIf snakeHireColumn = 2 Then
        dx = 450
    End If
    phase = 0
    clicks = 0
    started = TickCount()
    Do While TickCount() - started < 90000
        If BusinessExpired() Then
            Exit Function
        End If
        If phase = 0 Then
            If WorldMatch("155_P00") Then
                If Not WorldOffset(405, -100, 1000) Then
                    Exit Function
                End If
            End If
            If WorldMatch("155_P02") Then
                ax = foundX
                ay = foundY
                Call WorldWait(500)
                If pages > 0 Then
                    If Not SnakeHireScroll(True) Then
                        Exit Function
                    End If
                    pages = pages - 1
                Else
                    If Not WorldTap(ax + dx, ay + dy, 200) Then
                        Exit Function
                    End If
                    If Not WorldTap(ax + dx, ay + dy, 300) Then
                        Exit Function
                    End If
                    clicks = clicks + 1
                End If
                If clicks >= 3 Then
                    phase = 1
                End If
            End If
        Else
            If WorldMatch("155_P02") Then
                If Not SnakeHireScroll(False) Then
                    Exit Function
                End If
            End If
            If WorldMatch("155_P03") Then
                If Not WorldOffset(0, 0, 1500) Then
                    Exit Function
                End If
            End If
        End If
        Call WorldWait(50)
        If WorldMatch("155_P04") Then
            Exit Do
        End If
        Call WorldWait(50)
        If WorldMatch("155_P05") Then
            If SnakeHireTextHit() Then
                If Not WorldTap(517, 758, 200) Then
                    Exit Function
                End If
                If Not WorldTap(517, 758, 500) Then
                    Exit Function
                End If
            End If
            Exit Do
        End If
    Loop
    If Not BusinessExpired() Then
        HireSnakeWarrior = RESULT_OK
    End If
End Function
Function SweepSnake()
    Dim started, ax, ay
    SweepSnake = False
    Call WorldStage("蛇道扫荡")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("155_P49") Then
            If Not WorldOffset(252, -347, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("155_P50") Then
            ax = foundX
            ay = foundY
            If Not WorldTap(ax + 26, ay + 316, 300) Then
                Exit Function
            End If
            If Not WorldTap(ax - 177, ay + 638, 300) Then
                Exit Function
            End If
            If Not WorldTap(ax - 174, ay + 860, 1000) Then
                Exit Function
            End If
        End If
        If WorldMatch("155_P51") Then
            If Not WorldOffset(-174, 860, 50) Then
                Exit Function
            End If
        End If
        If WorldMatch("155_P52") Then
            If Not WorldOffset(-174, 860, 50) Then
                Exit Function
            End If
        End If
        If WorldMatch("155_P53") Then
            If Not WorldOffset(-35, 531, 50) Then
                Exit Function
            End If
        End If
        If WorldMatch("155_P00") Then
            SweepSnake = True
            Exit Function
        End If
        If TickCount() - started > 30000 Then
            Exit Function
        End If
    Loop
End Function
Function SnakeBattleVisible()
    SnakeBattleVisible = False
    If WorldMatch("155_P54") Then
        SnakeBattleVisible = WorldOffset(-310, 93, 50)
    End If
End Function
Function SnakeAutoTriple()
    SnakeAutoTriple = False
    If WorldMatch("155_P55") Then
        SnakeAutoTriple = True
    ElseIf WorldMatch("155_P56") Then
        Call WorldOffset(-310, 170, 50)
    ElseIf WorldMatch("155_P57") Then
        Call WorldOffset(318, 92, 50)
    ElseIf WorldMatch("155_P54") Then
        Call WorldOffset(318, 16, 50)
    End If
End Function
Function SnakeReady()
    SnakeReady = False
    If snakeAnimation = 0 Then
        SnakeReady = WorldMatch("155_P41")
    Else
        SnakeReady = WorldMatch("155_P42")
    End If
End Function
Function SnakeFormation()
    Dim ax, ay, sx, sy, tx, ty
    SnakeFormation = False
    // Never reuse a failed recognition's coordinates.
    If Not SnakeReady() Then
        Exit Function
    End If
    ax = foundX
    ay = foundY
    If snakeHireSlot <> 6 Then
        sx = 70 + (snakeHireSlot - Int(snakeHireSlot / 3) * 3) * 180
        sy = -620
        If snakeHireSlot >= 3 Then
            sy = -415
        End If
        tx = 250
        ty = -120
        If snakeHireSlot = 0 Then
            tx = 450
            ty = -180
        End If
        If Not SnakeSwipe(ax + sx, ay + sy, ax + tx, ay + ty, 100, 500) Then
            Exit Function
        End If
        If Not WorldTap(ax - 31, ay - 101, 500) Then
            Exit Function
        End If
    End If
    SnakeFormation = True
End Function
Function StartSnakeBattle()
    Dim misses, seen, started, formed
    StartSnakeBattle = RESULT_TIMEOUT
    Call WorldStage("蛇道出战确认")
    misses = 0
    seen = False
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("155_P43") Then
            seen = True
        Else
            misses = misses + 1
            Call WorldWait(500)
        End If
        If seen Then
            If SnakeReady() Then
                If Not WorldTap(398, 982, 0) Then
                    Exit Function
                End If
                snakeActionAt = TickCount()
                Call WorldWait(500)
                Exit Do
            End If
        End If
        If misses > 4 Then
            Exit Do
        End If
    Loop
    formed = False
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If Not formed Then
            formed = SnakeFormation()
        Else
            If SnakeReady() Then
                If Not WorldTap(587, 982, 500) Then
                    Exit Function
                End If
                snakeStarts = snakeStarts + 1
                snakeActionAt = TickCount()
            End If
            If WorldMatch("155_P44") Then
                If Not WorldTap(560, 760, 500) Then
                    Exit Function
                End If
                started = TickCount()
            End If
            If SnakeBattleVisible() Then
                snakeStarts = 0
                StartSnakeBattle = RESULT_OK
                Exit Function
            End If
            Call WorldWait(500)
            If WorldMatch("155_P45") Or WorldMatch("155_P39") Then
                snakeStarts = 0
                StartSnakeBattle = RESULT_OK
                Exit Function
            End If
        End If
        If TickCount() - started > 15000 Or snakeStarts > 5 Then
            StartSnakeBattle = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function SnakeChooseDifficulty()
    Dim difficulty
    SnakeChooseDifficulty = True
    If WorldMatch("155_P32") Then
        difficulty = SnakeDifficulty(snakeFloor)
        If difficulty = 0 Then
            SnakeChooseDifficulty = WorldOffset(240, -820, 0)
        ElseIf difficulty = 1 Then
            SnakeChooseDifficulty = WorldOffset(240, -528, 0)
        Else
            SnakeChooseDifficulty = WorldOffset(240, -225, 0)
        End If
    End If
    If WorldMatch("155_P33") Then
        SnakeChooseDifficulty = WorldOffset(240, -820, 0)
    ElseIf WorldMatch("155_P34") Then
        SnakeChooseDifficulty = WorldOffset(240, -528, 0)
    ElseIf WorldMatch("155_P35") Then
        SnakeChooseDifficulty = WorldOffset(240, -225, 0)
    End If
End Function
Function SnakeProgressClick(dx, dy)
    SnakeProgressClick = False
    If Not WorldOffset(dx, dy, 0) Then
        Exit Function
    End If
    If Not ResetSnakeTimer() Then
        Exit Function
    End If
    snakeActionAt = TickCount()
    SnakeProgressClick = True
End Function
Function SnakeMapStep()
    Dim swept, ax, ay
    SnakeMapStep = RESULT_OK
    If WorldMatch("155_P07") Then
        swept = SweepSnake()
        If BusinessExpired() Then
            SnakeMapStep = RESULT_TIMEOUT
            Exit Function
        End If
        If swept And snakeMode <> 1 Then
            SnakeMapStep = 5
        End If
        snakeActionAt = TickCount()
        Exit Function
    End If
    If WorldMatch("155_P08") Then
        snakeFloor = 1
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P09") Then
        snakeFloor = 2
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P10") Then
        snakeFloor = 3
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P11") Then
        snakeFloor = 4
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P12") Then
        snakeFloor = 5
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P13") Then
        snakeFloor = 6
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P14") Then
        snakeFloor = 7
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P15") Then
        snakeFloor = 8
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P16") Then
        snakeFloor = 9
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P17") Then
        snakeFloor = 10
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P18") Then
        snakeFloor = 11
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P19") Then
        snakeFloor = 12
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P20") Then
        snakeFloor = 13
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P21") Then
        snakeFloor = 14
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P22") Then
        snakeFloor = 15
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P23") Then
        If Not SnakeProgressClick(0, -30) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    ElseIf WorldMatch("155_P24") Or WorldMatch("155_P25") Then
        If Not SnakeProgressClick(0, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
        Exit Function
    End If
    If WorldMatch("155_P26") Then
        ax = foundX
        ay = foundY
        If Not WorldTap(ax + 379, ay - 375, 1000) Then
            SnakeMapStep = RESULT_TIMEOUT
            Exit Function
        End If
        If Not WorldTap(ax + 481, ay - 809, 1000) Then
            SnakeMapStep = RESULT_TIMEOUT
            Exit Function
        End If
        If Not WorldTap(ax, ay, 0) Then
            SnakeMapStep = RESULT_TIMEOUT
        End If
    End If
End Function
Function FinishSnake(retryLater)
    Dim started, count
    FinishSnake = RESULT_TIMEOUT
    Call WorldStage("蛇道挑战后返回")
    started = TickCount()
    count = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("155_P33") Then
            Call WorldOffset(0, 0, 1500)
        End If
        If WorldMatch("155_P34") Then
            Call WorldOffset(0, 0, 1500)
        End If
        If WorldMatch("155_P35") Then
            Call WorldOffset(0, 0, 1500)
        End If
        If SnakeReady() Then
            Call WorldOffset(0, 0, 1500)
        End If
        If WorldMatch("155_P46") Then
            Call WorldOffset(0, 0, 500)
        End If
        If WorldMatch("155_P00") Then
            Call WorldOffset(465, -979, 500)
            count = count + 1
        End If
        If WorldMatch("155_P29") Then
            Call WorldTap(210, 65, 0)
        End If
        If WorldMatch("155_P30") Then
            Call WorldTap(210, foundY - 453, 0)
        End If
        If WorldMatch("155_P47") Then
            Call WorldOffset(250, -146, 500)
            started = TickCount()
        End If
        If WorldMatch("155_P48") Then
            If Not WorldOffset(250, -171, 500) Then
                Exit Function
            End If
            Exit Do
        End If
        If count > 10 Or TickCount() - started > 20000 Then
            Exit Do
        End If
    Loop
    Call WorldWait(500)
    FinishSnake = ConfirmSnakeExit("原挑战收尾出口", retryLater)
End Function
Function RunSnake()
    Dim result
    RunSnake = RESULT_TIMEOUT
    Call WorldStage("蛇道逐关挑战")
    snakeActionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        result = SnakeMapStep()
        If result = RESULT_TIMEOUT Then
            Exit Function
        End If
        If result = 5 Then
            RunSnake = ConfirmSnakeExit("扫荡返回蛇道且非强打模式", False)
            Exit Function
        End If
        Call WorldStage("蛇道逐关挑战")
        If WorldMatch("155_P27") Then
            Call WorldOffset(0, 0, 1000)
        End If
        If WorldMatch("155_P28") Then
            Exit Do
        End If
        If WorldMatch("155_P29") Then
            Call WorldTap(210, 65, 0)
        End If
        If WorldMatch("155_P30") Then
            Call WorldTap(210, foundY - 453, 0)
        End If
        If WorldMatch("155_P31") Then
            Call WorldOffset(250, -171, 0)
        End If
        If Not SnakeChooseDifficulty() Then
            Exit Function
        End If
        If WorldMatch("155_P36") Then
            Call WorldOffset(0, 0, 0)
        End If
        If WorldMatch("155_P37") Then
            Call WorldOffset(551, -911, 0)
        End If
        If WorldMatch("155_P38") Then
            If Not WorldTap(210, 65, 0) Then
                Exit Function
            End If
            If snakeMode = 2 Then
                Exit Do
            End If
        End If
        If WorldMatch("155_P39") Then
            If Not WorldTap(360, 1150, 0) Then
                Exit Function
            End If
            snakeFailures = snakeFailures + 1
            If snakeMode = 2 Or snakeFailures >= snakeFailureLimit Then
                Exit Do
            End If
        End If
        If snakeAnimation = 0 Then
            If WorldMatch("155_P40") Then
                Call WorldOffset(52, -22, 200)
            End If
        End If
        If SnakeReady() Then
            result = StartSnakeBattle()
            If result <> RESULT_OK Then
                Exit Function
            End If
            Call WorldStage("蛇道逐关挑战")
        End If
        If WorldMatch("155_P44") Then
            Call WorldTap(560, 760, 1000)
        End If
        If SnakeAutoTriple() Then
            If Not ResetSnakeTimer() Then
                Exit Function
            End If
        End If
        If TickCount() - snakeActionAt > 600000 Or snakeStarts > 5 Then
            RunSnake = FinishSnake(True)
            Exit Function
        End If
    Loop
    RunSnake = FinishSnake(False)
End Function
Function ExecuteSnake()
    Dim result
    ExecuteSnake = RESULT_TIMEOUT
    result = EnterSnake()
    If result <> RESULT_OK Then
        Exit Function
    End If
    Call WorldStage("蛇道页面确认")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("155_P00") Then
            Exit Do
        End If
        If WorldMatch("155_P01") Then
            ExecuteSnake = ConfirmSnakeExit("原满通关页面", False)
            Exit Function
        End If
    Loop
    If Not ResetSnakeTimer() Then
        Exit Function
    End If
    result = HireSnakeWarrior()
    If result <> RESULT_OK Then
        Exit Function
    End If
    snakeFloor = 1
    snakeFailures = 0
    snakeStarts = 0
    If Not ResetSnakeTimer() Then
        Exit Function
    End If
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("155_P06") Then
            Call WorldOffset(0, 0, 500)
        End If
        If WorldMatch("155_P00") Then
            Exit Do
        End If
    Loop
    ExecuteSnake = RunSnake()
End Function


// common/龙珠大冒险状态.mq
Sub LoadAdventureSettings()
    advEnabled = WorldBoolean("Lzdmx")
    advReward = WorldNumber("Lzdmx许愿", 2, 5)
End Sub
Sub NewAdventureSession()
    advDue = Time()
    advDone = False
    advCount = 0
    advRecoveries = 0
    advRestarts = 0
    advPhase = "未开始"
    advReason = ""
    advFinishedAt = 0
End Sub
Function SelectAdventure()
    SelectAdventure = 0
    If advEnabled And Not advDone And Time() >= advDue Then
        SelectAdventure = 150
    End If
End Function
Sub StartAdventureTask()
    advReason = ""
    advFinishedAt = 0
    Call WorldStage("龙珠大冒险启动")
    Call WorldLog("原许愿配置索引=" & advReward & "；包含养成升级，不附加新配置")
End Sub
Sub RecoverAdventureTask()
    advReason = ""
    advFinishedAt = 0
    advRecoveries = advRecoveries + 1
    Call WorldLog("保存原任务150；出口或大厅未确认，不改期、不累计完成")
End Sub
Sub RestartAdventureTask()
    advRestarts = advRestarts + 1
    Call WorldLog("重启原任务150 次数=" & advRestarts)
End Sub
Sub CommitAdventureTask()
    advDue = advFinishedAt + 28800
    advCount = advCount + 1
    Call WorldLog("公共大厅确认后提交150；原下次时间+8小时 次数=" & advCount & " 下次Unix=" & advDue & "；不写永久完成")
End Sub
Function ResetAdventureTimer()
    ResetAdventureTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    ResetAdventureTimer = True
End Function
Function ConfirmAdventureExit(reason)
    ConfirmAdventureExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    advReason = reason
    advFinishedAt = Time()
    terminalConfirmed = True
    Call WorldLog("原出口=" & reason & "；等待公共大厅确认，尚未提交")
    ConfirmAdventureExit = RESULT_OK
End Function


// flows/150_龙珠大冒险/龙珠大冒险.mq
Function EnterAdventure()
    Dim started, attempts, result
    EnterAdventure = RESULT_TIMEOUT
    Call WorldStage("龙珠大冒险大厅入口")
    started = TickCount()
    attempts = 0
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("150_P00") Or WorldMatch("150_P01") Then
            EnterAdventure = RESULT_OK
            Exit Function
        ElseIf attempts > 10 Then
            result = ReturnToHall()
            If result <> RESULT_OK Then
                Exit Function
            End If
            attempts = 0
        Else
            attempts = attempts + 1
        End If
        If WorldMatch("150_P52") Or WorldMatch("150_P53") Or WorldMatch("150_P46") Then
            If WorldMatch("150_P50") Or WorldMatch("150_P51") Then
                If Not WorldOffset(-129, -108, 1500) Then
                    Exit Function
                End If
                attempts = 0
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                If Not Sys.AppIsFront(GAME_PACKAGE) Or BusinessExpired() Then
                    Exit Function
                End If
                Swipe 500, 545, 150, 545, 300
            End If
        End If
        Call WorldWait(300)
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("原入口60秒失败；现公共契约保留150恢复，不以未知页面写完成")
            Exit Function
        End If
    Loop
End Function
Function ExecuteAdventure()
    Dim result
    ExecuteAdventure = RESULT_TIMEOUT
    result = EnterAdventure()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = RunAdventure()
    If result <> RESULT_OK Then
        Exit Function
    End If
    ExecuteAdventure = ConfirmAdventureExit("原业务及两段收尾均通过")
End Function

Function AdventureFindEvent(direction)
    Dim name
    name = "150_P12"
    If direction > 0 Then
        name = "150_P12D" & CStr(direction)
    End If
    AdventureFindEvent = WorldMatch(name)
End Function
Function AdventureAnswer()
    Dim choice, dy
    AdventureAnswer = RESULT_TIMEOUT
    choice = Int(Rnd() * 3) + 1
    dy = 277
    If choice = 1 Then
        dy = 33
    ElseIf choice = 2 Then
        dy = 156
    End If
    If Not WorldOffset(0, dy, 0) Then
        Exit Function
    End If
    If Not ResetAdventureTimer() Then
        Exit Function
    End If
    AdventureAnswer = RESULT_OK
End Function
Function AdventureBricks(tenDraw)
    Dim ax, ay, i, dx, dy
    AdventureBricks = RESULT_TIMEOUT
    ax = foundX
    ay = foundY
    If Not WorldTap(ax, ay, 4500) Then
        Exit Function
    End If
    For i = 1 To 24
        dx = 48
        dy = 372
        If i = 2 Then
            dx = 167
            dy = 292
        ElseIf i = 3 Then
            dx = 286
            dy = 218
        ElseIf i = 4 Then
            dx = 417
            dy = 303
        ElseIf i = 5 Then
            dx = 533
            dy = 384
        ElseIf i = 6 Then
            dx = 407
            dy = 460
        ElseIf i = 7 Then
            dx = 535
            dy = 535
        ElseIf i = 8 Then
            dx = 416
            dy = 610
        ElseIf i = 9 Then
            dx = 536
            dy = 690
        ElseIf i = 10 Then
            dx = 410
            dy = 760
        ElseIf i = 11 Then
            dx = 535
            dy = 836
        ElseIf i = 12 Then
            dx = 416
            dy = 905
        ElseIf i = 13 Then
            dx = 300
            dy = 980
        ElseIf i = 14 Then
            dx = 170
            dy = 910
        ElseIf i = 15 Then
            dx = 52
            dy = 828
        ElseIf i = 16 Then
            dx = 167
            dy = 758
        ElseIf i = 17 Then
            dx = 45
            dy = 673
        ElseIf i = 18 Then
            dx = 175
            dy = 600
        ElseIf i = 19 Then
            dx = 45
            dy = 525
        ElseIf i = 20 Then
            dx = 180
            dy = 450
        ElseIf i = 21 Then
            dx = 295
            dy = 377
        ElseIf i = 22 Then
            dx = 300
            dy = 535
        ElseIf i = 23 Then
            dx = 295
            dy = 685
        ElseIf i = 24 Then
            dx = 290
            dy = 830
        End If
        If Not WorldTap(ax + dx, ay + dy, 0) Then
            Exit Function
        End If
        If tenDraw Then
            If Not WorldTap(ax + dx, ay + dy, 0) Then
                Exit Function
            End If
        End If
        Call WorldWait(40)
    Next
    If Not ResetAdventureTimer() Then
        Exit Function
    End If
    AdventureBricks = RESULT_OK
End Function
Function AdventureMiniEvents(tenDraw)
    Dim n
    AdventureMiniEvents = RESULT_TIMEOUT
    // Independent source order; these are not mutually exclusive branches.
    If tenDraw Then
        If WorldMatch("150_P13") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            advFailures = 0
        End If
        If WorldMatch("150_P14") Then
            If Not WorldTap(510, 780, 5000) Then
                Exit Function
            End If
            advFailures = 0
        End If
    Else
        If WorldMatch("150_P32") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            advFailures = 0
        End If
    End If
    If WorldMatch("150_P15") Then
        If tenDraw Then
            If Not WorldTap(165, 800, 1000) Then
                Exit Function
            End If
        Else
            If Not WorldOffset(0, 0, 5000) Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P16") Then
        If Not WorldTap(100, 50, 0) Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P17") Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P18") Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P19") Then
        If Not WorldOffset(-268, 121, 0) Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P20") Then
        If tenDraw Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
        Else
            If Not WorldTap(100, 50, 0) Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    n = "150_P33"
    If tenDraw Then
        n = "150_P21"
    End If
    If WorldMatch(n) Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P22") Then
        If tenDraw Then
            If Not WorldTap(150, 50, 0) Then
                Exit Function
            End If
        Else
            If Not WorldTap(100, 50, 0) Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P23") Then
        If tenDraw Then
            If Not WorldTap(150, 50, 0) Then
                Exit Function
            End If
        Else
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P24") Then
        If tenDraw Then
            If Not WorldTap(150, 50, 0) Then
                Exit Function
            End If
        Else
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P25") Then
        If AdventureAnswer() <> RESULT_OK Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P26") Then
        If AdventureBricks(tenDraw) <> RESULT_OK Then
            Exit Function
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P27") Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        If Not tenDraw Then
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P28") Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        If Not tenDraw Then
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If WorldMatch("150_P29") Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        If Not tenDraw Then
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        advFailures = 0
    End If
    If tenDraw Then
        n = "150_P31"
    Else
        n = "150_P34"
    End If
    If WorldMatch("150_P30") Or WorldMatch(n) Then
        If Not WorldOffset(0, 0, 0) Then
            Exit Function
        End If
        If Not ResetAdventureTimer() Then
            Exit Function
        End If
        If tenDraw Then
            advDirection = advDirection + 1
            If advDirection > 4 Then
                advDirection = 0
            End If
            advFailures = advFailures + 1
        End If
    End If
    AdventureMiniEvents = RESULT_OK
End Function
Function AdventureTenEvents()
    AdventureTenEvents = RESULT_TIMEOUT
    advFailures = 0
    Call WorldStage("龙珠大冒险十抽小事件")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("150_P06") Then
            Exit Do
        End If
        If WorldMatch("150_P07") Then
            If Not WorldTap(150, 50, 0) Then
                Exit Function
            End If
            Exit Do
        End If
        If WorldMatch("150_P10") Or WorldMatch("150_P11") Then
            If AdventureFindEvent(advDirection) Then
                If Not WorldOffset(0, -150, 0) Then
                    Exit Function
                End If
            End If
        End If
        If AdventureMiniEvents(True) <> RESULT_OK Then
            Exit Function
        End If
        If WorldMatch("150_P08") Or WorldMatch("150_P09") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            Exit Do
        End If
        If advFailures >= 5 Then
            advCloseTen = True
            Exit Do
        End If
        Delay 20
    Loop
    AdventureTenEvents = RESULT_OK
End Function
Function AdventureClaimItems()
    Dim claimed
    AdventureClaimItems = RESULT_TIMEOUT
    claimed = False
    If Not ResetAdventureTimer() Then
        Exit Function
    End If
    Call WorldStage("龙珠大冒险一键领取")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("150_P00") Then
            If claimed Then
                Exit Do
            End If
            If Not WorldTap(330, 1120, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P40") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P41") Then
            If claimed Then
                If Not WorldOffset(0, 0, 500) Then
                    Exit Function
                End If
            Else
                If Not WorldOffset(252, -90, 500) Then
                    Exit Function
                End If
                claimed = True
            End If
        End If
        If WorldMatch("150_P42") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            claimed = True
        End If
        Delay 20
    Loop
    AdventureClaimItems = RESULT_OK
End Function
Function AdventureClaimMilestones()
    Dim claimed
    AdventureClaimMilestones = RESULT_TIMEOUT
    claimed = False
    If Not ResetAdventureTimer() Then
        Exit Function
    End If
    Call WorldStage("龙珠大冒险收尾返回")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("150_P43") Then
            If claimed Then
                If Not WorldTap(108, 1211, 500) Then
                    Exit Function
                End If
            Else
                If Not WorldTap(80, 130, 500) Then
                    Exit Function
                End If
            End If
        End If
        If WorldMatch("150_P44") Then
            If Not WorldTap(108, 1211, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P45") Or WorldMatch("150_P46") Then
            Exit Do
        End If
        If WorldMatch("150_P47") Then
            If Not WorldTap(636, 760, 500) Then
                Exit Function
            End If
            claimed = True
        End If
        If WorldMatch("150_P48") Then
            If Not WorldTap(108, 1211, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P49") Then
            If Not WorldTap(108, 1211, 500) Then
                Exit Function
            End If
        End If
        Delay 20
    Loop
    AdventureClaimMilestones = RESULT_OK
End Function
Function RunAdventure()
    Dim mode, wishPending, ballPending, dx, dy
    RunAdventure = RESULT_TIMEOUT
    mode = 0
    wishPending = False
    ballPending = False
    advFailures = 0
    advCloseTen = False
    advDirection = 0
    Call WorldStage("龙珠大冒险确认页面")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("150_P00") Or WorldMatch("150_P01") Then
            Call WorldWait(200)
            Exit Do
        End If
        Delay 20
    Loop
    If Not ResetAdventureTimer() Then
        Exit Function
    End If
    Call WorldStage("龙珠大冒险转动与事件")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("150_P02") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            advCloseTen = False
            mode = 0
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P03") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            wishPending = False
            advCloseTen = False
            mode = 1
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P04") Or WorldMatch("150_P05") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            wishPending = False
            advCloseTen = False
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P06") Then
            If Not WorldOffset(-129, -108, 0) Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P07") Then
            If Not WorldTap(150, 50, 1000) Then
                Exit Function
            End If
            advCloseTen = False
        End If
        If WorldMatch("150_P08") Or WorldMatch("150_P09") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            advCloseTen = False
        End If
        If WorldMatch("150_P10") Or WorldMatch("150_P11") Then
            If advCloseTen Then
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
            Else
                If AdventureTenEvents() <> RESULT_OK Then
                    Exit Function
                End If
                Call WorldStage("龙珠大冒险转动与事件")
            End If
        End If
        If mode = 1 Then
            If AdventureMiniEvents(False) <> RESULT_OK Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P35") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
            advCloseTen = False
            ballPending = True
        End If
        If ballPending Then
            If WorldMatch("150_P36") Then
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
                If Not ResetAdventureTimer() Then
                    Exit Function
                End If
                advCloseTen = False
            End If
            If WorldMatch("150_P37") Then
                If Not WorldTap(485, 1251, 0) Then
                    Exit Function
                End If
                If Not ResetAdventureTimer() Then
                    Exit Function
                End If
                advCloseTen = False
                ballPending = False
            End If
        End If
        If wishPending Then
            If WorldMatch("150_P38") Then
                dx = 0
                If advReward = 1 Or advReward = 4 Then
                    dx = 192
                ElseIf advReward = 2 Or advReward = 5 Then
                    dx = 382
                End If
                dy = 0
                If advReward >= 3 Then
                    dy = 300
                End If
                If Not WorldOffset(dx, dy, 0) Then
                    Exit Function
                End If
                If Not ResetAdventureTimer() Then
                    Exit Function
                End If
            End If
        End If
        If WorldMatch("150_P01") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            wishPending = True
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
        End If
        If WorldMatch("150_P39") Then
            If Not WorldOffset(0, 0, 0) Then
                Exit Function
            End If
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
            wishPending = True
        End If
        If WorldMatch("150_P40") Then
            If Not ResetAdventureTimer() Then
                Exit Function
            End If
            Exit Do
        End If
        Delay 20
    Loop
    If AdventureClaimItems() <> RESULT_OK Then
        Exit Function
    End If
    If AdventureClaimMilestones() <> RESULT_OK Then
        Exit Function
    End If
    RunAdventure = RESULT_OK
End Function


// common/金币试炼状态.mq
Sub LoadGoldSettings()
    goldEnabled = WorldBoolean("SlJb")
End Sub
Sub NewGoldSession()
    goldDue = Time()
    goldDone = False
    goldAbandoned = False
    goldCount = 0
    goldRecoveries = 0
    goldRestarts = 0
    goldPhase = "未开始"
    goldReason = ""
    goldExitKind = 0
    goldFinishedAt = 0
    goldNativeTimeout = False
End Sub
Function SelectGold()
    SelectGold = 0
    If goldEnabled And Not goldDone And Not goldAbandoned And Time() >= goldDue Then
        SelectGold = 12
    End If
End Function
Sub StartGoldTask()
    goldReason = ""
    goldExitKind = 0
    goldFinishedAt = 0
    goldNativeTimeout = False
    Call WorldStage("金币试炼启动")
End Sub
Sub RecoverGoldTask()
    goldRecoveries = goldRecoveries + 1
    If goldNativeTimeout Then
        goldCount = goldCount + 1
        goldDue = goldFinishedAt + 65
        goldAbandoned = goldCount >= 5
        resumeTask = 0
        Call WorldLog("原业务超时计次并延后65秒；非胜利、非成功提交 次数=" & goldCount)
    Else
        Call WorldLog("前台或公共边界恢复；保留12，不计次、不改期")
    End If
    goldNativeTimeout = False
    goldExitKind = 0
    terminalConfirmed = False
End Sub
Sub RestartGoldTask()
    goldRestarts = goldRestarts + 1
    Call WorldLog("公共重启恢复12 次数=" & goldRestarts)
End Sub
Sub CommitGoldTask()
    If goldExitKind = 1 Then
        goldDone = True
    ElseIf goldExitKind = 2 Then
        goldDue = goldFinishedAt + 65
    ElseIf goldExitKind = 4 Then
        goldCount = goldCount + 1
        goldDue = goldFinishedAt + 65
        goldDone = goldCount >= 5
    End If
    goldExitKind = 0
    Call WorldLog("大厅连续确认后提交原出口；次数=" & goldCount & " 下次Unix=" & goldDue)
End Sub
Function ResetGoldTimer()
    ResetGoldTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    ResetGoldTimer = True
End Function
Function ConfirmGoldExit(reason, exitKind)
    ConfirmGoldExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    goldReason = reason
    goldExitKind = exitKind
    goldFinishedAt = Time()
    If exitKind = 3 Then
        goldNativeTimeout = True
        Call WorldLog("原超时出口=" & reason & "；交公共恢复，不标成功")
        Exit Function
    End If
    If exitKind <> 1 And exitKind <> 2 And exitKind <> 4 Then
        Exit Function
    End If
    terminalConfirmed = True
    Call WorldLog("原出口=" & reason & "；尚未提交，等待大厅连续确认")
    ConfirmGoldExit = RESULT_OK
End Function


// flows/012_金币试炼/金币试炼.mq
Function GoldWait(waitMs)
    GoldWait = False
    If BusinessExpired() Then
        Exit Function
    End If
    Call WorldWait(waitMs)
    GoldWait = Not BusinessExpired()
End Function
Function GoldTrialScrollUp()
    GoldTrialScrollUp = False
    If BusinessExpired() Or Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    Swipe 370, 300, 370, 1000, 300
    GoldTrialScrollUp = True
End Function
Function GoldTrialKnown()
    GoldTrialKnown = True
    If WorldMatch("012_P33") Then
        Exit Function
    End If
    If WorldMatch("012_P34") Then
        Exit Function
    End If
    GoldTrialKnown = False
End Function
Function GoldHallKnown()
    GoldHallKnown = True
    If WorldMatch("012_P30") Then
        Exit Function
    End If
    If WorldMatch("012_P31") Then
        Exit Function
    End If
    If WorldMatch("012_P32") Then
        Exit Function
    End If
    GoldHallKnown = False
End Function
Function GoldTrialIcon()
    GoldTrialIcon = True
    If WorldMatch("012_P28") Then
        Exit Function
    End If
    If WorldMatch("012_P29") Then
        Exit Function
    End If
    GoldTrialIcon = False
End Function
Function EnterGoldTrial()
    Dim started, result
    EnterGoldTrial = RESULT_TIMEOUT
    Call WorldStage("金币试炼公共入口")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If GoldTrialKnown() Then
            EnterGoldTrial = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 1000 Then
            Exit Do
        End If
        If Not GoldWait(20) Then
            Exit Function
        End If
    Loop
    result = ReturnToHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If GoldTrialKnown() Then
            EnterGoldTrial = RESULT_OK
            Exit Function
        End If
        result = ReturnToHall()
        If result <> RESULT_OK Then
            Exit Function
        End If
        If GoldHallKnown() Then
            If GoldTrialIcon() Then
                If Not WorldOffset(0, 0, 1500) Then
                    Exit Function
                End If
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                If BusinessExpired() Or Not Sys.AppIsFront(GAME_PACKAGE) Then
                    Exit Function
                End If
                Swipe 150, 545, 500, 545, 300
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("原试炼入口60秒未确认；交公共恢复，不写完成")
            Exit Function
        End If
        If Not GoldWait(20) Then
            Exit Function
        End If
    Loop
End Function
Function ExecuteGoldTrial()
    ExecuteGoldTrial = RESULT_TIMEOUT
    If EnterGoldTrial() <> RESULT_OK Then
        Exit Function
    End If
    ExecuteGoldTrial = RunGoldTrial()
End Function

// task12 only. Original OCR regions/conditions retained; 3.8 OcrText is not paddleV5.
Function GoldFilterText(value)
    Dim output
    output = ""
    If IsNull(value) Then
        GoldFilterText = output
        Exit Function
    End If
    // Conservative old-OCR separator normalization, not the original ssUtil engine.
    // Keep all other characters: e.g. error02 must never become an exhausted token.
    output = Replace(value, "/", "")
    output = Replace(output, "|", "")
    output = Replace(output, " ", "")
    output = Replace(output, Chr(9), "")
    output = Replace(output, Chr(10), "")
    output = Replace(output, Chr(13), "")
    GoldFilterText = output
End Function
Function GoldCountExhausted(value)
    GoldCountExhausted = value = "02" Or value = "03" Or value = "04" Or value = "05" Or value = "012" Or value = "013" Or value = "014" Or value = "015"
End Function
Function GoldSweepReady()
    GoldSweepReady = True
    If WorldMatch("012_P12") Then
        Exit Function
    End If
    GoldSweepReady = WorldMatch("012_P13")
End Function
Function GoldEntryIcon()
    GoldEntryIcon = True
    If WorldMatch("012_P00") Then
        Exit Function
    End If
    GoldEntryIcon = WorldMatch("012_P08")
End Function
Function GoldSweepResult()
    GoldSweepResult = True
    If WorldMatch("012_P26") Then
        Exit Function
    End If
    GoldSweepResult = WorldMatch("012_P27")
End Function
Function GoldAutoTriple()
    GoldAutoTriple = False
    If WorldMatch("012_AutoReady") Then
        GoldAutoTriple = True
    ElseIf WorldMatch("012_AutoOff") Then
        Call WorldOffset(-310, 170, 50)
    ElseIf WorldMatch("012_TripleOff") Then
        Call WorldOffset(318, 92, 50)
    ElseIf WorldMatch("012_BattleBase") Then
        Call WorldOffset(318, 16, 50)
    End If
End Function
Function RunGoldTrial()
    Dim phase, movedAt, actionAt, overallAt, text, ax, ay, countRead
    RunGoldTrial = RESULT_TIMEOUT
    phase = 0
    movedAt = TickCount()
    actionAt = TickCount()
    overallAt = TickCount()
    countRead = False
    If Not ResetGoldTimer() Then
        Exit Function
    End If
    Call WorldStage("金币试炼次数与入口")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If TickCount() - movedAt > 1500 Then
            If Not GoldTrialScrollUp() Then
                Exit Function
            End If
            movedAt = TickCount()
        End If
        If WorldMatch("012_P00") Then
            ax = foundX
            ay = foundY
            text = GoldFilterText(WorldText(ax - 400, ay + 105, ax - 330, ay + 145))
            If GoldCountExhausted(text) Then
                RunGoldTrial = ConfirmGoldExit("原次数耗尽", 1)
                Exit Function
            End If
            If text <> "" Then
                If InStr(1, text, "00") > 0 Then
                    RunGoldTrial = ConfirmGoldExit("原冷却改期", 2)
                    Exit Function
                End If
            End If
            // VM PC533: all other recognized readings continue; empty is never a terminal proof.
            countRead = True
        End If
        If countRead Then
            If GoldEntryIcon() Then
                If Not WorldOffset(0, 0, 50) Then
                    Exit Function
                End If
            End If
            If Not GoldWait(50) Then
                Exit Function
            End If
            If GoldSweepReady() Then
                phase = 1
                Exit Do
            End If
            If Not GoldWait(50) Then
                Exit Function
            End If
            If WorldMatch("012_P14") Then
                phase = 2
                Exit Do
            End If
            If TickCount() - actionAt > 20000 Then
                phase = 3
            End If
        End If
        If Not GoldWait(50) Then
            Exit Function
        End If
    Loop
    If Not ResetGoldTimer() Then
        Exit Function
    End If
    actionAt = TickCount()
    Call WorldStage("金币试炼扫荡或挑战")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If Not GoldWait(50) Then
            Exit Function
        End If
        If phase = 1 Then
            If GoldSweepReady() Then
                If Not WorldOffset(0, 0, 500) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
        ElseIf phase = 2 Then
            If WorldMatch("012_P14") Then
                If Not WorldOffset(180, -252, 500) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
            If WorldMatch("152_开战图标6") Then
                If Not WorldTap(398, 982, 500) Then
                    Exit Function
                End If
                If Not WorldTap(587, 982, 500) Then
                    Exit Function
                End If
                If Not GoldWait(500) Then
                    Exit Function
                End If
                If Not ResetGoldTimer() Then
                    Exit Function
                End If
            End If
            If WorldMatch("032_少人提示") Then
                If Not WorldOffset(0, 0, 0) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
        ElseIf phase = 3 Then
            RunGoldTrial = ConfirmGoldExit("原入页20秒边界", 3)
            Exit Function
        ElseIf phase = 4 Then
            text = WorldText(65, 7, 247, 59)
            If text = "试炼" Then
                RunGoldTrial = ConfirmGoldExit("原试炼标题返回", 4)
                Exit Function
            End If
            If WorldMatch("012_P23") Then
                If Not WorldTap(128, 1228, 1000) Then
                    Exit Function
                End If
                actionAt = TickCount()
            End If
        End If
        If WorldMatch("012_P22") Then
            If Not WorldOffset(-98, -361, 0) Then
                Exit Function
            End If
            phase = 4
            actionAt = TickCount()
        End If
        If WorldMatch("012_P24") Then
            If Not WorldOffset(-116, -315, 500) Then
                Exit Function
            End If
            phase = 4
            actionAt = TickCount()
        End If
        If WorldMatch("012_P25") Then
            ax = foundX
            ay = foundY
            If Not GoldWait(1000) Then
                Exit Function
            End If
            If Not WorldTap(ax, ay, 0) Then
                Exit Function
            End If
            RunGoldTrial = ConfirmGoldExit("原战斗失败退出", 4)
            Exit Function
        End If
        If GoldSweepResult() Then
            ax = foundX
            ay = foundY
            If Not GoldWait(1000) Then
                Exit Function
            End If
            If Not WorldTap(ax, ay, 0) Then
                Exit Function
            End If
            phase = 4
        End If
        If GoldAutoTriple() Then
            If Not ResetGoldTimer() Then
                Exit Function
            End If
            actionAt = TickCount()
            If Not GoldWait(500) Then
                Exit Function
            End If
        End If
        If TickCount() - actionAt > 35000 Or TickCount() - overallAt > 300000 Then
            RunGoldTrial = ConfirmGoldExit("原35秒或300秒超时", 3)
            Exit Function
        End If
    Loop
End Function


// common/经验试炼状态.mq
Sub LoadExperienceSettings()
    experienceEnabled = WorldBoolean("SlJyan")
End Sub
Sub NewExperienceSession()
    experienceDue = Time()
    experienceDone = False
    experienceAbandoned = False
    experienceCount = 0
    experienceRecoveries = 0
    experienceRestarts = 0
    experiencePhase = "未开始"
    experienceReason = ""
    experienceExitKind = 0
    experienceFinishedAt = 0
    experienceNativeTimeout = False
End Sub
Function SelectExperience()
    SelectExperience = 0
    If experienceEnabled And Not experienceDone And Not experienceAbandoned And Time() >= experienceDue Then
        SelectExperience = 13
    End If
End Function
Sub StartExperienceTask()
    experienceReason = ""
    experienceExitKind = 0
    experienceFinishedAt = 0
    experienceNativeTimeout = False
    Call WorldStage("经验试炼启动")
End Sub
Sub RecoverExperienceTask()
    experienceRecoveries = experienceRecoveries + 1
    If experienceNativeTimeout Then
        experienceCount = experienceCount + 1
        experienceDue = experienceFinishedAt + 65
        experienceAbandoned = experienceCount >= 5
        resumeTask = 0
        Call WorldLog("原业务超时计次并延后65秒；非胜利、非成功提交 次数=" & experienceCount)
    Else
        Call WorldLog("前台或公共边界恢复；保留13，不计次、不改期")
    End If
    experienceNativeTimeout = False
    experienceExitKind = 0
    terminalConfirmed = False
End Sub
Sub RestartExperienceTask()
    experienceRestarts = experienceRestarts + 1
    Call WorldLog("公共重启恢复13 次数=" & experienceRestarts)
End Sub
Sub CommitExperienceTask()
    If experienceExitKind = 1 Then
        experienceDone = True
    ElseIf experienceExitKind = 2 Then
        experienceDue = experienceFinishedAt + 65
    ElseIf experienceExitKind = 4 Then
        experienceCount = experienceCount + 1
        experienceDue = experienceFinishedAt + 65
        experienceDone = experienceCount >= 5
    End If
    experienceExitKind = 0
    Call WorldLog("大厅连续确认后提交原出口；次数=" & experienceCount & " 下次Unix=" & experienceDue)
End Sub
Function ResetExperienceTimer()
    ResetExperienceTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    ResetExperienceTimer = True
End Function
Function ConfirmExperienceExit(reason, exitKind)
    ConfirmExperienceExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    experienceReason = reason
    experienceExitKind = exitKind
    experienceFinishedAt = Time()
    If exitKind = 3 Then
        experienceNativeTimeout = True
        Call WorldLog("原超时出口=" & reason & "；交公共恢复，不标成功")
        Exit Function
    End If
    If exitKind <> 1 And exitKind <> 2 And exitKind <> 4 Then
        Exit Function
    End If
    terminalConfirmed = True
    Call WorldLog("原出口=" & reason & "；尚未提交，等待大厅连续确认")
    ConfirmExperienceExit = RESULT_OK
End Function


// flows/013_经验试炼/经验试炼.mq
Function ExperienceWait(waitMs)
    ExperienceWait = False
    If BusinessExpired() Then
        Exit Function
    End If
    Call WorldWait(waitMs)
    ExperienceWait = Not BusinessExpired()
End Function
Function ExperienceTrialScrollUp()
    ExperienceTrialScrollUp = False
    If BusinessExpired() Or Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    Swipe 370, 300, 370, 1000, 300
    ExperienceTrialScrollUp = True
End Function
Function ExperienceTrialKnown()
    ExperienceTrialKnown = True
    If WorldMatch("013_P33") Then
        Exit Function
    End If
    If WorldMatch("013_P34") Then
        Exit Function
    End If
    ExperienceTrialKnown = False
End Function
Function ExperienceHallKnown()
    ExperienceHallKnown = True
    If WorldMatch("013_P30") Then
        Exit Function
    End If
    If WorldMatch("013_P31") Then
        Exit Function
    End If
    If WorldMatch("013_P32") Then
        Exit Function
    End If
    ExperienceHallKnown = False
End Function
Function ExperienceTrialIcon()
    ExperienceTrialIcon = True
    If WorldMatch("013_P28") Then
        Exit Function
    End If
    If WorldMatch("013_P29") Then
        Exit Function
    End If
    ExperienceTrialIcon = False
End Function
Function EnterExperienceTrial()
    Dim started, result
    EnterExperienceTrial = RESULT_TIMEOUT
    Call WorldStage("经验试炼公共入口")
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If ExperienceTrialKnown() Then
            EnterExperienceTrial = RESULT_OK
            Exit Function
        End If
        If TickCount() - started > 1000 Then
            Exit Do
        End If
        If Not ExperienceWait(20) Then
            Exit Function
        End If
    Loop
    result = ReturnToHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    started = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If ExperienceTrialKnown() Then
            EnterExperienceTrial = RESULT_OK
            Exit Function
        End If
        result = ReturnToHall()
        If result <> RESULT_OK Then
            Exit Function
        End If
        If ExperienceHallKnown() Then
            If ExperienceTrialIcon() Then
                If Not WorldOffset(0, 0, 1500) Then
                    Exit Function
                End If
            Else
                result = ReturnToHall()
                If result <> RESULT_OK Then
                    Exit Function
                End If
                If BusinessExpired() Or Not Sys.AppIsFront(GAME_PACKAGE) Then
                    Exit Function
                End If
                Swipe 150, 545, 500, 545, 300
            End If
        End If
        If TickCount() - started > 60000 Then
            Call WorldWait(2000)
            Call WorldLog("原试炼入口60秒未确认；交公共恢复，不写完成")
            Exit Function
        End If
        If Not ExperienceWait(20) Then
            Exit Function
        End If
    Loop
End Function
Function ExecuteExperienceTrial()
    ExecuteExperienceTrial = RESULT_TIMEOUT
    If EnterExperienceTrial() <> RESULT_OK Then
        Exit Function
    End If
    ExecuteExperienceTrial = RunExperienceTrial()
End Function

