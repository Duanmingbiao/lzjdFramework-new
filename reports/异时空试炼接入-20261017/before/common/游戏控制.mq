Sub StartGame()
    Call Note("[流程] 入口 StartGame")
    If Sys.AppIsFront(QQ_PACKAGE) Or Sys.GetFront() = "com.tencent.mobileqq:openSdk" Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            Call Note("[流程] 出口 StartGame 分支1 路径条件 Sys.IsRunning(GAME_PACKAGE)")
            Exit Sub
        End If
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call BeginForegroundRecovery()
        RunApp GAME_PACKAGE
        Call EndForegroundRecovery()
    End If
    Call Note("[流程] 出口 StartGame 到达函数末尾（不代表任务已提交）")
End Sub
Sub RestartGame()
    If currentTask = 13 Then
        Call RestartExperienceTask()
    End If
    If currentTask = 16 Then
        Call RestartPartnerTask()
    End If
    If currentTask = 15 Then
        Call RestartGeneTask()
    End If
    If currentTask = 14 Then
        Call RestartSoulTask()
    End If
    If currentTask = 12 Then
        Call RestartGoldTask()
    End If
    If currentTask = 150 Then
        Call RestartAdventureTask()
    End If
    If currentTask = 155 Then
        Call RestartSnakeTask()
    End If
    If currentTask = 154 Then
        Call RestartPlantTask()
    End If
    If currentTask = 153 Then
        Call RestartSenzuTask()
    End If
    If currentTask = 71 Then
        Call RestartEarthTask()
    End If
    If currentTask = 78 Then
        Call RestartGatherTask()
    End If
    If currentTask = 79 Then
        Call RestartUniverseTask()
    End If
    If currentTask = 82 Then
        Call RestartMemoryTask()
    End If
    If currentTask = 80 Then
        Call RestartFriezaTask()
    End If
    If currentTask = 81 Then
        Call RestartDuelTask()
    End If
    If currentTask = 88 Then
        Call RestartNamekTask()
    End If
    If currentTask = 87 Then
        Call RestartBeyondTask()
    End If
    If currentTask = 86 Then
        Call RestartLegendTask()
    End If
    If IsRedArmy(currentTask) Then
        Call RestartRedArmyTask(currentTask)
    End If
    If currentTask = 83 Then
        Call RestartCrossBossTask()
    End If
    If IsWorldBoss(currentTask) Then
        Call RestartWorldBossTask(currentTask)
    End If
    If currentTask = 152 Then
        coopRestarts = coopRestarts + 1
        Call Note("[合作大冒险152] 重启原任务=152 重启次数=" & coopRestarts & " 恢复次数=" & coopRecoveries)
    End If
    If currentTask = 151 Then
        wukongRestarts = wukongRestarts + 1
        Call Note("[悟空的冒险151] 重启原任务=151 重启次数=" & wukongRestarts & " 恢复次数=" & wukongRecoveries)
    End If
    If IsTimedStamina(currentTask) Then
        Call RestartTimedStamina(currentTask)
    End If
    Call Note("[流程] 入口 RestartGame")
    Call BeginForegroundRecovery()
    foregroundLoginPending = True
    Call Note("重启游戏；保持同一会话及待恢复业务=" & resumeTask)
    KillApp GAME_PACKAGE
    // New-engine process shutdown settling delay, not a recovered task delay.
    Delay 1000
    loginStarted = TickCount()
    RunApp GAME_PACKAGE
    Call EndForegroundRecovery()
    Call Note("[流程] 出口 RestartGame 到达函数末尾（不代表任务已提交）")
End Sub
