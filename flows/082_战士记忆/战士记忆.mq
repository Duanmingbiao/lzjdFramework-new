Function EnterMemory()
    Dim actionAt, index, patternName
    EnterMemory = RESULT_TIMEOUT
    Call WorldStage("战士记忆入口完成状态识别")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldResourcePrompt()
        If WorldMatch("082_未开启") Then
            Call WorldWait(200)
            EnterMemory = ConfirmMemoryTerminal("图色确认未开启")
            Exit Function
        End If
        If WorldMatch("082_入口") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        For index = 0 To 4
            patternName = "082_完成状态" & index
            If WorldMatch(patternName) Then
                memoryInitial = index
                Call WorldWait(200)
                EnterMemory = RESULT_OK
                Exit Function
            End If
        Next
        If TickCount() - actionAt > 5000 Then
            memoryInitial = 4
            Call WorldLog("专业版入口5秒出口转领奖，不代表识别到完成或次数耗尽")
            EnterMemory = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function MemoryNativeLimit()
    MemoryNativeLimit = False
    If TickCount() - memoryStarted > 180000 Then
        If ConfirmMemoryTerminal("专业版挑战/返回/重入共享180秒出口；非胜利证明") = RESULT_OK Then
            MemoryNativeLimit = True
        End If
    End If
End Function

Function ReturnMemoryPage()
    ReturnMemoryPage = RESULT_TIMEOUT
    Call WorldStage("战士记忆挑战后返回")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_蓝按钮") Then
            If Not WorldOffset(0, 0, 1000) Then
                Exit Function
            End If
            memoryAnswer = 1
        End If
        If WorldMatch("082_失败") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_胜利") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_返回界面") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_主界面") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_入口") Then
            ReturnMemoryPage = RESULT_OK
            Exit Function
        End If
        If MemoryNativeLimit() Then
            ReturnMemoryPage = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function ReenterMemory()
    ReenterMemory = RESULT_TIMEOUT
    Call WorldStage("战士记忆重入")
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_大厅入口") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_入口") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
        End If
        If WorldMatch("082_主界面") Then
            ReenterMemory = RESULT_OK
            Exit Function
        End If
        If MemoryNativeLimit() Then
            ReenterMemory = RESULT_OK
            Exit Function
        End If
    Loop
End Function

Function AdvanceMemoryBranch()
    AdvanceMemoryBranch = False
    If memorySide >= 1 And memoryAnswer = 1 Then
        AdvanceMemoryBranch = True
        Exit Function
    End If
    If memoryAnswer = 1 Then
        memorySide = memorySide + 1
    End If
    If memoryAnswer = 0 Then
        memoryAnswer = 1
    Else
        memoryAnswer = 0
    End If
    Call WorldLog("专业版自动分支：侧=" & memorySide & " 答案=" & memoryAnswer)
End Function

Function RunMemory()
    Dim cleanup, result, index, x, y
    RunMemory = RESULT_TIMEOUT
    memoryAnswer = 0
    memorySide = 0
    If memoryInitial = 1 Then
        memorySide = 1
    ElseIf memoryInitial = 2 Then
        memorySide = 2
    End If
    memoryStarts = 0
    memoryStarted = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        Call WorldStage("战士记忆挑战")
        cleanup = False
        If WorldMatch("082_蓝按钮") Then
            cleanup = True
        Else
            If WorldMatch("082_下一步") Then
                x = foundX
                y = foundY
                For index = 1 To 4
                    If Not WorldTap(x, y, 100) Then
                        Exit Function
                    End If
                Next
            End If
        End If
        If Not cleanup Then
            If WorldMatch("082_失败") Then
                cleanup = True
            ElseIf WorldMatch("082_胜利") Then
                cleanup = True
            End If
        End If
        If Not cleanup Then
            If WorldMatch("082_主界面") Then
                If memorySide = 0 Or memorySide = 2 Then
                    If Not WorldOffset(26, -525, 0) Then
                        Exit Function
                    End If
                Else
                    If Not WorldOffset(480, -525, 0) Then
                        Exit Function
                    End If
                End If
            End If
            If WorldMatch("082_答案") Then
                If memoryAnswer = 0 Then
                    If Not WorldOffset(0, 0, 0) Then
                        Exit Function
                    End If
                Else
                    If Not WorldOffset(195, 0, 0) Then
                        Exit Function
                    End If
                End If
            End If
            If WorldMatch("152_开战图标6") Then
                If memoryAnswer = 0 Then
                    If Not WorldTap(128, 1228, 0) Then
                        Exit Function
                    End If
                    cleanup = True
                Else
                    If Not WorldTap(398, 982, 500) Then
                        Exit Function
                    End If
                    If Not WorldTap(587, 982, 500) Then
                        Exit Function
                    End If
                    memoryStarts = memoryStarts + 1
                End If
            End If
            If Not cleanup Then
                If WorldMatch("078_跳过战斗") Then
                    If Not WorldOffset(-310, 93, 50) Then
                        Exit Function
                    End If
                    Call WorldWait(500)
                    memoryStarts = 0
                End If
                If memoryStarts > 20 Then
                    If memoryFailureMode = 1 Then
                        Call WorldLog("专业版开战超过20次置重启标志；交公共恢复82，不提交")
                        Exit Function
                    Else
                        memoryUncompleted = True
                        RunMemory = RESULT_WAIT
                        Exit Function
                    End If
                End If
                If MemoryNativeLimit() Then
                    RunMemory = RESULT_OK
                    Exit Function
                End If
            End If
        End If
        If cleanup Then
            result = ReturnMemoryPage()
            If result <> RESULT_OK Or memoryTerminal Then
                RunMemory = result
                Exit Function
            End If
            result = ReenterMemory()
            If result <> RESULT_OK Or memoryTerminal Then
                RunMemory = result
                Exit Function
            End If
            If AdvanceMemoryBranch() Then
                RunMemory = RESULT_OK
                Exit Function
            End If
        End If
    Loop
End Function

Function FinishMemoryRewards()
    Dim actionAt
    FinishMemoryRewards = RESULT_TIMEOUT
    Call WorldStage("战士记忆双侧奖励")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_获得一") Then
            If Not WorldOffset(0, 0, 500) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_完成状态3") Then
            If Not WorldOffset(248, -437, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_完成状态4") Then
            Exit Do
        End If
        If TickCount() - actionAt > 5000 Then
            FinishMemoryRewards = ConfirmMemoryTerminal("专业版双侧领奖5秒无动作出口；不是次数耗尽")
            Exit Function
        End If
    Loop
    Call WorldStage("战士记忆附加奖励")
    actionAt = TickCount()
    Do
        If BusinessExpired() Then
            Exit Function
        End If
        If WorldMatch("082_获得二") Then
            If Not WorldOffset(0, 0, 200) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_主界面") Then
            If Not WorldOffset(354, -1074, 50) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_奖励面板") Then
            If Not WorldTap(600, 416, 50) Then
                Exit Function
            End If
            actionAt = TickCount()
        End If
        If WorldMatch("082_最终界面") Then
            FinishMemoryRewards = ConfirmMemoryTerminal("专业版最终界面出口")
            Exit Function
        End If
        If TickCount() - actionAt > 5000 Then
            FinishMemoryRewards = ConfirmMemoryTerminal("专业版附加奖励5秒无动作出口；非胜利证明")
            Exit Function
        End If
    Loop
End Function

Function ExecuteMemory()
    Dim result
    ExecuteMemory = RESULT_TIMEOUT
    result = EnterGatherHall()
    If result <> RESULT_OK Then
        Exit Function
    End If
    result = EnterMemory()
    If memoryTerminal Or result <> RESULT_OK Then
        ExecuteMemory = result
        Exit Function
    End If
    If memoryInitial < 3 Then
        result = RunMemory()
        If memoryTerminal Or result <> RESULT_OK Then
            ExecuteMemory = result
            Exit Function
        End If
    End If
    ExecuteMemory = FinishMemoryRewards()
End Function
