// app/入口.mq
Dim stamina50Failed, stamina50Phase, stamina50Restarts, stamina50Recoveries, stamina51Failed, stamina51Phase, stamina51Restarts, stamina51Recoveries, stamina52Failed, stamina52Phase, stamina52Restarts, stamina52Recoveries, stamina53Failed, stamina53Phase, stamina53Restarts, stamina53Recoveries, stamina54Failed, stamina54Phase, stamina54Restarts, stamina54Recoveries
Dim staminaKeepDownload
Dim staminaEnabled, staminaGem, staminaRecover, staminaExchange, staminaPhase, staminaRestartCount, staminaRecoveryCount, staminaTerminal, stamina50Due, stamina50Count, stamina50Failures, stamina50Done, stamina51Due, stamina51Count, stamina51Failures, stamina51Done, stamina52Due, stamina52Count, stamina52Failures, stamina52Done, stamina53Due, stamina53Count, stamina53Failures, stamina53Done, stamina54Due, stamina54Count, stamina54Failures, stamina54Done
Dim qfriendEnabled, qfriendOneClick, qfriendInterval, qfriendRegisteredTask, qfriendDone, qfriendFailed, qfriendCount, qfriendFailures, qfriendDue, qfriendFirst, qfriendPhase, qfriendTerminal, qfriendRecovery
Dim friendEnabled, friendInterval, friendRegisteredTask, friendDone, friendFailed, friendCount, friendFailures, friendDue, friendFirst, friendPhase
// 龙珠激斗脚本: independent MQ implementation. Mail168 and task rewards169 share one scheduler.
Dim RESULT_OK, RESULT_WAIT, RESULT_FAIL, RESULT_TIMEOUT
Dim GAME_PACKAGE, QQ_PACKAGE, stageName, foundX, foundY
Dim mailEnabled, mailInterval, loginLimit, businessLimit, messageMode
Dim currentTask, resumeTask, registeredTask, mailDone, mailFailed
Dim mailCount, mailFailures, mailDue, mailFirst, mailPhase
Dim loginStarted, businessStarted, progressAt, loginFailures
Dim hallFrames, hallSampleAt, terminalConfirmed
Dim qqLastForeground, qqLastDiagnosticAt
Dim hallMisses, hallExtended, hallActionIndex, hallReturnDelaySeconds
Dim rewardEnabled, rewardInterval, rewardRegisteredTask
Dim rewardDone, rewardFailed, rewardCount, rewardFailures
Dim rewardDue, rewardFirst, rewardPhase
Dim foregroundThread, foregroundLoginPending, foregroundStartupAt
Dim signEnabled, signInterval, signRegisteredTask
Dim signDone, signFailed, signCount, signFailures, signDue, signFirst, signPhase
Dim monthEnabled, monthInterval, monthRegisteredTask, monthKeepDownload
Dim monthDone, monthFailed, monthCount, monthFailures, monthDue, monthFirst, monthPhase
Dim monthCardType, monthlySearchDirection, activityOcrLast, activityOcrLogAt
Call InitConstants()
Call LoadSettings()
Call NewSession()
Call InitForegroundMonitor()
Call RegisterTasks()
If GetScreenX() <> 720 Or GetScreenY() <> 1280 Then
    TracePrint "需要720x1280；请同时在MuMu确认320 DPI"
    EndScript
End If
Call Note("新会话启动；已勾选普通任务先执行一次")
Call Note("线程启动R2：准备调用Thread.Start")
foregroundThread = Thread.Start(ForegroundMonitor)
Call Note("线程启动R2：Thread.Start已返回")
foregroundStartupAt = TickCount()
Do While Not Thread.GetShareVar("fg.ready")
    If TickCount() - foregroundStartupAt >= 3000 Then
        Call Note("线程启动R2：3秒未完成首次采样，停止；检查前台日志最后一步")
        ExitScript
    End If
    Delay 20
Loop
Call Note("线程启动R2：首次采样已确认，进入公共调度")
Do
    Call SchedulerStep()
    Delay 200
Loop


// common/常量.mq
Sub InitConstants()
    RESULT_OK = 1
    RESULT_WAIT = 2
    RESULT_FAIL = 3
    RESULT_TIMEOUT = 4
    GAME_PACKAGE = "com.tencent.tmgp.dragonball"
    QQ_PACKAGE = "com.tencent.mobileqq"
End Sub


// common/前台监控.mq
// User-defined foreground policy. This thread only samples and reports.
// Peterson two-party gate: exactly one main thread and one monitor thread.
// Shared reads/writes use the engine store; never call the iOS-only lock APIs.
Sub EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.gate.main", True)
    Call Thread.SetShareVar("fg.gate.turn", "monitor")
    Do While Thread.GetShareVar("fg.gate.monitor") And Thread.GetShareVar("fg.gate.turn") = "monitor"
        Delay 1
    Loop
End Sub
Sub LeaveMainForegroundGate()
    Call Thread.SetShareVar("fg.gate.main", False)
End Sub
Sub EnterMonitorForegroundGate()
    Call Thread.SetShareVar("fg.gate.monitor", True)
    Call Thread.SetShareVar("fg.gate.turn", "main")
    Do While Thread.GetShareVar("fg.gate.main") And Thread.GetShareVar("fg.gate.turn") = "main"
        Delay 1
    Loop
End Sub
Sub LeaveMonitorForegroundGate()
    Call Thread.SetShareVar("fg.gate.monitor", False)
End Sub
Sub InitForegroundMonitor()
    Call Thread.SetShareVar("fg.gate.main", False)
    Call Thread.SetShareVar("fg.gate.monitor", False)
    Call Thread.SetShareVar("fg.gate.turn", "main")
    Call Thread.SetShareVar("fg.recovering", False)
    Call Thread.SetShareVar("fg.request", False)
    Call Thread.SetShareVar("fg.outside", False)
    Call Thread.SetShareVar("fg.since", 0)
    Call Thread.SetShareVar("fg.last", "<未采样>")
    Call Thread.SetShareVar("fg.reason", "")
    Call Thread.SetShareVar("fg.ready", False)
    foregroundLoginPending = False
End Sub
Sub ForegroundLog(message)
    Call WriteForegroundLog("[龙珠激斗脚本][前台监控] " & message)
End Sub
Sub SampleForeground(gamePackage, qqPackage)
    Dim package, nowAt, recovering, outside, startupProbe
    startupProbe = Not Thread.GetShareVar("fg.ready")
    // Lock only this short sample; never hold across waits or game lifecycle calls.
    If startupProbe Then
        Call ForegroundLog("线程互斥R3：首次采样进入共享互斥前")
    End If
    Call EnterMonitorForegroundGate()
    If startupProbe Then
        Call ForegroundLog("线程互斥R3：已进入共享互斥，读取前台前")
    End If
    package = Sys.GetFront()
    If startupProbe Then
        Call ForegroundLog("线程启动R2：首次前台读取完成")
    End If
    nowAt = TickCount()
    If package <> Thread.GetShareVar("fg.last") Then
        Call Thread.SetShareVar("fg.last", package)
        Call ForegroundLog("前台包名=" & package)
    End If
    recovering = Thread.GetShareVar("fg.recovering")
    outside = Thread.GetShareVar("fg.outside")
    If recovering Then
        Call Thread.SetShareVar("fg.outside", False)
    ElseIf Not Thread.GetShareVar("fg.request") Then
        If package = gamePackage Or package = qqPackage Or package = "com.tencent.mobileqq:openSdk" Then
            If outside Then
                Call ForegroundLog("回到允许前台，取消5秒倒计时")
            End If
            Call Thread.SetShareVar("fg.outside", False)
        ElseIf Not outside Then
            Call Thread.SetShareVar("fg.outside", True)
            Call Thread.SetShareVar("fg.since", nowAt)
            Call ForegroundLog("离开允许前台，开始5秒倒计时")
        ElseIf nowAt - Thread.GetShareVar("fg.since") >= 5000 Then
            Call Thread.SetShareVar("fg.reason", package)
            Call Thread.SetShareVar("fg.request", True)
            Call ForegroundLog("连续离开5秒，上报前台离开")
        End If
    End If
    Call LeaveMonitorForegroundGate()
End Sub
Sub ForegroundMonitor()
    // No cross-thread argument capture; initialize immutable package names locally.
    Dim monitorGame, monitorQQ
    Call ForegroundLog("线程启动R2：已进入监控线程")
    monitorGame = "com.tencent.tmgp.dragonball"
    monitorQQ = "com.tencent.mobileqq"
    Call SampleForeground(monitorGame, monitorQQ)
    Call ForegroundLog("线程启动R2：首次采样完成")
    Call Thread.SetShareVar("fg.ready", True)
    Do
        Call SampleForeground(monitorGame, monitorQQ)
        Delay 200
    Loop
End Sub
Function ForegroundInterrupted()
    Call EnterMainForegroundGate()
    ForegroundInterrupted = Thread.GetShareVar("fg.request")
    Call LeaveMainForegroundGate()
End Function
Sub BeginForegroundRecovery()
    Call EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.recovering", True)
    Call Thread.SetShareVar("fg.request", False)
    Call Thread.SetShareVar("fg.outside", False)
    Call LeaveMainForegroundGate()
End Sub
Sub EndForegroundRecovery()
    Call EnterMainForegroundGate()
    Call Thread.SetShareVar("fg.outside", False)
    Call Thread.SetShareVar("fg.recovering", False)
    Call LeaveMainForegroundGate()
End Sub
Function BeginForegroundCommit()
    Dim accepted
    // Serialize the report/commit boundary; no completion can consume a pending report.
    Call EnterMainForegroundGate()
    accepted = Not Thread.GetShareVar("fg.request")
    BeginForegroundCommit = accepted
    If Not accepted Then
        Call LeaveMainForegroundGate()
    End If
End Function
Sub EndForegroundCommit()
    Call LeaveMainForegroundGate()
End Sub
Function HandleForegroundRecovery()
    HandleForegroundRecovery = False
    If Not ForegroundInterrupted() Then
        Exit Function
    End If
    Call Note("公共调度器收到前台离开；前台=" & Thread.GetShareVar("fg.reason"))
    If currentTask = 168 Or currentTask = 169 Or currentTask = 167 Or currentTask = 166 Or currentTask = 55 Or currentTask = 56 Or IsTimedStamina(currentTask) Then
        Call SaveRecovery()
    End If
    terminalConfirmed = False
    Call RestartGame()
    HandleForegroundRecovery = True
End Function


// common/日志.mq
// Separate files have one writer each; never acquire a nested thread lock here.
Sub WritePublicLog(path, message)
    Dim line, beforeBytes, afterBytes, created
    line = "[tick=" & TickCount() & "] " & message
    TracePrint line
    If Not Dir.Exist("/sdcard/Pictures") Then
        created = Dir.Create("/sdcard/Pictures")
    End If
    beforeBytes = 0
    If Dir.Exist(path) Then
        beforeBytes = File.Bytes(path)
    End If
    line = line & Chr(13) & Chr(10)
    Call File.Append(path, line)
    afterBytes = File.Bytes(path)
    If afterBytes <= beforeBytes Then
        TracePrint "[文件日志] 写入失败，请检查脚本应用存储权限和剩余空间"
    End If
End Sub
Sub WriteMainLog(message)
    Call WritePublicLog("/sdcard/Pictures/dragonball-main.log", message)
End Sub
Sub WriteForegroundLog(message)
    Call WritePublicLog("/sdcard/Pictures/dragonball-foreground.log", message)
End Sub
Sub Note(message)
    Call WriteMainLog("[龙珠激斗脚本][" & stageName & "] " & message)
End Sub
Sub SetStage(value)
    If stageName <> value Then
        stageName = value
        Call Note("进入阶段")
    End If
End Sub


// common/定时体力状态.mq
Function StaminaBooleanSetting(key)
    Dim raw, text
    StaminaBooleanSetting = False
    raw = ReadUIConfig(key, False)
    text = "<null>"
    If Not IsNull(raw) Then
        text = LCase(Trim(CStr(raw)))
        If text = "true" Or text = "1" Then
            StaminaBooleanSetting = True
        End If
    End If
    Call WriteMainLog("[龙珠激斗脚本][定时体力配置] 键=" & key & " 原值=" & text)
End Function
Sub LoadTimedStaminaSettings()
    staminaKeepDownload = StaminaBooleanSetting("保留下载提示")
    staminaEnabled = StaminaBooleanSetting("定时体力启用")
    staminaGem = StaminaBooleanSetting("体力龙石补领")
    staminaRecover = StaminaBooleanSetting("体力追回")
    staminaExchange = StaminaBooleanSetting("体力兑换")
End Sub
Function IsTimedStamina(taskId)
    IsTimedStamina = taskId >= 50 And taskId <= 54
End Function
Function StaminaDayStart(stamp)
    // Game schedules use Asia/Shanghai UTC+08, Unix seconds; TickCount only for durations.
    StaminaDayStart = Int((stamp + 28800) / 86400) * 86400 - 28800
End Function
Function StaminaName(taskId)
    StaminaName = "定时领取体力"
    If taskId = 50 Then
        StaminaName = "定时领取体力_上午"
    ElseIf taskId = 51 Then
        StaminaName = "定时领取体力_中午"
    ElseIf taskId = 52 Then
        StaminaName = "定时领取体力_下午"
    ElseIf taskId = 53 Then
        StaminaName = "定时领取体力_晚上"
    ElseIf taskId = 54 Then
        StaminaName = "定时领取体力_补领"
    End If
End Function
Function StaminaStartSecond(taskId)
    StaminaStartSecond = 0
    If taskId = 50 Then
        StaminaStartSecond = 25205
    ElseIf taskId = 51 Then
        StaminaStartSecond = 43205
    ElseIf taskId = 52 Then
        StaminaStartSecond = 64805
    ElseIf taskId = 53 Then
        StaminaStartSecond = 75605
    ElseIf taskId = 54 Then
        StaminaStartSecond = 5
    End If
End Function
Function StaminaEndSecond(taskId)
    StaminaEndSecond = 0
    If taskId = 50 Then
        StaminaEndSecond = 43200
    ElseIf taskId = 51 Then
        StaminaEndSecond = 64800
    ElseIf taskId = 52 Then
        StaminaEndSecond = 75600
    ElseIf taskId = 53 Then
        StaminaEndSecond = 86310
    ElseIf taskId = 54 Then
        StaminaEndSecond = 17940
    End If
End Function
Sub NewTimedStaminaSession()
    staminaPhase = "未开始"
    staminaRestartCount = 0
    staminaRecoveryCount = 0
    staminaTerminal = False
    stamina50Due = StaminaDayStart(Time()) + StaminaStartSecond(50)
    stamina50Count = 0
    stamina50Failures = 0
    stamina50Done = False
    stamina50Failed = False
    stamina50Phase = "未开始"
    stamina50Restarts = 0
    stamina50Recoveries = 0
    stamina51Due = StaminaDayStart(Time()) + StaminaStartSecond(51)
    stamina51Count = 0
    stamina51Failures = 0
    stamina51Done = False
    stamina51Failed = False
    stamina51Phase = "未开始"
    stamina51Restarts = 0
    stamina51Recoveries = 0
    stamina52Due = StaminaDayStart(Time()) + StaminaStartSecond(52)
    stamina52Count = 0
    stamina52Failures = 0
    stamina52Done = False
    stamina52Failed = False
    stamina52Phase = "未开始"
    stamina52Restarts = 0
    stamina52Recoveries = 0
    stamina53Due = StaminaDayStart(Time()) + StaminaStartSecond(53)
    stamina53Count = 0
    stamina53Failures = 0
    stamina53Done = False
    stamina53Failed = False
    stamina53Phase = "未开始"
    stamina53Restarts = 0
    stamina53Recoveries = 0
    stamina54Due = StaminaDayStart(Time()) + StaminaStartSecond(54)
    stamina54Count = 0
    stamina54Failures = 0
    stamina54Done = False
    stamina54Failed = False
    stamina54Phase = "未开始"
    stamina54Restarts = 0
    stamina54Recoveries = 0
End Sub
Function SelectTimedStamina()
    Dim nowStamp, dayStart, eligible
    SelectTimedStamina = 0
    If Not staminaEnabled Then
        Exit Function
    End If
    nowStamp = Time()
    dayStart = StaminaDayStart(nowStamp)
    eligible = True
    If eligible Then
        If nowStamp >= stamina50Due Then
            If nowStamp < dayStart + 25205 Then
                stamina50Due = dayStart + 25205
            ElseIf nowStamp <= dayStart + 43200 Then
                SelectTimedStamina = 50
                Exit Function
            Else
                stamina50Due = dayStart + 86400 + 25205
                Call Note("[定时体力50] 窗口已过，未提交完成；下一次执行时间Unix=" & stamina50Due)
            End If
        End If
    End If
    eligible = True
    If eligible Then
        If nowStamp >= stamina51Due Then
            If nowStamp < dayStart + 43205 Then
                stamina51Due = dayStart + 43205
            ElseIf nowStamp <= dayStart + 64800 Then
                SelectTimedStamina = 51
                Exit Function
            Else
                stamina51Due = dayStart + 86400 + 43205
                Call Note("[定时体力51] 窗口已过，未提交完成；下一次执行时间Unix=" & stamina51Due)
            End If
        End If
    End If
    eligible = True
    If eligible Then
        If nowStamp >= stamina52Due Then
            If nowStamp < dayStart + 64805 Then
                stamina52Due = dayStart + 64805
            ElseIf nowStamp <= dayStart + 75600 Then
                SelectTimedStamina = 52
                Exit Function
            Else
                stamina52Due = dayStart + 86400 + 64805
                Call Note("[定时体力52] 窗口已过，未提交完成；下一次执行时间Unix=" & stamina52Due)
            End If
        End If
    End If
    eligible = True
    If eligible Then
        If nowStamp >= stamina53Due Then
            If nowStamp < dayStart + 75605 Then
                stamina53Due = dayStart + 75605
            ElseIf nowStamp <= dayStart + 86310 Then
                SelectTimedStamina = 53
                Exit Function
            Else
                stamina53Due = dayStart + 86400 + 75605
                Call Note("[定时体力53] 窗口已过，未提交完成；下一次执行时间Unix=" & stamina53Due)
            End If
        End If
    End If
    eligible = True
    eligible = staminaGem
    If eligible Then
        If nowStamp >= stamina54Due Then
            If nowStamp < dayStart + 5 Then
                stamina54Due = dayStart + 5
            ElseIf nowStamp <= dayStart + 17940 Then
                SelectTimedStamina = 54
                Exit Function
            Else
                stamina54Due = dayStart + 86400 + 5
                Call Note("[定时体力54] 窗口已过，未提交完成；下一次执行时间Unix=" & stamina54Due)
            End If
        End If
    End If
End Function
Sub StartTimedStamina(taskId)
    If taskId = 50 Then
        staminaRestartCount = stamina50Restarts
        staminaRecoveryCount = stamina50Recoveries
        stamina50Done = False
        stamina50Failed = False
    ElseIf taskId = 51 Then
        staminaRestartCount = stamina51Restarts
        staminaRecoveryCount = stamina51Recoveries
        stamina51Done = False
        stamina51Failed = False
    ElseIf taskId = 52 Then
        staminaRestartCount = stamina52Restarts
        staminaRecoveryCount = stamina52Recoveries
        stamina52Done = False
        stamina52Failed = False
    ElseIf taskId = 53 Then
        staminaRestartCount = stamina53Restarts
        staminaRecoveryCount = stamina53Recoveries
        stamina53Done = False
        stamina53Failed = False
    ElseIf taskId = 54 Then
        staminaRestartCount = stamina54Restarts
        staminaRecoveryCount = stamina54Recoveries
        stamina54Done = False
        stamina54Failed = False
    End If
    staminaTerminal = False
    Call Note("[定时体力] 任务名称=" & StaminaName(taskId) & " 编号=" & taskId & " 任务开始时间Unix=" & Time() & " TickCount=" & TickCount() & " 重启次数=" & staminaRestartCount & " 恢复次数=" & staminaRecoveryCount)
End Sub
Sub RecoverTimedStamina(taskId)
    staminaRecoveryCount = staminaRecoveryCount + 1
    staminaTerminal = False
    If taskId = 50 Then
        stamina50Failures = stamina50Failures + 1
        stamina50Failed = True
        stamina50Recoveries = staminaRecoveryCount
    ElseIf taskId = 51 Then
        stamina51Failures = stamina51Failures + 1
        stamina51Failed = True
        stamina51Recoveries = staminaRecoveryCount
    ElseIf taskId = 52 Then
        stamina52Failures = stamina52Failures + 1
        stamina52Failed = True
        stamina52Recoveries = staminaRecoveryCount
    ElseIf taskId = 53 Then
        stamina53Failures = stamina53Failures + 1
        stamina53Failed = True
        stamina53Recoveries = staminaRecoveryCount
    ElseIf taskId = 54 Then
        stamina54Failures = stamina54Failures + 1
        stamina54Failed = True
        stamina54Recoveries = staminaRecoveryCount
    End If
    Call Note("[定时体力] 任务=" & taskId & " 未提交完成；恢复次数=" & staminaRecoveryCount & " 当前阶段=" & staminaPhase)
End Sub
Sub CommitTimedStamina(taskId)
    Dim nextStamp
    nextStamp = StaminaDayStart(Time()) + StaminaStartSecond(taskId)
    If nextStamp <= Time() Then
        nextStamp = nextStamp + 86400
    End If
    If taskId = 50 Then
        stamina50Done = True
        stamina50Failed = False
        stamina50Phase = "完成"
        stamina50Count = stamina50Count + 1
        stamina50Due = nextStamp
    ElseIf taskId = 51 Then
        stamina51Done = True
        stamina51Failed = False
        stamina51Phase = "完成"
        stamina51Count = stamina51Count + 1
        stamina51Due = nextStamp
    ElseIf taskId = 52 Then
        stamina52Done = True
        stamina52Failed = False
        stamina52Phase = "完成"
        stamina52Count = stamina52Count + 1
        stamina52Due = nextStamp
    ElseIf taskId = 53 Then
        stamina53Done = True
        stamina53Failed = False
        stamina53Phase = "完成"
        stamina53Count = stamina53Count + 1
        stamina53Due = nextStamp
    ElseIf taskId = 54 Then
        stamina54Done = True
        stamina54Failed = False
        stamina54Phase = "完成"
        stamina54Count = stamina54Count + 1
        stamina54Due = nextStamp
    End If
    Call Note("[定时体力] 任务名称=" & StaminaName(taskId) & " 编号=" & taskId & " 是否提交完成=是；下一次执行时间Unix=" & nextStamp & " 重启次数=" & staminaRestartCount & " 恢复次数=" & staminaRecoveryCount)
End Sub
Sub SetTimedStaminaPhase(taskId, value)
    If taskId = 50 Then
        stamina50Phase = value
    ElseIf taskId = 51 Then
        stamina51Phase = value
    ElseIf taskId = 52 Then
        stamina52Phase = value
    ElseIf taskId = 53 Then
        stamina53Phase = value
    ElseIf taskId = 54 Then
        stamina54Phase = value
    End If
End Sub
Sub RestartTimedStamina(taskId)
    staminaRestartCount = staminaRestartCount + 1
    If taskId = 50 Then
        stamina50Restarts = staminaRestartCount
    ElseIf taskId = 51 Then
        stamina51Restarts = staminaRestartCount
    ElseIf taskId = 52 Then
        stamina52Restarts = staminaRestartCount
    ElseIf taskId = 53 Then
        stamina53Restarts = staminaRestartCount
    ElseIf taskId = 54 Then
        stamina54Restarts = staminaRestartCount
    End If
    Call Note("[定时体力] 重启原任务=" & taskId & " 重启次数=" & staminaRestartCount & " 恢复次数=" & staminaRecoveryCount)
End Sub


// common/配置读取.mq
Function QFriendBooleanSetting(key)
    Dim raw, rawText, rawKind, normalized, resultText
    raw = ReadUIConfig(key, False)
    QFriendBooleanSetting = False
    rawText = "<null>"
    rawKind = "null"
    normalized = ""
    If Not IsNull(raw) Then
        rawText = CStr(raw)
        normalized = LCase(Trim(rawText))
        // MQ equality keeps primitive types distinct; no truthiness test of raw.
        If raw = rawText Then
            rawKind = "string"
        ElseIf raw = True Or raw = False Then
            rawKind = "boolean"
        ElseIf IsNumeric(raw) Then
            rawKind = "number"
        Else
            rawKind = "other"
        End If
        If normalized = "true" Or normalized = "1" Then
            QFriendBooleanSetting = True
        End If
    End If
    resultText = "关闭"
    If normalized = "true" Or normalized = "1" Then
        resultText = "开启"
    End If
    // LoadSettings precedes NewSession: do not concatenate uninitialized stageName.
    Call WriteMainLog("[龙珠激斗脚本][Q友体力56配置] 键=" & key & " 读取原值=[" & rawText & "] 返回类型=" & rawKind & " 规范值=[" & normalized & "] 解析结果=" & resultText)
    If normalized <> "true" And normalized <> "false" And normalized <> "1" And normalized <> "0" Then
        Call WriteMainLog("[龙珠激斗脚本][Q友体力56配置] 未识别配置值，按默认关闭处理；未改写保存值")
    End If
End Function
Function PositiveSetting(key, fallback)
    Dim raw
    raw = ReadUIConfig(key, fallback)
    PositiveSetting = fallback
    If IsNumeric(raw) Then
        If CDbl(raw) > 0 Then
            PositiveSetting = CDbl(raw)
        End If
    End If
End Function
Sub LoadSettings()
    Call LoadTimedStaminaSettings()
    qfriendEnabled = QFriendBooleanSetting("Q友体力启用")
    qfriendOneClick = QFriendBooleanSetting("Q友一键领取")
    qfriendInterval = PositiveSetting("Q友体力间隔秒", 14400)
    friendEnabled = ReadUIConfig("好友体力启用", False)
    friendInterval = PositiveSetting("好友体力间隔秒", 14400)
    monthEnabled = ReadUIConfig("月卡龙石启用", False)
    monthInterval = PositiveSetting("月卡间隔秒", 3600)
    monthKeepDownload = ReadUIConfig("保留下载提示", False)
    signEnabled = ReadUIConfig("日常签到启用", False)
    signInterval = PositiveSetting("签到间隔秒", 3600)
    rewardEnabled = ReadUIConfig("任务奖励启用", True)
    rewardInterval = PositiveSetting("任务奖励间隔秒", 21600)
    mailEnabled = ReadUIConfig("邮件启用", True)
    mailInterval = PositiveSetting("邮件间隔秒", 21600)
    loginLimit = PositiveSetting("登录总超时秒", 600) * 1000
    businessLimit = PositiveSetting("业务总超时秒", 120) * 1000
    messageMode = ReadUIConfig("消息邮件", 0)
    // root.784: zero means 1000ms; positive values are seconds.
    hallReturnDelaySeconds = PositiveSetting("返回延迟秒", 0)
End Sub


// common/任务状态.mq
Sub NewSession()
    Call NewTimedStaminaSession()
    qfriendDone = False
    qfriendFailed = False
    qfriendCount = 0
    qfriendFailures = 0
    qfriendDue = 0
    qfriendFirst = True
    qfriendPhase = "未开始"
    qfriendTerminal = False
    qfriendRecovery = False
    friendDone = False
    friendFailed = False
    friendCount = 0
    friendFailures = 0
    friendDue = 0
    friendFirst = True
    friendPhase = "未开始"
    monthDone = False
    monthFailed = False
    monthCount = 0
    monthFailures = 0
    monthDue = 0
    monthFirst = True
    monthPhase = "未开始"
    monthCardType = -1
    monthlySearchDirection = 0
    activityOcrLast = "<未识别>"
    activityOcrLogAt = TickCount() - 5000
    signDone = False
    signFailed = False
    signCount = 0
    signFailures = 0
    signDue = 0
    signFirst = True
    signPhase = "未开始"
    currentTask = 0
    resumeTask = 0
    mailDone = False
    mailFailed = False
    mailCount = 0
    mailFailures = 0
    mailDue = 0
    mailFirst = True
    mailPhase = "未开始"
    rewardDone = False
    rewardFailed = False
    rewardCount = 0
    rewardFailures = 0
    rewardDue = 0
    rewardFirst = True
    rewardPhase = "未开始"
    businessStarted = 0
    loginStarted = 0
    progressAt = 0
    hallMisses = 0
    hallExtended = False
    hallActionIndex = 0
    hallFrames = 0
    hallSampleAt = TickCount() - 500
    qqLastForeground = ""
    qqLastDiagnosticAt = TickCount() - 5000
    loginFailures = 0
    stageName = "新会话"
    terminalConfirmed = False
End Sub
Sub SaveCurrentTask(taskId)
    Call Note("[流程] 入口 SaveCurrentTask")
    currentTask = taskId
    resumeTask = taskId
    terminalConfirmed = False
    If IsTimedStamina(taskId) Then
        Call StartTimedStamina(taskId)
    End If
    If taskId = 56 Then
        qfriendDone = False
        qfriendFailed = False
        qfriendTerminal = False
        qfriendRecovery = False
    ElseIf taskId = 55 Then
        friendDone = False
        friendFailed = False
    ElseIf taskId = 166 Then
        monthDone = False
        monthFailed = False
    ElseIf taskId = 167 Then
        signDone = False
        signFailed = False
    ElseIf taskId = 168 Then
        mailDone = False
        mailFailed = False
    ElseIf taskId = 169 Then
        rewardDone = False
        rewardFailed = False
    End If
    Call Note("[流程] 出口 SaveCurrentTask 到达函数末尾（不代表任务已提交）")
End Sub
Sub SaveRecovery()
    Call Note("[流程] 入口 SaveRecovery")
    resumeTask = currentTask
    If IsTimedStamina(currentTask) Then
        Call RecoverTimedStamina(currentTask)
    End If
    If currentTask = 56 Then
        qfriendFailed = True
        qfriendRecovery = True
        qfriendTerminal = False
        qfriendFailures = qfriendFailures + 1
        qfriendPhase = "等待恢复"
        Call Note("[Q友体力56] 保存原任务=" & resumeTask & " 失败次数=" & qfriendFailures)
    ElseIf currentTask = 55 Then
        friendFailed = True
        friendFailures = friendFailures + 1
        friendPhase = "等待恢复"
        Call Note("[好友体力55] 保存恢复 原业务=" & resumeTask & " 失败次数=" & friendFailures)
    ElseIf currentTask = 166 Then
        monthFailed = True
        monthFailures = monthFailures + 1
        Call Note("保留原业务=" & resumeTask & "，月卡失败次数=" & monthFailures)
    ElseIf currentTask = 167 Then
        signFailed = True
        signFailures = signFailures + 1
        Call Note("保留原业务=" & resumeTask & "，签到失败次数=" & signFailures)
    ElseIf currentTask = 168 Then
        mailFailed = True
        mailFailures = mailFailures + 1
        Call Note("保留原业务=" & resumeTask & "，业务失败次数=" & mailFailures)
    ElseIf currentTask = 169 Then
        rewardFailed = True
        rewardFailures = rewardFailures + 1
        Call Note("保留原业务=" & resumeTask & "，业务失败次数=" & rewardFailures)
    End If
    Call Note("[流程] 出口 SaveRecovery 到达函数末尾（不代表任务已提交）")
End Sub
Function CommitTask(hallConfirmed)
    Call Note("[流程] 入口 CommitTask")
    CommitTask = False
    If currentTask <> 168 And currentTask <> 169 And currentTask <> 167 And currentTask <> 166 And currentTask <> 55 And currentTask <> 56 And Not IsTimedStamina(currentTask) Then
        Call Note("[流程] 出口 CommitTask 分支1 路径条件 currentTask <> 168 And currentTask <> 169 And currentTask <> 167 And currentTask <> 166 And currentTask <> 55 And currentTask <> 56")
        Exit Function
    End If
    If Not terminalConfirmed Then
        Call Note("[流程] 出口 CommitTask 分支2 路径条件 Not terminalConfirmed")
        Exit Function
    End If
    If Not hallConfirmed Then
        Call Note("[流程] 出口 CommitTask 分支3 路径条件 Not hallConfirmed")
        Exit Function
    End If
    If Not BeginForegroundCommit() Then
        Call Note("[流程] 出口 CommitTask 分支4 路径条件 Not BeginForegroundCommit()")
        Exit Function
    End If
    If IsTimedStamina(currentTask) Then
        Call CommitTimedStamina(currentTask)
    ElseIf currentTask = 56 Then
        qfriendDone = True
        qfriendFailed = False
        qfriendRecovery = False
        qfriendCount = qfriendCount + 1
        qfriendDue = TickCount() + qfriendInterval * 1000
        qfriendFirst = False
        qfriendPhase = "完成"
        Call Note("[Q友体力56] 返回大厅连续确认后提交 次数=" & qfriendCount & " 间隔秒=" & qfriendInterval)
    ElseIf currentTask = 55 Then
        friendDone = True
        friendFailed = False
        friendCount = friendCount + 1
        friendDue = TickCount() + friendInterval * 1000
        friendFirst = False
        friendPhase = "完成"
        Call Note("[好友体力55] 返回大厅连续确认后提交 次数=" & friendCount & " 间隔秒=" & friendInterval)
    ElseIf currentTask = 166 Then
        monthDone = True
        monthFailed = False
        monthCount = monthCount + 1
        monthDue = TickCount() + monthInterval * 1000
        monthFirst = False
        monthPhase = "完成"
        Call Note("月卡龙石166提交完成，次数=" & monthCount & "，间隔秒=" & monthInterval)
    ElseIf currentTask = 167 Then
        signDone = True
        signFailed = False
        signCount = signCount + 1
        signDue = TickCount() + signInterval * 1000
        signFirst = False
        signPhase = "完成"
        Call Note("日常签到167提交完成，次数=" & signCount & "，间隔秒=" & signInterval)
    ElseIf currentTask = 168 Then
        mailDone = True
        mailFailed = False
        mailCount = mailCount + 1
        mailDue = TickCount() + mailInterval * 1000
        mailFirst = False
        mailPhase = "完成"
        Call Note("邮件提交完成，次数=" & mailCount & "，间隔秒=" & mailInterval)
    ElseIf currentTask = 169 Then
        rewardDone = True
        rewardFailed = False
        rewardCount = rewardCount + 1
        rewardDue = TickCount() + rewardInterval * 1000
        rewardFirst = False
        rewardPhase = "完成"
        Call Note("任务奖励169提交完成，次数=" & rewardCount & "，间隔秒=" & rewardInterval)
    End If
    currentTask = 0
    resumeTask = 0
    terminalConfirmed = False
    CommitTask = True
    Call Note("[流程] 结果 CommitTask True")
    Call EndForegroundCommit()
    Call Note("[流程] 出口 CommitTask 到达函数末尾（不代表任务已提交）")
End Function


// common/运行计时.mq
Function LoginExpired()
    LoginExpired = ForegroundInterrupted() Or TickCount() - loginStarted >= loginLimit
End Function
Function BusinessExpired()
    BusinessExpired = ForegroundInterrupted() Or TickCount() - businessStarted >= businessLimit
End Function
Sub Progress()
    progressAt = TickCount()
End Sub


// common/点击操作.mq
Sub TouchPoint(x, y, waitMs)
    Dim remaining, sliceMs
    Call Note("[流程] 入口 TouchPoint")
    If ForegroundInterrupted() Then
        Call Note("[流程] 出口 TouchPoint 分支1 路径条件 ForegroundInterrupted()")
        Exit Sub
    End If
    // Do not tap another app during the five-second grace period.
    If Not Sys.AppIsFront(GAME_PACKAGE) And Not Sys.AppIsFront(QQ_PACKAGE) And Sys.GetFront() <> "com.tencent.mobileqq:openSdk" Then
        Call Note("[流程] 出口 TouchPoint 分支2 路径条件 Not Sys.AppIsFront(GAME_PACKAGE) And Not Sys.AppIsFront(QQ_PACKAGE) And Sys.GetFront() <> 'com.tencent.mobileqq:openSdk'")
        Exit Sub
    End If
    ReleaseCapture
    Tap x, y
    Call Note("[流程] 已发送点击 x=" & x & " y=" & y & " 等待毫秒=" & waitMs)
    remaining = waitMs
    Do While remaining > 0
        If ForegroundInterrupted() Then
            Call Note("[流程] 出口 TouchPoint 分支3 路径条件 ForegroundInterrupted()")
            Exit Sub
        End If
        sliceMs = remaining
        If sliceMs > 100 Then
            sliceMs = 100
        End If
        Delay sliceMs
        remaining = remaining - sliceMs
    Loop
    Call Note("[流程] 出口 TouchPoint 到达函数末尾（不代表任务已提交）")
End Sub
Function TouchPattern(name, waitMs)
    TouchPattern = False
    If MatchPattern(name) Then
        Call Note("[流程] 图色命中 " & name)
        Call TouchPoint(foundX, foundY, waitMs)
        TouchPattern = True
    End If
End Function


// common/活动入口.mq
Function ReadActivityText(x1, y1, x2, y2)
    Dim text
    ReadActivityText = ""
    If ForegroundInterrupted() Then
        Exit Function
    End If
    ReleaseCapture
    text = Image.OcrText(x1, y1, x2, y2, 0, 0)
    If IsNull(text) Then
        text = ""
    End If
    If text <> activityOcrLast Or TickCount() - activityOcrLogAt >= 5000 Then
        Call Note("[活动OCR] 区域=" & x1 & "," & y1 & "," & x2 & "," & y2 & " 文本=" & text)
        activityOcrLast = text
        activityOcrLogAt = TickCount()
    End If
    ReadActivityText = text
End Function
Sub SwipeActivityPage(reverse)
    If ForegroundInterrupted() Then
        Call Note("[活动滑动] 出口：前台中断，未执行")
        Exit Sub
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call Note("[活动滑动] 出口：游戏不在前台，未执行")
        Exit Sub
    End If
    ReleaseCapture
    If reverse Then
        Call Note("[活动滑动] 159,137到609,137，300毫秒")
        Swipe 159, 137, 609, 137, 300
    Else
        Call Note("[活动滑动] 609,137到159,137，300毫秒")
        Swipe 609, 137, 159, 137, 300
    End If
    If ForegroundInterrupted() Then
        Call Note("[活动滑动] 出口：后续短滑前中断")
        Exit Sub
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call Note("[活动滑动] 出口：后续短滑前离开游戏")
        Exit Sub
    End If
    Swipe 100, 100, 100, 50, 100
    Call Note("[活动滑动] 出口：已完成及100,100到100,50短滑")
End Sub


