// common/大厅清障.mq
// root.784: public return/clearance actions only. No business state submission.
Sub ResetHallClearing()
    hallMisses = 0
    hallExtended = False
    hallActionIndex = 0
End Sub
Function HallActionWait()
    HallActionWait = 1000
    If hallReturnDelaySeconds > 0 Then
        HallActionWait = hallReturnDelaySeconds * 1000
    End If
End Function
Function FindHallObstacle(includeExtended)
    FindHallObstacle = False
    hallActionIndex = 0
    If MatchPattern("大厅清障01") Then
        hallActionIndex = 1
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障02") Then
        hallActionIndex = 2
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障03") Then
        hallActionIndex = 3
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障04") Then
        hallActionIndex = 4
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障05") Then
        hallActionIndex = 5
        FindHallObstacle = True
        Exit Function
    End If
    If MatchPattern("大厅清障06") Then
        hallActionIndex = 6
        FindHallObstacle = True
        Exit Function
    End If
    If includeExtended Then
        If MatchPattern("大厅清障07") Then
            hallActionIndex = 7
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障08") Then
            hallActionIndex = 8
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障09") Then
            hallActionIndex = 9
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障10") Then
            hallActionIndex = 10
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障11") Then
            hallActionIndex = 11
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障12") Then
            hallActionIndex = 12
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障13") Then
            hallActionIndex = 13
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障14") Then
            hallActionIndex = 14
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障15") Then
            hallActionIndex = 15
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障16") Then
            hallActionIndex = 16
            FindHallObstacle = True
            Exit Function
        End If
        If MatchPattern("大厅清障17") Then
            hallActionIndex = 17
            FindHallObstacle = True
            Exit Function
        End If
    End If
End Function
Function ClearHallObstacle()
    Dim selected, selectedIndex, selectedX, selectedY, waitMs
    ClearHallObstacle = False
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    // The prototype keeps expanded candidate descriptors after the counter resets.
    If hallMisses > 3 Then
        hallMisses = 0
        hallExtended = True
    End If
    selected = FindHallObstacle(hallExtended)
    selectedIndex = hallActionIndex
    selectedX = foundX
    selectedY = foundY
    waitMs = HallActionWait()
    // Special lookup comes after selection but its action takes precedence.
    If MatchPattern("大厅清障特殊分支") Then
        Call Note("大厅清障：特殊分支，点击=" & (foundX - 311) & "," & (foundY + 10) & "，等待毫秒=" & waitMs)
        Call TouchPoint(foundX - 311, foundY + 10, waitMs)
        hallMisses = 0
        Call ResetHallCheck()
        ClearHallObstacle = True
    ElseIf selected Then
        Call Note("大厅清障：候选=" & selectedIndex & "，点击=" & selectedX & "," & selectedY & "，等待毫秒=" & waitMs)
        Call TouchPoint(selectedX, selectedY, waitMs)
        hallMisses = 0
        Call ResetHallCheck()
        ClearHallObstacle = True
    Else
        hallMisses = hallMisses + 1
    End If
    // Caller supplies the original 100ms tail once per clearance round.
End Function


// common/页面识别.mq
Function GreenArrow()
    GreenArrow = True
    If MatchPattern("绿色返回一") Then
        Exit Function
    End If
    GreenArrow = MatchPattern("绿色返回二")
End Function
Function HallCandidate()
    Dim candidateFound
    candidateFound = False
    HallCandidate = False
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Exit Function
    End If
    If MatchPattern("大厅主体") Then
        candidateFound = True
    ElseIf MatchPattern("大厅底部") Then
        candidateFound = True
    End If
    If Not candidateFound Then
        Exit Function
    End If
    HallCandidate = True
    If FindHallObstacle(True) Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("大厅清障特殊分支") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("获得奖励") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("邮件关闭弹窗") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭一") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭二") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("关闭三") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("我知道了") Then
        HallCandidate = False
        Exit Function
    End If
    If MatchPattern("回归公告") Then
        HallCandidate = False
    End If
End Function
Sub ResetHallCheck()
    hallFrames = 0
    hallSampleAt = TickCount() - 500
End Sub
Function ConfirmHall()
    ConfirmHall = False
    If TickCount() - hallSampleAt < 500 Then
        Exit Function
    End If
    hallSampleAt = TickCount()
    If HallCandidate() Then
        hallFrames = hallFrames + 1
    Else
        hallFrames = 0
    End If
    ConfirmHall = hallFrames >= 2
End Function


// common/游戏控制.mq
Sub StartGame()
    Call Note("[流程] 入口 StartGame")
    If Sys.AppIsFront(QQ_PACKAGE) Or Sys.GetFront() = "com.tencent.mobileqq:openSdk" Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            Call Note("[流程] 出口 StartGame 分支1 路径条件 Sys.IsRunning(GAME_PACKAGE)")
            Exit Sub
        End If
    End If
    If Not Sys.AppIsFront(GAME_PACKAGE) Then
        Call BeginForegroundRecovery()
        RunApp GAME_PACKAGE
        Call EndForegroundRecovery()
    End If
    Call Note("[流程] 出口 StartGame 到达函数末尾（不代表任务已提交）")
End Sub
Sub RestartGame()
    If IsTimedStamina(currentTask) Then
        Call RestartTimedStamina(currentTask)
    End If
    Call Note("[流程] 入口 RestartGame")
    Call BeginForegroundRecovery()
    foregroundLoginPending = True
    Call Note("重启游戏；保持同一会话及待恢复业务=" & resumeTask)
    KillApp GAME_PACKAGE
    // New-engine process shutdown settling delay, not a recovered task delay.
    Delay 1000
    loginStarted = TickCount()
    RunApp GAME_PACKAGE
    Call EndForegroundRecovery()
    Call Note("[流程] 出口 RestartGame 到达函数末尾（不代表任务已提交）")
End Sub


// common/返回大厅.mq
Function ReturnToHall()
    Dim returnStarted, acted
    Call Note("[流程] 入口 ReturnToHall")
    ReturnToHall = RESULT_TIMEOUT
    returnStarted = TickCount()
    Call SetStage("大厅清障与绿色箭头返回")
    Call ResetHallCheck()
    Call ResetHallClearing()
    Do
        If ForegroundInterrupted() Or TickCount() - returnStarted >= businessLimit Then
            Call Note("[流程] 出口 ReturnToHall 分支1 路径条件 ForegroundInterrupted() Or TickCount() - returnStarted >= businessLimit")
            Exit Function
        End If
        If ConfirmHall() Then
            ReturnToHall = RESULT_OK
            Call Note("[流程] 结果 ReturnToHall RESULT_OK")
            Call Note("[流程] 出口 ReturnToHall 分支2 路径条件 ConfirmHall()")
            Exit Function
        End If
        acted = ClearHallObstacle()
        Delay 100
    Loop
    Call Note("[流程] 出口 ReturnToHall 到达函数末尾（不代表任务已提交）")
End Function


// common/任务注册.mq
Sub RegisterTasks()
    qfriendRegisteredTask = 56
    friendRegisteredTask = 55
    registeredTask = 168
    rewardRegisteredTask = 169
    signRegisteredTask = 167
    monthRegisteredTask = 166
    Call Note("注册邮件168、任务奖励169、日常签到167和月卡龙石166、好友体力55、Q友体力56；定时体力50至54；使用唯一串行调度器")
End Sub
Function SelectDueTask()
    Dim selected, selectedDue
    SelectDueTask = 0
    If resumeTask = registeredTask Or resumeTask = rewardRegisteredTask Or resumeTask = signRegisteredTask Or resumeTask = monthRegisteredTask Or resumeTask = friendRegisteredTask Or resumeTask = qfriendRegisteredTask Or IsTimedStamina(resumeTask) Then
        If resumeTask <> 0 Then
            SelectDueTask = resumeTask
            Exit Function
        End If
    End If
    selected = SelectTimedStamina()
    If selected <> 0 Then
        SelectDueTask = selected
        Exit Function
    End If
    If mailEnabled And mailFirst Then
        SelectDueTask = registeredTask
        Exit Function
    End If
    If rewardEnabled And rewardFirst Then
        SelectDueTask = rewardRegisteredTask
        Exit Function
    End If
    If signEnabled And signFirst Then
        SelectDueTask = signRegisteredTask
        Exit Function
    End If
    If monthEnabled And monthFirst Then
        SelectDueTask = monthRegisteredTask
        Exit Function
    End If
    If friendEnabled And friendFirst Then
        SelectDueTask = friendRegisteredTask
        Exit Function
    End If
    If qfriendEnabled And qfriendFirst Then
        SelectDueTask = qfriendRegisteredTask
        Exit Function
    End If
    selected = 0
    selectedDue = 0
    If mailEnabled Then
        If TickCount() >= mailDue Then
            selected = registeredTask
            selectedDue = mailDue
        End If
    End If
    If rewardEnabled Then
        If TickCount() >= rewardDue Then
            If selected = 0 Or rewardDue < selectedDue Then
                selected = rewardRegisteredTask
                selectedDue = rewardDue
            End If
        End If
    End If
    If signEnabled Then
        If TickCount() >= signDue Then
            If selected = 0 Or signDue < selectedDue Then
                selected = signRegisteredTask
                selectedDue = signDue
            End If
        End If
    End If
    If monthEnabled Then
        If TickCount() >= monthDue Then
            If selected = 0 Or monthDue < selectedDue Then
                selected = monthRegisteredTask
                selectedDue = monthDue
            End If
        End If
    End If
    If friendEnabled Then
        If TickCount() >= friendDue Then
            If selected = 0 Or friendDue < selectedDue Then
                selected = friendRegisteredTask
                selectedDue = friendDue
            End If
        End If
    End If
    If qfriendEnabled Then
        If TickCount() >= qfriendDue Then
            If selected = 0 Or qfriendDue < selectedDue Then
                selected = qfriendRegisteredTask
            End If
        End If
    End If
    SelectDueTask = selected
End Function


// common/任务分派.mq
Function DispatchTask(taskId)
    Call Note("[流程] 入口 DispatchTask")
    DispatchTask = RESULT_FAIL
    If IsTimedStamina(taskId) Then
        terminalConfirmed = False
        DispatchTask = ExecuteTimedStamina(taskId)
    ElseIf taskId = 56 Then
        terminalConfirmed = False
        DispatchTask = ExecuteQQFriendStamina()
    ElseIf taskId = 55 Then
        terminalConfirmed = False
        DispatchTask = ExecuteFriendEnergy()
    ElseIf taskId = 166 Then
        terminalConfirmed = False
        DispatchTask = ExecuteMonthlyStones()
    ElseIf taskId = 167 Then
        terminalConfirmed = False
        DispatchTask = ExecuteDailySign()
    ElseIf taskId = 168 Then
        terminalConfirmed = False
        DispatchTask = ExecuteMail()
    ElseIf taskId = 169 Then
        terminalConfirmed = False
        DispatchTask = ExecuteTaskRewards()
    End If
    Call Note("[流程] 出口 DispatchTask 到达函数末尾（不代表任务已提交）")
End Function


// common/任务调度.mq
Sub SchedulerStep()
    Dim selected, result, hallResult, committed
    committed = HandleForegroundRecovery()
    selected = SelectDueTask()
    If selected = 0 Then
        If foregroundLoginPending Then
            result = EnsureGameHall()
            Call Note("[流程] EnsureGameHall() 返回=" & result)
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If result = RESULT_OK Then
                foregroundLoginPending = False
            Else
                Call RestartGame()
            End If
        End If
        Exit Sub
    End If
    Call SaveCurrentTask(selected)
    Call Note("[流程] 调度入口 任务=" & selected)
    result = EnsureGameHall()
    Call Note("[流程] EnsureGameHall() 返回=" & result)
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result <> RESULT_OK Then
        loginFailures = loginFailures + 1
        Call Note("登录总超时，次数=" & loginFailures)
        Call RestartGame()
        Exit Sub
    End If
    foregroundLoginPending = False
    businessStarted = TickCount()
    result = DispatchTask(selected)
    Call Note("[流程] DispatchTask(selected) 返回=" & result)
    Do While result = RESULT_WAIT
        If BusinessExpired() Then
            result = RESULT_TIMEOUT
        Else
            Delay 20
            result = DispatchTask(selected)
            Call Note("[流程] DispatchTask(selected) 返回=" & result)
        End If
    Loop
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result = RESULT_OK And terminalConfirmed Then
        hallResult = ReturnToHall()
        Call Note("[流程] ReturnToHall() 返回=" & hallResult)
        If IsTimedStamina(currentTask) Then
            Call Note("[定时体力] 编号=" & currentTask & " 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If HandleForegroundRecovery() Then
            Exit Sub
        End If
        If hallResult = RESULT_OK Then
            committed = CommitTask(True)
            Call Note("[流程] CommitTask(True) 返回=" & committed)
            If committed Then
                Exit Sub
            End If
        End If
    End If
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    Call SaveRecovery()
    Call Note("[流程] 调度出口 业务未提交成功，进入恢复")
    Call RestartGame()
End Sub


// flows/001_游戏重连/QQ登录.mq
Function ClickQQAuthorization(patternName, label, offsetX, offsetY)
    ClickQQAuthorization = False
    If LoginExpired() Then
        Exit Function
    End If
    If MatchPattern(patternName) Then
        Call Note("QQ授权R3：" & label & "，模板=" & patternName & "，点击=" & (foundX + offsetX) & "," & (foundY + offsetY))
        Call TouchPoint(foundX + offsetX, foundY + offsetY, 1000)
        ClickQQAuthorization = True
    End If
End Function
Function HandleQQ()
    Dim anchorX, anchorY, authorizationHandled, diagnosticRound
    HandleQQ = False
    authorizationHandled = False
    diagnosticRound = False
    If TickCount() - qqLastDiagnosticAt >= 5000 Then
        qqLastDiagnosticAt = TickCount()
        diagnosticRound = True
        Call Note("QQ授权R3：原版图色巡检，登录已用毫秒=" & (TickCount() - loginStarted))
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // root.793 L3694-3752: one-click check precedes the three authorization groups.
    If MatchPattern("QQ一键登录") Then
        anchorX = foundX
        anchorY = foundY
        Call Note("QQ授权R3：一键登录")
        Call TouchPoint(anchorX - 151, anchorY + 86, 1000)
        If Not LoginExpired() Then
            Call TouchPoint(anchorX + 63, anchorY, 1000)
        End If
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // Keep the original candidates first. Add screenshot-derived fallback only.
    If ClickQQAuthorization("QQ授权登录一", "授权登录", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ授权登录二", "授权登录", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版头像昵称同意", "头像昵称同意", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    // root.793 L4012/L4026: confirmation has two original candidates.
    If ClickQQAuthorization("QQ授权确认", "VIP会员确认", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ授权登录二", "VIP会员确认候选二", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版VIP会员确认", "VIP会员确认", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If LoginExpired() Then
        Exit Function
    End If
    If ClickQQAuthorization("QQ授权同意", "游戏信息同意", 0, 0) Then
        HandleQQ = True
        authorizationHandled = True
    ElseIf ClickQQAuthorization("QQ现版游戏信息同意", "游戏信息同意", 120, 0) Then
        HandleQQ = True
        authorizationHandled = True
    End If
    If Not authorizationHandled And diagnosticRound Then
        Call Note("QQ授权R3：未命中授权页面，继续登录总计时")
    End If
    // root.793 L4113-4117: authorization-section tail, not a new timeout.
    Delay 50
End Function


// flows/001_游戏重连/登录游戏.mq
Function EnsureGameHall()
    Dim agreementTouched, acted, clearanceChecked
    Call Note("[流程] 入口 EnsureGameHall")
    EnsureGameHall = RESULT_TIMEOUT
    agreementTouched = False
    If Not foregroundLoginPending Then
        loginStarted = TickCount()
    End If
    Call SetStage("启动及QQ登录")
    Call ResetHallCheck()
    Call ResetHallClearing()
    Call StartGame()
    Do
        If LoginExpired() Then
            Call Note("[流程] 出口 EnsureGameHall 分支1 路径条件 LoginExpired()")
            Exit Function
        End If
        If ConfirmHall() Then
            EnsureGameHall = RESULT_OK
            Call Note("[流程] 结果 EnsureGameHall RESULT_OK")
            Call Note("[流程] 出口 EnsureGameHall 分支2 路径条件 ConfirmHall()")
            Exit Function
        End If
        clearanceChecked = False
        acted = HandleQQ()
        If Sys.AppIsFront(GAME_PACKAGE) And Not acted Then
            // root.793: known notice handlers; no task-specific claim here.
            // Screenshot-specific game agreement; keep the shared login deadline.
            If MatchPattern("首次启动协议") Then
                Call Note("首次启动协议：点击同意，登录总计时继续")
                Call TouchPoint(foundX + 120, foundY + 1, 1000)
                acted = True
            ElseIf MatchPattern("游戏协议弹窗") Then
                Call Note("游戏协议弹窗：点击同意，登录总计时继续")
                Call TouchPoint(foundX + 58, foundY + 16, 1000)
                acted = True
            End If
            If Not acted Then
                acted = TouchPattern("我知道了", 1000)
            End If
            If Not acted Then
                acted = TouchPattern("回归公告", 1000)
            End If
            If Not acted Then
                acted = TouchPattern("开始游戏", 1500)
            End If
            // The original pattern named QQ登录页 is a login-options anchor.
            // root.793 L831-849 uses this template with automatic anchor click.
            If Not acted Then
                If MatchPattern("QQ登录页") Then
                    If MatchPattern("协议已选") Then
                        If MatchPattern("QQ登录页") Then
                            Call TouchPoint(foundX, foundY, 1500)
                            acted = True
                        End If
                    ElseIf Not agreementTouched Then
                        Call TouchPoint(45, 1150, 1500)
                        agreementTouched = True
                        acted = True
                    End If
                End If
            End If
            If Not acted Then
                clearanceChecked = True
                acted = ClearHallObstacle()
            End If
        End If
        // QQ or unknown foreground keeps the same login deadline.
        If clearanceChecked Then
            Delay 100
        Else
            Delay 20
        End If
    Loop
    Call Note("[流程] 出口 EnsureGameHall 到达函数末尾（不代表任务已提交）")
End Function


// flows/168_领邮件奖励/领邮件奖励.mq
Function MailEmpty()
    MailEmpty = True
    If MatchPattern("邮件空一") Then
        Exit Function
    End If
    MailEmpty = MatchPattern("邮件空二")
End Function
Function MailClaimable()
    MailClaimable = True
    If MatchPattern("邮件可领一") Then
        Exit Function
    End If
    MailClaimable = MatchPattern("邮件可领二")
End Function
Sub MailStage(value)
    mailPhase = value
    Call SetStage(value)
End Sub
Function ReadMessages()
    Dim localStarted, elapsed
    Call Note("[流程] 入口 ReadMessages")
    ReadMessages = RESULT_TIMEOUT
    localStarted = TickCount()
    Call MailStage("消息邮件自动阅读")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ReadMessages 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MatchPattern("邮件关闭弹窗") Then
            Call Note("[流程] 邮件图色命中 邮件关闭弹窗")
            Call TouchPoint(foundX, foundY, 200)
            localStarted = TickCount()
        End If
        If MatchPattern("邮件消息打开") Then
            Call Note("[流程] 邮件图色命中 邮件消息打开")
            Call TouchPoint(foundX, foundY, 200)
        End If
        elapsed = TickCount() - localStarted
        If elapsed > 2000 And elapsed <= 5000 Then
            If MatchPattern("邮件消息终态") Then
                Call Note("[流程] 邮件图色命中 邮件消息终态")
                ReadMessages = RESULT_OK
                Call Note("[流程] 结果 ReadMessages RESULT_OK")
                Call Note("[流程] 出口 ReadMessages 分支2 路径条件 MatchPattern('邮件消息终态')")
                Exit Function
            End If
        End If
        If elapsed > 5000 Then
            Call Note("[流程] 出口 ReadMessages 分支3 路径条件 elapsed > 5000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 ReadMessages 到达函数末尾（不代表任务已提交）")
End Function
Function ExecuteMail()
    Dim claimStarted, messageResult
    Call Note("[流程] 入口 ExecuteMail")
    ExecuteMail = RESULT_TIMEOUT
    Call MailStage("进入邮件")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ExecuteMail 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MatchPattern("邮件专业入口") Then
            Call Note("[流程] 邮件图色命中 邮件专业入口")
            Call TouchPoint(25, 830, 200)
        End If
        If MatchPattern("低客户端提示") Then
            Call Note("[流程] 邮件图色命中 低客户端提示")
            Call TouchPoint(foundX, foundY, 1500)
        End If
        If MailEmpty() Then
            Call Note("[流程] 邮件识别 无奖励状态命中")
            terminalConfirmed = True
            Call MailStage("入口确认无奖励")
            ExecuteMail = RESULT_OK
            Call Note("[流程] 结果 ExecuteMail RESULT_OK")
            Call Note("[流程] 出口 ExecuteMail 分支2 路径条件 MailEmpty()")
            Exit Function
        End If
        If MailClaimable() Then
            Delay 200
            Exit Do
        End If
        Delay 20
    Loop
    Call Progress()
    claimStarted = TickCount()
    Call MailStage("领取邮件奖励")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 ExecuteMail 分支3 路径条件 BusinessExpired()")
            Exit Function
        End If
        If MailClaimable() Then
            Call TouchPoint(foundX + 319, foundY - 90, 200)
            Call Progress()
        End If
        If MatchPattern("获得奖励") Then
            Call Note("[流程] 邮件图色命中 获得奖励")
            Call TouchPoint(foundX, foundY, 200)
            Call Progress()
        End If
        If MatchPattern("邮件关闭弹窗") Then
            Call Note("[流程] 邮件图色命中 邮件关闭弹窗")
            Call TouchPoint(foundX, foundY, 200)
            Call Progress()
        End If
        If MailEmpty() Then
            Call Note("[流程] 邮件识别 无奖励状态命中")
            Call Progress()
            Exit Do
        End If
        If TickCount() - claimStarted > 5000 Then
            Call Note("[流程] 出口 ExecuteMail 分支4 路径条件 TickCount() - claimStarted > 5000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 消息邮件模式 0手动跳过 1自动 当前=" & messageMode)
    If messageMode = 1 Then
        Call Note("[流程] 消息邮件 自动模式入口")
        messageResult = ReadMessages()
        If messageResult <> RESULT_OK Then
            Call Note("[流程] 出口 ExecuteMail 分支5 路径条件 messageResult <> RESULT_OK")
            Exit Function
        End If
    End If
    terminalConfirmed = True
    Call MailStage("邮件业务终态确认")
    ExecuteMail = RESULT_OK
    Call Note("[流程] 结果 ExecuteMail RESULT_OK")
    Call Note("[流程] 出口 ExecuteMail 到达函数末尾（不代表任务已提交）")
End Function


// flows/169_领任务奖励/领任务奖励.mq
// Independent MQ implementation of professional root.729 behavior.
Sub RewardStage(value)
    rewardPhase = value
    Call SetStage(value)
End Sub
Function RewardTouch(name, dx, dy, waitMs)
    RewardTouch = False
    If MatchPattern(name) Then
        Call Note("任务169：" & name & "，点击=" & (foundX + dx) & "," & (foundY + dy))
        Call TouchPoint(foundX + dx, foundY + dy, waitMs)
        RewardTouch = True
    End If
End Function
Function RewardGrowthClaimable()
    RewardGrowthClaimable = True
    If MatchPattern("169_成长有奖一") Then
        Exit Function
    End If
    RewardGrowthClaimable = MatchPattern("169_成长有奖二")
End Function
Function RewardGrowthEmpty()
    RewardGrowthEmpty = True
    If MatchPattern("169_成长无奖一") Then
        Exit Function
    End If
    RewardGrowthEmpty = MatchPattern("169_成长无奖二")
End Function
Function RewardDailyClaimable()
    RewardDailyClaimable = True
    If MatchPattern("169_日常有奖一") Then
        Exit Function
    End If
    RewardDailyClaimable = MatchPattern("169_日常有奖二")
End Function
Function RewardDailyEmpty()
    RewardDailyEmpty = True
    If MatchPattern("169_日常无奖一") Then
        Exit Function
    End If
    RewardDailyEmpty = MatchPattern("169_日常无奖二")
End Function
Function RewardPageKnown()
    RewardPageKnown = True
    If RewardGrowthClaimable() Then
        Exit Function
    End If
    If RewardGrowthEmpty() Then
        Exit Function
    End If
    If RewardDailyClaimable() Then
        Exit Function
    End If
    If RewardDailyEmpty() Then
        Exit Function
    End If
    If MatchPattern("169_通行证") Then
        Exit Function
    End If
    If MatchPattern("169_特殊有奖") Then
        Exit Function
    End If
    RewardPageKnown = MatchPattern("169_特殊无奖")
End Function
Function EnterTaskRewards()
    Dim acted
    Call Note("[流程] 入口 EnterTaskRewards")
    EnterTaskRewards = RESULT_TIMEOUT
    Call RewardStage("169进入任务页面")
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 EnterTaskRewards 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        acted = RewardTouch("169_入口", 327, 0, 200)
        If RewardPageKnown() Then
            EnterTaskRewards = RESULT_OK
            Call Note("[流程] 结果 EnterTaskRewards RESULT_OK")
            Call Note("[流程] 出口 EnterTaskRewards 分支2 路径条件 RewardPageKnown()")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 EnterTaskRewards 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFirstPass()
    Dim phaseProgress
    Call Note("[流程] 入口 RewardFirstPass")
    RewardFirstPass = RESULT_TIMEOUT
    Call RewardStage("169第一段：成长、日常、特殊")
    phaseProgress = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFirstPass 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        // Independent checks in professional order; no universal popup priority.
        If RewardGrowthClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
            phaseProgress = TickCount()
        End If
        If RewardGrowthEmpty() Then
            Call TouchPoint(foundX - 90, foundY - 977, 50)
            phaseProgress = TickCount()
        End If
        If RewardDailyClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
        End If
        If RewardDailyEmpty() Then
            Delay 50
            RewardFirstPass = RESULT_OK
            Call Note("[流程] 结果 RewardFirstPass RESULT_OK")
            Call Note("[流程] 出口 RewardFirstPass 分支2 路径条件 RewardDailyEmpty()")
            Exit Function
        End If
        If RewardTouch("169_通行证", 179, -1045, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_特殊有奖", 0, 0, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_特殊无奖", -90, -977, 50) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 50) Then
            phaseProgress = TickCount()
        End If
        If TickCount() - phaseProgress > 10000 Then
            Call Note("任务169第一段无进展超时，交公共恢复")
            Call Note("[流程] 出口 RewardFirstPass 分支3 路径条件 TickCount() - phaseProgress > 10000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFirstPass 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFourPositions()
    Dim phaseProgress, positionIndex, dx
    Call Note("[流程] 入口 RewardFourPositions")
    RewardFourPositions = RESULT_TIMEOUT
    Call RewardStage("169第二段：四位置奖励")
    phaseProgress = TickCount()
    positionIndex = 0
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFourPositions 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 200) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗二", 0, 0, 1000) Then
            phaseProgress = TickCount()
        End If
        If RewardDailyEmpty() Then
            dx = -159
            If positionIndex = 1 Then
                dx = -27
            ElseIf positionIndex = 2 Then
                dx = 106
            ElseIf positionIndex = 3 Then
                dx = 234
            End If
            Call Note("任务169四位置，序号=" & (positionIndex + 1))
            Call TouchPoint(foundX + dx, foundY - 875, 1000)
            positionIndex = positionIndex + 1
        End If
        // Original exit precedes the phase timeout check. Four clicks only.
        If positionIndex > 3 Then
            RewardFourPositions = RESULT_OK
            Call Note("[流程] 结果 RewardFourPositions RESULT_OK")
            Call Note("[流程] 出口 RewardFourPositions 分支2 路径条件 positionIndex > 3")
            Exit Function
        End If
        If TickCount() - phaseProgress > 10000 Then
            Call Note("任务169第二段无进展超时，交公共恢复")
            Call Note("[流程] 出口 RewardFourPositions 分支3 路径条件 TickCount() - phaseProgress > 10000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFourPositions 到达函数末尾（不代表任务已提交）")
End Function
Function RewardFinalPass()
    Dim phaseProgress, acted
    Call Note("[流程] 入口 RewardFinalPass")
    RewardFinalPass = RESULT_TIMEOUT
    Call RewardStage("169第三段：确认成长或特殊终态")
    phaseProgress = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[流程] 出口 RewardFinalPass 分支1 路径条件 BusinessExpired()")
            Exit Function
        End If
        If RewardTouch("169_奖励弹窗二", 0, 0, 1000) Then
            phaseProgress = TickCount()
        End If
        If RewardTouch("169_奖励弹窗一", 0, 0, 200) Then
            phaseProgress = TickCount()
        End If
        If RewardDailyEmpty() Then
            Call TouchPoint(foundX + 87, foundY - 977, 50)
        End If
        If RewardGrowthClaimable() Then
            Call TouchPoint(foundX, foundY, 50)
            phaseProgress = TickCount()
        End If
        If RewardGrowthEmpty() Then
            If Not BusinessExpired() Then
                terminalConfirmed = True
                RewardFinalPass = RESULT_OK
                Call Note("[流程] 结果 RewardFinalPass RESULT_OK")
                Call RewardStage("169成长无奖终态已确认")
            End If
            Call Note("[流程] 出口 RewardFinalPass 分支2 路径条件 Not BusinessExpired()")
            Exit Function
        End If
        acted = RewardTouch("169_特殊有奖", 0, 0, 50)
        If MatchPattern("169_特殊无奖") Then
            If Not BusinessExpired() Then
                terminalConfirmed = True
                RewardFinalPass = RESULT_OK
                Call Note("[流程] 结果 RewardFinalPass RESULT_OK")
                Call RewardStage("169特殊无奖终态已确认")
            End If
            Call Note("[流程] 出口 RewardFinalPass 分支3 路径条件 Not BusinessExpired()")
            Exit Function
        End If
        If TickCount() - phaseProgress > 4000 Then
            Call Note("任务169末段无进展超时，未确认终态，交公共恢复")
            Call Note("[流程] 出口 RewardFinalPass 分支4 路径条件 TickCount() - phaseProgress > 4000")
            Exit Function
        End If
        Delay 20
    Loop
    Call Note("[流程] 出口 RewardFinalPass 到达函数末尾（不代表任务已提交）")
End Function
Function ExecuteTaskRewards()
    Dim result
    Call Note("[流程] 入口 ExecuteTaskRewards")
    ExecuteTaskRewards = RESULT_TIMEOUT
    terminalConfirmed = False
    result = EnterTaskRewards()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支1 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    result = RewardFirstPass()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支2 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    result = RewardFourPositions()
    If result <> RESULT_OK Then
        Call Note("[流程] 出口 ExecuteTaskRewards 分支3 路径条件 result <> RESULT_OK")
        Exit Function
    End If
    ExecuteTaskRewards = RewardFinalPass()
    Call Note("[流程] 出口 ExecuteTaskRewards 到达函数末尾（不代表任务已提交）")
End Function


// flows/167_日常签到/日常签到.mq
Sub SignStage(value)
    signPhase = value
    Call SetStage(value)
End Sub
Sub SignTouch(name, x, y, waitMs)
    Call Note("[签到167] 命中=" & name & " 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function EnterDailySign()
    EnterDailySign = RESULT_TIMEOUT
    Call SignStage("167进入签到中心")
    Call Note("[签到167] 入口 EnterDailySign")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 EnterDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_入口") Then
            Call SignTouch("167_入口", foundX, foundY, 100)
        End If
        If MatchPattern("167_中心页面") Then
            Call SignTouch("167_中心页面", 150, 50, 200)
            If BusinessExpired() Then
                Call Note("[签到167] 出口 EnterDailySign：点击后超时或中断")
                Exit Function
            End If
            EnterDailySign = RESULT_OK
            Call Note("[签到167] 出口 EnterDailySign：中心已识别，进入领取")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ClaimDailySign()
    Dim claimStarted, cumulativeLogged
    ClaimDailySign = RESULT_TIMEOUT
    claimStarted = TickCount()
    cumulativeLogged = False
    Call SignStage("167领取签到奖励")
    Call Note("[签到167] 入口 ClaimDailySign；累计检查门槛大于5000毫秒")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 ClaimDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_领取一") Then
            Call SignTouch("167_领取一", foundX + 5, foundY, 500)
        End If
        If MatchPattern("167_领取二") Then
            Call SignTouch("167_领取二", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_领取三") Then
            Call SignTouch("167_领取三", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_领取四") Then
            Call SignTouch("167_领取四", foundX + 50, foundY - 20, 500)
        End If
        If MatchPattern("167_奖励弹窗") Then
            Call SignTouch("167_奖励弹窗", 5, 5, 0)
        End If
        If MatchPattern("167_充值提示") Then
            Call SignTouch("167_充值提示", foundX, foundY, 0)
        End If
        If TickCount() - claimStarted > 5000 Then
            If Not cumulativeLogged Then
                Call Note("[签到167] 累计检查启用；领取起点未刷新")
                cumulativeLogged = True
            End If
            If MatchPattern("167_累计可领") Then
                Call SignTouch("167_累计可领", foundX, foundY, 0)
            End If
            If MatchPattern("167_累计灰色") Then
                If BusinessExpired() Then
                    Call Note("[签到167] 出口 ClaimDailySign：灰色命中时已超时或中断")
                    Exit Function
                End If
                ClaimDailySign = RESULT_OK
                Call Note("[签到167] 出口 ClaimDailySign：累计灰色已确认，等待收尾终态")
                Exit Function
            End If
        End If
        Delay 20
    Loop
End Function
Function FinishDailySign()
    FinishDailySign = RESULT_TIMEOUT
    Call SignStage("167签到收尾确认")
    Call Progress()
    Call Note("[签到167] 入口 FinishDailySign")
    Do
        If BusinessExpired() Then
            Call Note("[签到167] 出口 FinishDailySign：业务总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("167_奖励弹窗") Then
            Call SignTouch("167_奖励弹窗收尾", foundX, foundY, 0)
            If BusinessExpired() Then
                Call Note("[签到167] 出口 FinishDailySign：收尾点击后超时或中断")
                Exit Function
            End If
            FinishDailySign = RESULT_OK
            Call Note("[签到167] 出口 FinishDailySign：奖励弹窗终态已处理")
            Exit Function
        End If
        If MatchPattern("167_中心页面") Then
            If BusinessExpired() Then
                Call Note("[签到167] 出口 FinishDailySign：中心命中时超时或中断")
                Exit Function
            End If
            FinishDailySign = RESULT_OK
            Call Note("[签到167] 出口 FinishDailySign：中心页面终态已确认")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteDailySign()
    Dim result
    ExecuteDailySign = RESULT_TIMEOUT
    terminalConfirmed = False
    Call Note("[签到167] 业务入口 ExecuteDailySign")
    result = EnterDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：进入失败，返回超时")
        Exit Function
    End If
    result = ClaimDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：领取未完成，返回超时")
        Exit Function
    End If
    result = FinishDailySign()
    If result <> RESULT_OK Then
        Call Note("[签到167] 业务出口：收尾未完成，返回超时")
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[签到167] 业务出口：终态提交前超时或中断")
        Exit Function
    End If
    terminalConfirmed = True
    ExecuteDailySign = RESULT_OK
    Call SignStage("167签到业务终态确认")
    Call Note("[签到167] 业务出口：成功；等待公共返回大厅后提交")
End Function


// flows/166_领月卡龙石/领月卡龙石.mq
Sub MonthStage(value)
    monthPhase = value
    Call SetStage(value)
End Sub
Sub MonthTouch(name, x, y, waitMs)
    Call Note("[月卡166] 命中=" & name & " 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function MonthActivityFrame()
    MonthActivityFrame = True
    If MatchPattern("166_活动框一") Then
        Exit Function
    End If
    MonthActivityFrame = MatchPattern("166_活动框二")
End Function
Function MonthHallKnown()
    MonthHallKnown = True
    If MatchPattern("166_大厅识别一") Then
        Exit Function
    End If
    If MatchPattern("166_大厅识别二") Then
        Exit Function
    End If
    MonthHallKnown = MatchPattern("166_大厅识别三")
End Function
Function MonthActivityIcon()
    MonthActivityIcon = True
    If MatchPattern("166_大厅活动入口一") Then
        Exit Function
    End If
    MonthActivityIcon = MatchPattern("166_大厅活动入口二")
End Function
Sub MonthResourcePrompt()
    Dim x, y, text
    If Not monthKeepDownload Then
        If MatchPattern("166_资源下载提示") Then
            x = foundX
            y = foundY
            text = ReadActivityText(100, 395, 317, 448)
            If text = "下载新功能" Then
                Call MonthTouch("166_资源下载提示标题", x, y, 0)
            End If
            text = ReadActivityText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                Call MonthTouch("166_资源下载提示网络", x, y, 0)
            End If
        End If
    End If
End Sub
Function EnterMonthlyActivities()
    Dim initialStarted, enterStarted, text, hallResult
    EnterMonthlyActivities = RESULT_TIMEOUT
    Call MonthStage("166进入活动界面")
    Call Note("[月卡166] 入口 EnterMonthlyActivities")
    initialStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：活动位置检查超时或前台中断")
            Exit Function
        End If
        If MonthActivityFrame() Then
            EnterMonthlyActivities = RESULT_OK
            Call Note("[月卡166] 出口：原活动框已确认")
            Exit Function
        End If
        If TickCount() - initialStarted > 2000 Then
            Exit Do
        End If
        Delay 20
    Loop
    hallResult = ReturnToHall()
    If hallResult <> RESULT_OK Then
        Call Note("[月卡166] 出口：进入活动前返回大厅失败")
        Exit Function
    End If
    enterStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：进入活动业务总超时或前台中断")
            Exit Function
        End If
        Call MonthResourcePrompt()
        If MonthActivityFrame() Then
            EnterMonthlyActivities = RESULT_OK
            Call Note("[月卡166] 出口：专业版当前位置活动框复核成功，进入月卡分页")
            Exit Function
        End If
        text = ReadActivityText(65, 7, 247, 59)
        If text = "活动" Then
            EnterMonthlyActivities = RESULT_OK
            Call Note("[月卡166] 出口：OCR活动标题已确认")
            Exit Function
        Else
            hallResult = ReturnToHall()
            If hallResult <> RESULT_OK Then
                Call Note("[月卡166] 出口：活动标题未成立且公共返回失败")
                Exit Function
            End If
        End If
        If MonthHallKnown() Then
            If MonthActivityIcon() Then
                Call MonthTouch("166_大厅活动入口", foundX, foundY, 1500)
            Else
                hallResult = ReturnToHall()
                If hallResult <> RESULT_OK Then
                    Call Note("[月卡166] 出口：无活动图标且公共返回失败")
                    Exit Function
                End If
            End If
        End If
        Delay 300
        If TickCount() - enterStarted > 60000 Then
            Call Note("[月卡166] 出口：专业版活动入口60秒超时；不提交完成")
            Delay 2000
            Exit Function
        End If
    Loop
End Function
Function FindMonthlyPage()
    Dim searchStarted, lastAction, swipeCount
    FindMonthlyPage = RESULT_TIMEOUT
    searchStarted = TickCount()
    lastAction = TickCount() + 1500
    swipeCount = 0
    monthlySearchDirection = 0
    Call MonthStage("166查找月卡分页")
    Call Note("[月卡166] 入口 FindMonthlyPage，入口限时35秒")
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：分页业务总超时或前台中断")
            Exit Function
        End If
        If monthlySearchDirection < 4 Then
            monthlySearchDirection = monthlySearchDirection + 1
        Else
            monthlySearchDirection = 0
        End If
        If MatchPattern("166_月卡页面") Then
            FindMonthlyPage = RESULT_OK
            Call Note("[月卡166] 出口：月卡页面已确认，搜索方向=" & monthlySearchDirection)
            Exit Function
        End If
        If MonthActivityFrame() Then
            If MatchPattern("166_月卡图标") Then
                Call MonthTouch("166_月卡图标", foundX, foundY, 1500)
                lastAction = TickCount()
            End If
            If TickCount() - lastAction > 1500 Then
                swipeCount = swipeCount + 1
                Call Note("[月卡166] 活动分页滑动序号=" & swipeCount)
                If swipeCount <= 7 Then
                    Call SwipeActivityPage(False)
                Else
                    Call SwipeActivityPage(True)
                    If swipeCount = 14 Then
                        swipeCount = 0
                    End If
                End If
                lastAction = TickCount()
            End If
        End If
        If TickCount() - searchStarted > 35000 Then
            Call Note("[月卡166] 出口：专业版分页35秒超时；不提交完成")
            Delay 2000
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function DetectMonthlyCard()
    Dim detected
    DetectMonthlyCard = RESULT_TIMEOUT
    monthCardType = -1
    Call MonthStage("166识别月卡类型")
    Call Progress()
    Call Note("[月卡166] 入口 DetectMonthlyCard；顺序左卡、右卡、双卡、未购买")
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：卡型未知至总超时或前台中断")
            Exit Function
        End If
        detected = False
        If MatchPattern("166_类型左卡") Then
            monthCardType = 1
            detected = True
        ElseIf MatchPattern("166_类型右卡") Then
            monthCardType = 3
            detected = True
        ElseIf MatchPattern("166_类型双卡") Then
            monthCardType = 2
            detected = True
        ElseIf MatchPattern("166_类型未购买") Then
            monthCardType = 0
            detected = True
        End If
        If detected Then
            Call Note("[月卡166] 卡型=" & monthCardType & "；0未购买 1左卡 2双卡 3右卡；等待1000毫秒")
            Delay 1000
            If BusinessExpired() Then
                Call Note("[月卡166] 出口：卡型等待后总超时或中断")
                Exit Function
            End If
            DetectMonthlyCard = RESULT_OK
            Call Note("[月卡166] 出口：卡型已确认")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Sub MonthClaimPair(name, dx)
    Dim x, y
    If MatchPattern(name) Then
        x = foundX + dx
        y = foundY - 184
        Call MonthTouch(name, x, y, 500)
        Call MonthTouch(name, x, y, 500)
    End If
End Sub
Function ClaimMonthlyStones()
    Dim finished
    ClaimMonthlyStones = RESULT_TIMEOUT
    Call MonthStage("166领取月卡龙石")
    Call Progress()
    Call Note("[月卡166] 入口 ClaimMonthlyStones，卡型=" & monthCardType)
    If monthCardType = 0 Then
        ClaimMonthlyStones = RESULT_OK
        Call Note("[月卡166] 出口：明确未购买，无奖励终态")
        Exit Function
    End If
    Do
        If BusinessExpired() Then
            Call Note("[月卡166] 出口：领取总超时或前台中断")
            Exit Function
        End If
        If MatchPattern("166_奖励弹窗") Then
            Call MonthTouch("166_奖励弹窗", foundX, foundY, 0)
        End If
        finished = False
        If monthCardType = 1 Then
            Call MonthClaimPair("166_左卡可领", 63)
            finished = MatchPattern("166_左卡灰色")
        ElseIf monthCardType = 2 Then
            Call MonthClaimPair("166_左卡可领", 63)
            Call MonthClaimPair("166_右卡可领", 410)
            finished = MatchPattern("166_双卡灰色")
        ElseIf monthCardType = 3 Then
            Call MonthClaimPair("166_右卡可领", 410)
            finished = MatchPattern("166_右卡灰色")
        End If
        If finished Then
            If BusinessExpired() Then
                Call Note("[月卡166] 出口：灰色终态命中时总超时或中断")
                Exit Function
            End If
            ClaimMonthlyStones = RESULT_OK
            Call Note("[月卡166] 出口：对应月卡灰色终态确认，卡型=" & monthCardType)
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteMonthlyStones()
    Dim result
    ExecuteMonthlyStones = RESULT_TIMEOUT
    terminalConfirmed = False
    Call Note("[月卡166] 业务入口 ExecuteMonthlyStones")
    result = EnterMonthlyActivities()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：活动入口失败，返回超时")
        Exit Function
    End If
    result = FindMonthlyPage()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：月卡分页失败，返回超时")
        Exit Function
    End If
    result = DetectMonthlyCard()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：卡型未确认，返回超时")
        Exit Function
    End If
    result = ClaimMonthlyStones()
    If result <> RESULT_OK Then
        Call Note("[月卡166] 业务出口：月卡终态未确认，返回超时")
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[月卡166] 业务出口：终态提交前已超时或中断")
        Exit Function
    End If
    terminalConfirmed = True
    ExecuteMonthlyStones = RESULT_OK
    Call MonthStage("166月卡业务终态确认")
    Call Note("[月卡166] 业务出口：成功，等待公共返回大厅后提交")
End Function


// flows/055_好友体力/好友体力.mq
Sub FriendStage(value)
    friendPhase = value
    Call SetStage(value)
End Sub
Function FriendTap(x, y, waitMs)
    FriendTap = False
    // Public foreground grace remains five seconds; never count a skipped click.
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Exit Function
    End If
    Call Note("[好友体力55] 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    If Not BusinessExpired() Then
        FriendTap = True
    End If
End Function
Function ExecuteFriendEnergy()
    Dim enteredAt, anchorX, anchorY, firstGroup
    ExecuteFriendEnergy = RESULT_TIMEOUT
    terminalConfirmed = False
    enteredAt = TickCount()
    firstGroup = True
    Call FriendStage("好友体力55进入")
    Call Note("[好友体力55] 入口 root.707 全屏多点找色 方向1 相似度0.9；进入限时10000毫秒")
    Do
        If BusinessExpired() Then
            Call Note("[好友体力55] 进入出口：公共超时或前台中断，保留原任务")
            Exit Function
        End If
        If MatchPattern("055_大厅入口锚点") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[好友体力55] 命中大厅锚点=" & anchorX & "," & anchorY & " 区域0,0,719,1279 偏移538,-28")
            If Not FriendTap(anchorX + 538, anchorY - 28, 1000) Then
                Exit Function
            End If
        End If
        If MatchPattern("055_好友页面") Then
            Call Note("[好友体力55] 进入好友页面确认；每组重新找色，同组沿用锚点")
            Exit Do
        End If
        If TickCount() - enteredAt > 10000 Then
            Call Note("[好友体力55] 进入超时出口：未确认好友页，不提交，交公共恢复原任务")
            Exit Function
        End If
        Delay 20
    Loop
    Call FriendStage("好友体力55第一组")
    Do
        If BusinessExpired() Then
            Call Note("[好友体力55] 动作出口：公共超时或前台中断，保留原任务")
            Exit Function
        End If
        If MatchPattern("055_好友页面") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[好友体力55] 命中好友页面=" & anchorX & "," & anchorY & " 区域0,0,719,1279")
            If firstGroup Then
                Call Note("[好友体力55] 第一组 偏移250,-110 双点击 等待500/1000毫秒")
                If Not FriendTap(anchorX + 250, anchorY - 110, 500) Then
                    Exit Function
                End If
                If Not FriendTap(anchorX + 250, anchorY - 110, 1000) Then
                    Exit Function
                End If
                firstGroup = False
                Call FriendStage("好友体力55第二组")
            Else
                Call Note("[好友体力55] 第二组 偏移460,-110 双点击 等待500/0毫秒")
                If Not FriendTap(anchorX + 460, anchorY - 110, 500) Then
                    Exit Function
                End If
                If Not FriendTap(anchorX + 460, anchorY - 110, 0) Then
                    Exit Function
                End If
                terminalConfirmed = True
                Call FriendStage("好友体力55待返回大厅")
                Call Note("[好友体力55] 业务出口成功：两组双点击完成，按用户确认终态；等待公共返回大厅连续确认后提交")
                ExecuteFriendEnergy = RESULT_OK
                Exit Function
            End If
        Else
            Delay 20
        End If
    Loop
End Function


// flows/056_Q友体力/Q友体力.mq
Sub QFriendStage(value)
    qfriendPhase = value
    Call SetStage(value)
    Call Note("[Q友体力56] 当前阶段=" & value)
End Sub
Function QFriendTap(x, y, waitMs)
    QFriendTap = False
    // Public foreground grace remains five seconds; never count a skipped click.
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Call Note("[Q友体力56] 点击出口=前台等待期间公共超时或中断，保留56恢复")
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[Q友体力56] 点击出口=动作前公共超时或中断，未执行点击")
        Exit Function
    End If
    Call Note("[Q友体力56] 点击=" & x & "," & y & " 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    If Not BusinessExpired() Then
        QFriendTap = True
    Else
        Call Note("[Q友体力56] 点击出口=动作等待期间公共超时或中断，不计为完成")
    End If
End Function
Function QFriendMatch(name)
    Dim matched
    matched = MatchPattern(name)
    QFriendMatch = matched
    If matched Then
        Call Note("[Q友体力56] 命中模板=" & name & " 搜索区域=0,0,719,1279 相似度=0.9 方向=1 锚点=" & foundX & "," & foundY)
    End If
End Function
Function ExecuteQQFriendStamina()
    Dim entryProgress, lastClaim, lastScroll, actionStarted, scrollCount, claimRun, scrollLocked, anchorX, anchorY, text, lastText, idleMs
    ExecuteQQFriendStamina = RESULT_TIMEOUT
    terminalConfirmed = False
    qfriendTerminal = False
    entryProgress = TickCount()
    Call QFriendStage("Q友体力56进入")
    If qfriendOneClick Then
        Call Note("[Q友体力56] 业务入口；一键领取配置=开启")
    Else
        Call Note("[Q友体力56] 业务入口；一键领取配置=关闭")
    End If
    Do
        If BusinessExpired() Then
            Call Note("[Q友体力56] 超时阶段=进入；公共超时或前台中断，等待公共恢复56")
            Exit Function
        End If
        If QFriendMatch("056_大厅入口") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[Q友体力56] 点击偏移=538,-28")
            If Not QFriendTap(anchorX + 538, anchorY - 28, 1000) Then
                Exit Function
            End If
            entryProgress = TickCount()
        End If
        If QFriendMatch("056_游戏好友页") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[Q友体力56] 切换QQ好友页签 点击偏移=10,-1046 等待毫秒=0")
            If Not QFriendTap(anchorX + 10, anchorY - 1046, 0) Then
                Exit Function
            End If
        End If
        If QFriendMatch("056_Q友页面") Then
            Call Note("[Q友体力56] Q友页面确认 等待毫秒=6000")
            // Reuse interruptible wait in public TouchPoint only for clicks; this is an explicit source Delay.
            Delay 6000
            Exit Do
        End If
        If TickCount() - entryProgress > 20000 Then
            Call Note("[Q友体力56] 失败原因=进入20秒无进展；不沿用原版标完成，交公共超时恢复")
            Exit Function
        End If
        Delay 20
    Loop
    actionStarted = TickCount()
    lastScroll = actionStarted
    Call QFriendStage("Q友体力56第一组")
    Do
        If BusinessExpired() Then
            Call Note("[Q友体力56] 超时阶段=第一组；公共超时或前台中断")
            Exit Function
        End If
        If QFriendMatch("056_Q友页面") Then
            anchorX = foundX
            anchorY = foundY
            Call Note("[Q友体力56] 第一组双点击 点击偏移=250,-110 等待毫秒=500/1000；不作为已赠送画面证明")
            If Not QFriendTap(anchorX + 250, anchorY - 110, 500) Then
                Exit Function
            End If
            If Not QFriendTap(anchorX + 250, anchorY - 110, 1000) Then
                Exit Function
            End If
            Exit Do
        End If
        Delay 20
    Loop
    lastClaim = entryProgress
    scrollCount = 0
    claimRun = 0
    scrollLocked = True
    lastText = "<未识别>"
    Call QFriendStage("Q友体力56领取")
    Do
        If BusinessExpired() Then
            Call Note("[Q友体力56] 超时阶段=领取；公共超时或前台中断，保留56")
            Exit Function
        End If
        If qfriendOneClick Then
            If QFriendMatch("056_Q友页面") Then
                anchorX = foundX
                anchorY = foundY
                Call Note("[Q友体力56] 一键领取 点击偏移=460,-110 等待毫秒=500/0")
                If Not QFriendTap(anchorX + 460, anchorY - 110, 500) Then
                    Exit Function
                End If
                If Not QFriendTap(anchorX + 460, anchorY - 110, 0) Then
                    Exit Function
                End If
                Call Note("[Q友体力56] 业务终态确认=用户批准的批量双点击完成；等待公共返回大厅")
                Exit Do
            End If
        Else
            If TickCount() - lastScroll > 2000 And Not scrollLocked Then
                If QFriendMatch("056_Q友页面") Then
                    anchorX = foundX
                    anchorY = foundY
                    If Not Sys.AppIsFront(GAME_PACKAGE) Then
                        Call Note("[Q友体力56] 滚动暂停：游戏不在前台")
                    Else
                        ReleaseCapture
                        If scrollCount < 10 Then
                            Call Note("[Q友体力56] 向上滚动 偏移250,-200到250,-580 时长200 等待1000")
                            Swipe anchorX + 250, anchorY - 200, anchorX + 250, anchorY - 580, 200
                            Delay 1000
                        ElseIf scrollCount < 20 Then
                            Call Note("[Q友体力56] 向下滚动 偏移250,-580到250,-200 时长200 等待1000")
                            Swipe anchorX + 250, anchorY - 580, anchorX + 250, anchorY - 200, 200
                            Delay 1000
                        Else
                            scrollCount = 0
                        End If
                        scrollCount = scrollCount + 1
                        claimRun = 0
                        Call Progress()
                    End If
                End If
                lastScroll = TickCount()
            End If
            If QFriendMatch("056_单项领取") Then
                anchorX = foundX
                anchorY = foundY
                Call Note("[Q友体力56] 单项领取 点击偏移=0,0 等待毫秒=500")
                If Not QFriendTap(anchorX, anchorY, 500) Then
                    Exit Function
                End If
                lastClaim = TickCount()
                lastScroll = TickCount()
                claimRun = claimRun + 1
                Call Progress()
            End If
            If QFriendMatch("056_Q友页面") Then
                ReleaseCapture
                text = Image.OcrText(555, 215, 623, 248, 0, 0)
                If IsNull(text) Then
                    text = ""
                End If
                If text <> lastText Then
                    Call Note("[Q友体力56] OCR 搜索区域=555,215,623,248 参数0 文本=" & text)
                    lastText = text
                End If
                If text = "60/60" Or text = "6060" Then
                    If Not BusinessExpired() Then
                        Call Note("[Q友体力56] 业务终态确认=Q友页OCR满额；等待公共返回大厅")
                        Exit Do
                    End If
                End If
            End If
            idleMs = TickCount() - lastClaim
            If idleMs > 2000 And idleMs <= 20000 Then
                scrollLocked = False
            ElseIf idleMs > 30000 Then
                Call Note("[Q友体力56] 失败原因=30秒无领取进展且未确认OCR终态；交公共恢复56")
                Exit Function
            End If
            If TickCount() - actionStarted > 180000 Or claimRun > 10 Then
                Call Note("[Q友体力56] 失败原因=专业版操作保护出口，未确认终态；交公共恢复56")
                Exit Function
            End If
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[Q友体力56] 终态提交前公共超时或前台中断，不返回成功")
        Exit Function
    End If
    qfriendTerminal = True
    terminalConfirmed = True
    Call QFriendStage("Q友体力56待返回大厅")
    ExecuteQQFriendStamina = RESULT_OK
    Call Note("[Q友体力56] 业务出口=成功；尚未提交完成次数")
End Function


// flows/050_定时领取体力/定时领取体力.mq
Sub TimedStage(value)
    staminaPhase = value
    Call SetTimedStaminaPhase(currentTask, value)
    Call SetStage(value)
End Sub
Sub TimedTouch(name, x, y, waitMs)
    Call Note("[定时体力] 命中=" & name & " 点击=" & x & "," & y & " 点击偏移=0,0 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
End Sub
Function TimedActivityFrame()
    TimedActivityFrame = True
    If StaminaMatch("050_活动框一") Then
        Exit Function
    End If
    TimedActivityFrame = StaminaMatch("050_活动框二")
End Function
Function TimedHallKnown()
    TimedHallKnown = True
    If StaminaMatch("050_大厅识别一") Then
        Exit Function
    End If
    If StaminaMatch("050_大厅识别二") Then
        Exit Function
    End If
    TimedHallKnown = StaminaMatch("050_大厅识别三")
End Function
Function TimedActivityIcon()
    TimedActivityIcon = True
    If StaminaMatch("050_大厅活动入口一") Then
        Exit Function
    End If
    TimedActivityIcon = StaminaMatch("050_大厅活动入口二")
End Function
Sub TimedResourcePrompt()
    Dim x, y, text
    If Not staminaKeepDownload Then
        If StaminaMatch("050_资源下载提示") Then
            x = foundX
            y = foundY
            text = ReadActivityText(100, 395, 317, 448)
            If text = "下载新功能" Then
                Call TimedTouch("050_资源下载提示标题", x, y, 0)
            End If
            text = ReadActivityText(230, 615, 479, 654)
            If text = "请在稳定网络下进行" Then
                Call TimedTouch("050_资源下载提示网络", x, y, 0)
            End If
        End If
    End If
End Sub
Function EnterTimedActivities()
    Dim initialStarted, enterStarted, text, hallResult
    EnterTimedActivities = RESULT_TIMEOUT
    Call TimedStage("定时体力进入活动")
    Call Note("[定时体力] 入口 EnterTimedActivities")
    initialStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 出口：活动位置检查超时或前台中断")
            Exit Function
        End If
        If TimedActivityFrame() Then
            EnterTimedActivities = RESULT_OK
            Call Note("[定时体力] 出口：原活动框已确认")
            Exit Function
        End If
        If TickCount() - initialStarted > 2000 Then
            Exit Do
        End If
        Delay 20
    Loop
    hallResult = ReturnToHall()
    If hallResult <> RESULT_OK Then
        Call Note("[定时体力] 出口：进入活动前返回大厅失败")
        Exit Function
    End If
    enterStarted = TickCount()
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 出口：进入活动业务总超时或前台中断")
            Exit Function
        End If
        Call TimedResourcePrompt()
        If TimedActivityFrame() Then
            EnterTimedActivities = RESULT_OK
            Call Note("[定时体力] 出口：专业版当前位置活动框复核成功，进入体力分页")
            Exit Function
        End If
        text = ReadActivityText(65, 7, 247, 59)
        If text = "活动" Then
            EnterTimedActivities = RESULT_OK
            Call Note("[定时体力] 出口：OCR活动标题已确认")
            Exit Function
        Else
            hallResult = ReturnToHall()
            If hallResult <> RESULT_OK Then
                Call Note("[定时体力] 出口：活动标题未成立且公共返回失败")
                Exit Function
            End If
        End If
        If TimedHallKnown() Then
            If TimedActivityIcon() Then
                Call TimedTouch("050_大厅活动入口", foundX, foundY, 1500)
            Else
                hallResult = ReturnToHall()
                If hallResult <> RESULT_OK Then
                    Call Note("[定时体力] 出口：无活动图标且公共返回失败")
                    Exit Function
                End If
            End If
        End If
        Delay 300
        If TickCount() - enterStarted > 60000 Then
            Call Note("[定时体力] 出口：专业版活动入口60秒超时；不提交完成")
            Delay 2000
            Exit Function
        End If
    Loop
End Function
Function StaminaMatch(name)
    Dim matched
    matched = MatchPattern(name)
    StaminaMatch = matched
    If matched Then
        Call Note("[定时体力] 编号=" & currentTask & " 阶段=" & staminaPhase & " 命中模板=" & name & " 搜索区域=见图色登记 锚点=" & foundX & "," & foundY)
    End If
End Function
Function StaminaTap(x, y, waitMs)
    StaminaTap = False
    Do While Not Sys.AppIsFront(GAME_PACKAGE)
        If BusinessExpired() Then
            Call Note("[定时体力] 失败原因=动作前等待前台时超时或中断；未提交")
            Exit Function
        End If
        Delay 20
    Loop
    If BusinessExpired() Then
        Call Note("[定时体力] 失败原因=动作前公共超时或中断；未提交")
        Exit Function
    End If
    Call Note("[定时体力] 编号=" & currentTask & " 点击坐标=" & x & "," & y & " 点击偏移=0,0（模板锚点或已记录的固定坐标） 等待毫秒=" & waitMs)
    Call TouchPoint(x, y, waitMs)
    StaminaTap = Not BusinessExpired()
End Function
Function StaminaSlotName(slot)
    StaminaSlotName = "晚上"
    If slot = 1 Then
        StaminaSlotName = "上午"
    ElseIf slot = 2 Then
        StaminaSlotName = "中午"
    ElseIf slot = 3 Then
        StaminaSlotName = "下午"
    End If
End Function
Function EnterTimedStaminaPage()
    Dim started, lastAction, swipeCount, direction, name
    EnterTimedStaminaPage = RESULT_TIMEOUT
    If EnterTimedActivities() <> RESULT_OK Then
        Call Note("[定时体力] 失败原因=公共活动入口未确认")
        Exit Function
    End If
    started = TickCount()
    lastAction = TickCount() + 1500
    swipeCount = 0
    direction = 0
    Call TimedStage("定时体力查找分页")
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=查找分页公共超时或前台中断")
            Exit Function
        End If
        If direction < 4 Then
            direction = direction + 1
        Else
            direction = 0
        End If
        If StaminaMatch("050_体力页面一") Then
            EnterTimedStaminaPage = RESULT_OK
            Exit Function
        End If
        If StaminaMatch("050_体力页面二") Then
            EnterTimedStaminaPage = RESULT_OK
            Exit Function
        End If
        If TimedActivityFrame() Then
            If StaminaMatch("050_体力图标") Then
                If Not StaminaTap(foundX, foundY, 1500) Then
                    Exit Function
                End If
                lastAction = TickCount()
            End If
            If TickCount() - lastAction > 1500 Then
                swipeCount = swipeCount + 1
                Call Note("[定时体力] 分页滑动序号=" & swipeCount & " 专业版辅助搜索方向=" & direction)
                If swipeCount <= 7 Then
                    Call SwipeActivityPage(False)
                Else
                    Call SwipeActivityPage(True)
                    If swipeCount = 14 Then
                        swipeCount = 0
                    End If
                End If
                lastAction = TickCount()
            End If
        End If
        If TickCount() - started > 35000 Then
            Call Note("[定时体力] 超时原因=分页查找超过35000毫秒 等待2000后公共恢复")
            Delay 2000
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function DetectStaminaSlot(slot)
    Dim prefix, name
    DetectStaminaSlot = RESULT_TIMEOUT
    prefix = "050_" & StaminaSlotName(slot)
    Call TimedStage(prefix)
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=初始时段状态未知；未提交完成")
            Exit Function
        End If
        name = prefix & "已领"
        If StaminaMatch(name) Then
            Call Note("[定时体力] 初始状态=已领取；不是最终完成提交")
            Delay 200
            DetectStaminaSlot = RESULT_OK
            Exit Function
        End If
        name = prefix & "可补"
        If StaminaMatch(name) Then
            Call Note("[定时体力] 初始状态=可补领")
            Delay 200
            DetectStaminaSlot = RESULT_OK
            Exit Function
        End If
        name = prefix & "可领"
        If StaminaMatch(name) Then
            Call Note("[定时体力] 初始状态=免费未领取")
            Delay 200
            DetectStaminaSlot = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ClaimTimedStamina(slot)
    Dim actionSlot, name, prefix, terminalName
    ClaimTimedStamina = RESULT_TIMEOUT
    terminalName = "050_" & StaminaSlotName(slot) & "已领"
    If staminaGem Then
        If slot = 2 Then
            terminalName = "050_前两档已领"
        ElseIf slot = 3 Then
            terminalName = "050_前三档已领"
        ElseIf slot = 4 Then
            terminalName = "050_四档已领"
        End If
    End If
    Call TimedStage("定时体力领取与补领")
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=领取未确认已领终态；未提交完成")
            Exit Function
        End If
        actionSlot = slot
        If staminaGem Then
            actionSlot = 1
        End If
        Do While actionSlot <= slot
            prefix = "050_" & StaminaSlotName(actionSlot)
            name = prefix & "可领"
            If StaminaMatch(name) Then
                If Not StaminaTap(foundX, foundY, 200) Then
                    Exit Function
                End If
            End If
            If staminaGem Then
                name = prefix & "可补"
                If StaminaMatch(name) Then
                    If Not StaminaTap(foundX, foundY, 200) Then
                        Exit Function
                    End If
                End If
            End If
            actionSlot = actionSlot + 1
        Loop
        If StaminaMatch(terminalName) Then
            Call Note("[定时体力] 领取正常终态=" & terminalName & " 等待毫秒=200；已领取或已无本档奖励")
            Delay 200
            ClaimTimedStamina = RESULT_OK
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function TimedStaminaExtras()
    Dim started, phase, text, attempt, balance
    TimedStaminaExtras = RESULT_TIMEOUT
    If Not staminaRecover And Not staminaExchange Then
        TimedStaminaExtras = RESULT_OK
        Exit Function
    End If
    Call TimedStage("定时体力追回兑换")
    started = TickCount()
    phase = 0
    Do
        If BusinessExpired() Then
            Call Note("[定时体力] 超时原因=追回兑换公共超时或前台中断")
            Exit Function
        End If
        If StaminaMatch("050_追回入口") Then
            Call Note("[定时体力] 固定点击追回入口630,260")
            If Not StaminaTap(630, 260, 1000) Then
                Exit Function
            End If
        End If
        If phase = 0 Then
            If staminaRecover Then
                If StaminaMatch("050_追回灰色") Then
                    Call Note("[定时体力] 追回灰色，进入兑换阶段")
                    phase = 1
                End If
                If StaminaMatch("050_追回可用") Then
                    If Not StaminaTap(570, 400, 1000) Then
                        Exit Function
                    End If
                End If
                If StaminaMatch("050_追回确认") Then
                    ReleaseCapture
                    text = Image.OcrText(141, 543, 564, 651, 0, 0)
                    If IsNull(text) Then
                        text = ""
                    End If
                    Call Note("[定时体力] 追回确认OCR 区域141,543,564,651 关键词是否消耗/5日内未 模糊 文本=" & text)
                    If InStr(1, text, "是否消耗") > 0 Or InStr(1, text, "5日内未") > 0 Then
                        If Not StaminaTap(440, 785, 1000) Then
                            Exit Function
                        End If
                        phase = 1
                    End If
                End If
            Else
                phase = 1
            End If
        ElseIf phase = 1 Then
            If staminaExchange Then
                If StaminaMatch("050_兑换弹窗") Then
                    If Not StaminaTap(612, 650, 1000) Then
                        Exit Function
                    End If
                    If Not StaminaTap(412, 750, 1000) Then
                        Exit Function
                    End If
                    If Not StaminaTap(412, 750, 1000) Then
                        Exit Function
                    End If
                    TimedStaminaExtras = RESULT_OK
                    Call Note("[定时体力] 兑换正常出口=专业版特殊弹窗三次点击完成")
                    Exit Function
                End If
                If StaminaMatch("050_兑换灰色") Then
                    TimedStaminaExtras = RESULT_OK
                    Call Note("[定时体力] 兑换正常出口=灰色不可兑换")
                    Exit Function
                End If
                If StaminaMatch("050_兑换可用") Then
                    attempt = 1
                    Do While attempt <= 2
                        ReleaseCapture
                        text = Image.OcrText(95, 262, 184, 294, 2, 0)
                        If IsNull(text) Then
                            text = ""
                        End If
                        Call Note("[定时体力] 兑换余额OCR 区域95,262,184,294 参数2 次数=" & attempt & " 文本=" & text)
                        If IsNumeric(text) Then
                            balance = Int(CDbl(text))
                            If balance >= 40 Then
                                If Not StaminaTap(570, 777, 1000) Then
                                    Exit Function
                                End If
                                Exit Do
                            Else
                                TimedStaminaExtras = RESULT_OK
                                Call Note("[定时体力] 兑换正常出口=已识别余额不足40")
                                Exit Function
                            End If
                        End If
                        Delay 500
                        attempt = attempt + 1
                    Loop
                End If
            Else
                TimedStaminaExtras = RESULT_OK
                Call Note("[定时体力] 可选追回流程完成，兑换关闭")
                Exit Function
            End If
        End If
        If TickCount() - started > 15000 Then
            Call Note("[定时体力] 超时原因=追回兑换15000毫秒保护出口，未确认终态，不提交")
            Exit Function
        End If
        Delay 20
    Loop
End Function
Function ExecuteTimedStamina(taskId)
    Dim slot, checkSlot, result
    ExecuteTimedStamina = RESULT_TIMEOUT
    terminalConfirmed = False
    staminaTerminal = False
    slot = taskId - 49
    If slot = 5 Then
        slot = 4
    End If
    Call Note("[定时体力] 业务入口 名称=" & StaminaName(taskId) & " 编号=" & taskId & " 开始时间Unix=" & Time())
    result = EnterTimedStaminaPage()
    If result <> RESULT_OK Then
        Call Note("[定时体力] 失败或超时原因=进入体力页面失败，等待公共恢复原任务；未提交")
        Exit Function
    End If
    checkSlot = 1
    Do While checkSlot <= slot
        If DetectStaminaSlot(checkSlot) <> RESULT_OK Then
            Exit Function
        End If
        Call Progress()
        checkSlot = checkSlot + 1
    Loop
    Call Note("[定时体力] 初始状态确认完成 等待毫秒=3000")
    Delay 3000
    Call Progress()
    If ClaimTimedStamina(slot) <> RESULT_OK Then
        Exit Function
    End If
    If TimedStaminaExtras() <> RESULT_OK Then
        Exit Function
    End If
    If BusinessExpired() Then
        Call Note("[定时体力] 终态出口前公共超时或中断，未提交完成")
        Exit Function
    End If
    staminaTerminal = True
    terminalConfirmed = True
    ExecuteTimedStamina = RESULT_OK
    Call TimedStage("定时体力业务终态确认")
    Call Note("[定时体力] 正常终态确认；等待公共返回大厅与连续确认，是否提交完成=否")
End Function
