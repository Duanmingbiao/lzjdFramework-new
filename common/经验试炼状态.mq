Sub LoadExperienceSettings()
    experienceEnabled = WorldBoolean("SlJyan")
End Sub
Sub NewExperienceSession()
    experienceDue = Time()
    experienceDone = False
    experienceAbandoned = False
    experienceCount = 0
    experienceRecoveries = 0
    experienceRestarts = 0
    experiencePhase = "未开始"
    experienceReason = ""
    experienceExitKind = 0
    experienceFinishedAt = 0
    experienceNativeTimeout = False
End Sub
Function SelectExperience()
    SelectExperience = 0
    If experienceEnabled And Not experienceDone And Not experienceAbandoned And Time() >= experienceDue Then
        SelectExperience = 13
    End If
End Function
Sub StartExperienceTask()
    experienceReason = ""
    experienceExitKind = 0
    experienceFinishedAt = 0
    experienceNativeTimeout = False
    Call WorldStage("经验试炼启动")
End Sub
Sub RecoverExperienceTask()
    experienceRecoveries = experienceRecoveries + 1
    If experienceNativeTimeout Then
        experienceCount = experienceCount + 1
        experienceDue = experienceFinishedAt + 65
        experienceAbandoned = experienceCount >= 5
        resumeTask = 0
        Call WorldLog("原业务超时计次并延后65秒；非胜利、非成功提交 次数=" & experienceCount)
    Else
        Call WorldLog("前台或公共边界恢复；保留13，不计次、不改期")
    End If
    If experienceAbandoned Then
        resumeTask = 0
    End If
    experienceNativeTimeout = False
    experienceExitKind = 0
    terminalConfirmed = False
End Sub
Sub RestartExperienceTask()
    experienceRestarts = experienceRestarts + 1
    Call WorldLog("公共重启恢复13 次数=" & experienceRestarts)
End Sub
Sub CommitExperienceTask()
    If experienceExitKind = 1 Then
        experienceDone = True
    ElseIf experienceExitKind = 2 Then
        experienceDue = experienceFinishedAt + 65
    ElseIf experienceExitKind = 4 Then
        experienceCount = experienceCount + 1
        experienceDue = experienceFinishedAt + 65
        experienceDone = experienceCount >= 5
    End If
    experienceExitKind = 0
    Call WorldLog("大厅连续确认后提交原出口；次数=" & experienceCount & " 下次Unix=" & experienceDue)
End Sub
Function ResetExperienceTimer()
    ResetExperienceTimer = False
    If BusinessExpired() Then
        Exit Function
    End If
    businessStarted = TickCount()
    ResetExperienceTimer = True
End Function
Function ConfirmExperienceExit(reason, exitKind)
    ConfirmExperienceExit = RESULT_TIMEOUT
    If BusinessExpired() Then
        Exit Function
    End If
    experienceReason = reason
    experienceExitKind = exitKind
    experienceFinishedAt = Time()
    If exitKind = 3 Then
        experienceNativeTimeout = True
        Call WorldLog("原超时出口=" & reason & "；交公共恢复，不标成功")
        Exit Function
    End If
    If exitKind <> 1 And exitKind <> 2 And exitKind <> 4 Then
        Exit Function
    End If
    terminalConfirmed = True
    Call WorldLog("原出口=" & reason & "；尚未提交，等待大厅连续确认")
    ConfirmExperienceExit = RESULT_OK
End Function
