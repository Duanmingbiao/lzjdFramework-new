Sub SchedulerStep()
    Dim selected, result, hallResult, committed
    committed = HandleForegroundRecovery()
    selected = SelectDueTask()
    If selected = 0 Then
        If foregroundLoginPending Then
            result = EnsureGameHall()
            Call Note("[流程] EnsureGameHall() 返回=" & result)
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If result = RESULT_OK Then
                foregroundLoginPending = False
            Else
                Call RestartGame()
            End If
        End If
        Exit Sub
    End If
    Call SaveCurrentTask(selected)
    Call Note("[流程] 调度入口 任务=" & selected)
    result = EnsureGameHall()
    Call Note("[流程] EnsureGameHall() 返回=" & result)
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result <> RESULT_OK Then
        loginFailures = loginFailures + 1
        Call Note("登录总超时，次数=" & loginFailures)
        Call RestartGame()
        Exit Sub
    End If
    foregroundLoginPending = False
    businessStarted = TickCount()
    result = DispatchTask(selected)
    Call Note("[流程] DispatchTask(selected) 返回=" & result)
    If currentTask = 22 Then
        Call StageForestPublicTimeout()
        If forestDeferred Then
            result = RESULT_WAIT
        End If
    End If
    If currentTask = 82 And result = RESULT_WAIT Then
        If memoryUncompleted Then
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseMemoryUncompleted(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    If currentTask = 21 And result = RESULT_WAIT Then
        If galaxyDeferred Then
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ScheduleGalaxyRetry(hallResult = RESULT_OK) Then
                Call Note("[跨银河21] 原服务器异常一小时后重试；非完成；执行原重启请求")
                Call RestartGame()
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    If currentTask = 22 And result = RESULT_WAIT Then
        If forestDeferred Then
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ScheduleForestRetry(hallResult = RESULT_OK) Then
                If forestTimeoutPending Then
                    forestTimeoutPending = False
                    If Sys.IsRunning(GAME_PACKAGE) And Not forestRestartOnTimeout Then
                        Call WorldWait(1000)
                    Else
                        Call RestartGame()
                    End If
                End If
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    If currentTask = 23 And result = RESULT_WAIT Then
        If allianceDeferred Then
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseAllianceRetry(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    If currentTask = 88 And result = RESULT_WAIT Then
        If namekDeferred Then
            hallResult = ReturnToHall()
            Call WorldLog("待重试返回大厅结果=" & hallResult & " 是否提交完成=否")
            If HandleForegroundRecovery() Then
                Call Note("[流程] 出口 SchedulerStep 待重试时前台恢复")
                Exit Sub
            End If
            If ScheduleNamekRetry(hallResult = RESULT_OK) Then
                Call Note("[流程] 出口 SchedulerStep 任务88已安排一小时后重试，未提交完成")
                Exit Sub
            End If
            result = RESULT_TIMEOUT
        End If
    End If
    Do While result = RESULT_WAIT
        If BusinessExpired() Then
            result = RESULT_TIMEOUT
        Else
            Delay 20
            result = DispatchTask(selected)
            Call Note("[流程] DispatchTask(selected) 返回=" & result)
        End If
    Loop
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If result = RESULT_OK And terminalConfirmed Then
        hallResult = ReturnToHall()
        Call Note("[流程] ReturnToHall() 返回=" & hallResult)
        If currentTask = 71 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 88 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 87 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 86 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If IsRedArmy(currentTask) Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 83 Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If IsWorldBoss(currentTask) Then
            Call WorldLog("返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 152 Then
            Call Note("[合作大冒险152] 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If currentTask = 151 Then
            Call Note("[悟空的冒险151] 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If IsTimedStamina(currentTask) Then
            Call Note("[定时体力] 编号=" & currentTask & " 返回大厅结果=" & hallResult & " 是否提交完成=尚未提交")
        End If
        If HandleForegroundRecovery() Then
            Exit Sub
        End If
        If hallResult = RESULT_OK Then
            committed = CommitTask(True)
            If committed Then
                Call Note("[流程] CommitTask(True) 返回=true")
            Else
                Call Note("[流程] CommitTask(True) 返回=false")
            End If
            If committed Then
                Exit Sub
            End If
        End If
    End If
    If HandleForegroundRecovery() Then
        Exit Sub
    End If
    If currentTask = 80 And result = RESULT_OK And terminalConfirmed Then
        If hallResult <> RESULT_OK Then
            friezaTimedOut = True
            friezaReason = "专业版公共返回大厅失败，不提交完成"
        End If
    End If
    If currentTask = 81 And result = RESULT_OK And terminalConfirmed Then
        If hallResult <> RESULT_OK Then
            duelTimedOut = True
            duelReason = "专业版公共返回大厅失败，不提交完成"
        End If
    End If
    Call SaveRecovery()
    If currentTask = 23 And allianceTimeoutRecovery Then
        allianceTimeoutRecovery = False
        businessStarted = TickCount()
        If Sys.IsRunning(GAME_PACKAGE) And Not allianceRestartOnTimeout Then
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            Call WorldLog("原公共超时不重启；大厅结果=" & hallResult & "；非成功")
            Call WorldWait(1000)
            Exit Sub
        End If
    End If
    If trialPublicRecoveryTask = currentTask And IsTrialTask(currentTask) Then
        trialPublicRecoveryTask = 0
        businessStarted = TickCount()
        If Sys.IsRunning(GAME_PACKAGE) And Not trialRestartOnTimeout Then
            Call WorldLog("原公共超时配置不重启；返回大厅后重新调度")
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            Call WorldLog("公共超时返回大厅结果=" & hallResult & "；非成功提交")
            Call WorldWait(1000)
            Exit Sub
        End If
    End If
    If currentTask = 92 And yskNoRestartPending Then
        yskNoRestartPending = False
        Exit Sub
    End If
    If currentTask = 15 And geneNoRestartPending Then
        geneNoRestartPending = False
        Call WorldLog("原公共超时配置不重启；大厅未确认，保留公共恢复，不提交")
        Exit Sub
    End If
    Call Note("[流程] 调度出口 业务未提交成功，进入恢复")
    If currentTask = 81 And duelTimedOut And Not duelRestartOnTimeout Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            duelRunning = False
            duelWatchdogTripped = False
            Call DuelProgress()
            duelRunning = True
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseDuelTimeout(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            duelRunning = False
            Exit Sub
        End If
    End If
    If currentTask = 80 And friezaTimedOut And Not friezaRestartOnTimeout Then
        If Sys.IsRunning(GAME_PACKAGE) Then
            friezaRunning = False
            friezaWatchdogTripped = False
            Call FriezaProgress()
            friezaRunning = True
            hallResult = ReturnToHall()
            If HandleForegroundRecovery() Then
                Exit Sub
            End If
            If ReleaseFriezaTimeout(hallResult = RESULT_OK) Then
                Exit Sub
            End If
            // Keep the no-restart option even when hall confirmation failed.
            friezaRunning = False
            Exit Sub
        End If
    End If
    Call RestartGame()
End Sub
